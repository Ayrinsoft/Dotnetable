@model Dotnetable.Web.Controllers.BlogController.BlogListView
@{
    var title = Model.Heading ?? "Blog";
    ViewData["Title"] = title;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PageHeader", (title, "Blog"))

<section class="site-section">
    <div class="container">
        @if (Model.Posts.Count == 0)
        {
            <div class="text-center py-5">
                <p class="text-muted mb-0">No posts to show yet.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var post in Model.Posts)
                {
                    var primaryCategory = post.Categories.FirstOrDefault();
                    <div class="col-md-6 col-lg-4">
                        <article class="blog-card">
                            @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                            {
                                <div class="thumb" style="background-image:url('@post.FeaturedImageUrl'); background-size:cover; background-position:center;"></div>
                            }
                            else
                            {
                                <div class="thumb" style="background-image:linear-gradient(135deg,#1d2433,#2a3346);"></div>
                            }
                            <div class="body">
                                @if (primaryCategory is not null)
                                {
                                    <a class="tag text-decoration-none" asp-controller="Blog" asp-action="Category" asp-route-slug="@primaryCategory.Slug">@primaryCategory.Name</a>
                                }
                                <h3><a class="text-reset" asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug">@post.Title</a></h3>
                                @if (!string.IsNullOrEmpty(post.Excerpt))
                                {
                                    <p class="text-muted">@post.Excerpt</p>
                                }
                                <div class="meta d-flex justify-content-between">
                                    <span><i class="bi bi-calendar3 me-1"></i>@(post.PublishedAt?.ToString("MMM d, yyyy") ?? "")</span>
                                    @if (!string.IsNullOrEmpty(post.AuthorName))
                                    {
                                        <span><i class="bi bi-person me-1"></i>@post.AuthorName</span>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5" aria-label="Blog pages">
                    <ul class="pagination justify-content-center">
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Blog" asp-action="Index"
                                   asp-route-page="@i" asp-route-category="@Model.Category" asp-route-tag="@Model.Tag">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</section>
