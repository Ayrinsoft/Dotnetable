@using Dotnetable.Web.Services
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Dotnetable.Application.DTOs.PostDetailDto
@inject ContentShortcodeProcessor Shortcodes
@inject ApiClient Api
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";

    // Article card: the excerpt and featured image are what a chat app or social preview renders.
    ViewData["OgType"] = "article";
    ViewData["OgImage"] = Model.FeaturedImageUrl;
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Excerpt : Model.MetaDescription;
    ViewData["MetaKeywords"] = Model.MetaKeywords;

    var primaryCategory = Model.Categories.FirstOrDefault();
    var content = await Shortcodes.ExpandAsync(Model.Content);
}

@await Html.PartialAsync("_PageHeader", (Model.Title, "Blog"))

<section class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex gap-3 align-items-center mb-4 flex-wrap">
                    @if (primaryCategory is not null)
                    {
                        <a class="tag text-primary fw-bold text-uppercase text-decoration-none"
                           asp-controller="Blog" asp-action="Category" asp-route-slug="@primaryCategory.Slug">@primaryCategory.Name</a>
                    }
                    <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>@(Model.PublishedAt?.ToString("MMMM d, yyyy") ?? "")</span>
                    @if (!string.IsNullOrEmpty(Model.AuthorName))
                    {
                        @if (!string.IsNullOrEmpty(Model.Author?.Slug))
                        {
                            <a class="text-muted" href="@Url.RouteUrl("author", new { slug = Model.Author.Slug })"><i class="bi bi-person me-1"></i>@Model.AuthorName</a>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-person me-1"></i>@Model.AuthorName</span>
                        }
                    }
                </div>

                @if (Model.Images.Count > 1)
                {
                    var galleryId = $"post-gallery-{Model.PostID}";
                    <div id="@galleryId" class="carousel slide site-slideshow post-gallery rounded-4 mb-4" data-bs-ride="false">
                        <div class="carousel-indicators">
                            @for (var i = 0; i < Model.Images.Count; i++)
                            {
                                <button type="button" data-bs-target="#@galleryId" data-bs-slide-to="@i" class="@(i == 0 ? "active" : null)"
                                        aria-current="@(i == 0 ? "true" : null)" aria-label="@($"Slide {i + 1}")"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @for (var i = 0; i < Model.Images.Count; i++)
                            {
                                var photo = Model.Images[i];
                                var full = string.IsNullOrEmpty(photo.FullUrl) ? photo.Url : photo.FullUrl;
                                <div class="carousel-item@(i == 0 ? " active" : "")">
                                    <a href="@full" class="site-slideshow-lightbox" data-lightbox-group="@galleryId">
                                        <img src="@MediaHtml.Placeholder" data-src="@photo.Url" class="d-block w-100 dn-lazy" alt="@Model.Title" />
                                    </a>
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#@galleryId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#@galleryId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                {
                    @* The thumbnail is what the page shows; the original is fetched only when the visitor opens it. *@
                    var featuredFull = Model.FeaturedImageFullUrl != Model.FeaturedImageUrl ? Model.FeaturedImageFullUrl : null;
                    <img src="@MediaHtml.Placeholder" data-src="@Model.FeaturedImageUrl" data-full="@featuredFull" alt="@Model.Title"
                         class="img-fluid rounded-4 mb-4 dn-lazy @(featuredFull is null ? null : "dn-zoom")" />
                }
                else
                {
                    <div class="ratio ratio-21x9 rounded-4 bg-dark-section mb-4" style="background:linear-gradient(135deg,#1d2433,#2a3346);"></div>
                }

                @if (!string.IsNullOrEmpty(Model.Excerpt))
                {
                    <p class="lead">@Model.Excerpt</p>
                }

                <div class="post-content">
                    @Html.Raw(content)
                </div>
                @{
                    var blogAds = await Api.GetAdvertisementsAsync("Blog", Context.Request.Cookies["lang"]);
                }
                @if (blogAds.Count > 0)
                {
                    <div class="mt-4">
                        @await Html.PartialAsync("_Advertisements", blogAds, new ViewDataDictionary(ViewData) { ["AdsModifier"] = "blog" })
                    </div>
                }

                @if (Model.Tags.Any())
                {
                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        @foreach (var tag in Model.Tags)
                        {
                            <a class="badge bg-secondary text-decoration-none"
                               asp-controller="Blog" asp-action="Tag" asp-route-slug="@tag.Slug">#@tag.Name</a>
                        }
                    </div>
                }

                <div class="mt-4">
                    <partial name="_ReactionBar" model='@(("post", Model.PostID, Model.LikeCount))' />
                </div>

                @if (Model.Author is not null)
                {
                    <partial name="_AuthorBox" model="Model.Author" />
                }

                @if (Model.CommentsEnabled)
                {
                    <partial name="_Comments" model="(Dotnetable.Application.DTOs.CommentTarget.Post, Model.PostID)" />
                }

                <hr class="my-4" />
                <a class="btn btn-outline-secondary" asp-controller="Blog" asp-action="Index">
                    <i class="bi bi-arrow-left me-1"></i>Back to blog
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (Model.CommentsEnabled)
    {
        <script src="~/js/comments.js" asp-append-version="true"></script>
    }
}
