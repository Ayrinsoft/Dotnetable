@using Dotnetable.Application.DTOs
@using Dotnetable.Domain.Enums
@model CustomerReturnDto
@{
    ViewData["Title"] = $"Return #{Model.CustomerReturnRequestID}";
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    var status = (CustomerReturnStatus)Model.Status;
    string StatusLabel(CustomerReturnStatus s) => s switch
    {
        CustomerReturnStatus.PreRequest => "Waiting for review",
        CustomerReturnStatus.Rejected => "Rejected",
        CustomerReturnStatus.ApprovedAwaitingShipment => "Approved — ship the parcel",
        CustomerReturnStatus.Shipped => "Shipped",
        CustomerReturnStatus.Received => "Received at warehouse",
        CustomerReturnStatus.Completed => "Completed",
        CustomerReturnStatus.Cancelled => "Cancelled",
        _ => s.ToString(),
    };
}

@await Html.PartialAsync("_PageHeader", ($"Return #{Model.CustomerReturnRequestID}", "Account"))

<section class="site-section">
    <div class="container" style="max-width:760px">
        @if (TempData["ReturnError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <span class="badge text-bg-primary">@StatusLabel(status)</span>
                    <span class="text-muted small">Order @Model.OrderNumber</span>
                </div>
                <p class="mb-1"><strong>Reason:</strong> @((CustomerReturnReason)Model.Reason)</p>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                @if (Model.ShippingPayer != 0)
                {
                    <p class="mb-1">
                        <strong>Return shipping:</strong>
                        @(((ReturnShippingPayer)Model.ShippingPayer) switch
                        {
                            ReturnShippingPayer.Customer => "Paid by you",
                            ReturnShippingPayer.SplitFiftyFifty => "Split 50 / 50",
                            ReturnShippingPayer.Seller => "Paid by the seller",
                            ReturnShippingPayer.DropOffAtCenter => "Drop-off at a store / center",
                            _ => "—",
                        })
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
                {
                    <p class="text-muted small">Review note: @Model.ReviewNote</p>
                }
            </div>
        </div>

        @if (Model.Photos.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var p in Model.Photos)
                {
                    var src = p.ThumbnailUrl ?? p.Url;
                    if (!string.IsNullOrWhiteSpace(src))
                    {
                        <a href="@p.Url" target="_blank"><img src="@src" alt="" style="width:88px;height:88px;object-fit:cover;border-radius:8px;" /></a>
                    }
                }
            </div>
        }

        <table class="table mb-4">
            <thead><tr><th>Item</th><th>Qty</th><th>Paid</th><th>Asked</th><th>Approved</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@l.Title <div class="small text-muted">@l.Sku</div></td>
                        <td>@l.Quantity</td>
                        <td>@l.UnitPricePaid.ToString("0.##")</td>
                        <td>@l.UnitRefundRequested.ToString("0.##")</td>
                        <td>@(l.UnitRefundApproved > 0 ? l.UnitRefundApproved.ToString("0.##") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.ShippingPayer == (byte)ReturnShippingPayer.DropOffAtCenter
             && status == CustomerReturnStatus.ApprovedAwaitingShipment)
        {
            <div class="alert alert-info">Bring the goods to a store / return center. Tracking is not required.</div>
        }
        else if (status == CustomerReturnStatus.ApprovedAwaitingShipment || status == CustomerReturnStatus.Shipped)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6>@(status == CustomerReturnStatus.Shipped ? "Update tracking" : "I have shipped the parcel")</h6>
                    <form asp-action="@(status == CustomerReturnStatus.Shipped ? "ReturnTracking" : "ReturnShip")" method="post">
                        <input type="hidden" name="id" value="@Model.CustomerReturnRequestID" />
                        <div class="mb-2">
                            <label class="form-label">How you sent it</label>
                            <input name="shipMethod" class="form-control" value="@Model.ShipMethod" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Tracking code</label>
                            <input name="trackingCode" class="form-control" value="@Model.TrackingCode" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                </div>
            </div>
        }

        <div class="small text-muted">
            @foreach (var h in Model.Histories)
            {
                <div>@h.CreatedAt.ToLocalTime().ToString("g") — @StatusLabel((CustomerReturnStatus)h.ToStatus) @(h.Note)</div>
            }
        </div>

        <div class="mt-3">
            <a asp-action="Returns" class="btn btn-link px-0">← All returns</a>
            <a asp-action="OrderDetail" asp-route-id="@Model.OrderID" class="btn btn-link">Order</a>
        </div>
    </div>
</section>
