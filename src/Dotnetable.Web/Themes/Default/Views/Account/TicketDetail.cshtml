@using Dotnetable.Application.DTOs
@model ClientSupportTicketDetailDto
@{
    ViewData["Title"] = Model.Ticket.SessionNumber;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    var t = Model.Ticket;
}

@await Html.PartialAsync("_PageHeader", (t.SessionNumber, "Account"))

<section class="site-section">
    <div class="container" style="max-width:800px">
        @if (TempData["TicketError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge text-bg-primary">@t.StatusName</span>
            <span class="badge text-bg-secondary">@t.ChannelName</span>
            @if (!string.IsNullOrEmpty(t.RelatedOrderNumber) && t.RelatedOrderID is int oid)
            {
                <a asp-action="OrderDetail" asp-route-id="@oid">Order @t.RelatedOrderNumber</a>
            }
        </div>
        <h2 class="h5">@(t.Subject ?? "Support ticket")</h2>
        <p class="text-muted">Opened @t.CreatedAt.ToLocalTime().ToString("g")</p>

        <div class="mb-4">
            @foreach (var i in Model.Interactions)
            {
                <div class="border rounded p-3 mb-2 @(i.InteractionType == (byte)SupportInteractionType.CustomerReply ? "bg-light" : "")">
                    <div class="small text-muted mb-1">
                        @(i.CreatedByMemberName ?? "Support") · @i.CreatedAt.ToLocalTime().ToString("g")
                    </div>
                    <div style="white-space:pre-wrap">@i.Body</div>
                </div>
            }
        </div>

        @if (t.Status is not (byte)SupportSessionStatus.Closed)
        {
            <form asp-action="TicketReply" asp-route-id="@t.SupportSessionID" method="post">
                <div class="mb-3">
                    <label class="form-label">Reply</label>
                    <textarea name="body" class="form-control" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send reply</button>
            </form>
        }

        <div class="mt-3">
            <a asp-action="Tickets" class="btn btn-link px-0">← All tickets</a>
        </div>
    </div>
</section>
