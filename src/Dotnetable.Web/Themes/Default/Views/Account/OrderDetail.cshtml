@using Dotnetable.Application.DTOs
@using Dotnetable.Domain.Entities
@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    var digitalItems = ViewBag.DigitalItems as IReadOnlyList<DigitalLibraryItemDto> ?? Array.Empty<DigitalLibraryItemDto>();
}

@await Html.PartialAsync("_PageHeader", ($"Order {Model.OrderNumber}", "Account"))

<section class="site-section">
    <div class="container" style="max-width:720px">
        <p><strong>Status:</strong> @((Dotnetable.Application.Interfaces.OrderStatus)Model.Status)</p>
        <table class="table">
            <thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>
                            @item.TitleSnapshot
                            @if (item.Vendor is not null)
                            {
                                <div class="small text-muted">Sold by @item.Vendor.Name</div>
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td>@item.TotalPrice.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-end fs-5 fw-bold">Total: @Model.GrandTotal.ToString("0.##") @Model.CurrencyCode</div>

        @if (digitalItems.Count > 0)
        {
            <div class="alert alert-success mt-4">
                <h6 class="alert-heading mb-2"><i class="bi bi-cloud-download me-1"></i> Digital delivery</h6>
                <p class="mb-2 small">These items stay available in your library after purchase.</p>
                <ul class="mb-2">
                    @foreach (var d in digitalItems)
                    {
                        <li>
                            <a asp-controller="Account" asp-action="DownloadDetail" asp-route-id="@d.OrderDigitalAssetID">@d.Title</a>
                            @if (d.HasDownloadUrl) { <span class="badge text-bg-primary">Download</span> }
                            @if (d.HasDeliveryNote) { <span class="badge text-bg-secondary">Code</span> }
                            @if (d.HasServiceUrl) { <span class="badge text-bg-info">Service</span> }
                        </li>
                    }
                </ul>
                <a asp-controller="Account" asp-action="Downloads" class="btn btn-sm btn-outline-success">Open digital library</a>
            </div>
        }

        @if (Model.Status == (byte)Dotnetable.Application.Interfaces.OrderStatus.PendingPayment)
        {
            <a asp-controller="Checkout" asp-action="Payment" asp-route-orderId="@Model.OrderID" class="btn btn-primary mt-3">Complete payment</a>
        }
    </div>
</section>
