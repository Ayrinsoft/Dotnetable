@using Dotnetable.Application.DTOs
@using Dotnetable.Domain.Entities
@using Dotnetable.Application.Interfaces
@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    var digitalItems = ViewBag.DigitalItems as IReadOnlyList<DigitalLibraryItemDto> ?? Array.Empty<DigitalLibraryItemDto>();
    string OrderStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.PendingPayment => "Pending payment",
        OrderStatus.Paid => "Paid",
        OrderStatus.Processing => "Processing",
        OrderStatus.Shipped => "Shipped",
        OrderStatus.Completed => "Completed",
        OrderStatus.Cancelled => "Cancelled",
        OrderStatus.Refunded => "Refunded",
        _ => s.ToString(),
    };
    string PrepLabel(OrderPreparationStatus s) => s switch
    {
        OrderPreparationStatus.NotStarted => "Not started",
        OrderPreparationStatus.Pending => "Pending",
        OrderPreparationStatus.Preparing => "Preparing / warehouse",
        OrderPreparationStatus.ReadyToShip => "Ready to ship",
        _ => s.ToString(),
    };
    string ShipLabel(OrderShippingStatus s) => s switch
    {
        OrderShippingStatus.NotShipped => "Not shipped",
        OrderShippingStatus.PreparingShipment => "Preparing shipment",
        OrderShippingStatus.Shipped => "Shipped",
        OrderShippingStatus.InTransit => "In transit",
        OrderShippingStatus.Delivered => "Delivered",
        OrderShippingStatus.Returned => "Returned",
        _ => s.ToString(),
    };
    var orderStatus = (OrderStatus)Model.Status;
    var prepStatus = (OrderPreparationStatus)Model.PreparationStatus;
    var shipStatus = (OrderShippingStatus)Model.ShippingStatus;
}

@await Html.PartialAsync("_PageHeader", ($"Order {Model.OrderNumber}", "Account"))

<section class="site-section">
    <div class="container" style="max-width:720px">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <span class="badge text-bg-primary">@OrderStatusLabel(orderStatus)</span>
                    @if (Model.PaidAt is DateTime paid)
                    {
                        <span class="text-muted small">Paid @paid.ToLocalTime().ToString("g")</span>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Preparation</div>
                        <div class="fw-semibold">@PrepLabel(prepStatus)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Shipping</div>
                        <div class="fw-semibold">@ShipLabel(shipStatus)</div>
                    </div>
                    @if (Model.ShippingMethod is not null)
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">Shipping method</div>
                            <div>@Model.ShippingMethod.Title</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ShippingTrackingCode))
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">Tracking code</div>
                            <div><code class="user-select-all">@Model.ShippingTrackingCode</code></div>
                        </div>
                    }
                    @if (Model.ShippedAt is DateTime shipped)
                    {
                        <div class="col-md-6">
                            <div class="text-muted small">Shipped at</div>
                            <div>@shipped.ToLocalTime().ToString("g")</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AddressSnapshot))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Shipping address</div>
                            <div>@Model.AddressSnapshot</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <table class="table">
            <thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>
                            @item.TitleSnapshot
                            @if (item.Vendor is not null)
                            {
                                <div class="small text-muted">Sold by @item.Vendor.Name</div>
                            }
                            @if (item.ProductVariantID is int vid)
                            {
                                <div class="small text-muted">Variant #@vid · SKU @item.SkuSnapshot</div>
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td>@item.TotalPrice.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-end fs-5 fw-bold">Total: @Model.GrandTotal.ToString("0.##") @Model.CurrencyCode</div>

        @if (digitalItems.Count > 0)
        {
            <div class="alert alert-success mt-4">
                <h6 class="alert-heading mb-2"><i class="bi bi-cloud-download me-1"></i> Digital delivery</h6>
                <p class="mb-2 small">These items stay available in your library after purchase.</p>
                <ul class="mb-2">
                    @foreach (var d in digitalItems)
                    {
                        <li>
                            <a asp-controller="Account" asp-action="DownloadDetail" asp-route-id="@d.OrderDigitalAssetID">@d.Title</a>
                            @if (d.HasDownloadUrl) { <span class="badge text-bg-primary">Download</span> }
                            @if (d.HasDeliveryNote) { <span class="badge text-bg-secondary">Code</span> }
                            @if (d.HasServiceUrl) { <span class="badge text-bg-info">Service</span> }
                        </li>
                    }
                </ul>
                <a asp-controller="Account" asp-action="Downloads" class="btn btn-sm btn-outline-success">Open digital library</a>
            </div>
        }

        @if (Model.Status == (byte)OrderStatus.PendingPayment)
        {
            <a asp-controller="Checkout" asp-action="Payment" asp-route-orderId="@Model.OrderID" class="btn btn-primary mt-3">Complete payment</a>
        }

        <div class="mt-3 d-flex flex-wrap gap-2">
            <a asp-controller="Account" asp-action="ReturnNew" asp-route-orderId="@Model.OrderID" class="btn btn-outline-secondary">Request a return</a>
            <a asp-controller="Account" asp-action="Returns" class="btn btn-outline-secondary">My returns</a>
        </div>

        <div class="mt-3">
            <a asp-controller="Account" asp-action="Orders" class="btn btn-link px-0">← Back to orders</a>
        </div>
    </div>
</section>
