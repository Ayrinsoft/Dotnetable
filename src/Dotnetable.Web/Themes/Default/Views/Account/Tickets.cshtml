@using Dotnetable.Application.DTOs
@model PagedResult<SupportSessionSummaryDto>
@{
    ViewData["Title"] = "My support tickets";
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PageHeader", ("My support tickets", "Account"))

<section class="site-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">Ask about an order — our team replies on this ticket.</p>
            <a asp-action="TicketNew" class="btn btn-primary">New ticket</a>
        </div>
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">You have not opened a support ticket yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Ticket</th><th>Subject</th><th>Order</th><th>Status</th><th>Updated</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr>
                            <td><code>@t.SessionNumber</code></td>
                            <td>@(t.Subject ?? "—")</td>
                            <td>@(t.RelatedOrderNumber ?? "—")</td>
                            <td>@t.StatusName</td>
                            <td>@((t.LastInteractionAt ?? t.CreatedAt).ToLocalTime().ToString("g"))</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="TicketDetail" asp-route-id="@t.SupportSessionID">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
