@using Dotnetable.Web.Services
@using Dotnetable.Application.DTOs
@inject ApiClient Api
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var isLoggedIn = Context.Request.Cookies.ContainsKey(ClientAuth.TokenCookie);
    string Active(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    // Brand, logo, contact info, socials and SEO defaults are managed in the admin (Websites +
    // Website Settings); the layout only falls back to neutral text when the API is unreachable.
    SiteInfoDto? site = await Api.GetSiteInfoAsync();
    var brandName = string.IsNullOrWhiteSpace(site?.BrandName) ? "Website" : site!.BrandName;
    var separator = site?.TitleSeparator ?? "·";

    // Language switcher + content language for menus: only languages this website picked in admin.
    var languages = await Api.GetActiveLanguagesAsync();
    var currentLangCode = Context.Request.Cookies["lang"];
    var currentLang = languages.FirstOrDefault(l => l.Code == currentLangCode)
        ?? languages.FirstOrDefault(l => l.IsDefault)
        ?? languages.FirstOrDefault();
    // Prefer cookie / resolved UI language so Header/Footer titles use MenuItemTranslations.
    var menuLang = currentLang?.Code;

    // Header/footer navigation is driven by admin-managed menus; static links are the fallback so
    // the site always has navigation before menus are configured.
    MenuDto? headerMenu = await Api.GetMenuAsync("Header", menuLang);
    MenuDto? footerMenu = await Api.GetMenuAsync("Footer", menuLang);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Antiforgery token for the JSON fetch calls in site.js / addresses.js / contact.js. Real form
    // posts get theirs from the tag helper; scripted requests have no form to read one from, so it
    // is published here and sent back as the RequestVerificationToken header.
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="@(currentLang?.Code ?? site?.DefaultLanguageCode ?? "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] @separator @(site?.DefaultMetaTitle ?? brandName)</title>
    @if (!string.IsNullOrWhiteSpace(site?.DefaultMetaDescription))
    {
        <meta name="description" content="@site.DefaultMetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(site?.FavIconUrl))
    {
        <link rel="icon" href="@site.FavIconUrl" />
    }

    @*
        Canonical + Open Graph.

        Canonical is built from the path only, with the query string dropped, because the shop's
        filter and sort links generate a different URL for the same page — without this a crawler
        treats every facet combination as duplicate content and splits the page's ranking across
        all of them. A page that legitimately varies by query (a search result) sets
        ViewData["Canonical"] itself.

        Open Graph is what social platforms and chat apps read; with no og:* tags a shared product
        link renders as a bare URL with no title or image.
    *@
    @{
        var canonicalOverride = ViewData["Canonical"] as string;
        var canonicalUrl = !string.IsNullOrWhiteSpace(canonicalOverride)
            ? canonicalOverride
            : $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

        var ogTitle = ViewData["Title"] as string;
        if (string.IsNullOrWhiteSpace(ogTitle)) ogTitle = site?.DefaultMetaTitle ?? brandName;

        var ogDescription = ViewData["MetaDescription"] as string ?? site?.DefaultMetaDescription;
        var ogImage = ViewData["OgImage"] as string ?? site?.LogoUrl;
        var ogType = ViewData["OgType"] as string ?? "website";

        // Social crawlers reject relative image URLs, so promote one to absolute.
        if (!string.IsNullOrWhiteSpace(ogImage) && ogImage.StartsWith('/'))
            ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}{ogImage}";
    }

    <meta name="request-verification-token" content="@antiforgeryToken" />

    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="@brandName" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:url" content="@canonicalUrl" />
    @if (!string.IsNullOrWhiteSpace(ogDescription))
    {
        <meta property="og:description" content="@ogDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    else
    {
        <meta name="twitter:card" content="summary" />
    }
    <meta name="twitter:title" content="@ogTitle" />
    @if (!string.IsNullOrWhiteSpace(ogDescription))
    {
        <meta name="twitter:description" content="@ogDescription" />
    }
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/slideshow.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ── Navbar ─────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg sticky-top site-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrWhiteSpace(site?.LogoUrl))
                {
                    <img src="@site.LogoUrl" alt="@brandName" style="height:36px; width:auto;" />
                }
                <span>@brandName</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    @if (headerMenu is not null && headerMenu.Items.Count > 0)
                    {
                        @foreach (var item in headerMenu.Items)
                        {
                            @await Html.PartialAsync("_MenuNavItem", (item, true))
                        }
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Shop")" asp-controller="Shop" asp-action="Index">Shop</a></li>
                        <li class="nav-item"><a class="nav-link @Active("PriceList")" asp-controller="PriceList" asp-action="Index">Price lists</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Blog")" asp-controller="Blog" asp-action="Index">Blog</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    }
                </ul>
                <div class="d-flex gap-2 align-items-center">
                    @if (languages.Count > 1)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-globe2 me-1"></i>@(currentLang?.Name ?? "Language")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var lang in languages)
                                {
                                    <li>
                                        <a class="dropdown-item @(lang.Code == currentLang?.Code ? "active" : "")"
                                           asp-controller="Language" asp-action="Set"
                                           asp-route-code="@lang.Code" asp-route-returnUrl="@returnUrl">@lang.Name</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="Index" title="Cart">
                        <i class="bi bi-cart3"></i>
                    </a>
                    @if (isLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person me-1"></i>My Account
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Orders">My Orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Tickets">Support tickets</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Returns">My Returns</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Downloads">My Downloads</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Wallet">My Wallet</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Wishlist">My Wishlist</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses">My Addresses</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><button type="button" class="dropdown-item" onclick="doLogout()">Logout</button></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" onclick="openAuth('login')">Sign in</button>
                        <button type="button" class="btn btn-primary" onclick="openAuth('register')">Get started</button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────── -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-white">@brandName</h5>
                    @if (!string.IsNullOrWhiteSpace(site?.DefaultMetaDescription))
                    {
                        <p>@site.DefaultMetaDescription</p>
                    }
                    @if (site?.SocialLinks is { Count: > 0 })
                    {
                        <div class="d-flex gap-3 fs-5">
                            @foreach (var social in site.SocialLinks)
                            {
                                <a href="@social.Url" target="_blank" rel="noopener" aria-label="@(social.Name ?? "social")">
                                    <i class="@(string.IsNullOrWhiteSpace(social.Icon) ? "bi bi-globe" : social.Icon)"></i>
                                </a>
                            }
                        </div>
                    }
                </div>
                <div class="col-6 col-lg-4">
                    <h5>Links</h5>
                    <ul class="list-unstyled d-grid gap-2 footer-menu-tree">
                        @if (footerMenu is not null && footerMenu.Items.Count > 0)
                        {
                            @foreach (var item in footerMenu.Items)
                            {
                                @await Html.PartialAsync("_FooterMenuItem", (item, 0))
                            }
                        }
                        else
                        {
                            <li><a asp-controller="Home" asp-action="About">About</a></li>
                            <li><a asp-controller="Home" asp-action="Services">Services</a></li>
                            <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                            <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Get in touch</h5>
                    @if (!string.IsNullOrWhiteSpace(site?.Email))
                    {
                        <p class="mb-1"><i class="bi bi-envelope me-2"></i><a href="mailto:@site.Email">@site.Email</a></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(site?.Phone))
                    {
                        <p class="mb-1"><i class="bi bi-telephone me-2"></i><a href="tel:@site.Phone">@site.Phone</a></p>
                    }
                    <p class="mb-0"><a asp-controller="Home" asp-action="Contact">Send us a message →</a></p>
                </div>
            </div>
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year @brandName. All rights reserved.</span>
            </div>
        </div>
    </footer>

    @await Html.PartialAsync("_AuthModal")

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/slideshow.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
