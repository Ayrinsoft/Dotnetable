        tr: { flip: 'Daha fazlası için dokunun', back: 'Geri dönmek için dokunun', call: 'Ara', whatsapp: 'WhatsApp', email: 'E-posta', website: 'Web sitesi', map: 'Yol tarifi', save: 'Kişiyi kaydet', leave: 'Numaram', contact: 'İletişim', mobile: 'Cep', phone: 'Telefon', address: 'Adres', about: 'Hakkında', bank: 'Banka', holder: 'Hesap sahibi', sheba: 'IBAN', pan: 'Kart', socials: 'Sosyal ağlar', leaveTitle: 'Numaramı bırak', leaveHint: 'Adınız, telefon veya e-posta ve neden aranmalısınız.', send: 'Gönder', resume: 'Yazar sayfası', copied: 'Kopyalandı', ok: 'Kaydedildi. Teşekkürler.', fail: 'Kaydedilemedi.', namePh: 'Ad', mobilePh: 'Telefon', emailPh: 'E-posta', reasonPh: 'Neden arayalım?' },
        de: { flip: 'Tippen für mehr', back: 'Tippen zum Zurückdrehen', call: 'Anrufen', whatsapp: 'WhatsApp', email: 'E-Mail', website: 'Website', map: 'Route', save: 'Kontakt speichern', leave: 'Meine Nummer', contact: 'Kontakt', mobile: 'Mobil', phone: 'Telefon', address: 'Adresse', about: 'Über', bank: 'Bankdaten', holder: 'Kontoinhaber', sheba: 'IBAN', pan: 'Karte', socials: 'Soziale Netze', leaveTitle: 'Meine Nummer hinterlassen', leaveHint: 'Name, Telefon oder E-Mail und warum wir uns melden sollen.', send: 'Senden', resume: 'Autorenseite', copied: 'Kopiert', ok: 'Gespeichert. Danke.', fail: 'Speichern fehlgeschlagen.', namePh: 'Name', mobilePh: 'Telefon', emailPh: 'E-Mail', reasonPh: 'Worum geht es?' },
        fr: { flip: 'Touchez pour la suite', back: 'Touchez pour revenir', call: 'Appeler', whatsapp: 'WhatsApp', email: 'E-mail', website: 'Site web', map: 'Itinéraire', save: 'Enregistrer le contact', leave: 'Mon numéro', contact: 'Contact', mobile: 'Mobile', phone: 'Téléphone', address: 'Adresse', about: 'À propos', bank: 'Banque', holder: 'Titulaire', sheba: 'IBAN', pan: 'Carte', socials: 'Réseaux sociaux', leaveTitle: 'Laisser mon numéro', leaveHint: 'Votre nom, un téléphone ou un e-mail, et pourquoi vous contacter.', send: 'Envoyer', resume: 'Page auteur', copied: 'Copié', ok: 'Enregistré. Merci.', fail: 'Enregistrement impossible.', namePh: 'Nom', mobilePh: 'Téléphone', emailPh: 'E-mail', reasonPh: 'Pourquoi vous appeler ?' },
        ru: { flip: 'Нажмите, чтобы читать', back: 'Нажмите, чтобы вернуть', call: 'Позвонить', whatsapp: 'WhatsApp', email: 'Почта', website: 'Сайт', map: 'Маршрут', save: 'Сохранить контакт', leave: 'Мой номер', contact: 'Контакты', mobile: 'Мобильный', phone: 'Телефон', address: 'Адрес', about: 'О себе', bank: 'Банк', holder: 'Владелец счёта', sheba: 'IBAN', pan: 'Карта', socials: 'Соцсети', leaveTitle: 'Оставить мой номер', leaveHint: 'Имя, телефон или почта и по какому поводу связаться.', send: 'Отправить', resume: 'Страница автора', copied: 'Скопировано', ok: 'Сохранено. Спасибо.', fail: 'Не удалось сохранить.', namePh: 'Имя', mobilePh: 'Телефон', emailPh: 'Почта', reasonPh: 'По какому поводу?' }
    };
    var rtl = { fa: true, ar: true, en: false, tr: false, de: false, fr: false, ru: false };
    function text(lang, key) { return (ui[lang] || ui.en)[key] || ui.fa[key] || ''; }
    function applyUi(lang) {
        document.querySelectorAll('[data-ui]').forEach(function (el) {
            var v = text(lang, el.getAttribute('data-ui'));
            if (v) el.textContent = v;
        });
        document.querySelectorAll('[data-ph]').forEach(function (el) {
            el.placeholder = text(lang, el.getAttribute('data-ph') + 'Ph');
        });
    }
    function pick(tr, key, fallback) {
        if (!tr) return fallback;
        var v = tr[key];
        return v && String(v).trim() ? v : fallback;
    }
    function applyLang(lang) {
        var tr = (data.translations || []).filter(function (t) { return t.lang === lang; })[0];
        var map = {
            fullName: pick(tr, 'fullName', data.fullName),
            brand: pick(tr, 'brandName', data.brand),
            job: pick(tr, 'jobTitle', data.job),
            slogan: pick(tr, 'slogan', data.slogan),
            address: pick(tr, 'address', data.address),
            description: pick(tr, 'description', data.description)
        };
        document.querySelectorAll('[data-k]').forEach(function (el) {
            var v = map[el.getAttribute('data-k')];
            if (v !== undefined) el.textContent = v || '';
        });
        (data.fields || []).forEach(function (f) {
            var title = document.querySelector('[data-fk="' + f.key + '"]');
            var value = document.querySelector('[data-fv="' + f.key + '"]');
            if (title) title.textContent = pick(tr, f.key.charAt(0).toLowerCase() + f.key.slice(1) + 'Title', f.title) || f.title;
            if (value) value.textContent = pick(tr, f.key.charAt(0).toLowerCase() + f.key.slice(1) + 'Value', f.value) || f.value;
        });
        root.dir = rtl[lang] === false ? 'ltr' : 'rtl';
        applyUi(ui[lang] ? lang : 'en');
        document.querySelectorAll('#vcLangs button').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang') === lang ? 'true' : 'false');
        });
        root.dataset.lang = lang;
    }
    document.getElementById('vcLangs').addEventListener('click', function (e) {
        var b = e.target.closest('button');
        if (b) applyLang(b.getAttribute('data-lang'));
    });
    var flip = document.getElementById('vcFlip');
    if (flip) flip.addEventListener('click', function () { flip.classList.toggle('flipped'); });
    document.getElementById('vcTheme').addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('vc-theme-' + data.slug, next); } catch (e) {}
    });
    try {
        var savedTheme = localStorage.getItem('vc-theme-' + data.slug);
        if (savedTheme) root.setAttribute('data-theme', savedTheme);
    } catch (e) {}
    function visitor() {
        var key = 'vc-visitor';
        try {
            var cur = localStorage.getItem(key);
            if (cur && cur.length === 32) return cur;
            var bytes = new Uint8Array(16);
            crypto.getRandomValues(bytes);
            cur = Array.from(bytes).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
            localStorage.setItem(key, cur);
            return cur;
        } catch (e) { return ''; }
    }
    function vcfEscape(s) { return String(s || '').replace(/\\/g, '\\\\').replace(/\n/g, '\\n').replace(/,/g, '\\,').replace(/;/g, '\\;'); }
    document.getElementById('vcSave').addEventListener('click', function () {
        var lang = root.dataset.lang || 'fa';
        var tr = (data.translations || []).filter(function (t) { return t.lang === lang; })[0];
        var fn = pick(tr, 'fullName', data.fullName) || data.brand || 'contact';
        var lines = ['BEGIN:VCARD', 'VERSION:3.0', 'FN:' + vcfEscape(fn), 'N:' + vcfEscape(fn) + ';;;;'];
        if (data.brand) lines.push('ORG:' + vcfEscape(pick(tr, 'brandName', data.brand)));
        if (data.job) lines.push('TITLE:' + vcfEscape(pick(tr, 'jobTitle', data.job)));
        if (data.mobile) lines.push('TEL;TYPE=CELL:' + vcfEscape(data.mobile));
        if (data.phone) lines.push('TEL;TYPE=WORK:' + vcfEscape(data.phone));
        if (data.email) lines.push('EMAIL:' + vcfEscape(data.email));
        if (data.website) lines.push('URL:' + vcfEscape(data.website));
        if (data.address) lines.push('ADR;TYPE=WORK:;;' + vcfEscape(pick(tr, 'address', data.address)) + ';;;;');
        lines.push('END:VCARD');
        var blob = new Blob([lines.join('\r\n')], { type: 'text/vcard;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = (fn || 'contact').replace(/[\\/:*?"<>|]/g, '').trim() + '.vcf';
        a.click();
        try { localStorage.setItem('vc-saved-' + data.slug, '1'); } catch (e) {}
    });
    var leave = document.getElementById('vcLeave');
    if (leave) leave.addEventListener('click', function () {
        var box = document.getElementById('vcBook');
        if (box) box.scrollIntoView({ behavior: 'smooth' });
    });
    document.querySelectorAll('.vc-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var value = btn.getAttribute('data-copy') || '';
            if (navigator.clipboard) navigator.clipboard.writeText(value);
            var lang = root.dataset.lang || 'fa';
            btn.dataset.prev = btn.dataset.prev || btn.textContent;
            btn.textContent = text(lang, 'copied');
            setTimeout(function () { btn.textContent = btn.dataset.prev; }, 1200);
        });
    });
    var form = document.getElementById('vcForm');
    if (form) form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var msg = document.getElementById('vcMsg');
        var lang = root.dataset.lang || 'fa';
        var body = {
            name: form.name.value,
            mobile: form.mobile.value,
            email: form.email.value,
            reason: form.reason.value,
            company: form.company.value,
            visitorKey: visitor(),
            savedContact: false
        };
        try { body.savedContact = localStorage.getItem('vc-saved-' + data.slug) === '1'; } catch (e) {}
        fetch('/c/' + encodeURIComponent(data.slug) + '/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': '@tokens.RequestToken' },
            body: JSON.stringify(body)
        }).then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
          .then(function (res) {
              msg.textContent = res.ok ? text(lang, 'ok') : (res.body && res.body.message ? res.body.message : text(lang, 'fail'));
              if (res.ok) form.reset();
          }).catch(function () { msg.textContent = text(lang, 'fail'); });
    });
    applyLang('fa');
})();
</script>
</body>
