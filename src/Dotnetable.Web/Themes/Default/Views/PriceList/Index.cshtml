@model IReadOnlyList<Dotnetable.Application.DTOs.PriceListSummaryDto>
@{
    var title = "Price lists";
    ViewData["Title"] = title;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PageHeader", (title, "Price lists"))

<section class="site-section">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <p class="text-muted mb-0">No price lists have been published yet.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var list in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <a class="price-list-card card h-100 text-reset text-decoration-none"
                           asp-controller="PriceList" asp-action="Detail" asp-route-slug="@list.Slug">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@list.Title</h5>
                                @if (!string.IsNullOrWhiteSpace(list.Description))
                                {
                                    <p class="card-text text-muted">@list.Description</p>
                                }
                                <div class="mt-auto small text-muted">
                                    <div>@list.ItemCount items</div>
                                    <div>Last price update: @list.LastUpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>
