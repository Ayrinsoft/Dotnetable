@using Dotnetable.Domain.Enums
@model Dotnetable.Web.Models.ContactPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_PageHeader", (Model.PageTitle, "Contact"))

<section class="site-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <span class="site-eyebrow">Get in touch</span>
                <h2 class="site-section-title">We'd love to hear from you</h2>
                <div class="page-content text-muted">
                    @Html.Raw(Dotnetable.Application.Security.ContentSanitizer.Sanitize(Model.ContentHtml))
                </div>

                @if (Model.ContactInfos.Count > 0)
                {
                    <div class="contact-info-groups mt-4">
                        @foreach (var group in Model.ContactInfos.GroupBy(c => c.GroupTitle))
                        {
                            <div class="contact-info-group mb-4">
                                @if (!string.IsNullOrWhiteSpace(group.Key))
                                {
                                    <h6 class="fw-bold mb-2">@group.Key</h6>
                                }
                                <ul class="list-unstyled mb-0">
                                    @foreach (var info in group)
                                    {
                                        <li class="d-flex align-items-start gap-2 mb-2">
                                            <i class="@(string.IsNullOrWhiteSpace(info.Icon) ? "bi bi-info-circle" : info.Icon)"></i>
                                            <span><strong>@info.Title:</strong> @ContactValueLink(info)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="col-lg-7">
                <div class="site-card">
                    <div id="contact-alert"></div>

                    <div id="contact-pending" class="d-none">
                        <p class="text-muted mb-2">Your last message:</p>
                        <div class="border rounded p-3 mb-3 bg-light">
                            <div class="fw-semibold" id="contact-pending-subject"></div>
                            <div class="text-muted small mb-2" id="contact-pending-meta"></div>
                            <div id="contact-pending-message" style="white-space:pre-wrap"></div>
                        </div>
                        <div class="alert alert-info mb-0">Awaiting review by the site admin.</div>
                    </div>

                    <form id="contact-form">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <input class="form-control" name="senderName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input class="form-control" type="email" name="emailAddress" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input class="form-control" name="cellphoneNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <input class="form-control" name="messageSubject" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="5" name="messageBody" required></textarea>
                            </div>

                            @* Honeypot: real visitors never see this; hidden off-screen instead of display:none
                               so simple bots that skip hidden fields still fill it in. *@
                            <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
                                <label>Website</label>
                                <input type="text" name="website" tabindex="-1" autocomplete="off" />
                            </div>

                            <div class="col-12" id="contact-captcha"></div>

                            <div class="col-12">
                                <button class="btn btn-primary" type="submit" id="contact-submit">Send message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}

@functions {
    // Phone/email rows render as clickable tel:/mailto: links; everything else (address, location,
    // working hours, ...) is plain text since there's no single universal action for it.
    private Microsoft.AspNetCore.Html.IHtmlContent ContactValueLink(Dotnetable.Application.DTOs.ContactInfoDto info)
    {
        var type = (ContactInfoType)info.Type;
        var scheme = type switch
        {
            ContactInfoType.Phone => "tel:",
            ContactInfoType.Email => "mailto:",
            _ => null,
        };

        var encodedValue = Html.Encode(info.Value);
        if (scheme is null)
            return new Microsoft.AspNetCore.Html.HtmlString(encodedValue);

        var href = Html.Encode(scheme + info.Value);
        return new Microsoft.AspNetCore.Html.HtmlString($"<a href=\"{href}\">{encodedValue}</a>");
    }
}
