@using Dotnetable.Application.DTOs
@model ProductDetailDto
@{
    ViewData["Title"] = Model.Title;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    var reviews = ViewBag.Reviews as PagedResult<Dotnetable.Domain.Entities.ProductReview>;
    var questions = ViewBag.Questions as PagedResult<Dotnetable.Domain.Entities.ProductQuestion>;
    var isLoggedIn = Context.Request.Cookies.ContainsKey(Dotnetable.Web.Services.ClientAuth.TokenCookie);
    var defaultVariant = Model.Variants.FirstOrDefault(v => v.IsDefault) ?? Model.Variants.FirstOrDefault();
    var inStockSellers = Model.Sellers.Where(s => s.IsInStock).ToList();
    var defaultSeller = inStockSellers.FirstOrDefault();
}

<section class="site-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                {
                    <img src="@Model.FeaturedImageUrl" class="img-fluid rounded" alt="@Model.Title" />
                }
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @foreach (var img in Model.GalleryImageUrls)
                    {
                        <img src="@img" style="width:70px;height:70px;object-fit:cover" class="rounded border" />
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <h1 class="mb-2">@Model.Title</h1>
                @if (!string.IsNullOrEmpty(Model.VendorName))
                {
                    <div class="text-muted mb-1"><i class="bi bi-shop"></i> @Model.VendorName</div>
                }
                @if (!string.IsNullOrEmpty(Model.BrandName))
                {
                    <div class="text-muted mb-2">@Model.BrandName</div>
                }
                <div class="mb-3">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(Model.AvgRating) ? "bi-star-fill text-warning" : "bi-star")"></i>
                    }
                    <span class="text-muted ms-1">(@Model.RatingCount)</span>
                </div>
                <p>@Model.ShortDescription</p>

                <div class="mb-3">
                    @if (!Model.IsInStock)
                    {
                        <span class="badge text-bg-secondary fs-6">Out of stock</span>
                    }
                    else if (Model.DisplayStockQuantity is int left)
                    {
                        <span class="badge text-bg-warning text-dark fs-6">Only @left left</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success fs-6">In stock</span>
                    }
                </div>

                @if (Model.IsInStock && (Model.Variants.Count > 0 || inStockSellers.Count > 0))
                {
                    <form asp-controller="Shop" asp-action="AddToCart" method="post" class="mt-4" id="addToCartForm">
                        @if (Model.VendorID is int vid && inStockSellers.Count == 0)
                        {
                            <input type="hidden" name="vendorId" value="@vid" />
                        }

                        @if (Model.Variants.Count > 1)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="variantSelect">Variant</label>
                                <select name="variantId" class="form-select" style="max-width:320px" id="variantSelect">
                                    @foreach (var v in Model.Variants)
                                    {
                                        var stockLabel = v.DisplayStockQuantity is int n
                                            ? $" — only {n} left"
                                            : " — in stock";
                                        if (v.ProductVariantID == defaultVariant?.ProductVariantID)
                                        {
                                            <option value="@v.ProductVariantID"
                                                    data-vendor-product-id="@v.VendorProductID"
                                                    data-stock="@v.StockQuantity"
                                                    selected>
                                                @(string.IsNullOrWhiteSpace(v.Title) ? v.Sku : v.Title)
                                                — @v.Price.Amount.ToString("0.##") @v.Price.CurrencyCode@stockLabel
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@v.ProductVariantID"
                                                    data-vendor-product-id="@v.VendorProductID"
                                                    data-stock="@v.StockQuantity">
                                                @(string.IsNullOrWhiteSpace(v.Title) ? v.Sku : v.Title)
                                                — @v.Price.Amount.ToString("0.##") @v.Price.CurrencyCode@stockLabel
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else if (defaultVariant is not null)
                        {
                            <input type="hidden" name="variantId" id="variantIdSingle" value="@defaultVariant.ProductVariantID" />
                            <div class="fs-4 fw-bold mb-2">@defaultVariant.Price.Amount.ToString("0.##") @defaultVariant.Price.CurrencyCode</div>
                        }

                        @if (inStockSellers.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Seller</label>
                                <div class="list-group" style="max-width:420px">
                                    @foreach (var s in inStockSellers)
                                    {
                                        var stockText = s.DisplayStockQuantity is int n
                                            ? $"Only {n} left"
                                            : "In stock";
                                        var isDefault = defaultSeller is not null && s.VendorProductID == defaultSeller.VendorProductID;
                                        <label class="list-group-item list-group-item-action d-flex gap-2 align-items-start">
                                            <input class="form-check-input mt-1 seller-radio" type="radio" name="vendorProductId"
                                                   value="@s.VendorProductID"
                                                   data-variant-id="@s.ProductVariantID"
                                                   data-vendor-id="@s.VendorID"
                                                   data-stock="@s.StockQuantity"
                                                   @(isDefault ? "checked" : null) />
                                            <span class="flex-grow-1">
                                                <strong>@s.VendorName</strong>
                                                <span class="d-block small text-muted">
                                                    @(string.IsNullOrWhiteSpace(s.VariantTitle) ? s.Sku : s.VariantTitle)
                                                    · @s.Price.Amount.ToString("0.##") @s.Price.CurrencyCode
                                                    · @stockText
                                                    @if (s.DeliveryDays > 0)
                                                    {
                                                        <span>· @s.DeliveryDays d delivery</span>
                                                    }
                                                </span>
                                            </span>
                                        </label>
                                    }
                                </div>
                                <input type="hidden" name="vendorId" id="sellerVendorId" value="@(defaultSeller?.VendorID)" />
                            </div>
                        }
                        else if (defaultVariant?.VendorProductID is int vpid)
                        {
                            <input type="hidden" name="vendorProductId" value="@vpid" />
                        }

                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" name="quantity" id="qtyInput" value="1" min="1"
                                   max="@(defaultSeller?.StockQuantity ?? defaultVariant?.StockQuantity ?? 1)"
                                   class="form-control" style="max-width:90px" />
                            <button type="submit" class="btn btn-primary">Add to cart</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mt-4 mb-0">This product is currently unavailable.</p>
                }

                @if (isLoggedIn && defaultVariant is not null)
                {
                    <form asp-controller="Account" asp-action="AddToWishlist" method="post" class="mt-2">
                        <input type="hidden" name="variantId" value="@defaultVariant.ProductVariantID" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-heart"></i> Save for later</button>
                    </form>
                }

                @foreach (var w in Model.Attributes)
                {
                    <div class="mt-2"><strong>@w.AttributeName:</strong> @(w.OptionValue ?? w.CustomValue)</div>
                }
                @foreach (var w in Model.Warnings)
                {
                    <div class="alert alert-warning mt-3 mb-0">@w.Text</div>
                }
                @if (Model.Warranties.Count > 0)
                {
                    <div class="mt-3 product-warranties">
                        <strong>Warranty</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var war in Model.Warranties)
                            {
                                <li>
                                    @war.Title
                                    @if (war.DurationMonths is int months)
                                    {
                                        <span class="text-muted">(@months months)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(war.ProviderName))
                                    {
                                        <span class="text-muted">— @war.ProviderName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(war.Description))
                                    {
                                        <div class="small text-muted">@war.Description</div>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        @{
            // Only real text counts — empty editor shells are null from API.
            var hasDescription = !string.IsNullOrWhiteSpace(Model.Content);
            var hasExpertReview = !string.IsNullOrWhiteSpace(Model.ExpertReview);
            var detailTabs = new List<(string Id, string Label)>();
            if (hasDescription) detailTabs.Add(("desc", "Description"));
            if (hasExpertReview) detailTabs.Add(("expert", "Expert review"));
        }
        @if (detailTabs.Count > 0)
        {
            <div class="mt-5 product-detail-tabs">
                <ul class="nav nav-tabs" role="tablist">
                    @for (var ti = 0; ti < detailTabs.Count; ti++)
                    {
                        var tab = detailTabs[ti];
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(ti == 0 ? "active" : null)"
                                    id="product-tab-@tab.Id"
                                    data-bs-toggle="tab"
                                    data-bs-target="#product-pane-@tab.Id"
                                    type="button"
                                    role="tab"
                                    aria-controls="product-pane-@tab.Id"
                                    aria-selected="@(ti == 0 ? "true" : "false")">
                                @tab.Label
                            </button>
                        </li>
                    }
                </ul>
                <div class="tab-content border border-top-0 rounded-bottom p-3">
                    @if (hasDescription)
                    {
                        <div class="tab-pane fade show active" id="product-pane-desc" role="tabpanel" aria-labelledby="product-tab-desc">
                            <div class="product-content">@Html.Raw(Model.Content)</div>
                        </div>
                    }
                    @if (hasExpertReview)
                    {
                        <div class="tab-pane fade @(hasDescription ? null : "show active")" id="product-pane-expert" role="tabpanel" aria-labelledby="product-tab-expert">
                            <div class="product-content">@Html.Raw(Model.ExpertReview)</div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.RelatedProducts.Count > 0)
        {
            <h4 class="mt-5 mb-3">Related products</h4>
            <div class="row g-4">
                @foreach (var r in Model.RelatedProducts)
                {
                    <div class="col-md-3">
                        <a asp-controller="Shop" asp-action="Product" asp-route-slug="@r.Slug" class="text-reset text-decoration-none">
                            @if (!string.IsNullOrEmpty(r.ImageUrl))
                            {
                                <img src="@r.ImageUrl" class="img-fluid rounded mb-2" />
                            }
                            <div>@r.Title</div>
                        </a>
                    </div>
                }
            </div>
        }

        <hr class="my-5" />

        <div class="row g-5">
            <div class="col-lg-6">
                <h4 class="mb-3">Reviews</h4>
                @if (reviews is not null)
                {
                    foreach (var r in reviews.Items)
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <div>
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= r.Rating ? "bi-star-fill text-warning" : "bi-star")"></i>
                                }
                                @if (r.IsVerifiedPurchase)
                                {
                                    <span class="badge bg-success ms-2">Verified purchase</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(r.Title))
                            {
                                <strong>@r.Title</strong>
                            }
                            <p class="mb-0">@r.Body</p>
                        </div>
                    }
                }
                @if (isLoggedIn)
                {
                    <form asp-controller="Shop" asp-action="SubmitReview" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@Model.ProductID" />
                        <select name="rating" class="form-select mb-2" style="max-width:150px">
                            <option value="5">5 stars</option>
                            <option value="4">4 stars</option>
                            <option value="3">3 stars</option>
                            <option value="2">2 stars</option>
                            <option value="1">1 star</option>
                        </select>
                        <input type="text" name="title" class="form-control mb-2" placeholder="Title (optional)" />
                        <textarea name="body" class="form-control mb-2" rows="3" placeholder="Write your review..." required></textarea>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Submit review</button>
                    </form>
                }
            </div>
            <div class="col-lg-6">
                <h4 class="mb-3">Questions &amp; Answers</h4>
                @if (questions is not null)
                {
                    foreach (var q in questions.Items)
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <strong>Q: @q.Body</strong>
                            @foreach (var a in q.ProductAnswers.Where(a => a.Approved))
                            {
                                <p class="text-muted ms-3 mb-0">A: @a.Body</p>
                            }
                        </div>
                    }
                }
                @if (isLoggedIn)
                {
                    <form asp-controller="Shop" asp-action="AskQuestion" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@Model.ProductID" />
                        <textarea name="body" class="form-control mb-2" rows="2" placeholder="Ask a question..." required></textarea>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Ask</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@if (inStockSellers.Count > 0 || Model.Variants.Count > 1)
{
    <script>
        (function () {
            const form = document.getElementById('addToCartForm');
            if (!form) return;
            const qty = document.getElementById('qtyInput');
            const vendorIdInput = document.getElementById('sellerVendorId');
            const variantSelect = document.getElementById('variantSelect');
            const variantSingle = document.getElementById('variantIdSingle');

            function applySeller(radio) {
                if (!radio) return;
                const stock = parseInt(radio.getAttribute('data-stock') || '1', 10);
                if (qty) {
                    qty.max = String(Math.max(1, stock));
                    if (parseInt(qty.value, 10) > stock) qty.value = String(stock);
                }
                if (vendorIdInput) vendorIdInput.value = radio.getAttribute('data-vendor-id') || '';
                const variantId = radio.getAttribute('data-variant-id');
                if (variantSelect && variantId) {
                    variantSelect.value = variantId;
                } else if (variantSingle && variantId) {
                    variantSingle.value = variantId;
                }
            }

            form.querySelectorAll('.seller-radio').forEach(function (r) {
                r.addEventListener('change', function () { applySeller(r); });
            });
            const checked = form.querySelector('.seller-radio:checked');
            if (checked) applySeller(checked);

            if (variantSelect) {
                variantSelect.addEventListener('change', function () {
                    const opt = variantSelect.selectedOptions[0];
                    if (!opt) return;
                    const stock = parseInt(opt.getAttribute('data-stock') || '1', 10);
                    if (qty && !form.querySelector('.seller-radio:checked')) {
                        qty.max = String(Math.max(1, stock));
                        if (parseInt(qty.value, 10) > stock) qty.value = String(stock);
                    }
                });
            }
        })();
    </script>
}
