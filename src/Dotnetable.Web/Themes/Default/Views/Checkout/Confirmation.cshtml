@using Dotnetable.Domain.Entities
@model Order
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
}

<section class="site-section">
    <div class="container text-center" style="max-width:640px">
        <i class="bi bi-check-circle-fill text-success" style="font-size:4rem"></i>
        <h2 class="mt-3">Thank you for your order!</h2>
        <p class="text-muted">Order number: <strong>@Model.OrderNumber</strong></p>
        <p>We'll notify you once your payment is confirmed and your order is on its way.</p>
        <a asp-controller="Account" asp-action="Orders" class="btn btn-primary mt-3">View my orders</a>
    </div>
</section>
