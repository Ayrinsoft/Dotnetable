@using Dotnetable.Web.Services
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Dotnetable.Application.DTOs.PageDto
@inject ContentShortcodeProcessor Shortcodes
@inject ApiClient Api
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    Layout = "/Themes/Default/Views/Shared/_Layout.cshtml";
    ViewData["MetaDescription"] = Model.MetaDescription;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
    var content = await Shortcodes.ExpandAsync(Model.Content);
}

@await Html.PartialAsync("_PageHeader", (Model.Title, Model.Title))

<section class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="page-content">
                    @Html.Raw(content)
                </div>
                @{
                    var pageAds = await Api.GetAdvertisementsAsync("Page", Context.Request.Cookies["lang"]);
                }
                @if (pageAds.Count > 0)
                {
                    <div class="mt-4">
                        @await Html.PartialAsync("_Advertisements", pageAds, new ViewDataDictionary(ViewData) { ["AdsModifier"] = "page" })
                    </div>
                }
            </div>
        </div>
    </div>
</section>
