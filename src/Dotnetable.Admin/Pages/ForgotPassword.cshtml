@page
@model Dotnetable.Admin.Pages.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.S.ForgotTitle;
}

<p class="auth-subtitle">@Model.S.ForgotSubtitle</p>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
    <div class="auth-links"><a asp-page="/Login">@Model.S.BackToSignIn</a></div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="field">
            <label asp-for="EmailOrUsername">@Model.S.EmailOrUsernameLabel</label>
            <input asp-for="EmailOrUsername" type="text" autocomplete="username" autofocus />
            <span asp-validation-for="EmailOrUsername" class="field-error"></span>
        </div>

        <partial name="_Captcha" model="Model" />

        <button type="submit" class="btn">@Model.S.SendResetLink</button>

        <div class="auth-links">
            <a asp-page="/Login">@Model.S.BackToSignIn</a>
        </div>
    </form>
}
