@* Shown by AuthorizeRouteView/MainLayout when the current user may not see the page.

   "Not authorized" covers two different situations and they must not be treated the same:
   a signed-out visitor needs the login form, while a signed-in member who simply lacks the
   permission needs /AccessDenied. Sending the second case to /Login produced an endless redirect
   loop — /Login bounces an authenticated member back to "/" and the landing page bounced straight
   back here — with a returnUrl that doubled in length every lap. Behind IIS that burst of requests
   trips Dynamic IP Restriction, which answers with its own 403 page until the member clears their
   cookies. *@
@using Dotnetable.Admin.Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/AccessDenied", forceLoad: true);
            return;
        }

        // Never send the member back to login, logout, or a sign-out flag. Those returnUrls
        // are what re-open /Login?signedOut=1 after a successful sign-in.
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var target = AuthReturnUrl.IsSafe(path)
            ? $"/Login?returnUrl={Uri.EscapeDataString(path)}"
            : "/Login";
        Nav.NavigateTo(target, forceLoad: true);
    }
}
