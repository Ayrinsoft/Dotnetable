@page "/languages"
@attribute [Authorize(Policy = AdminPolicies.SuperAdminOnly)]
@inject ILanguageService LanguageService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["languages.catalog", "Language Catalog"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["languages.catalog", "Language Catalog"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["languages.subtitle", "Admin panel language catalog only (WebsiteID is empty). Controls which languages the admin UI can switch to. Each website has its own languages under Website → Languages — including master site 1."]
        </MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
        @L["languages.new", "New Language"]
    </MudButton>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["languages.empty", "No languages found."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var lang in _items)
            {
                <tr>
                    <td><code>@lang.LanguageCode</code></td>
                    <td>@lang.LanguageCodeISO</td>
                    <td>@lang.Name</td>
                    <td>@(lang.RTLDesign ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>@(lang.IsDefault ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>@(lang.Active ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(lang))" />
                            <MudIconButton Icon="@(lang.Active ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Size="Size.Small" Color="@(lang.Active ? Color.Error : Color.Success)"
                                           Disabled="@lang.IsDefault"
                                           OnClick="@(() => ToggleActiveAsync(lang))"
                                           Title="@(lang.IsDefault
                                               ? L["languages.default_cannot_deactivate", "The default language cannot be deactivated"]
                                               : lang.Active ? L["languages.deactivate", "Deactivate — hide from all language lists"] : L["languages.activate", "Activate"])" />
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private List<Language> _items = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["languages.code", "Code"], ColumnName = nameof(Language.LanguageCode), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["languages.iso_code", "ISO Code"], ColumnName = nameof(Language.LanguageCodeISO), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Language.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["languages.rtl", "RTL"], ColumnName = nameof(Language.RTLDesign) },
                new() { ColumnTitle = L["languages.default", "Default"], ColumnName = nameof(Language.IsDefault) },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(Language.Active) },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await LanguageService.GetCatalogPagedAsync(_grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Language { Active = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Language lang)
    {
        var copy = new Language
        {
            LanguageID = lang.LanguageID,
            LanguageCode = lang.LanguageCode,
            LanguageCodeISO = lang.LanguageCodeISO,
            Name = lang.Name,
            Priority = lang.Priority,
            IsDefault = lang.IsDefault,
            Active = lang.Active,
            RTLDesign = lang.RTLDesign,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Language model, bool isNew)
    {
        var parameters = new DialogParameters<LanguageDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<LanguageDialog>(
            isNew ? L["languages.new", "New Language"] : L["languages.edit", "Edit Language"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task ToggleActiveAsync(Language lang)
    {
        try
        {
            await LanguageService.SetActiveAsync(lang.LanguageID, !lang.Active);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
    }
}
