@page "/website/languages"
@page "/content-languages"
@attribute [Authorize(Policy = RoleKeys.LocalizationEdit)]
@inject ILanguageService LanguageService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["website_languages", "Languages"] />

<MudStack Spacing="0" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">@L["website_languages", "Languages"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["website_languages.subtitle", "Languages for this website only (storefront, content editors, translation keys). Independent of the admin panel language catalog under Initial Data."]
            </MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (_isMaster)
            {
                <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                                 Label="@L["website", "Website"]" Variant="Variant.Outlined"
                                 Dense="true" Style="min-width:180px" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync" Disabled="_loading">
                @L["languages.new", "New Language"]
            </MudButton>
        </MudStack>
    </MudStack>
</MudStack>

@if (!string.IsNullOrEmpty(_defaultLanguageCode))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @L["website_languages.site_default", "Site default language"]:
        <code>@_defaultLanguageCode</code>
        — @L["website_languages.default_hint", "A new site starts with only this language. Add more languages when you need translations on the storefront."]
    </MudAlert>
}

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["languages.empty", "No languages found."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var lang in _items)
            {
                <tr>
                    <td><code>@lang.LanguageCode</code></td>
                    <td>@lang.LanguageCodeISO</td>
                    <td>@lang.Name</td>
                    <td>@(lang.RTLDesign ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        @if (lang.IsDefault)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @L["languages.default", "Default"]
                            </MudChip>
                        }
                        else
                        {
                            @L["no", "No"]
                        }
                    </td>
                    <td>
                        @if (lang.Active)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                @L["active", "Active"]
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                @L["inactive", "Inactive"]
                            </MudChip>
                        }
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (!lang.IsDefault)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small" Color="Color.Warning"
                                               Title="@L["languages.set_default", "Set as default"]"
                                               OnClick="@(() => SetDefaultAsync(lang))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => EditAsync(lang))" />
                            <MudIconButton Icon="@(lang.Active ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Size="Size.Small" Color="@(lang.Active ? Color.Error : Color.Success)"
                                           Disabled="@lang.IsDefault"
                                           Title="@(lang.Active ? L["languages.deactivate", "Deactivate"] : L["languages.activate", "Activate"])"
                                           OnClick="@(() => ToggleActiveAsync(lang))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="@lang.IsDefault"
                                           Title="@L["delete", "Delete"]"
                                           OnClick="@(() => RemoveAsync(lang))" />
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private string _defaultLanguageCode = "en";
    private List<Website> _websites = new();
    private List<Language> _items = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["languages.code", "Code"], ColumnName = nameof(Language.LanguageCode), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["languages.iso_code", "ISO Code"], ColumnName = nameof(Language.LanguageCodeISO), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Language.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["languages.rtl", "RTL"], ColumnName = nameof(Language.RTLDesign) },
                new() { ColumnTitle = L["languages.default", "Default"], ColumnName = nameof(Language.IsDefault) },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(Language.Active) },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var site = await WebsiteService.GetByIdAsync(_websiteId);
            _defaultLanguageCode = string.IsNullOrWhiteSpace(site?.DefaultLanguageCode)
                ? "en"
                : site!.DefaultLanguageCode.Trim().ToLowerInvariant();

            var all = await LanguageService.GetForWebsiteAsync(_websiteId);

            var siteDefault = all.FirstOrDefault(l => l.IsDefault);
            if (siteDefault is not null)
                _defaultLanguageCode = siteDefault.LanguageCode;

            // Client-side filter / sort / page — website language lists are small.
            var query = _grid.ToQuery();
            IEnumerable<Language> q = all;

            if (query.GetSearch(nameof(Language.LanguageCode)) is string code)
                q = q.Where(l => l.LanguageCode.Contains(code, StringComparison.OrdinalIgnoreCase));
            if (query.GetSearch(nameof(Language.LanguageCodeISO)) is string iso)
                q = q.Where(l => l.LanguageCodeISO.Contains(iso, StringComparison.OrdinalIgnoreCase));
            if (query.GetSearch(nameof(Language.Name)) is string name)
                q = q.Where(l => l.Name.Contains(name, StringComparison.OrdinalIgnoreCase));

            q = ApplyOrderBy(q, query.OrderBy);

            var filtered = q.ToList();
            _grid.Pagination.MaxLength = filtered.Count;
            _items = filtered.Skip(query.Skip).Take(query.Take).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private static IEnumerable<Language> ApplyOrderBy(IEnumerable<Language> source, string? orderBy)
    {
        if (string.IsNullOrWhiteSpace(orderBy))
            return source.OrderBy(l => l.Priority).ThenBy(l => l.Name);

        // First sort clause only (grid typically sets one active column).
        var parts = orderBy.Split(',')[0].Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var col = parts[0];
        var desc = parts.Length > 1 && parts[1].Equals("DESC", StringComparison.OrdinalIgnoreCase);

        return (col, desc) switch
        {
            (nameof(Language.LanguageCode), false) => source.OrderBy(l => l.LanguageCode),
            (nameof(Language.LanguageCode), true) => source.OrderByDescending(l => l.LanguageCode),
            (nameof(Language.LanguageCodeISO), false) => source.OrderBy(l => l.LanguageCodeISO),
            (nameof(Language.LanguageCodeISO), true) => source.OrderByDescending(l => l.LanguageCodeISO),
            (nameof(Language.Name), false) => source.OrderBy(l => l.Name),
            (nameof(Language.Name), true) => source.OrderByDescending(l => l.Name),
            _ => source.OrderBy(l => l.Priority).ThenBy(l => l.Name),
        };
    }

    private async Task CreateAsync()
    {
        var model = new Language { Active = true, IsDefault = false };
        if (await ShowDialogAsync(model, isNew: true))
            await LoadAsync();
    }

    private async Task EditAsync(Language lang)
    {
        var copy = new Language
        {
            LanguageID = lang.LanguageID,
            LanguageCode = lang.LanguageCode,
            LanguageCodeISO = lang.LanguageCodeISO,
            Name = lang.Name,
            Priority = lang.Priority,
            IsDefault = lang.IsDefault,
            Active = lang.Active,
            RTLDesign = lang.RTLDesign,
            WebsiteID = lang.WebsiteID,
        };
        if (await ShowDialogAsync(copy, isNew: false))
            await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Language model, bool isNew)
    {
        var parameters = new DialogParameters<WebsiteLanguageDialog>
        {
            { x => x.WebsiteId, _websiteId },
            { x => x.Model, model },
            { x => x.IsNew, isNew },
        };
        var dialog = await DialogService.ShowAsync<WebsiteLanguageDialog>(
            isNew ? L["languages.new", "New Language"] : L["languages.edit", "Edit Language"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task ToggleActiveAsync(Language lang)
    {
        try
        {
            await LanguageService.SetWebsiteLanguageActiveAsync(_websiteId, lang.LanguageID, !lang.Active);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
    }

    private async Task SetDefaultAsync(Language lang)
    {
        try
        {
            await LanguageService.SetWebsiteDefaultLanguageAsync(_websiteId, lang.LanguageID);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveAsync(Language lang)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            L["confirm", "Confirm"],
            string.Format(L["website_languages.delete_confirm", "Remove language \"{0}\" from this website?"], lang.Name),
            yesText: L["delete", "Delete"],
            cancelText: L["cancel", "Cancel"]);
        if (confirm != true) return;

        try
        {
            await LanguageService.RemoveWebsiteLanguageAsync(_websiteId, lang.LanguageCode);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
    }
}
