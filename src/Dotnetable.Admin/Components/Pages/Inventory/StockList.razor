@page "/inventory"
@attribute [Authorize(Policy = RoleKeys.InventoryView)]
@inject IInventoryService InventoryService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["inventory", "Inventory"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["inventory", "Inventory"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["inventory.subtitle", "Stock on hand, reserved and low-stock levels per product variant."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:180px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History" Href="/inventory/movements">
            @L["inventory.movements", "Stock Ledger"]
        </MudButton>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr><td colspan="7" style="text-align:center; padding:32px;">
                <MudText Color="Color.Secondary">@L["inventory.empty", "No stock rows yet."]</MudText>
            </td></tr>
        }
        else
        {
            @foreach (var i in _items)
            {
                var lowStock = i.QuantityOnHand <= i.ReorderLevel;
                <tr>
                    <td>@i.ProductVariant.Product.Title</td>
                    <td><code>@i.ProductVariant.Sku</code></td>
                    <td>@i.QuantityOnHand</td>
                    <td>@i.QuantityReserved</td>
                    <td>@(i.QuantityOnHand - i.QuantityReserved)</td>
                    <td>
                        @if (lowStock)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["inventory.low", "Low"]</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["inventory.ok", "OK"]</MudChip>
                        }
                    </td>
                    <td>
                        @if (_canEdit)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AdjustAsync(i))">@L["inventory.adjust", "Adjust"]</MudButton>
                        }
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canEdit;
    private int _websiteId;
    private List<InventoryItem> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, RoleKeys.InventoryEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["product", "Product"], ColumnName = "Title", HasSearch = true },
                new() { ColumnTitle = L["sku", "SKU"], ColumnName = nameof(ProductVariant.Sku), HasSearch = true },
                new() { ColumnTitle = L["inventory.onhand", "On Hand"], ColumnName = nameof(InventoryItem.QuantityOnHand), HasSort = true },
                new() { ColumnTitle = L["inventory.reserved", "Reserved"], ColumnName = nameof(InventoryItem.QuantityReserved), HasSort = true },
                new() { ColumnTitle = L["inventory.available", "Available"], ColumnName = "" },
                new() { ColumnTitle = L["status", "Status"], ColumnName = "" },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(IEnumerable<int> _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await InventoryService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task AdjustAsync(InventoryItem item)
    {
        var parameters = new DialogParameters<StockAdjustDialog>
        {
            { x => x.WebsiteId, _websiteId },
            { x => x.VariantId, item.ProductVariantID },
            { x => x.ProductTitle, item.ProductVariant.Product.Title },
            { x => x.Sku, item.ProductVariant.Sku },
        };
        var dialog = await DialogService.ShowAsync<StockAdjustDialog>(L["inventory.adjust", "Adjust"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
    }
}
