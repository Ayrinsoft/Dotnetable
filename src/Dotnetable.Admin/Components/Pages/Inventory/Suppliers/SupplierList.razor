@page "/inventory/suppliers"
@attribute [Authorize(Policy = RoleKeys.SuppliersView)]
@inject ISupplierService SupplierService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["suppliers", "Suppliers"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["suppliers", "Suppliers"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["suppliers.subtitle", "Vendors you purchase stock from."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["suppliers.new", "New Supplier"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="4" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["suppliers.empty", "No suppliers yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var s in _items)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Phone</td>
                    <td>@(s.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(s))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(s))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Supplier> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.SuppliersInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.SuppliersEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.SuppliersDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Supplier.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["phone", "Phone"], ColumnName = nameof(Supplier.Phone), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(Supplier.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await SupplierService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Supplier { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Supplier s)
    {
        var copy = new Supplier { SupplierID = s.SupplierID, WebsiteID = s.WebsiteID, Name = s.Name, Phone = s.Phone, IsActive = s.IsActive };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Supplier model, bool isNew)
    {
        var parameters = new DialogParameters<SupplierDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>(
            isNew ? L["suppliers.new", "New Supplier"] : L["suppliers.edit", "Edit Supplier"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Supplier s)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["suppliers.delete", "Delete supplier"],
            L["suppliers.delete_confirm", "Delete this supplier?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await SupplierService.DeleteAsync(s.SupplierID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
