@page "/inventory/returns"
@using Dotnetable.Domain.Enums
@attribute [Authorize(Policy = RoleKeys.WarehouseView)]
@inject ICustomerReturnService Returns
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["returns.title", "Customer returns"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["returns.title", "Customer returns"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["returns.subtitle", "Pre-requests from the storefront: review photos and reason, set who pays shipping, then wait for the customer to ship."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canCreate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AssignmentReturn" OnClick="CreateAsync">
                @L["returns.new", "New return"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged"
                SearchPlaceholder="@L["search", "Search…"]" AllText="@L["all", "All"]">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["returns.empty", "No customer returns yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var d in _items)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/inventory/returns/{d.CustomerReturnRequestID}"))">
                    <td>#@d.CustomerReturnRequestID</td>
                    <td>
                        <MudLink Href="@($"/orders/{d.OrderID}")" @onclick:stopPropagation="true">@d.OrderNumber</MudLink>
                    </td>
                    <td>@(d.ClientName ?? "—")</td>
                    <td>@StatusLabel((CustomerReturnStatus)d.Status)</td>
                    <td>@MoneyFormat.Group(d.RequestedRefundTotal, d.CurrencyCode)</td>
                    <td>@(d.TrackingCode ?? "—")</td>
                    <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true, _isMaster, _canCreate;
    private int _websiteId, _memberId;
    private List<Website> _websites = new();
    private List<CustomerReturnDto> _items = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var u = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = u.HasClaim(AdminClaimTypes.Master, "true");
        _canCreate = AdminPolicies.Allows(u, RoleKeys.WarehouseReceive) || AdminPolicies.Allows(u, RoleKeys.WarehouseIssue);
        int.TryParse(u.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(u.FindFirst(AdminClaimTypes.MemberId)?.Value, out _memberId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["id", "ID"], ColumnName = nameof(CustomerReturnDto.CustomerReturnRequestID), HasSort = true },
                new() { ColumnTitle = L["orders.order", "Order"], ColumnName = "OrderNumber", HasSearch = true },
                new() { ColumnTitle = L["client", "Customer"], ColumnName = "" },
                new()
                {
                    ColumnTitle = L["status", "Status"],
                    ColumnName = nameof(CustomerReturnDto.Status),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    OtherDropDownValues = Enum.GetValues<CustomerReturnStatus>()
                        .ToDictionary(s => StatusLabel(s), s => ((byte)s).ToString())
                },
                new() { ColumnTitle = L["returns.requested", "Requested"], ColumnName = nameof(CustomerReturnDto.RequestedRefundTotal), HasSort = true },
                new() { ColumnTitle = L["orders.tracking_code", "Tracking"], ColumnName = nameof(CustomerReturnDto.TrackingCode), HasSearch = true },
                new() { ColumnTitle = L["created", "Created"], ColumnName = nameof(CustomerReturnDto.CreatedAt), HasSort = true },
            }
        };

        await LoadAsync();
    }

    private string StatusLabel(CustomerReturnStatus s) => s switch
    {
        CustomerReturnStatus.PreRequest => L["returns.status.pre", "Pre-request"],
        CustomerReturnStatus.Rejected => L["returns.status.rejected", "Rejected"],
        CustomerReturnStatus.ApprovedAwaitingShipment => L["returns.status.approved", "Awaiting shipment"],
        CustomerReturnStatus.Shipped => L["returns.status.shipped", "Shipped"],
        CustomerReturnStatus.Received => L["returns.status.received", "Received"],
        CustomerReturnStatus.Completed => L["returns.status.completed", "Completed"],
        CustomerReturnStatus.Cancelled => L["returns.status.cancelled", "Cancelled"],
        _ => s.ToString(),
    };

    private async Task OnWebsiteChanged(int id) { _websiteId = id; _grid.Pagination.PageIndex = 1; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        if (_websiteId > 0)
        {
            var result = await Returns.GetPagedAsync(_websiteId, null, null, _grid.ToQuery());
            _items = result.Items.ToList();
            _grid.Pagination.MaxLength = result.TotalCount;
        }
        else
        {
            _items = new();
            _grid.Pagination.MaxLength = 0;
        }
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (_websiteId <= 0) return;
        var parameters = new DialogParameters<NewReturnDialog>
        {
            { x => x.WebsiteId, _websiteId },
            { x => x.MemberId, _memberId > 0 ? _memberId : null },
        };
        var dialog = await DialogService.ShowAsync<NewReturnDialog>(L["returns.new", "New return"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is int id)
            Nav.NavigateTo($"/inventory/returns/{id}");
        else
            await LoadAsync();
    }
}
