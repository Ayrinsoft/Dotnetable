@page "/inventory/stock-documents"
@page "/inventory/stock-documents/{DocumentId:int}"
@using Dotnetable.Domain.Enums
@attribute [Authorize(Policy = RoleKeys.WarehouseView)]
@inject IStockDocumentService Docs
@inject IWarehouseService Warehouses
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject NavigationManager Nav

<DNPageTitle Title=@L["warehouse.docs", "Stock documents"] />

@if (DocumentId is > 0)
{
    @if (_doc is null) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h5">@_doc.DocumentNumber · @((StockDocumentType)_doc.DocumentType) · @((StockDocumentStatus)_doc.Status)</MudText>
            <MudButton OnClick="@(() => Nav.NavigateTo("/inventory/stock-documents"))">@L["back", "Back"]</MudButton>
        </MudStack>
        <MudStack Row="true" Class="mb-3 gap-2 flex-wrap">
            @if (_canIssue && _doc.Status == (byte)StockDocumentStatus.Draft)
            { <MudButton Variant="Variant.Outlined" OnClick="Submit">@L["submit", "Submit"]</MudButton> }
            @if (_canApprove && _doc.Status == (byte)StockDocumentStatus.Submitted)
            {
                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Approve">@L["approve", "Approve"]</MudButton>
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="Reject">@L["reject", "Reject"]</MudButton>
            }
            @if (_canPost && (_doc.Status == (byte)StockDocumentStatus.Approved || _doc.Status == (byte)StockDocumentStatus.Submitted))
            { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Post">@L["post", "Post to stock"]</MudButton> }
        </MudStack>
        <MudPaper Class="app-card pa-4 mb-3">
            @if (_doc.OrderID is int oid)
            {
                <MudText Class="mb-2" Typo="Typo.caption">
                    @L["orders.order", "Order"]:
                    <MudLink Href="@($"/orders/{oid}")">#@oid</MudLink>
                </MudText>
            }
            @if (_doc.PaymentRefundID is int rid)
            {
                <MudText Class="mb-2" Typo="Typo.caption">
                    @L["payments.refund", "Refund"]: #@rid
                    <MudLink Href="/payments/refunds" Class="ms-1">@L["payments.refunds", "Bank refunds"]</MudLink>
                </MudText>
            }
            @if (_doc.FromWarehouse is not null || _doc.ToWarehouse is not null)
            {
                <MudText Class="mb-2" Typo="Typo.caption">
                    @if (_doc.FromWarehouse is not null) { <span>@L["warehouse.from", "From"]: @_doc.FromWarehouse.Name</span> }
                    @if (_doc.ToWarehouse is not null) { <span class="ms-2">@L["warehouse.to", "To"]: @_doc.ToWarehouse.Name</span> }
                </MudText>
            }
            @if (_doc.DocumentType == (byte)StockDocumentType.Count)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" Variant="Variant.Outlined">
                    @L["warehouse.count_hint", "Book = system on-hand at count. Counted = physical. Variance = Counted − Book (posted as stock adjustment)."]
                </MudAlert>
            }
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>@L["variant", "Variant"]</th>
                        @if (_doc.DocumentType == (byte)StockDocumentType.Count)
                        {
                            <th>@L["warehouse.book_qty", "Book"]</th>
                            <th>@L["warehouse.counted_qty", "Counted"]</th>
                            <th>@L["warehouse.variance", "Variance"]</th>
                        }
                        else
                        {
                            <th>@L["qty", "Qty"]</th>
                            <th>@L["unit_cost", "Unit cost"]</th>
                        }
                        @if (_doc.DocumentType == (byte)StockDocumentType.Return)
                        {
                            <th>@L["warehouse.item_condition", "Condition"]</th>
                            <th>@L["warehouse.health_grade", "Health grade"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _doc.StockDocumentLines)
                    {
                        <tr>
                            <td>@l.ProductVariant?.Sku — @l.ProductVariant?.Product?.Title</td>
                            @if (_doc.DocumentType == (byte)StockDocumentType.Count)
                            {
                                <td>@l.BookQuantity</td>
                                <td>
                                    @if (_doc.Status != (byte)StockDocumentStatus.Posted && (_canReceive || _canPost || _canIssue))
                                    {
                                        <MudNumericField T="int" Value="@(l.CountedQuantity ?? l.BookQuantity)" Dense="true" Style="max-width:100px"
                                                         ValueChanged="@(async v => await SetCountedAsync(l.StockDocumentLineID, v))" Min="0" />
                                    }
                                    else { @(l.CountedQuantity ?? l.BookQuantity) }
                                </td>
                                <td>
                                    @{
                                        var variance = l.Quantity;
                                        var vColor = variance == 0 ? Color.Default : variance > 0 ? Color.Success : Color.Error;
                                    }
                                    <MudChip T="string" Size="Size.Small" Color="vColor">@(variance > 0 ? $"+{variance}" : variance.ToString())</MudChip>
                                </td>
                            }
                            else
                            {
                                <td>@l.Quantity</td>
                                <td>@l.UnitCost.ToString("0.##")</td>
                            }
                            @if (_doc.DocumentType == (byte)StockDocumentType.Return)
                            {
                                <td>
                                    @if (_doc.Status != (byte)StockDocumentStatus.Posted && (_canReceive || _canPost))
                                    {
                                        <MudSelect T="byte" Value="l.ReturnCondition" Dense="true" Style="min-width:150px"
                                                   ValueChanged="@(async v => await SetConditionAsync(l, v, l.HealthGrade))">
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.New)">@L["warehouse.cond.new", "New"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.LikeNew)">@L["warehouse.cond.like_new", "Like new"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.OpenBox)">@L["warehouse.cond.open_box", "Open box"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.Display)">@L["warehouse.cond.display", "Display / showcase"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.Used)">@L["warehouse.cond.used", "Used"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockItemCondition.Defective)">@L["warehouse.cond.defective", "Defective"]</MudSelectItem>
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        @ConditionLabel((StockItemCondition)l.ReturnCondition)
                                    }
                                </td>
                                <td>
                                    @if (_doc.Status != (byte)StockDocumentStatus.Posted && (_canReceive || _canPost)
                                         && l.ReturnCondition is not ((byte)StockItemCondition.New or (byte)StockItemCondition.Defective))
                                    {
                                        <MudSelect T="byte" Value="l.HealthGrade" Dense="true" Style="min-width:100px"
                                                   ValueChanged="@(async v => await SetConditionAsync(l, l.ReturnCondition, v))">
                                            <MudSelectItem T="byte" Value="@((byte)StockHealthGrade.A)">A — @L["warehouse.grade.a", "Excellent"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockHealthGrade.B)">B — @L["warehouse.grade.b", "Good"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockHealthGrade.C)">C — @L["warehouse.grade.c", "Fair"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockHealthGrade.D)">D — @L["warehouse.grade.d", "Poor"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="@((byte)StockHealthGrade.F)">F — @L["warehouse.grade.f", "Critical"]</MudSelectItem>
                                        </MudSelect>
                                    }
                                    else if (l.HealthGrade > 0)
                                    {
                                        @($"G{l.HealthGrade}")
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (_doc.DocumentType == (byte)StockDocumentType.Count && _doc.StockDocumentLines.Count > 0)
            {
                var totalVar = _doc.StockDocumentLines.Sum(x => x.Quantity);
                <MudText Class="mt-2" Typo="Typo.caption">
                    @L["warehouse.total_variance", "Total variance"]: <strong>@(totalVar > 0 ? $"+{totalVar}" : totalVar.ToString())</strong>
                    · @L["warehouse.lines_with_diff", "Lines with difference"]: @_doc.StockDocumentLines.Count(x => x.Quantity != 0)
                </MudText>
            }
            @if (_doc.Status != (byte)StockDocumentStatus.Posted
                 && _doc.DocumentType is (byte)StockDocumentType.Transfer or (byte)StockDocumentType.Inbound or (byte)StockDocumentType.Outbound
                 && (_canIssue || _canReceive))
            {
                <MudGrid Spacing="2" Class="mt-3">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int" @bind-Value="_addVariantId" Label="@L["variant_id", "Variant ID"]"
                                         Variant="Variant.Outlined" Dense="true" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int" @bind-Value="_addQty" Label="@L["qty", "Qty"]"
                                         Variant="Variant.Outlined" Dense="true" Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-end">
                        <MudButton Size="Size.Medium" Variant="Variant.Outlined" OnClick="AddLineAsync">@L["warehouse.add_line", "Add line"]</MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        <RecordAttachmentsPanel WebsiteId="_doc.WebsiteID"
                               EntityType="@Dotnetable.Application.RecordAttachments.RecordEntityTypes.StockDocument"
                               EntityId="_doc.StockDocumentID"
                               CanEdit="@(_canReceive || _canIssue || _canPost)"
                               Title="@L["attachments.stock_doc", "Document scans / packing slips"]" />
    }
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">@L["warehouse.docs", "Stock documents"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["warehouse.docs.subtitle", "Inbound, outbound, transfer, count, adjustment. Customer product returns have their own page."]
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (_isMaster)
            {
                <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                                 Label="@L["website", "Website"]" Variant="Variant.Outlined"
                                 Dense="true" Style="min-width:180px" />
            }
            <MudButton Variant="Variant.Outlined" Href="/inventory/returns">
                @L["returns.title", "Customer returns"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_canIssue || _canReceive)
    {
        <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
            <MudText Typo="Typo.subtitle2" Class="mb-3">@L["warehouse.transfer_count", "Transfer & count (quick)"]</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="_fromWh" Label="@L["warehouse.from", "From warehouse"]"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        @foreach (var w in _wh) { <MudSelectItem T="int?" Value="@w.WarehouseID">@w.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="_toWh" Label="@L["warehouse.to", "To warehouse"]"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        @foreach (var w in _wh) { <MudSelectItem T="int?" Value="@w.WarehouseID">@w.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true"
                               OnClick="CreateTransfer" Disabled="@(_fromWh is null or <= 0 || _toWh is null or <= 0 || _fromWh == _toWh)">
                        @L["warehouse.create_transfer", "Create transfer"]
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium" FullWidth="true"
                               OnClick="CreateCount" Disabled="@((_toWh ?? _fromWh) is null or <= 0)">
                        @L["warehouse.create_count", "Physical count"]
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                @L["warehouse.transfer_hint", "Transfer: set From + To, then open the document and add lines. Count: loads all on-hand rows for the warehouse (To, or From) so you can enter physical counts and review variance."]
            </MudText>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-3">@L["warehouse.new_doc", "Other document types"]</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="StockDocumentType" @bind-Value="_newType" Label="@L["type", "Type"]"
                               Variant="Variant.Outlined" Dense="true">
                        @foreach (StockDocumentType t in Enum.GetValues<StockDocumentType>().Where(x => x != StockDocumentType.Return))
                        { <MudSelectItem T="StockDocumentType" Value="@t">@t</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudNumericField T="int" @bind-Value="_lineVariantId" Label="@L["variant_id", "Variant ID"]"
                                     Variant="Variant.Outlined" Dense="true" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudNumericField T="int" @bind-Value="_lineQty" Label="@L["qty", "Qty"]"
                                     Variant="Variant.Outlined" Dense="true" Min="1" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <DNMoneyField @bind-Value="_lineCost" Label="@L["unit_cost", "Unit cost"]" Min="0" Variant="Variant.Outlined" Margin="Margin.None" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true" OnClick="CreateDoc">
                        @L["create", "Create"]
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged"
                    SearchPlaceholder="@L["search", "Search…"]" AllText="@L["all", "All"]">
            @if (_list.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align:center; padding:32px;">
                        <MudText Color="Color.Secondary">@L["warehouse.docs.empty", "No stock documents yet."]</MudText>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var d in _list)
                {
                    <tr style="cursor:pointer" @onclick="@(() => OpenDoc(d))">
                        <td><code>@d.DocumentNumber</code></td>
                        <td>@((StockDocumentType)d.DocumentType)</td>
                        <td>@((StockDocumentStatus)d.Status)</td>
                        <td>@(d.FromWarehouse?.Name ?? "—")</td>
                        <td>@(d.ToWarehouse?.Name ?? "—")</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            }
        </DNGridView>
    </MudPaper>
}

@code {
    [Parameter] public int? DocumentId { get; set; }
    private bool _loading, _isMaster, _canReceive, _canIssue, _canApprove, _canPost;
    private int _websiteId, _memberId, _lineVariantId, _lineQty = 1, _addVariantId, _addQty = 1;
    private decimal _lineCost;
    private int? _toWh, _fromWh;
    private StockDocumentType _newType = StockDocumentType.Inbound;
    private List<Website> _websites = new(); private List<Warehouse> _wh = new();
    private List<StockDocument> _list = new(); private StockDocument? _doc;
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnParametersSetAsync()
    {
        await L.EnsureLoadedAsync();
        var u = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = u.HasClaim(AdminClaimTypes.Master, "true");
        _canReceive = AdminPolicies.Allows(u, RoleKeys.WarehouseReceive);
        _canIssue = AdminPolicies.Allows(u, RoleKeys.WarehouseIssue);
        _canApprove = AdminPolicies.Allows(u, RoleKeys.WarehouseApprove);
        _canPost = AdminPolicies.Allows(u, RoleKeys.WarehousePost);
        int.TryParse(u.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(u.FindFirst(AdminClaimTypes.MemberId)?.Value, out _memberId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        if (_grid.HeaderItems.Count == 0)
        {
            _grid = new GridViewHeaderParameters
            {
                Pagination = new PaginationModel { PageSize = 25 },
                HeaderItems = new()
                {
                    new() { ColumnTitle = L["number", "Number"], ColumnName = nameof(StockDocument.DocumentNumber), HasSort = true, HasSearch = true },
                    new()
                    {
                        ColumnTitle = L["type", "Type"],
                        ColumnName = nameof(StockDocument.DocumentType),
                        HasSort = true,
                        HasSearch = true,
                        SearchType = SearchColumnType.DropDown,
                        OtherDropDownValues = Enum.GetValues<StockDocumentType>()
                            .Where(t => t != StockDocumentType.Return)
                            .ToDictionary(t => t.ToString(), t => ((byte)t).ToString())
                    },
                    new()
                    {
                        ColumnTitle = L["status", "Status"],
                        ColumnName = nameof(StockDocument.Status),
                        HasSort = true,
                        HasSearch = true,
                        SearchType = SearchColumnType.DropDown,
                        OtherDropDownValues = Enum.GetValues<StockDocumentStatus>()
                            .ToDictionary(s => s.ToString(), s => ((byte)s).ToString())
                    },
                    new() { ColumnTitle = L["warehouse.from", "From"], ColumnName = nameof(StockDocument.FromWarehouseID), HasSort = true },
                    new() { ColumnTitle = L["warehouse.to", "To"], ColumnName = nameof(StockDocument.ToWarehouseID), HasSort = true },
                    new() { ColumnTitle = L["created", "Created"], ColumnName = nameof(StockDocument.CreatedAt), HasSort = true },
                }
            };
        }

        if (DocumentId is > 0) _doc = await Docs.GetByIdAsync(DocumentId.Value);
        else await LoadList();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        _grid.Pagination.PageIndex = 1;
        await LoadList();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadList();

    private void OpenDoc(StockDocument d)
    {
        if (d.DocumentType == (byte)StockDocumentType.Return)
            Nav.NavigateTo($"/inventory/returns/wms/{d.StockDocumentID}");
        else
            Nav.NavigateTo($"/inventory/stock-documents/{d.StockDocumentID}");
    }

    private async Task LoadList()
    {
        _loading = true;
        if (_websiteId > 0)
        {
            _wh = (await Warehouses.GetAllAsync(_websiteId)).ToList();
            var r = await Docs.GetPagedAsync(_websiteId, null, null, _grid.ToQuery(), excludeReturns: true);
            _list = r.Items.ToList();
            _grid.Pagination.MaxLength = r.TotalCount;
        }
        else
        {
            _list = new();
            _grid.Pagination.MaxLength = 0;
        }
        _loading = false;
    }

    private async Task CreateDoc()
    {
        if (_websiteId <= 0 || _lineVariantId <= 0) return;
        var (ok, err, doc) = await Docs.CreateAsync(_websiteId, _newType, _fromWh, _toWh, null, null,
            new[] { new StockDocumentLineRequest { ProductVariantID = _lineVariantId, Quantity = _lineQty, UnitCost = _lineCost } }, _memberId);
        if (ok && doc is not null) Nav.NavigateTo($"/inventory/stock-documents/{doc.StockDocumentID}");
        else Snackbar.Add(err ?? "Failed", Severity.Error);
    }

    private async Task CreateTransfer()
    {
        if (_websiteId <= 0 || _fromWh is null || _toWh is null || _fromWh == _toWh)
        {
            Snackbar.Add(L["warehouse.transfer_need_wh", "Pick two different warehouses."], Severity.Warning);
            return;
        }
        // Start with empty draft (one placeholder line required by Create — use qty 0 invalid).
        // Create with a dummy then delete is messy; require first line via Add after empty create.
        // Use Create with one optional line if user filled variant, else create inbound-style with no lines fails.
        // CreateAsync requires lines — seed with first available stock SKU qty 0 not allowed.
        // Solution: create Transfer with first warehouse stock line qty 1 if any, else ask for variant.
        if (_lineVariantId <= 0)
        {
            var stocks = _fromWh is int fid ? await Warehouses.GetStockAsync(fid) : Array.Empty<WarehouseStock>();
            var first = stocks.FirstOrDefault(s => s.QuantityOnHand > 0);
            if (first is null)
            {
                Snackbar.Add(L["warehouse.transfer_need_line", "Enter a Variant ID (and qty) for the first transfer line, or stock the From warehouse first."], Severity.Warning);
                return;
            }
            _lineVariantId = first.ProductVariantID;
            _lineQty = Math.Min(1, first.QuantityOnHand);
        }
        var (ok, err, doc) = await Docs.CreateAsync(_websiteId, StockDocumentType.Transfer, _fromWh, _toWh, null,
            L["warehouse.transfer_note", "Inter-warehouse transfer"],
            new[] { new StockDocumentLineRequest { ProductVariantID = _lineVariantId, Quantity = Math.Max(1, _lineQty), UnitCost = _lineCost } },
            _memberId);
        if (ok && doc is not null) Nav.NavigateTo($"/inventory/stock-documents/{doc.StockDocumentID}");
        else Snackbar.Add(err ?? "Failed", Severity.Error);
    }

    private async Task CreateCount()
    {
        var wh = _toWh ?? _fromWh;
        if (_websiteId <= 0 || wh is null or <= 0)
        {
            Snackbar.Add(L["warehouse.count_need_wh", "Select a warehouse (To or From)."], Severity.Warning);
            return;
        }
        var (ok, err, doc) = await Docs.CreateCountFromWarehouseAsync(_websiteId, wh.Value, null, _memberId);
        if (ok && doc is not null) Nav.NavigateTo($"/inventory/stock-documents/{doc.StockDocumentID}");
        else Snackbar.Add(err ?? "Failed", Severity.Error);
    }

    private async Task SetCountedAsync(int lineId, int counted)
    {
        var (ok, e) = await Docs.SetCountedQuantityAsync(lineId, counted, _memberId);
        await After(ok, e);
    }

    private async Task AddLineAsync()
    {
        if (DocumentId is null or <= 0 || _addVariantId <= 0 || _addQty <= 0) return;
        var (ok, e) = await Docs.AddLineAsync(DocumentId.Value,
            new StockDocumentLineRequest { ProductVariantID = _addVariantId, Quantity = _addQty, UnitCost = 0 }, _memberId);
        if (ok) { _addVariantId = 0; _addQty = 1; }
        await After(ok, e);
    }

    private async Task Submit() { var (ok, e) = await Docs.SubmitAsync(DocumentId!.Value, _memberId); await After(ok, e); }
    private async Task Approve() { var (ok, e) = await Docs.ApproveAsync(DocumentId!.Value, _memberId); await After(ok, e); }
    private async Task Reject() { var (ok, e) = await Docs.RejectAsync(DocumentId!.Value, _memberId, null); await After(ok, e); }
    private async Task Post() { var (ok, e) = await Docs.PostAsync(DocumentId!.Value, _memberId); await After(ok, e); }
    private async Task SetConditionAsync(StockDocumentLine line, byte condition, byte grade)
    {
        if (condition is not ((byte)StockItemCondition.New or (byte)StockItemCondition.Defective)
            && grade == 0)
            grade = (byte)StockHealthGrade.B; // sensible default when switching to non-new
        var (ok, e) = await Docs.SetReturnLineConditionAsync(
            line.StockDocumentLineID, (StockItemCondition)condition, (StockHealthGrade)grade, _memberId);
        await After(ok, e);
    }

    private string ConditionLabel(StockItemCondition c) => c switch
    {
        StockItemCondition.New => L["warehouse.cond.new", "New"],
        StockItemCondition.LikeNew => L["warehouse.cond.like_new", "Like new"],
        StockItemCondition.OpenBox => L["warehouse.cond.open_box", "Open box"],
        StockItemCondition.Display => L["warehouse.cond.display", "Display / showcase"],
        StockItemCondition.Used => L["warehouse.cond.used", "Used"],
        StockItemCondition.Defective => L["warehouse.cond.defective", "Defective"],
        _ => c.ToString(),
    };
    private async Task After(bool ok, string? e)
    {
        if (ok) { Snackbar.Add(L["saved", "Saved."], Severity.Success); _doc = await Docs.GetByIdAsync(DocumentId!.Value); }
        else Snackbar.Add(e ?? "Failed", Severity.Error);
    }
}
