@inject IOrderService Orders
@inject ICustomerReturnService Returns
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @L["returns.new_hint", "Register a pre-request for selected lines. Choose who pays return shipping so later ledgers can split the cost."]
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_orderSearch" Label="@L["orders.order_number", "Order number"]"
                              Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="SearchOrderAsync" OnKeyDown="OnSearchKey" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Outlined" OnClick="SearchOrderAsync" FullWidth="true">@L["search", "Search"]</MudButton>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="CustomerReturnReason" @bind-Value="_reason" Label="@L["returns.reason", "Reason"]"
                           Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.Damaged">@L["returns.reason.damaged", "Damaged"]</MudSelectItem>
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.WrongItem">@L["returns.reason.wrong", "Wrong item"]</MudSelectItem>
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.NotAsDescribed">@L["returns.reason.not_described", "Not as described"]</MudSelectItem>
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.ChangedMind">@L["returns.reason.changed_mind", "Changed mind"]</MudSelectItem>
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.Defective">@L["returns.reason.defective", "Defective"]</MudSelectItem>
                    <MudSelectItem T="CustomerReturnReason" Value="CustomerReturnReason.Other">@L["returns.reason.other", "Other"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="ReturnShippingPayer" @bind-Value="_payer" Label="@L["returns.who_pays", "Who pays return shipping"]"
                           Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="ReturnShippingPayer" Value="ReturnShippingPayer.Customer">@L["returns.payer.customer", "Customer"]</MudSelectItem>
                    <MudSelectItem T="ReturnShippingPayer" Value="ReturnShippingPayer.SplitFiftyFifty">@L["returns.payer.split", "50 / 50"]</MudSelectItem>
                    <MudSelectItem T="ReturnShippingPayer" Value="ReturnShippingPayer.Seller">@L["returns.payer.seller", "Seller"]</MudSelectItem>
                    <MudSelectItem T="ReturnShippingPayer" Value="ReturnShippingPayer.DropOffAtCenter">@L["returns.payer.dropoff", "Drop-off at store / center"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_description" Label="@L["returns.description", "Description"]"
                              Variant="Variant.Outlined" Dense="true" Lines="2" />
            </MudItem>
        </MudGrid>

        @if (_searching)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
        }
        else if (_elig is not null)
        {
            @if (!_elig.Eligible && !_elig.CanAcceptAfterWindow)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Variant="Variant.Outlined">@_elig.BlockReason</MudAlert>
            }
            else if (_elig.CanAcceptAfterWindow)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Variant="Variant.Outlined">@_elig.BlockReason</MudAlert>
                <MudCheckBox T="bool" @bind-Value="_acceptExpired" Class="mt-2"
                             Label="@L["returns.accept_expired", "Accept this return knowing the return window has ended"]" />
            }
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@_elig.OrderNumber</MudText>
            <MudSimpleTable Dense="true" Elevation="0">
                <thead>
                    <tr>
                        <th></th>
                        <th>@L["title", "Title"]</th>
                        <th>@L["returns.remaining", "Left"]</th>
                        <th>@L["returns.qty", "Qty"]</th>
                        <th>@L["returns.paid", "Paid"]</th>
                        <th>@L["returns.refund_unit", "Refund / unit"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _lines)
                    {
                        <tr>
                            <td><MudCheckBox T="bool" @bind-Value="row.Selected" Dense="true" Disabled="@(row.RemainingQty <= 0)" /></td>
                            <td>@row.Title <code class="ms-1">@row.Sku</code></td>
                            <td>@row.RemainingQty / @row.OrderedQty</td>
                            <td>
                                <MudNumericField T="int" @bind-Value="row.Qty" Variant="Variant.Outlined" Dense="true"
                                                 Min="1" Max="Math.Max(1, row.RemainingQty)" Style="max-width:90px"
                                                 Disabled="@(row.RemainingQty <= 0)" />
                            </td>
                            <td>@row.UnitPricePaid.ToString("0.##")</td>
                            <td>
                                <MudNumericField T="decimal" @bind-Value="row.UnitRefund" Variant="Variant.Outlined" Dense="true"
                                                 Min="0" Style="max-width:110px" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else if (_searched)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" Variant="Variant.Outlined">
                @L["returns.order_not_found", "No order matched that number."]
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   Disabled="@(_saving || _elig is null || !CanSave || !_lines.Any(x => x.Selected && x.Qty > 0))">
            @L["returns.register", "Register return"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public int? MemberId { get; set; }

    private string _orderSearch = "", _description = "";
    private CustomerReturnReason _reason = CustomerReturnReason.Damaged;
    private ReturnShippingPayer _payer = ReturnShippingPayer.Customer;
    private bool _acceptExpired;
    private bool _searching, _searched, _saving;
    private ReturnEligibilityDto? _elig;
    private int _clientId;
    private List<LinePick> _lines = new();

    private bool CanSave =>
        _elig is not null && (_elig.Eligible || (_elig.CanAcceptAfterWindow && _acceptExpired));

    private void Cancel() => MudDialog.Cancel();

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchOrderAsync();
    }

    private async Task SearchOrderAsync()
    {
        if (WebsiteId <= 0 || string.IsNullOrWhiteSpace(_orderSearch)) return;
        _searching = true;
        _searched = true;
        _acceptExpired = false;
        var q = new GridQuery { PageSize = 10 };
        q.Search[nameof(Order.OrderNumber)] = _orderSearch.Trim();
        var page = await Orders.GetPagedAsync(WebsiteId, null, q);
        var hit = page.Items.FirstOrDefault();
        if (hit is null && int.TryParse(_orderSearch.Trim().TrimStart('#'), out var id))
            hit = await Orders.GetByIdAsync(id);

        if (hit is null)
        {
            _elig = null;
            _lines = new();
            _searching = false;
            return;
        }

        _clientId = hit.WebsiteClientID;
        _elig = await Returns.GetEligibilityAsync(hit.OrderID, hit.WebsiteClientID);
        _lines = _elig.Lines.Select(i => new LinePick
        {
            OrderItemID = i.OrderItemID,
            Title = i.Title,
            Sku = i.Sku,
            OrderedQty = i.OrderedQty,
            RemainingQty = i.RemainingQty,
            Qty = Math.Max(1, i.RemainingQty),
            UnitPricePaid = i.UnitPricePaid,
            UnitRefund = i.UnitPricePaid,
            Selected = i.RemainingQty > 0,
        }).ToList();
        _searching = false;
    }

    private async Task SaveAsync()
    {
        if (_elig is null || !CanSave) return;
        var selected = _lines.Where(x => x.Selected && x.Qty > 0 && x.RemainingQty > 0).ToList();
        if (selected.Count == 0) return;
        _saving = true;
        try
        {
            var (ok, err, row) = await Returns.CreateAsync(
                WebsiteId, _clientId, _elig.OrderID, _reason, null, _description, null,
                selected.Select(x => new CustomerReturnLineInput
                {
                    OrderItemID = x.OrderItemID,
                    Quantity = x.Qty,
                    UnitRefundRequested = x.UnitRefund,
                }).ToList(),
                null, _payer, _acceptExpired);
            if (!ok || row is null)
            {
                Snackbar.Add(err ?? L["save_failed", "Save failed"], Severity.Error);
                return;
            }
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(row.CustomerReturnRequestID));
        }
        finally { _saving = false; }
    }

    private sealed class LinePick
    {
        public int OrderItemID { get; set; }
        public string Title { get; set; } = "";
        public string Sku { get; set; } = "";
        public int OrderedQty { get; set; }
        public int RemainingQty { get; set; }
        public int Qty { get; set; }
        public decimal UnitPricePaid { get; set; }
        public decimal UnitRefund { get; set; }
        public bool Selected { get; set; }
    }
}
