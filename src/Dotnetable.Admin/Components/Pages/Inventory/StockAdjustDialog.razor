@inject IInventoryService InventoryService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-3"><b>@ProductTitle</b> <code>@Sku</code></MudText>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_delta" Label="@L["inventory.delta", "Quantity change (+/-)"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_unitCostUsd" Label="@L["inventory.unitcost", "Unit cost (USD, optional)"]" Variant="Variant.Outlined" Format="F4" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_note" Label="@L["note", "Note"]" Variant="Variant.Outlined" Lines="2" />
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public int VariantId { get; set; }
    [Parameter] public string ProductTitle { get; set; } = "";
    [Parameter] public string Sku { get; set; } = "";

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private int _delta;
    private decimal? _unitCostUsd;
    private string? _note;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid || _delta == 0) return;

        _saving = true;
        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var memberId);

            await InventoryService.AdjustAsync(WebsiteId, VariantId, _delta, _unitCostUsd, _note, memberId);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
