@page "/media/watermark"
@attribute [Authorize(Policy = RoleKeys.MediaUpload)]
@using Dotnetable.Domain.Enums
@inject IWebsiteSettingService SettingService
@inject IFileService FileService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["watermark.heading", "Watermark"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["watermark.heading", "Watermark"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["watermark.subtitle", "Applied automatically to image uploads for this website"]</MudText>
    </MudStack>
    @if (_isMaster)
    {
        <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                         Label="@L["website", "Website"]" Variant="Variant.Outlined"
                         Dense="true" Style="min-width:200px;" />
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
else
{
    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mb-1">@L["watermark.image", "Watermark image"]</MudText>
                <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickWatermarkAsync">
                    <div style="aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                        @if (!string.IsNullOrEmpty(_watermarkFile?.CNDUrl))
                        {
                            <img src="@(_watermarkFile.ThumbnailCDN ?? _watermarkFile.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:contain;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                        }
                    </div>
                </MudPaper>
                @if (_watermarkFile is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="@(() => { _watermarkFile = null; _setting.WatermarkFileID = null; })" Class="mt-1">
                        @L["watermark.remove", "Remove"]
                    </MudButton>
                }
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_setting.Enabled" Label="@L["watermark.enabled", "Apply to every image upload automatically"]" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="byte" @bind-Value="_setting.Position" Label="@L["watermark.position", "Position"]" Variant="Variant.Outlined">
                            @foreach (WatermarkPosition p in Enum.GetValues<WatermarkPosition>())
                            {
                                <MudSelectItem T="byte" Value="@((byte)p)">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_setting.SizePercent" Label="@L["watermark.size", "Size (% of image width)"]" Variant="Variant.Outlined" Min="1" Max="100" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_setting.Opacity" Label="@L["watermark.opacity", "Opacity (%)"]" Variant="Variant.Outlined" Min="0" Max="100" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">
                @L["save", "Save"]
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private bool _isMaster;
    private int _websiteId;
    private bool _loading = true;
    private bool _saving;
    private List<Website> _websites = new();
    private WebsiteWatermarkSetting _setting = new() { Position = (byte)WatermarkPosition.BottomRight, SizePercent = 20, Opacity = 80 };
    private FileRecord? _watermarkFile;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var existing = await SettingService.GetWatermarkSettingAsync(_websiteId);
        _setting = existing ?? new WebsiteWatermarkSetting
        {
            WebsiteID = _websiteId,
            Position = (byte)WatermarkPosition.BottomRight,
            SizePercent = 20,
            Opacity = 80,
        };
        _watermarkFile = existing?.WatermarkFile;
        _loading = false;
    }

    private async Task PickWatermarkAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = _websiteId,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
        {
            _watermarkFile = file;
            _setting.WatermarkFileID = file.FileRecordID;
        }
    }

    private async Task SaveAsync()
    {
        _setting.WebsiteID = _websiteId;
        _saving = true;
        try
        {
            await SettingService.SaveWatermarkSettingAsync(_setting);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
