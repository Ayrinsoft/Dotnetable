@page "/media/folders"
@page "/media/albums"
@attribute [Authorize(Policy = RoleKeys.MediaView)]
@inject IFileService FileService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["media.folders", "Media folders"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["media.folders", "Media folders"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["media.folders_subtitle", "Organize the media library into nested virtual folders"]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/media"
                   StartIcon="@Icons.Material.Filled.PhotoLibrary">@L["media_library", "Media Library"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder"
                   OnClick="@(() => CreateAsync(null))">@L["media.new_folder", "New folder"]</MudButton>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }

    <MudTextField @bind-Value="_search"
                  Placeholder="@L["media.search_folders", "Search folders…"]"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Class="mb-3"
                  Style="max-width:360px;" />

    @if (_folders.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="pa-6" Align="Align.Center">
            @L["media.folders_empty", "No folders yet."]
        </MudText>
    }
    else if (VisibleRoots.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="pa-6" Align="Align.Center">
            @L["media.folders_search_empty", "No folders match your search."]
        </MudText>
    }
    else
    {
        <ul class="dn-tree dn-tree-root">
            @foreach (var folder in VisibleRoots)
            {
                @RenderManageNode(folder, 0)
            }
        </ul>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private string? _search;
    private List<FileFolder> _folders = new();
    private List<Website> _websites = new();
    private readonly HashSet<int> _expanded = new();

    private IReadOnlyList<FileFolder> VisibleRoots
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
                return _folders.Where(f => f.ParentFolderID is null).OrderBy(f => f.Name).ToList();

            var needle = _search.Trim();
            var matchIds = _folders
                .Where(f => f.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                            || (f.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
                .Select(f => f.FileFolderID)
                .ToHashSet();

            var byId = _folders.ToDictionary(f => f.FileFolderID);
            var visible = new HashSet<int>(matchIds);
            foreach (var id in matchIds.ToList())
            {
                var current = byId.GetValueOrDefault(id);
                while (current?.ParentFolderID is int parentId)
                {
                    visible.Add(parentId);
                    _expanded.Add(parentId);
                    if (!byId.TryGetValue(parentId, out current)) break;
                }
            }

            return _folders.Where(f => f.ParentFolderID is null && visible.Contains(f.FileFolderID))
                .OrderBy(f => f.Name).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _folders = (await FileService.GetFoldersAsync(_websiteId)).ToList();
        // Expand top-level by default for manage page.
        foreach (var root in _folders.Where(f => f.ParentFolderID is null))
            _expanded.Add(root.FileFolderID);
        _loading = false;
    }

    private IEnumerable<FileFolder> ChildrenOf(int parentId)
    {
        IEnumerable<FileFolder> children = _folders.Where(f => f.ParentFolderID == parentId).OrderBy(f => f.Name);
        if (string.IsNullOrWhiteSpace(_search)) return children;

        var needle = _search.Trim();
        var matchIds = _folders
            .Where(f => f.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                        || (f.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
            .Select(f => f.FileFolderID)
            .ToHashSet();
        var byId = _folders.ToDictionary(f => f.FileFolderID);
        var visible = new HashSet<int>(matchIds);
        foreach (var id in matchIds.ToList())
        {
            var current = byId.GetValueOrDefault(id);
            while (current?.ParentFolderID is int p)
            {
                visible.Add(p);
                if (!byId.TryGetValue(p, out current)) break;
            }
        }
        return children.Where(c => visible.Contains(c.FileFolderID));
    }

    private bool HasChildren(int folderId) => _folders.Any(f => f.ParentFolderID == folderId);

    private void ToggleExpand(int folderId)
    {
        if (!_expanded.Add(folderId))
            _expanded.Remove(folderId);
    }

    private async Task CreateAsync(int? parentFolderId)
    {
        if (await ShowDialogAsync(null, parentFolderId)) await LoadAsync();
    }

    private async Task EditAsync(FileFolder folder)
    {
        if (await ShowDialogAsync(folder, null)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(FileFolder? folder, int? parentFolderId)
    {
        var parameters = new DialogParameters
        {
            [nameof(FileFolderDialog.WebsiteId)] = _websiteId,
            [nameof(FileFolderDialog.Folder)] = folder,
            [nameof(FileFolderDialog.PresetParentFolderId)] = parentFolderId,
            [nameof(FileFolderDialog.AllFolders)] = _folders,
        };
        var dialog = await DialogService.ShowAsync<FileFolderDialog>(
            folder is null ? L["media.new_folder", "New folder"] : L["media.edit_folder", "Edit folder"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private async Task DeleteAsync(FileFolder folder)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            L["media.delete_folder_q", "Delete folder?"],
            $"\"{folder.Name}\" {L["media.delete_folder_body", "will be removed. Child folders move up one level; files fall back to Root."]}",
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (ok != true) return;

        try
        {
            await FileService.DeleteFolderAsync(folder.FileFolderID);
            Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["delete_failed", "Delete failed"]}: {ex.Message}", Severity.Error);
        }
    }

    private RenderFragment RenderManageNode(FileFolder folder, int depth) => __builder =>
    {
        var hasChildren = HasChildren(folder.FileFolderID);
        var expanded = _expanded.Contains(folder.FileFolderID) || !string.IsNullOrWhiteSpace(_search);
        var indent = depth * 16;

        <li class="dn-tree-node">
            <div class="dn-tree-row" style="@($"padding-inline-start:{10 + indent}px")">
                @if (hasChildren)
                {
                    <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" Class="pa-0"
                                   OnClick="@(() => ToggleExpand(folder.FileFolderID))" />
                }
                else
                {
                    <span style="width:28px;display:inline-block;"></span>
                }
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Primary" />
                <div style="flex:1; min-width:0;">
                    <MudText Typo="Typo.body2" Class="text-truncate">@folder.Name</MudText>
                    @if (!string.IsNullOrWhiteSpace(folder.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@folder.Description</MudText>
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small"
                               Title="@L["media.add_subfolder", "Add subfolder"]"
                               OnClick="@(() => CreateAsync(folder.FileFolderID))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Title="@L["edit", "Edit"]"
                               OnClick="@(() => EditAsync(folder))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               Title="@L["delete", "Delete"]"
                               OnClick="@(() => DeleteAsync(folder))" />
            </div>
            @if (hasChildren && expanded)
            {
                <ul class="dn-tree-children">
                    @foreach (var child in ChildrenOf(folder.FileFolderID))
                    {
                        @RenderManageNode(child, depth + 1)
                    }
                </ul>
            }
        </li>
    };
}
