@using Microsoft.AspNetCore.Components.Forms
@inject IFileService FileService
@inject IStorageSettingService StorageService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="me-2" />
            @L["upload.title", "Upload files"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_storages.Count == 0)
        {
            <MudAlert Severity="Severity.Warning">
                @L["upload.no_storage", "No active storage for this website. Add one under Storage Backends first."]
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudSelect T="int" @bind-Value="_storageId" Label="@L["storage", "Storage"]" Variant="Variant.Outlined" Disabled="@_busy">
                        @foreach (var s in _storages)
                        {
                            <MudSelectItem T="int" Value="s.WebsiteStorageSettingsID">
                                @MediaFormat.ProviderLabel(s.Provider)
                                @if (s.Quota is { } q)
                                {
                                    <span> — @MediaFormat.Size(q.UsedKB)@(q.TotalKB is long t ? $"/{MediaFormat.Size(t)}" : "") @L["storage.used", "used"]</span>
                                }
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @{ var selected = _storages.FirstOrDefault(s => s.WebsiteStorageSettingsID == _storageId); }
                @if (selected?.Quota is { TotalKB: long } && MediaFormat.UsedPercent(selected.Quota) is double pct)
                {
                    <MudItem xs="12">
                        <MudProgressLinear Color="@(pct >= 90 ? Color.Error : Color.Info)" Value="@pct" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @($"{pct:0}% {L["storage.used", "used"]} · {MediaFormat.Size(selected.Quota!.RemainingKB ?? 0)} {L["upload.remaining", "remaining"]}")
                        </MudText>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="FileFolder" Value="_selectedFolder" ValueChanged="OnFolderChanged"
                                     Label="@L["upload.folder", "Folder (optional — empty = Root)"]" Variant="Variant.Outlined"
                                     SearchFunc="SearchFolders" ToStringFunc="FolderPath"
                                     Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                     Disabled="@_busy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="FileTag" Value="_tagToAdd" ValueChanged="OnTagAdd"
                                     Label="@L["upload.tags", "Tags (optional)"]" Variant="Variant.Outlined"
                                     SearchFunc="SearchTags" ToStringFunc="@(t => t?.Name ?? "")"
                                     ResetValueOnEmptyText="true" CoerceText="false"
                                     Placeholder="@L["media.search_add_tag", "Search and add a tag…"]"
                                     Disabled="@_busy" />
                    @if (_selectedTags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var t in _selectedTags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                         OnClose="@(() => { if (!_busy) RemoveTag(t.FileTagID); })">@t.Name</MudChip>
                            }
                        </div>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" Files="_files" FilesChanged="OnFilesChanged" MaximumFileCount="20" Disabled="@_busy">
                        <CustomContent Context="upload">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.AttachFile"
                                       OnClick="@(() => upload.OpenFilePickerAsync())"
                                       Disabled="@_busy">
                                @L["upload.choose_files", "Choose files"]
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    @if (_files is { Count: > 0 })
                    {
                        <MudStack Spacing="2" Class="mt-3">
                            @foreach (var f in _files)
                            {
                                var ext = Path.GetExtension(f.Name);
                                <MudPaper Outlined="true" Class="pa-3">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div style="min-width:0;">
                                                <MudText Typo="Typo.body2" Class="text-truncate">
                                                    @f.Name
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @MediaFormat.Size((long)Math.Ceiling(f.Size / 1024d))
                                                    @if (!string.IsNullOrEmpty(f.ContentType))
                                                    {
                                                        <span> · @f.ContentType</span>
                                                    }
                                                    @if (IsImageFile(f) && _edits.TryGetValue(f, out var spec) && spec.HasEdits)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-1">@L["upload.edited", "edited"]</MudChip>
                                                    }
                                                </MudText>
                                            </div>
                                            @if (IsImageFile(f) && !_busy)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                                                               Title="@L["upload.edit", "Crop / resize / watermark"]"
                                                               OnClick="@(() => EditFileAsync(f))" />
                                            }
                                        </MudStack>
                                        <MudTextField T="string"
                                                      Value="@GetCustomName(f)"
                                                      ValueChanged="@(v => SetCustomName(f, v))"
                                                      Label="@L["upload.file_name", "File name"]"
                                                      Variant="Variant.Outlined"
                                                      Dense="true"
                                                      Disabled="@_busy"
                                                      Adornment="Adornment.End"
                                                      AdornmentText="@ext"
                                                      Immediate="true" />
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudItem>
            </MudGrid>

            @if (_busy)
            {
                <div class="mt-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @if (_totalFiles > 1)
                            {
                                <span>@L["upload.file_of", "File"] @_currentFileIndex / @_totalFiles · </span>
                            }
                            @_progressStatus
                        </MudText>
                        <MudText Typo="Typo.caption" Class="fw-bold">@_displayPercent.ToString("0")%</MudText>
                    </MudStack>
                    <MudProgressLinear Color="Color.Primary" Value="@_displayPercent" Class="my-1" Style="height:8px;border-radius:4px;" />
                    @if (!string.IsNullOrEmpty(_currentFileName))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@_currentFileName</MudText>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_busy">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="UploadAsync" Disabled="@(_busy || _storages.Count == 0 || _files is null or { Count: 0 })">
            @L["media.upload", "Upload"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public int? PresetFolderId { get; set; }

    private const long MaxUploadBytes = 200L * 1024 * 1024; // 200 MB per file

    private bool _busy;
    private int _storageId;
    private FileFolder? _selectedFolder;
    private FileTag? _tagToAdd;
    private List<FileTag> _selectedTags = new();
    private IReadOnlyList<IBrowserFile>? _files;
    private readonly Dictionary<IBrowserFile, FileEditSpec> _edits = new();
    private readonly Dictionary<IBrowserFile, string> _customNames = new();
    private List<StorageSettingInfo> _storages = new();
    private IReadOnlyList<FileFolder> _folders = Array.Empty<FileFolder>();
    private IReadOnlyList<FileTag> _tags = Array.Empty<FileTag>();

    // Progress (0..100 overall across all selected files)
    private double _displayPercent;
    private int _currentFileIndex;
    private int _totalFiles;
    private string _currentFileName = "";
    private string _progressStatus = "";
    private double _fileReadFraction; // 0..1 within current file read

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _storages = (await StorageService.GetActiveForWebsiteAsync(WebsiteId)).ToList();
        if (_storages.Count > 0) _storageId = _storages[0].WebsiteStorageSettingsID;
        _folders = await FileService.GetFoldersAsync(WebsiteId);
        _tags = await FileService.GetTagsAsync(WebsiteId);
        if (PresetFolderId is int presetId)
            _selectedFolder = _folders.FirstOrDefault(f => f.FileFolderID == presetId);
    }

    private void OnFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        _files = files;
        // Drop names/edits for files no longer selected; seed names for new ones.
        if (files is null)
        {
            _customNames.Clear();
            _edits.Clear();
            return;
        }

        var keep = files.ToHashSet();
        foreach (var key in _customNames.Keys.Where(k => !keep.Contains(k)).ToList())
            _customNames.Remove(key);
        foreach (var key in _edits.Keys.Where(k => !keep.Contains(k)).ToList())
            _edits.Remove(key);

        foreach (var f in files)
        {
            if (!_customNames.ContainsKey(f))
                _customNames[f] = Path.GetFileNameWithoutExtension(f.Name);
        }
    }

    private string GetCustomName(IBrowserFile file) =>
        _customNames.TryGetValue(file, out var n) ? n : Path.GetFileNameWithoutExtension(file.Name);

    private void SetCustomName(IBrowserFile file, string? value) =>
        _customNames[file] = value ?? "";

    private Task<IEnumerable<FileFolder>> SearchFolders(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_folders.AsEnumerable());
        return Task.FromResult(_folders.Where(f =>
            f.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || FolderPath(f).Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private string FolderPath(FileFolder? folder)
    {
        if (folder is null) return "";
        var byId = _folders.ToDictionary(f => f.FileFolderID);
        var parts = new List<string> { folder.Name };
        var current = folder;
        var guard = 0;
        while (current.ParentFolderID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private Task<IEnumerable<FileTag>> SearchTags(string value, CancellationToken ct)
    {
        var available = _tags.Where(t => _selectedTags.All(s => s.FileTagID != t.FileTagID));
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(available);
        return Task.FromResult(available.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnFolderChanged(FileFolder? folder) => _selectedFolder = folder;

    private void OnTagAdd(FileTag? tag)
    {
        if (tag is not null && _selectedTags.All(t => t.FileTagID != tag.FileTagID))
            _selectedTags.Add(tag);
        _tagToAdd = null;
    }

    private void RemoveTag(int tagId) => _selectedTags.RemoveAll(t => t.FileTagID == tagId);

    /// <summary>Image edit (crop / resize / grayscale / watermark) only applies to images.</summary>
    private static bool IsImageFile(IBrowserFile file) =>
        !string.IsNullOrEmpty(file.ContentType)
        && file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private async Task EditFileAsync(IBrowserFile file)
    {
        if (!IsImageFile(file)) return;

        var existing = _edits.GetValueOrDefault(file) ?? new FileEditSpec();
        existing.FileName = GetCustomName(file);

        var parameters = new DialogParameters<MediaEditDialog>
        {
            { x => x.File, file },
            { x => x.Existing, existing },
        };
        var dialog = await DialogService.ShowAsync<MediaEditDialog>(L["upload.edit_title", "Edit before upload"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileEditSpec spec })
        {
            // Keep the name from the main form; image options come from the dialog.
            spec.FileName = GetCustomName(file);
            _edits[file] = spec;
        }
    }

    /// <summary>Build stored display name: custom base + original extension when the user omitted it.</summary>
    private static string? ResolveCustomFileName(string? customBase, string originalName)
    {
        if (string.IsNullOrWhiteSpace(customBase)) return null;
        var name = customBase.Trim();
        if (name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
            name = string.Concat(name.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c));

        if (Path.HasExtension(name))
            return name;

        var ext = Path.GetExtension(originalName);
        return string.IsNullOrEmpty(ext) ? name : name + ext;
    }

    private async Task UploadAsync()
    {
        if (_files is null || _files.Count == 0) return;
        _busy = true;
        _totalFiles = _files.Count;
        _displayPercent = 0;
        int ok = 0;
        try
        {
            var tagIds = _selectedTags.Select(t => t.FileTagID).ToList();
            var index = 0;
            foreach (var file in _files)
            {
                index++;
                _currentFileIndex = index;
                _currentFileName = file.Name;
                _fileReadFraction = 0;
                _progressStatus = L["upload.sending", "Uploading…"];
                RefreshOverallProgress();
                await InvokeAsync(StateHasChanged);

                try
                {
                    var spec = _edits.GetValueOrDefault(file);
                    var customName = ResolveCustomFileName(GetCustomName(file), file.Name);

                    await using var browserStream = file.OpenReadStream(MaxUploadBytes);
                    await using var progressStream = new ProgressStream(
                        browserStream,
                        file.Size,
                        fraction =>
                        {
                            _fileReadFraction = fraction;
                            // Reading from the browser is the long phase for large files (~0–90% of this file).
                            RefreshOverallProgress(filePhase: 0.9 * fraction);
                            _ = InvokeAsync(StateHasChanged);
                        });

                    var uploadTask = FileService.UploadAsync(new FileUploadRequest
                    {
                        WebsiteID = WebsiteId,
                        StorageSettingID = _storageId,
                        Content = progressStream,
                        OriginalFileName = file.Name,
                        MimeType = file.ContentType,
                        FolderID = _selectedFolder?.FileFolderID,
                        TagIDs = tagIds,
                        CustomFileName = customName,
                        Crop = spec?.Crop,
                        ResizeWidth = spec?.ResizeWidth,
                        ResizeHeight = spec?.ResizeHeight,
                        Grayscale = spec?.Grayscale ?? false,
                        ApplyWatermark = spec?.ApplyWatermark,
                    });

                    // After the stream is fully read, server still processes + stores — show remaining phase.
                    var monitor = MonitorPostReadAsync(uploadTask);
                    await uploadTask;
                    await monitor;

                    ok++;
                    _fileReadFraction = 1;
                    RefreshOverallProgress(filePhase: 1);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"{file.Name}: {ex.Message}", Severity.Error);
                    // Count failed file as complete for overall bar so it keeps moving.
                    RefreshOverallProgress(filePhase: 1);
                    await InvokeAsync(StateHasChanged);
                }
            }
            if (ok > 0) Snackbar.Add($"{L["upload.uploaded", "Uploaded"]} {ok} {L["upload.files_suffix", "file(s)."]}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(ok));
        }
        finally
        {
            _busy = false;
            _progressStatus = "";
            _currentFileName = "";
        }
    }

    /// <summary>
    /// While UploadAsync continues after the browser stream is drained (image process + CDN write),
    /// nudge the bar through the remaining 10% of the current file slot.
    /// </summary>
    private async Task MonitorPostReadAsync(Task uploadTask)
    {
        // Wait until read looks finished (or upload already done).
        while (!uploadTask.IsCompleted && _fileReadFraction < 0.999)
            await Task.Delay(100);

        if (uploadTask.IsCompleted) return;

        _progressStatus = L["upload.processing", "Processing & storing…"];
        var step = 0.90;
        while (!uploadTask.IsCompleted && step < 0.99)
        {
            step = Math.Min(0.99, step + 0.01);
            RefreshOverallProgress(filePhase: step);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(400);
        }
    }

    /// <param name="filePhase">0..1 completion of the current file (default from read fraction mapped to 0–0.9).</param>
    private void RefreshOverallProgress(double? filePhase = null)
    {
        if (_totalFiles <= 0)
        {
            _displayPercent = 0;
            return;
        }

        var phase = filePhase ?? (0.9 * _fileReadFraction);
        phase = Math.Clamp(phase, 0d, 1d);
        var overall = ((_currentFileIndex - 1) + phase) / _totalFiles;
        _displayPercent = Math.Clamp(overall * 100d, 0d, 100d);
    }

    private void Cancel()
    {
        if (_busy) return;
        MudDialog.Cancel();
    }
}
