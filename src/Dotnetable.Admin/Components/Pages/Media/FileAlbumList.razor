@page "/media/albums"
@attribute [Authorize(Policy = RoleKeys.MediaView)]
@inject IFileService FileService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["media.albums", "Albums"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["media.albums", "Albums"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["media.albums_subtitle", "Organize media library files into albums"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/media"
                   StartIcon="@Icons.Material.Filled.PhotoLibrary">@L["media_library", "Media Library"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateAsync">@L["media.new_album", "New album"]</MudButton>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged"
                SearchPlaceholder="@L["search", "Search…"]" AllText="@L["all", "All"]">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="4" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["media.albums_empty", "No albums yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var a in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Title="@L["edit", "Edit"]"
                                           OnClick="@(() => EditAsync(a))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Title="@L["delete", "Delete"]"
                                           OnClick="@(() => DeleteAsync(a))" />
                        </MudStack>
                    </td>
                    <td>@a.Name</td>
                    <td>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-truncate" Style="max-width:320px;">
                            @(a.Description ?? "—")
                        </MudText>
                    </td>
                    <td>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@a.CreateDate.ToLocalTime().ToString("g")</MudText>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private List<FileAlbum> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(FileAlbum.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["description", "Description"], ColumnName = nameof(FileAlbum.Description), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["created", "Created"], ColumnName = nameof(FileAlbum.CreateDate), HasSort = true },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await FileService.GetAlbumsPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(null)) await LoadAsync();
    }

    private async Task EditAsync(FileAlbum album)
    {
        if (await ShowDialogAsync(album)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(FileAlbum? album)
    {
        var parameters = new DialogParameters
        {
            [nameof(FileAlbumDialog.WebsiteId)] = _websiteId,
            [nameof(FileAlbumDialog.Album)] = album,
        };
        var dialog = await DialogService.ShowAsync<FileAlbumDialog>(
            album is null ? L["media.new_album", "New album"] : L["media.edit_album", "Edit album"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private async Task DeleteAsync(FileAlbum album)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            L["media.delete_album_q", "Delete album?"],
            $"\"{album.Name}\" {L["media.delete_album_body", "will be removed. Files inside stay in the library."]}",
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (ok != true) return;

        await FileService.DeleteAlbumAsync(album.FileAlbumID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
