@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["media.file_details", "File details"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_file is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="5">
                    <div class="app-media-preview rounded-lg" style="aspect-ratio:1; display:flex; align-items:center; justify-content:center; overflow:hidden; background:var(--mud-palette-background-grey);">
                        @if (_file.FileCategory == (byte)FileCategory.Image && !string.IsNullOrEmpty(_file.CNDUrl))
                        {
                            <img src="@(_file.ThumbnailCDN ?? _file.CNDUrl)" alt="@_file.AltText"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <MudIcon Icon="@MediaFormat.CategoryIcon(_file.FileCategory)" Size="Size.Large" Color="Color.Secondary" />
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                        @_file.OriginalFileName · @MediaFormat.Size(_file.FileSizeKB) · @_file.MimeType
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_alt" Label="@L["media.alt_text", "Alt text"]" Variant="Variant.Outlined" Class="mb-3" />
                    <MudAutocomplete T="FileAlbum" Value="_selectedAlbum" ValueChanged="OnAlbumChanged"
                                     Label="@L["media.album", "Album"]" Variant="Variant.Outlined" Class="mb-3"
                                     SearchFunc="SearchAlbums" ToStringFunc="@(a => a?.Name ?? "")"
                                     Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" />
                    <MudAutocomplete T="FileTag" Value="_tagToAdd" ValueChanged="OnTagAdd"
                                     Label="@L["media.tags", "Tags"]" Variant="Variant.Outlined"
                                     SearchFunc="SearchTags" ToStringFunc="@(t => t?.Name ?? "")"
                                     ResetValueOnEmptyText="true" CoerceText="false"
                                     Placeholder="@L["media.search_add_tag", "Search and add a tag…"]" />
                    @if (_selectedTags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var t in _selectedTags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                         OnClose="@(() => RemoveTag(t.FileTagID))">@t.Name</MudChip>
                            }
                        </div>
                    }

                    @{
                        var detailUrl = MediaFormat.PublicUrl(_file);
                    }
                    @if (!string.IsNullOrEmpty(detailUrl))
                    {
                        <MudTextField Value="@detailUrl" Label="@L["media.cdn_url", "CDN URL"]" Variant="Variant.Outlined" ReadOnly="true"
                                      Class="mt-3" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                      OnAdornmentClick="CopyUrlAsync" />
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">@L["delete", "Delete"]</MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@_busy">@L["save_short", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int FileId { get; set; }
    [Parameter] public int WebsiteId { get; set; }

    private FileRecord? _file;
    private bool _busy;
    private string? _title;
    private string? _alt;
    private FileAlbum? _selectedAlbum;
    private FileTag? _tagToAdd;
    private List<FileTag> _selectedTags = new();
    private IReadOnlyList<FileAlbum> _albums = Array.Empty<FileAlbum>();
    private IReadOnlyList<FileTag> _tags = Array.Empty<FileTag>();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _albums = await FileService.GetAlbumsAsync(WebsiteId);
        _tags = await FileService.GetTagsAsync(WebsiteId);
        _file = await FileService.GetByIdAsync(FileId);
        if (_file is not null)
        {
            _title = _file.Title;
            _alt = _file.AltText;
            _selectedAlbum = _file.FileAlbumID is int albumId
                ? _albums.FirstOrDefault(a => a.FileAlbumID == albumId)
                : null;
            var selectedIds = _file.FileRecordTags.Select(t => t.FileTagID).ToHashSet();
            _selectedTags = _tags.Where(t => selectedIds.Contains(t.FileTagID)).ToList();
        }
    }

    private Task<IEnumerable<FileAlbum>> SearchAlbums(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_albums.AsEnumerable());
        return Task.FromResult(_albums.Where(a => a.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<FileTag>> SearchTags(string value, CancellationToken ct)
    {
        var available = _tags.Where(t => _selectedTags.All(s => s.FileTagID != t.FileTagID));
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(available);
        return Task.FromResult(available.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnAlbumChanged(FileAlbum? album) => _selectedAlbum = album;

    private void OnTagAdd(FileTag? tag)
    {
        if (tag is not null && _selectedTags.All(t => t.FileTagID != tag.FileTagID))
            _selectedTags.Add(tag);
        _tagToAdd = null;
    }

    private void RemoveTag(int tagId) => _selectedTags.RemoveAll(t => t.FileTagID == tagId);

    private async Task SaveAsync()
    {
        if (_file is null) return;
        _busy = true;
        try
        {
            await FileService.UpdateMetadataAsync(
                _file.FileRecordID, _title, _alt,
                _selectedAlbum?.FileAlbumID,
                _selectedTags.Select(t => t.FileTagID).ToList());
            Snackbar.Add(L["saved_short", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_file is null) return;
        await FileService.SoftDeleteAsync(_file.FileRecordID);
        Snackbar.Add(L["media.file_removed", "File removed."], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task CopyUrlAsync()
    {
        var url = _file is null ? null : MediaFormat.PublicUrl(_file);
        if (string.IsNullOrWhiteSpace(url))
        {
            Snackbar.Add(L["content.insert_media.no_url", "This file has no public URL yet. Check storage settings."], Severity.Warning);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Snackbar.Add(L["media.url_copied", "URL copied."], Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["media.url_copy_failed", "Could not copy to clipboard."], Severity.Warning);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
