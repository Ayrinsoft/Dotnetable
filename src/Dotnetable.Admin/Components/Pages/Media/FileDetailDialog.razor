@using Microsoft.AspNetCore.Components.Forms
@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["media.file_details", "File details"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_file is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="5">
                    @{
                        var previewUrl = MediaFormat.PublicUrl(_file);
                        var canOpen = !string.IsNullOrEmpty(previewUrl);
                        var isImage = _file.FileCategory == (byte)FileCategory.Image;
                        var isVideo = _file.FileCategory == (byte)FileCategory.Video;
                    }
                    <div class="app-media-preview rounded-lg"
                         role="@(canOpen ? "button" : null)"
                         title="@(canOpen ? L["media.click_to_view", "Click to view"] : null)"
                         @onclick="OpenFileAsync"
                         style="aspect-ratio:1; display:flex; align-items:center; justify-content:center; overflow:hidden; background:var(--mud-palette-background-grey); position:relative; @(canOpen ? "cursor:pointer;" : null)">
                        @if (isImage && !string.IsNullOrEmpty(previewUrl))
                        {
                            <img src="@CacheBusted(_file.ThumbnailCDN ?? previewUrl)" alt="@_file.AltText"
                                 style="width:100%; height:100%; object-fit:contain;" />
                        }
                        else if (isVideo && !string.IsNullOrEmpty(previewUrl))
                        {
                            <video src="@CacheBusted(previewUrl)" muted preload="metadata"
                                   style="width:100%; height:100%; object-fit:contain; pointer-events:none;"></video>
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircleFilled" Color="Color.Primary"
                                     Style="position:absolute; font-size:3rem; opacity:.9; pointer-events:none;" />
                        }
                        else
                        {
                            <MudIcon Icon="@MediaFormat.CategoryIcon(_file.FileCategory)" Size="Size.Large" Color="Color.Secondary" />
                        }
                        @if (canOpen)
                        {
                            <MudIcon Icon="@(isImage || isVideo ? Icons.Material.Filled.ZoomIn : Icons.Material.Filled.Download)"
                                     Color="Color.Default"
                                     Style="position:absolute; bottom:8px; right:8px; opacity:.75; background:var(--mud-palette-surface); border-radius:50%; padding:4px;" />
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                        @_file.OriginalFileName · @MediaFormat.Size(_file.FileSizeKB) · @_file.MimeType
                    </MudText>
                    @if (canOpen)
                    {
                        <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="DownloadAsync"
                                       Disabled="@_downloading">
                                @(_downloading ? L["media.downloading", "Downloading…"] : L["download", "Download"])
                            </MudButton>
                            @if (isImage || isVideo)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.ZoomIn"
                                           OnClick="OpenFileAsync">
                                    @L["media.preview", "Preview"]
                                </MudButton>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            @(isImage || isVideo
                                ? L["media.click_preview_full", "Click preview to view full size"]
                                : L["media.click_to_download", "Click preview or Download to save the file"])
                        </MudText>
                    }
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnReplaceFileSelected" Class="mt-2" Disabled="@(_busy || _replacing)">
                        <CustomContent Context="upload">
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.FindReplace"
                                       OnClick="@(() => upload.OpenFilePickerAsync())"
                                       Disabled="@(_busy || _replacing)">
                                @(_replacing ? L["media.replacing", "Replacing…"] : L["media.replace_file", "Replace file"])
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                        @L["media.replace_file_hint", "Uploads new content under the same ID and URL — nothing that already links to this file breaks."]
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_fileName" Label="@L["media.file_name", "File name"]" Variant="Variant.Outlined" Class="mb-3"
                                  HelperText="@L["media.file_name_hint", "Display/download name only — spaces and unsafe characters are cleaned up automatically."]" />
                    <MudTextField @bind-Value="_alt" Label="@L["media.alt_text", "Alt text"]" Variant="Variant.Outlined" Class="mb-3" />
                    <MudAutocomplete T="FileFolder" Value="_selectedFolder" ValueChanged="OnFolderChanged"
                                     Label="@L["media.folder", "Folder"]" Variant="Variant.Outlined" Class="mb-3"
                                     SearchFunc="SearchFolders" ToStringFunc="FolderPath"
                                     Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                     HelperText="@L["media.folder_root_hint", "Empty means Root"]" />
                    <MudAutocomplete T="FileTag" Value="_tagToAdd" ValueChanged="OnTagAdd"
                                     Label="@L["media.tags", "Tags"]" Variant="Variant.Outlined"
                                     SearchFunc="SearchTags" ToStringFunc="@(t => t?.Name ?? "")"
                                     ResetValueOnEmptyText="true" CoerceText="false"
                                     Placeholder="@L["media.search_add_tag", "Search and add a tag…"]" />
                    @if (_selectedTags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var t in _selectedTags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                         OnClose="@(() => RemoveTag(t.FileTagID))">@t.Name</MudChip>
                            }
                        </div>
                    }

                    @{
                        var detailUrl = MediaFormat.PublicUrl(_file);
                    }
                    @if (!string.IsNullOrEmpty(detailUrl))
                    {
                        <MudTextField Value="@detailUrl" Label="@L["media.cdn_url", "CDN URL"]" Variant="Variant.Outlined" ReadOnly="true"
                                      Class="mt-3" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                      OnAdornmentClick="CopyUrlAsync" />
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">@L["delete", "Delete"]</MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@_busy">@L["save_short", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int FileId { get; set; }
    [Parameter] public int WebsiteId { get; set; }

    private const long MaxReplaceBytes = 200L * 1024 * 1024; // 200 MB, same cap as a fresh upload

    private FileRecord? _file;
    private bool _busy;
    private bool _downloading;
    private bool _replacing;
    private string? _title;
    private string? _alt;
    private string? _fileName;
    private FileFolder? _selectedFolder;
    private FileTag? _tagToAdd;
    private List<FileTag> _selectedTags = new();
    private IReadOnlyList<FileFolder> _folders = Array.Empty<FileFolder>();
    private IReadOnlyList<FileTag> _tags = Array.Empty<FileTag>();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _folders = await FileService.GetFoldersAsync(WebsiteId);
        _tags = await FileService.GetTagsAsync(WebsiteId);
        _file = await FileService.GetByIdAsync(FileId);
        if (_file is not null)
        {
            _title = _file.Title;
            _alt = _file.AltText;
            _fileName = _file.OriginalFileName;
            _selectedFolder = _file.FileFolderID is int folderId
                ? _folders.FirstOrDefault(f => f.FileFolderID == folderId)
                : null;
            var selectedIds = _file.FileRecordTags.Select(t => t.FileTagID).ToHashSet();
            _selectedTags = _tags.Where(t => selectedIds.Contains(t.FileTagID)).ToList();
        }
    }

    private Task<IEnumerable<FileFolder>> SearchFolders(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_folders.AsEnumerable());
        return Task.FromResult(_folders.Where(f =>
            f.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || FolderPath(f).Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private string FolderPath(FileFolder? folder)
    {
        if (folder is null) return "";
        var byId = _folders.ToDictionary(f => f.FileFolderID);
        var parts = new List<string> { folder.Name };
        var current = folder;
        var guard = 0;
        while (current.ParentFolderID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private Task<IEnumerable<FileTag>> SearchTags(string value, CancellationToken ct)
    {
        var available = _tags.Where(t => _selectedTags.All(s => s.FileTagID != t.FileTagID));
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(available);
        return Task.FromResult(available.Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnFolderChanged(FileFolder? folder) => _selectedFolder = folder;

    private void OnTagAdd(FileTag? tag)
    {
        if (tag is not null && _selectedTags.All(t => t.FileTagID != tag.FileTagID))
            _selectedTags.Add(tag);
        _tagToAdd = null;
    }

    private void RemoveTag(int tagId) => _selectedTags.RemoveAll(t => t.FileTagID == tagId);

    private async Task SaveAsync()
    {
        if (_file is null) return;
        _busy = true;
        try
        {
            await FileService.UpdateMetadataAsync(
                _file.FileRecordID, _title, _alt, _fileName,
                _selectedFolder?.FileFolderID,
                _selectedTags.Select(t => t.FileTagID).ToList());
            Snackbar.Add(L["saved_short", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Replaces this file's content in place (same ID, same URL) — a confirmation gate first since
    /// it's irreversible and, unlike a normal upload, overwrites the object other pages/records are
    /// already relying on.
    /// </summary>
    private async Task OnReplaceFileSelected(IBrowserFile? file)
    {
        if (file is null || _file is null || _busy || _replacing) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["media.replace_file", "Replace file"],
            L["media.replace_confirm", "This replaces the current file's content everywhere it's used (same ID and URL). Continue?"],
            yesText: L["media.replace_file", "Replace file"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        _replacing = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxReplaceBytes);
            _file = await FileService.ReplaceContentAsync(
                _file.FileRecordID, stream, file.Name, file.ContentType);
            _fileName = _file.OriginalFileName;
            Snackbar.Add(L["media.replaced", "File replaced."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["media.replace_failed", "Could not replace the file"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _replacing = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_file is null || _busy) return;

        FileUsageSummary usage;
        try
        {
            usage = await FileService.GetUsageAsync(_file.FileRecordID);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["media.delete_failed", "Could not delete file"]}: {ex.Message}", Severity.Error);
            return;
        }

        var message = (MarkupString)BuildDeleteConfirmMessage(usage);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["media.delete_title", "Delete file"],
            message,
            yesText: L["delete", "Delete"],
            cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        _busy = true;
        try
        {
            await FileService.SoftDeleteAsync(_file.FileRecordID);
            Snackbar.Add(L["media.file_removed", "File removed."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["media.delete_failed", "Could not delete file"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildDeleteConfirmMessage(FileUsageSummary usage)
    {
        static string Esc(string s) => s
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\"", "&quot;");

        var parts = new List<string>
        {
            $"<p>{Esc(L["media.delete_confirm", "Delete this file permanently from the library and storage?"])}</p>",
        };

        if (!usage.HasAny)
            return string.Concat(parts);

        var required = usage.Items.Where(i => i.IsRequired).ToList();
        var optional = usage.Items.Where(i => !i.IsRequired).ToList();

        if (required.Count > 0)
        {
            parts.Add($"<p><strong>{Esc(L["media.delete_required_warning",
                "This file is the primary image for the following. Those records will be removed:"])}</strong></p><ul>");
            foreach (var item in required)
            {
                var line = $"{Esc(item.Label)} ({item.Count})";
                if (!string.IsNullOrWhiteSpace(item.Detail))
                    line += $" — {Esc(item.Detail)}";
                parts.Add($"<li>{line}</li>");
            }
            parts.Add("</ul>");
        }

        if (optional.Count > 0)
        {
            parts.Add($"<p>{Esc(L["media.delete_optional_note",
                "These places will keep their records, but the file link will be cleared:"])}</p><ul>");
            foreach (var item in optional)
                parts.Add($"<li>{Esc(item.Label)} ({item.Count})</li>");
            parts.Add("</ul>");
        }

        return string.Concat(parts);
    }

    private async Task CopyUrlAsync()
    {
        var url = _file is null ? null : MediaFormat.PublicUrl(_file);
        if (string.IsNullOrWhiteSpace(url))
        {
            Snackbar.Add(L["content.insert_media.no_url", "This file has no public URL yet. Check storage settings."], Severity.Warning);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Snackbar.Add(L["media.url_copied", "URL copied."], Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["media.url_copy_failed", "Could not copy to clipboard."], Severity.Warning);
        }
    }

    /// <summary>
    /// Image/video: full-size preview dialog. Other files: trigger a file download (no new tab).
    /// </summary>
    private async Task OpenFileAsync()
    {
        if (_file is null) return;
        var url = MediaFormat.PublicUrl(_file);
        if (string.IsNullOrWhiteSpace(url))
        {
            Snackbar.Add(L["content.insert_media.no_url", "This file has no public URL yet. Check storage settings."], Severity.Warning);
            return;
        }

        var category = (FileCategory)_file.FileCategory;
        if (category is FileCategory.Image or FileCategory.Video)
        {
            var parameters = new DialogParameters<MediaPreviewDialog>
            {
                { x => x.Url, url },
                { x => x.Title, _file.Title ?? _file.OriginalFileName },
                { x => x.IsVideo, category == FileCategory.Video },
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true,
            };
            await DialogService.ShowAsync<MediaPreviewDialog>(
                L["media.preview", "Preview"], parameters, options);
            return;
        }

        await DownloadAsync();
    }

    /// <summary>
    /// Downloads via the Admin same-origin proxy (/media/download/{id}) so the browser receives
    /// Content-Disposition: attachment without CDN CORS or a new tab.
    /// </summary>
    private async Task DownloadAsync()
    {
        if (_file is null || _downloading) return;

        var publicUrl = MediaFormat.PublicUrl(_file);
        if (string.IsNullOrWhiteSpace(publicUrl))
        {
            Snackbar.Add(L["content.insert_media.no_url", "This file has no public URL yet. Check storage settings."], Severity.Warning);
            return;
        }

        _downloading = true;
        try
        {
            var fileName = string.IsNullOrWhiteSpace(_file.OriginalFileName) ? "download" : _file.OriginalFileName;
            // Same-origin authenticated endpoint — works for image, video, PDF, etc.
            var downloadUrl = Nav.ToAbsoluteUri($"/media/download/{_file.FileRecordID}").ToString();

            // Prefer named helper; fall back if the browser still has a cached theme.js.
            try
            {
                await JS.InvokeVoidAsync("dotnetableFile.downloadUrl", downloadUrl, fileName);
            }
            catch
            {
                await JS.InvokeVoidAsync("eval", BuildDownloadClickScript(downloadUrl, fileName));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["media.download_failed", "Could not download the file."]} {ex.Message}", Severity.Warning);
        }
        finally
        {
            _downloading = false;
        }
    }

    private static string BuildDownloadClickScript(string url, string fileName)
    {
        static string Esc(string s) => s.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\r", "").Replace("\n", "");
        return $"(function(){{var a=document.createElement('a');a.href='{Esc(url)}';a.download='{Esc(fileName)}';document.body.appendChild(a);a.click();a.remove();}})()";
    }

    /// <summary>
    /// Appends the file's last-modified timestamp as a query string so the browser (and any CDN
    /// that keys its cache off the full URL) fetches fresh bytes after a "Replace file" — replace
    /// deliberately reuses the exact same URL, so without this the preview would keep showing the
    /// old cached image right after a successful replace.
    /// </summary>
    private string? CacheBusted(string? url)
    {
        if (string.IsNullOrEmpty(url) || _file is null) return url;
        var separator = url.Contains('?') ? '&' : '?';
        return $"{url}{separator}v={_file.UploadDate.Ticks}";
    }

    private void Cancel() => MudDialog.Cancel();
}
