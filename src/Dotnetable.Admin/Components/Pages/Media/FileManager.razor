@page "/media"
@attribute [Authorize(Policy = RoleKeys.MediaView)]
@inject IFileService FileService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["media_library", "Media Library"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["media_library", "Media Library"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["media.subtitle", "Browse, organize and upload files"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Cloud" Href="/media/storage">@L["storage", "Storage"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="OpenUploadAsync">@L["media.upload", "Upload"]</MudButton>
    </MudStack>
</MudStack>

<MudGrid Spacing="3">
    @* ── Left rail ─────────────────────────────────────── *@
    <MudItem xs="12" md="3">
        <MudPaper Elevation="0" Class="app-card rounded-lg pa-3">
            <MudButton Variant="@(!HasAlbumOrTagFilter ? Variant.Filled : Variant.Text)"
                       Color="@(!HasAlbumOrTagFilter ? Color.Primary : Color.Default)"
                       StartIcon="@Icons.Material.Filled.PhotoLibrary"
                       FullWidth="true" Class="justify-start"
                       OnClick="ClearAlbumAndTagFilters">@L["media.all_files", "All files"]</MudButton>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3 mb-1">
                <MudText Typo="Typo.caption" Class="fw-bold text-uppercase">@L["media.albums", "Albums"]</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="/media/albums"
                               Class="pa-0" />
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mb-1"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="OpenAlbumFilterAsync">
                @L["media.filter_by_album", "Filter by album"]
                @if (_albumIds.Count > 0)
                {
                    <span>&nbsp;(@_albumIds.Count)</span>
                }
            </MudButton>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                <MudTextField @bind-Value="_newAlbum" Placeholder="@L["media.new_album", "New album"]" Variant="Variant.Text"
                              Margin="Margin.Dense" Immediate="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddAlbumAsync" />
            </MudStack>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.caption" Class="fw-bold text-uppercase">@L["media.category", "Category"]</MudText>
            <MudSelect T="FileCategory?" Value="_filter.Category" ValueChanged="OnCategoryChanged"
                       Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1">
                <MudSelectItem T="FileCategory?" Value="FileCategory.Image">@L["media.cat_images", "Images"]</MudSelectItem>
                <MudSelectItem T="FileCategory?" Value="FileCategory.Document">@L["media.cat_documents", "Documents"]</MudSelectItem>
                <MudSelectItem T="FileCategory?" Value="FileCategory.Video">@L["media.cat_video", "Video"]</MudSelectItem>
                <MudSelectItem T="FileCategory?" Value="FileCategory.Audio">@L["media.cat_audio", "Audio"]</MudSelectItem>
                <MudSelectItem T="FileCategory?" Value="FileCategory.Other">@L["media.cat_other", "Other"]</MudSelectItem>
            </MudSelect>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3 mb-1">
                <MudText Typo="Typo.caption" Class="fw-bold text-uppercase">@L["media.tags", "Tags"]</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="/media/tags"
                               Class="pa-0" />
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mb-1"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="OpenTagFilterAsync">
                @L["media.filter_by_tag", "Filter by tag"]
                @if (_tagIds.Count > 0)
                {
                    <span>&nbsp;(@_tagIds.Count)</span>
                }
            </MudButton>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                <MudTextField @bind-Value="_newTag" Placeholder="@L["media.new_tag", "New tag"]" Variant="Variant.Text"
                              Margin="Margin.Dense" Immediate="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                               OnClick="AddTagAsync" />
            </MudStack>
        </MudPaper>
    </MudItem>

    @* ── Gallery ──────────────────────────────────────── *@
    <MudItem xs="12" md="9">
        <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
                <MudButton Variant="@(_albumIds.Count > 0 ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Collections"
                           OnClick="OpenAlbumFilterAsync">
                    @L["media.albums", "Albums"]
                    @if (_albumIds.Count > 0)
                    {
                        <span>&nbsp;(@_albumIds.Count)</span>
                    }
                </MudButton>
                <MudButton Variant="@(_tagIds.Count > 0 ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sell"
                           OnClick="OpenTagFilterAsync">
                    @L["media.tags", "Tags"]
                    @if (_tagIds.Count > 0)
                    {
                        <span>&nbsp;(@_tagIds.Count)</span>
                    }
                </MudButton>
                <MudTextField @bind-Value="_search" Placeholder="@L["media.search", "Search files…"]" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="false" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" OnClearButtonClick="OnSearchCleared"
                              OnKeyUp="OnSearchKey" Style="flex:1; min-width:180px;" />
            </MudStack>

            @if (HasActiveFilters)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3 flex-wrap">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="me-1">
                        @L["media.active_filters", "Active filters"]:
                    </MudText>
                    @foreach (var album in SelectedAlbums)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                 OnClose="@(() => RemoveAlbumFilter(album.FileAlbumID))">
                            @L["media.album", "Album"]: @album.Name
                        </MudChip>
                    }
                    @foreach (var tag in SelectedTags)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                 OnClose="@(() => RemoveTagFilter(tag.FileTagID))">
                            @L["media.tag", "Tag"]: @tag.Name
                        </MudChip>
                    }
                    @if (_filter.Category is FileCategory cat)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                 OnClose="ClearCategoryFilter">
                            @L["media.category", "Category"]: @CategoryLabel(cat)
                        </MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(_filter.Search))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled"
                                 OnClose="ClearSearchFilter">
                            @L["search", "Search"]: @_filter.Search
                        </MudChip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="ClearAllFilters">@L["media.clear_filters", "Clear filters"]</MudButton>
                </MudStack>
            }

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            }

            @if (_items.Count == 0 && !_loading)
            {
                <div style="text-align:center; padding:48px;">
                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary" Class="mt-2">
                        @(HasActiveFilters
                            ? L["media.empty_filtered", "No files match the current filters."]
                            : L["media.empty", "No files found."])
                    </MudText>
                    @if (HasActiveFilters)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                                   OnClick="ClearAllFilters">@L["media.clear_filters", "Clear filters"]</MudButton>
                    }
                </div>
            }
            else
            {
                <div class="app-media-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:12px;">
                    @foreach (var f in _items)
                    {
                        var publicUrl = MediaFormat.PublicUrl(f);
                        <MudPaper Elevation="0" Class="border rounded-lg" Style="overflow:hidden; cursor:pointer;"
                                  @onclick="@(() => OpenDetailAsync(f.FileRecordID))">
                            <div style="aspect-ratio:1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); overflow:hidden;">
                                @if (f.FileCategory == (byte)FileCategory.Image && !string.IsNullOrEmpty(publicUrl))
                                {
                                    <img src="@(f.ThumbnailCDN ?? publicUrl)" alt="@f.AltText"
                                         loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@MediaFormat.CategoryIcon(f.FileCategory)" Size="Size.Large" Color="Color.Secondary" />
                                }
                            </div>
                            <div class="pa-2">
                                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="1">
                                    <div style="flex:1; min-width:0;">
                                        <MudText Typo="Typo.caption" Class="d-block text-truncate" title="@f.OriginalFileName">
                                            @(string.IsNullOrWhiteSpace(f.Title) ? f.OriginalFileName : f.Title)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@MediaFormat.Size(f.FileSizeKB)</MudText>
                                    </div>
                                    @if (!string.IsNullOrEmpty(publicUrl))
                                    {
                                        <span @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                            <MudTooltip Text="@($"{L["media.copy_url", "Copy link"]}: {publicUrl}")">
                                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                               Size="Size.Small"
                                                               Color="Color.Primary"
                                                               Class="pa-0 mt-n1"
                                                               Style="width:26px; height:26px; min-width:26px;"
                                                               OnClick="@(() => CopyUrlAsync(publicUrl))" />
                                            </MudTooltip>
                                        </span>
                                    }
                                </MudStack>
                            </div>
                        </MudPaper>
                    }
                </div>

                @if (_total > _pageSize)
                {
                    <div class="d-flex justify-center mt-4">
                        <MudPagination Count="@((_total + _pageSize - 1) / _pageSize)" Selected="_pageIndex"
                                       SelectedChanged="OnPageChanged" Color="Color.Primary" />
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _isMaster;
    private int _websiteId;
    private bool _loading = true;

    private List<Website> _websites = new();
    private List<FileRecord> _items = new();
    private IReadOnlyList<FileAlbum> _albums = Array.Empty<FileAlbum>();
    private IReadOnlyList<FileTag> _tags = Array.Empty<FileTag>();

    private readonly FileFilter _filter = new();
    private readonly List<int> _albumIds = new();
    private readonly List<int> _tagIds = new();
    private string? _search;
    private string? _newAlbum;
    private string? _newTag;
    private int _pageIndex = 1;
    private const int _pageSize = 24;
    private int _total;

    private bool HasAlbumOrTagFilter => _albumIds.Count > 0 || _tagIds.Count > 0;

    private bool HasActiveFilters =>
        HasAlbumOrTagFilter
        || _filter.Category is not null
        || !string.IsNullOrWhiteSpace(_filter.Search);

    private IEnumerable<FileAlbum> SelectedAlbums =>
        _albums.Where(a => _albumIds.Contains(a.FileAlbumID));

    private IEnumerable<FileTag> SelectedTags =>
        _tags.Where(t => _tagIds.Contains(t.FileTagID));

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }
        await ReloadSidebarAsync();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        ResetFilters(keepSearch: false);
        await ReloadSidebarAsync();
        await LoadAsync();
    }

    private async Task ReloadSidebarAsync()
    {
        _albums = await FileService.GetAlbumsAsync(_websiteId);
        _tags = await FileService.GetTagsAsync(_websiteId);
    }

    private void ApplyListFiltersToModel()
    {
        _filter.AlbumIDs = _albumIds.Count > 0 ? _albumIds.ToList() : null;
        _filter.TagIDs = _tagIds.Count > 0 ? _tagIds.ToList() : null;
        _filter.AlbumID = null;
        _filter.TagID = null;
        _filter.Search = _search;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        ApplyListFiltersToModel();
        var result = await FileService.GetPagedAsync(_websiteId, _filter,
            new GridQuery { PageIndex = _pageIndex, PageSize = _pageSize });
        _items = result.Items.ToList();
        _total = result.TotalCount;
        _loading = false;
    }

    private async Task CopyUrlAsync(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            Snackbar.Add(L["content.insert_media.no_url", "This file has no public URL yet. Check storage settings."], Severity.Warning);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Snackbar.Add(L["media.url_copied", "URL copied."], Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["media.url_copy_failed", "Could not copy to clipboard."], Severity.Warning);
        }
    }

    private async Task OpenAlbumFilterAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(MediaFilterPickDialog.WebsiteId)] = _websiteId,
            [nameof(MediaFilterPickDialog.Kind)] = MediaFilterPickDialog.PickKind.Album,
            [nameof(MediaFilterPickDialog.InitialSelectedIds)] = _albumIds.ToList(),
        };
        var dialog = await DialogService.ShowAsync<MediaFilterPickDialog>(
            L["media.pick_albums", "Select albums"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<int> ids })
        {
            _albumIds.Clear();
            _albumIds.AddRange(ids);
            _pageIndex = 1;
            await ReloadSidebarAsync();
            await LoadAsync();
        }
    }

    private async Task OpenTagFilterAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(MediaFilterPickDialog.WebsiteId)] = _websiteId,
            [nameof(MediaFilterPickDialog.Kind)] = MediaFilterPickDialog.PickKind.Tag,
            [nameof(MediaFilterPickDialog.InitialSelectedIds)] = _tagIds.ToList(),
        };
        var dialog = await DialogService.ShowAsync<MediaFilterPickDialog>(
            L["media.pick_tags", "Select tags"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<int> ids })
        {
            _tagIds.Clear();
            _tagIds.AddRange(ids);
            _pageIndex = 1;
            await ReloadSidebarAsync();
            await LoadAsync();
        }
    }

    private async Task OnCategoryChanged(FileCategory? c)
    {
        _filter.Category = c;
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _pageIndex = page;
        await LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _pageIndex = 1; await LoadAsync(); }
    }

    private async Task OnSearchCleared()
    {
        _search = null;
        _filter.Search = null;
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task RemoveAlbumFilter(int albumId)
    {
        _albumIds.Remove(albumId);
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task RemoveTagFilter(int tagId)
    {
        _tagIds.Remove(tagId);
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task ClearCategoryFilter()
    {
        _filter.Category = null;
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task ClearSearchFilter()
    {
        _search = null;
        _filter.Search = null;
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task ClearAlbumAndTagFilters()
    {
        _albumIds.Clear();
        _tagIds.Clear();
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task ClearAllFilters()
    {
        ResetFilters(keepSearch: false);
        _pageIndex = 1;
        await LoadAsync();
    }

    private void ResetFilters(bool keepSearch)
    {
        _albumIds.Clear();
        _tagIds.Clear();
        _filter.AlbumIDs = null;
        _filter.TagIDs = null;
        _filter.AlbumID = null;
        _filter.TagID = null;
        _filter.Category = null;
        if (!keepSearch)
        {
            _search = null;
            _filter.Search = null;
        }
    }

    private string CategoryLabel(FileCategory cat) => cat switch
    {
        FileCategory.Image => L["media.cat_images", "Images"],
        FileCategory.Document => L["media.cat_documents", "Documents"],
        FileCategory.Video => L["media.cat_video", "Video"],
        FileCategory.Audio => L["media.cat_audio", "Audio"],
        _ => L["media.cat_other", "Other"],
    };

    private async Task AddAlbumAsync()
    {
        if (string.IsNullOrWhiteSpace(_newAlbum)) return;
        await FileService.CreateAlbumAsync(_websiteId, _newAlbum.Trim(), null);
        _newAlbum = null;
        await ReloadSidebarAsync();
    }

    private async Task AddTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTag)) return;
        await FileService.CreateTagAsync(_websiteId, _newTag.Trim());
        _newTag = null;
        await ReloadSidebarAsync();
    }

    private async Task OpenUploadAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(UploadDialog.WebsiteId)] = _websiteId,
            [nameof(UploadDialog.PresetAlbumId)] = _albumIds.Count == 1 ? _albumIds[0] : null,
        };
        var dialog = await DialogService.ShowAsync<UploadDialog>(L["media.upload", "Upload"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenDetailAsync(int fileId)
    {
        var parameters = new DialogParameters
        {
            [nameof(FileDetailDialog.FileId)] = fileId,
            [nameof(FileDetailDialog.WebsiteId)] = _websiteId,
        };
        var dialog = await DialogService.ShowAsync<FileDetailDialog>(L["media.file_details", "File details"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await LoadAsync();
    }
}
