@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="@L["name", "Name"]" Variant="Variant.Outlined"
                          Required="true" Class="mb-3" Immediate="true" />
            <MudTextField @bind-Value="_description" Label="@L["description", "Description"]"
                          Variant="Variant.Outlined" Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">
            @L["save", "Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public FileAlbum? Album { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string _name = "";
    private string? _description;

    protected override void OnInitialized()
    {
        if (Album is not null)
        {
            _name = Album.Name;
            _description = Album.Description;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || string.IsNullOrWhiteSpace(_name)) return;

        _saving = true;
        try
        {
            if (Album is null)
                await FileService.CreateAlbumAsync(WebsiteId, _name.Trim(), _description?.Trim());
            else
                await FileService.RenameAlbumAsync(Album.FileAlbumID, _name.Trim(), _description?.Trim());

            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }
}
