@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(ReplaceExisting ? L["media.edit_image", "Edit image"] : L["upload.edit_title", "Edit before upload"])</MudText>
    </TitleContent>
    <DialogContent>
        @if (_previewDataUrl is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                @L["upload.crop_hint", "Drag to select a crop. Then move the box or drag its handles to adjust. Leave empty to keep the full image."]
            </MudText>
            <MudSelect T="string"
                       Value="_aspectKey"
                       ValueChanged="OnAspectChangedAsync"
                       Label="@L["upload.aspect_ratio", "Aspect ratio"]"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Class="mb-2"
                       Style="max-width: 220px;">
                <MudSelectItem T="string" Value="@("free")">@L["upload.aspect_free", "Free"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("1:1")">1:1</MudSelectItem>
                <MudSelectItem T="string" Value="@("4:3")">4:3</MudSelectItem>
                <MudSelectItem T="string" Value="@("3:2")">3:2</MudSelectItem>
                <MudSelectItem T="string" Value="@("16:9")">16:9</MudSelectItem>
                <MudSelectItem T="string" Value="@("9:16")">9:16</MudSelectItem>
                <MudSelectItem T="string" Value="@("3:4")">3:4</MudSelectItem>
            </MudSelect>
            <canvas id="@_canvasId" style="max-width:100%;border:1px solid var(--mud-palette-lines-default);border-radius:4px;cursor:crosshair;touch-action:none;"></canvas>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearCrop" Class="mt-1">
                @L["upload.clear_crop", "Clear crop"]
            </MudButton>
        }
        else if (_previewUnavailable)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @L["upload.preview_unavailable", "File too large for an interactive crop preview — resize/grayscale still apply."]
            </MudAlert>
        }

        <MudGrid Spacing="2" Class="mt-2" AlignItems="AlignItems.Center">
            <MudItem xs="5">
                <MudNumericField T="int?" Value="_resizeWidth" ValueChanged="OnWidthChanged" Label="@L["upload.width", "Width (px)"]" Variant="Variant.Outlined" Min="1" />
            </MudItem>
            <MudItem xs="2" Class="d-flex justify-center">
                <MudIconButton Icon="@(_linked ? Icons.Material.Filled.Link : Icons.Material.Filled.LinkOff)"
                               Size="Size.Small"
                               Color="@(_linked ? Color.Primary : Color.Default)"
                               OnClick="ToggleLink"
                               title="@L["upload.link_dimensions", "Keep aspect ratio"]" />
            </MudItem>
            <MudItem xs="5">
                <MudNumericField T="int?" Value="_resizeHeight" ValueChanged="OnHeightChanged" Label="@L["upload.height", "Height (px)"]" Variant="Variant.Outlined" Min="1" />
            </MudItem>
        </MudGrid>

        <MudCheckBox T="bool" @bind-Value="_grayscale" Label="@L["upload.grayscale", "Black & white"]" Class="mt-2" />

        <MudSelect T="bool?" @bind-Value="_applyWatermark" Label="@L["upload.watermark", "Watermark"]" Variant="Variant.Outlined" Class="mt-2">
            <MudSelectItem T="bool?" Value="null">@L["upload.watermark_default", "Use site default"]</MudSelectItem>
            <MudSelectItem T="bool?" Value="true">@L["upload.watermark_apply", "Apply"]</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">@L["upload.watermark_skip", "Don't apply"]</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public IBrowserFile? File { get; set; }
    /// <summary>Public URL of an image already in the library. Used instead of <see cref="File"/>.</summary>
    [Parameter] public string? ImageUrl { get; set; }
    /// <summary>When true, saving describes an in-place replacement. Unchanged dimensions are not sent as a resize.</summary>
    [Parameter] public bool ReplaceExisting { get; set; }
    [Parameter] public FileEditSpec? Existing { get; set; }

    private const int PreviewMaxBytes = 15 * 1024 * 1024;
    private const int MaxUploadBytes = 200 * 1024 * 1024;

    private readonly string _canvasId = "crop_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MediaEditDialog>? _self;
    private int? _resizeWidth;
    private int? _resizeHeight;
    private int _naturalWidth;
    private int _naturalHeight;
    private int? _autoWidth;
    private int? _autoHeight;
    private bool _cropActive;
    private bool _grayscale;
    private bool? _applyWatermark;
    private string? _previewDataUrl;
    private bool _previewUnavailable;
    private bool _initialized;
    private bool _disposed;
    private string _aspectKey = "free";
    private bool _editorReady;
    private bool _linked = true;
    private double? _aspectRatio;

    protected override void OnInitialized()
    {
        _resizeWidth = Existing?.ResizeWidth;
        _resizeHeight = Existing?.ResizeHeight;
        _grayscale = Existing?.Grayscale ?? false;
        // An image already in the library was watermarked at upload when the site default is on.
        // Leave that choice off unless the caller passed one, so a plain crop does not stamp it again.
        _applyWatermark = ReplaceExisting ? Existing?.ApplyWatermark ?? false : Existing?.ApplyWatermark;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            await StartEditorAsync(ImageUrl);
            return;
        }

        if (File is null) return;

        var isImage = File.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
        if (!isImage || File.Size > PreviewMaxBytes)
        {
            _previewUnavailable = isImage;
            StateHasChanged();
            return;
        }

        await using var stream = File.OpenReadStream(MaxUploadBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        if (_disposed) return;

        _previewDataUrl = $"data:{File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        await StartEditorAsync(_previewDataUrl);
    }

    private async Task StartEditorAsync(string imageSource)
    {
        _previewDataUrl = imageSource;
        StateHasChanged();
        await Task.Yield();
        if (_disposed) return;

        _self?.Dispose();
        _self = DotNetObjectReference.Create(this);
        var ready = await JS.InvokeAsync<bool>("mediaEditor.init", _canvasId, imageSource, 480, 360);
        if (_disposed) return;
        if (!ready)
        {
            _previewDataUrl = null;
            _previewUnavailable = true;
            StateHasChanged();
            return;
        }

        _editorReady = true;
        await JS.InvokeVoidAsync("mediaEditor.setChangeHandler", _canvasId, _self);

        var natural = await JS.InvokeAsync<NaturalSizeResult?>("mediaEditor.naturalSize", _canvasId);
        if (natural is { Width: > 0, Height: > 0 })
        {
            _naturalWidth = natural.Width;
            _naturalHeight = natural.Height;
            _resizeWidth ??= natural.Width;
            _resizeHeight ??= natural.Height;
        }

        _autoWidth = _resizeWidth;
        _autoHeight = _resizeHeight;

        if (_resizeWidth is > 0 && _resizeHeight is > 0)
            _aspectRatio = (double)_resizeWidth.Value / _resizeHeight.Value;

        await ApplyAspectToJsAsync(createIfEmpty: false);
        StateHasChanged();
    }

    /// <summary>
    /// Crop output must use the cropped pixel size. Leaving width/height at the original
    /// image stretches a non-matching crop (a landscape selection forced back to 1:1).
    /// </summary>
    [JSInvokable]
    public void OnCropChanged(CropJsResult? crop)
    {
        if (_disposed || _naturalWidth <= 0 || _naturalHeight <= 0) return;

        if (crop is { Active: true, Width: > 0, Height: > 0 })
        {
            var (width, height) = CropPixelSize(crop, _naturalWidth, _naturalHeight);
            SetAutoSize(width, height);
            _cropActive = true;
        }
        else if (_cropActive)
        {
            SetAutoSize(_naturalWidth, _naturalHeight);
            _cropActive = false;
        }
        else
        {
            return;
        }

        if (_resizeWidth is > 0 && _resizeHeight is > 0)
            _aspectRatio = (double)_resizeWidth.Value / _resizeHeight.Value;

        StateHasChanged();
    }

    private async Task ClearCrop() => await JS.InvokeVoidAsync("mediaEditor.clearCrop", _canvasId);

    private void ToggleLink()
    {
        _linked = !_linked;
        if (_linked && _resizeWidth is > 0 && _resizeHeight is > 0)
            _aspectRatio = (double)_resizeWidth.Value / _resizeHeight.Value;
    }

    private void OnWidthChanged(int? value)
    {
        _resizeWidth = value;
        if (_linked && value is > 0 && _aspectRatio is > 0)
            _resizeHeight = Math.Max(1, (int)Math.Round(value.Value / _aspectRatio.Value));
    }

    private void OnHeightChanged(int? value)
    {
        _resizeHeight = value;
        if (_linked && value is > 0 && _aspectRatio is > 0)
            _resizeWidth = Math.Max(1, (int)Math.Round(value.Value * _aspectRatio.Value));
    }

    private async Task OnAspectChangedAsync(string value)
    {
        _aspectKey = value ?? "free";
        if (_editorReady)
            await ApplyAspectToJsAsync(createIfEmpty: _aspectKey != "free");
    }

    private async Task ApplyAspectToJsAsync(bool createIfEmpty)
    {
        double? ratio = AspectKeyToRatio(_aspectKey);
        await JS.InvokeVoidAsync("mediaEditor.setAspectRatio", _canvasId, ratio, createIfEmpty);
    }

    private static double? AspectKeyToRatio(string key) => key switch
    {
        "1:1" => 1.0,
        "4:3" => 4.0 / 3.0,
        "3:2" => 3.0 / 2.0,
        "16:9" => 16.0 / 9.0,
        "9:16" => 9.0 / 16.0,
        "3:4" => 3.0 / 4.0,
        _ => null
    };

    private async Task SaveAsync()
    {
        ImageCropRect? crop = null;
        if (_previewDataUrl is not null)
        {
            var js = await JS.InvokeAsync<CropJsResult?>("mediaEditor.getCrop", _canvasId);
            if (js is not null)
            {
                crop = new ImageCropRect { X = js.X, Y = js.Y, Width = js.Width, Height = js.Height };
                ApplyCropSizeOnSave(js);
            }
        }

        // Replacing an existing file: the fields start at the current pixel size. Sending that
        // size back would re-encode the whole image even when the user changed nothing.
        if (ReplaceExisting && crop is null
            && _naturalWidth > 0 && _naturalHeight > 0
            && _resizeWidth == _naturalWidth && _resizeHeight == _naturalHeight)
        {
            _resizeWidth = null;
            _resizeHeight = null;
        }

        MudDialog.Close(DialogResult.Ok(new FileEditSpec
        {
            // File name is edited on the upload form (all file types), not here.
            FileName = Existing?.FileName,
            Crop = crop,
            ResizeWidth = _resizeWidth,
            ResizeHeight = _resizeHeight,
            Grayscale = _grayscale,
            ApplyWatermark = _applyWatermark,
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await JS.InvokeVoidAsync("mediaEditor.setChangeHandler", _canvasId, null);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        _self?.Dispose();
        _self = null;
    }

    /// <summary>
    /// Output pixels follow the crop. A size the user typed is kept on the width and the height
    /// is adjusted to the crop ratio, so a landscape crop is not stretched back to the original frame.
    /// </summary>
    private void ApplyCropSizeOnSave(CropJsResult crop)
    {
        if (_naturalWidth <= 0 || _naturalHeight <= 0) return;

        var (width, height) = CropPixelSize(crop, _naturalWidth, _naturalHeight);
        var untouched = (_resizeWidth == _autoWidth && _resizeHeight == _autoHeight)
            || (_resizeWidth == _naturalWidth && _resizeHeight == _naturalHeight);
        if (untouched)
        {
            SetAutoSize(width, height);
            return;
        }

        if (_linked && _resizeWidth is > 0 && height > 0)
        {
            var cropAspect = (double)width / height;
            var currentAspect = (double)_resizeWidth.Value / Math.Max(1, _resizeHeight ?? 1);
            if (Math.Abs(currentAspect - cropAspect) > 0.015)
                _resizeHeight = Math.Max(1, (int)Math.Round(_resizeWidth.Value / cropAspect));
        }
    }

    private void SetAutoSize(int width, int height)
    {
        _resizeWidth = width;
        _resizeHeight = height;
        _autoWidth = width;
        _autoHeight = height;
    }

    /// <summary>Same rounding as <c>ImageProcessor.ApplyCrop</c> so the resize target matches the cropped bitmap.</summary>
    private static (int Width, int Height) CropPixelSize(CropJsResult crop, int sourceWidth, int sourceHeight)
    {
        var x = (int)Math.Round(Math.Clamp(crop.X, 0, 1) * sourceWidth);
        var y = (int)Math.Round(Math.Clamp(crop.Y, 0, 1) * sourceHeight);
        var w = (int)Math.Round(Math.Clamp(crop.Width, 0, 1) * sourceWidth);
        var h = (int)Math.Round(Math.Clamp(crop.Height, 0, 1) * sourceHeight);
        w = Math.Clamp(w, 1, Math.Max(1, sourceWidth - x));
        h = Math.Clamp(h, 1, Math.Max(1, sourceHeight - y));
        return (w, h);
    }

    public sealed class CropJsResult
    {
        public bool Active { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private sealed class NaturalSizeResult
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}
