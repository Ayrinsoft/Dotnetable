@page "/content/post-types"
@attribute [Authorize(Policy = RoleKeys.TaxonomyView)]
@inject IPostTypeService PostTypeService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["post_types", "Post Types"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["post_types", "Post Types"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["post_types.subtitle", "Groups of posts (Blog, News, Portfolio…) with their own features."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["post_types.new", "New Post Type"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["post_types.empty", "No post types yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var t in _items)
            {
                <tr>
                    <td>@t.Name</td>
                    <td><code>@t.Slug</code></td>
                    <td>@Bool(t.HasCategories)</td>
                    <td>@Bool(t.HasTags)</td>
                    <td>@Bool(t.HasAuthor)</td>
                    <td>@Bool(t.CommentsEnabled)</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(t))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(t))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<PostType> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.TaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.TaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.TaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(PostType.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["slug", "Slug"], ColumnName = nameof(PostType.Slug), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["post_types.categories", "Categories"], ColumnName = nameof(PostType.HasCategories), HasSort = true },
                new() { ColumnTitle = L["post_types.tags", "Tags"], ColumnName = nameof(PostType.HasTags), HasSort = true },
                new() { ColumnTitle = L["post_types.author", "Author"], ColumnName = nameof(PostType.HasAuthor), HasSort = true },
                new() { ColumnTitle = L["post_types.comments", "Comments"], ColumnName = nameof(PostType.CommentsEnabled), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private string Bool(bool v) => v ? L["yes", "Yes"] : L["no", "No"];
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await PostTypeService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        var model = new PostType { WebsiteID = _websiteId, HasCategories = true, HasTags = true, HasAuthor = true, CommentsEnabled = true };
        if (await ShowDialogAsync(model, true)) await LoadAsync();
    }

    private async Task EditAsync(PostType t)
    {
        var copy = new PostType
        {
            PostTypeID = t.PostTypeID, WebsiteID = t.WebsiteID, Name = t.Name, Slug = t.Slug,
            HasCategories = t.HasCategories, HasTags = t.HasTags, HasAuthor = t.HasAuthor, CommentsEnabled = t.CommentsEnabled,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(PostType model, bool isNew)
    {
        var parameters = new DialogParameters<PostTypeDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<PostTypeDialog>(
            isNew ? L["post_types.new", "New Post Type"] : L["post_types.edit", "Edit Post Type"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(PostType t)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["post_types.delete", "Delete post type"],
            L["post_types.delete_confirm", "Delete this post type? Posts using it must be removed first."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        try
        {
            await PostTypeService.DeleteAsync(t.PostTypeID);
            Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{L["delete_failed", "Delete failed"]}: {ex.Message}", Severity.Error); }
    }
}
