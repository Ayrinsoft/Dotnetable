@page "/content/tags"
@attribute [Authorize(Policy = RoleKeys.TaxonomyView)]
@inject ITagService TagService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["tags", "Tags"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["tags", "Tags"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["tags.subtitle", "Free-form labels for posts, with per-language translations."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["tags.new", "New Tag"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_items.Count == 0)
    {
        <div style="text-align:center; padding:32px;"><MudText Color="Color.Secondary">@L["tags.empty", "No tags yet."]</MudText></div>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead><tr><th>@L["name", "Name"]</th><th>@L["slug", "Slug"]</th><th style="width:1%"></th></tr></thead>
            <tbody>
                @foreach (var t in _items)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td><code>@t.Slug</code></td>
                        <td>
                            <MudStack Row="true" Spacing="0">
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(t))" />
                                }
                                @if (_canDelete)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(t))" />
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Tag> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.TaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.TaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.TaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await TagService.GetAllAsync(_websiteId);
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Tag { WebsiteID = _websiteId }, true)) await LoadAsync();
    }

    private async Task EditAsync(Tag t)
    {
        var copy = new Tag { TagID = t.TagID, WebsiteID = t.WebsiteID, Name = t.Name, Slug = t.Slug };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Tag model, bool isNew)
    {
        var parameters = new DialogParameters<TagDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<TagDialog>(
            isNew ? L["tags.new", "New Tag"] : L["tags.edit", "Edit Tag"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Tag t)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["tags.delete", "Delete tag"],
            L["tags.delete_confirm", "Delete this tag? It will be removed from all posts."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await TagService.DeleteAsync(t.TagID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
