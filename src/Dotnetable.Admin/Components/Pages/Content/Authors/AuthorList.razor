@page "/content/authors"
@attribute [Authorize(Policy = RoleKeys.AuthorsManage)]
@inject IAuthorProfileService AuthorService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["authors", "Authors"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["authors", "Authors"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["authors.subtitle", "Bios shown under posts and the public résumé pages of your website's members"]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <AuthorizeView Policy="@RoleKeys.AuthorsProfile" Context="own">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Badge" Href="/my/author-profile">
                @L["authors.my_profile", "My author profile"]
            </MudButton>
        </AuthorizeView>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <MudTextField @bind-Value="_search" Placeholder="@L["search", "Search"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                  Class="mb-3" Style="max-width:320px;" />
    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
        <thead>
            <tr>
                <th style="width:60px;"></th>
                <th>@L["name", "Name"]</th>
                <th>@L["username", "Username"]</th>
                <th>@L["authors.bio", "Short bio"]</th>
                <th>@L["authors.resume_page", "Résumé page"]</th>
                <th>@L["authors.items_count", "Résumé items"]</th>
                <th>@L["posts", "Posts"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Filtered.Count == 0)
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:32px;">
                        <MudText Color="Color.Secondary">@L["authors.empty", "No members found."]</MudText>
                    </td>
                </tr>
            }
            @foreach (var a in Filtered)
            {
                <tr>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/content/authors/{a.MemberID}")" />
                    </td>
                    <td>
                        @a.FullName
                        @if (!a.Active)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ms-1">@L["inactive", "Inactive"]</MudChip>
                        }
                    </td>
                    <td>@a.Username</td>
                    <td>@(a.HasBio ? "✓" : "–")</td>
                    <td>
                        @if (a.ResumeEnabled)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">/author/@a.Slug</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@(a.HasProfile ? L["authors.not_published", "Not published"] : "–")</MudText>
                        }
                    </td>
                    <td>@a.ResumeItemCount</td>
                    <td>@a.PostCount</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private string _search = string.Empty;
    private List<Website> _websites = new();
    private List<AuthorListRow> _rows = new();

    private List<AuthorListRow> Filtered
    {
        get
        {
            var needle = _search.Trim();
            return needle.Length == 0
                ? _rows
                : _rows.Where(r => r.FullName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                                   || r.Username.Contains(needle, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        // Always scoped to one website — a non-master can never list another site's members.
        _rows = await AuthorService.GetAuthorsAsync(_websiteId);
        _loading = false;
    }
}
