@using Dotnetable.Application.Social
@inject ITelegramAccountService Accounts
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@L["posts.tg_help_title", "Telegram — connect your bot"]</MudText>
    <MudExpansionPanels Elevation="0" Class="mb-3">
        <MudExpansionPanel Text="@L["posts.ig_open_help", "Show steps"]" Icon="@Icons.Material.Filled.Info" Expanded="_helpOpen" ExpandedChanged="OnHelpChanged">
            <MudText Typo="Typo.body2" Class="mb-2">@Intro</MudText>
            <ol class="mb-0" style="padding-inline-start:1.25rem">
                @foreach (var step in Steps)
                {
                    <li class="mb-1"><MudText Typo="Typo.body2">@step</MudText></li>
                }
            </ol>
        </MudExpansionPanel>
    </MudExpansionPanels>
    @if (CanEdit)
    {
        <SocialChannelList Items="_rows" EditingId="_accountId" OnEdit="Edit" OnRemove="DisconnectAsync" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@(_accountId > 0 ? EditLabel : AddLabel)</MudText>
        <SocialChannelNameFields WebsiteId="WebsiteId" @bind-Title="_title" @bind-LanguageCode="_language" />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_chatId" Label="@L["posts.tg_chat", "Chat id (@channel or numeric)"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_token" Label="@L["posts.tg_token", "Bot token"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputType="InputType.Password" HelperText="@(_editingHasToken ? L["posts.ig_token_keep", "Leave blank to keep the saved token."] : null)" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">@L["posts.tg_save", "Check and save"]</MudButton>
            @if (_accountId > 0)
            {
                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="StartNew">@AddLabel</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private bool _busy;
    private bool _helpOpen;
    private int _loadedFor;
    private int _accountId;
    private bool _editingHasToken;
    private List<TelegramAccountStatus> _accounts = new();
    private string _title = "";
    private string _language = "";
    private string _chatId = "";
    private string _token = "";
    private string AddLabel => Persian ? "کانال دیگر" : "Add another channel";
    private string EditLabel => Persian ? "ویرایش این کانال" : "Edit this channel";
    private IReadOnlyList<SocialChannelRow> _rows => _accounts
        .Select(account => new SocialChannelRow(account.AccountId, SocialChannelChoice.Format(account.Title, account.ChatId, account.LanguageCode)
            + (string.IsNullOrWhiteSpace(account.Username) ? "" : " · @" + account.Username.TrimStart('@'))))
        .ToList();
    private bool Persian => L.LanguageCode.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    private string Intro => Persian
        ? "ربات باید مدیر کانال یا گروهی باشد که پست در آن منتشر می‌شود. توکن بعد از ذخیره نشان داده نمی‌شود. برای زبان یا کارکرد دیگر، کانال دیگری اضافه کنید."
        : "The bot must be an administrator of the channel or group that receives the post. The token is not shown again after you save. Add another channel when the language or the purpose is different.";
    private IEnumerable<string> Steps => Persian ? StepsFa : StepsEn;
    private static readonly string[] StepsFa =
    [
        "در تلگرام به @BotFather بروید، /newbot را بزنید و توکن ربات را کپی کنید.",
        "یک کانال یا گروه بسازید و ربات را با اجازه ارسال پیام، مدیر کنید.",
        "برای کانال عمومی @channel یا لینک t.me/channel را بگذارید. برای کانال خصوصی شناسه عددی (معمولاً با ‎-100) را بگذارید. لینک دعوت قابل بررسی نیست.",
        "توکن و شناسه گفتگو را ذخیره کنید. سایت با getMe و getChat آن‌ها را چک می‌کند.",
        "آلبوم تلگرام حداکثر ۱۰ فایل است. بیشتر از آن در آلبوم بعدی می‌رود. کپشن بلندتر از ۱۰۲۴ نویسه به‌صورت پیام جدا می‌آید.",
        "در پنجره ارسال، تلگرام را تیک بزنید و فقط عکس‌هایی را که باید آنجا بروند انتخاب کنید. می‌توانید فقط تلگرام را بفرستید. ارسال دوباره مجاز است.",
    ];
    private static readonly string[] StepsEn =
    [
        "In Telegram, open @BotFather, send /newbot, and copy the bot token.",
        "Create a channel or group and make the bot an administrator that can post messages.",
        "For a public channel use @channel or the t.me/channel link. For a private chat use the numeric id, which usually starts with -100. An invite link cannot be checked.",
        "Save the token and the chat id. The site checks them with getMe and getChat.",
        "A Telegram album holds at most 10 files. Extra files go in the next album. A caption longer than 1024 characters is sent as its own message.",
        "In the send window, tick Telegram and only the photos that should go there. You can send to Telegram alone. Sending again is allowed.",
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (WebsiteId <= 0 || WebsiteId == _loadedFor) return;
        _loadedFor = WebsiteId;
        StartNew();
        _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
    }

    private void StartNew()
    {
        _accountId = 0;
        _editingHasToken = false;
        _title = "";
        _language = "";
        _chatId = "";
        _token = "";
    }

    private void Edit(int accountId)
    {
        var account = _accounts.FirstOrDefault(a => a.AccountId == accountId);
        if (account is null) return;
        _accountId = account.AccountId;
        _editingHasToken = account.HasToken;
        _title = account.Title;
        _language = account.LanguageCode ?? "";
        _chatId = account.ChatId ?? "";
        _token = "";
    }

    private void OnHelpChanged(bool value) => _helpOpen = value;

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.SaveAsync(WebsiteId, new TelegramAccountInput
            {
                AccountId = _accountId,
                Title = _title,
                LanguageCode = _language,
                ChatId = _chatId,
                BotToken = _token,
            });
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            StartNew();
            Snackbar.Add(L["posts.tg_saved", "Telegram bot saved."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync(int accountId)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.DisconnectAsync(WebsiteId, accountId);
            if (_accountId == accountId) StartNew();
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            _token = "";
            Snackbar.Add(L["posts.tg_disconnected", "Telegram disconnected."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
