@using Dotnetable.Application.Social
@inject IInstagramAccountService Accounts
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@L["posts.ig_help_title", "Instagram — connect your page"]</MudText>
    <MudExpansionPanels Elevation="0" Class="mb-3">
        <MudExpansionPanel Text="@L["posts.ig_open_help", "Show steps"]" Icon="@Icons.Material.Filled.Info" Expanded="_helpOpen" ExpandedChanged="OnHelpChanged">
            <MudText Typo="Typo.body2" Class="mb-2">@Intro</MudText>
            <ol class="mb-0" style="padding-inline-start:1.25rem">
                @foreach (var step in Steps)
                {
                    <li class="mb-1"><MudText Typo="Typo.body2">@step</MudText></li>
                }
            </ol>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @if (CanEdit)
    {
        <SocialChannelList Items="_rows" EditingId="_accountId" OnEdit="Edit" OnRemove="DisconnectAsync" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@(_accountId > 0 ? EditLabel : AddLabel)</MudText>
        <SocialChannelNameFields WebsiteId="WebsiteId" @bind-Title="_title" @bind-LanguageCode="_language" />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_igUserId" Label="@L["posts.ig_user_id", "Instagram account id"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_pageId" Label="@L["posts.ig_page_id", "Facebook Page id (optional)"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_token" Label="@L["posts.ig_token", "Page access token"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputType="InputType.Password" HelperText="@(_editingHasToken ? L["posts.ig_token_keep", "Leave blank to keep the saved token."] : null)" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">@L["posts.ig_save", "Check and save"]</MudButton>
            @if (_accountId > 0)
            {
                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="StartNew">@AddLabel</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private bool _busy;
    private bool _helpOpen;
    private int _loadedFor;
    private int _accountId;
    private bool _editingHasToken;
    private List<InstagramAccountStatus> _accounts = new();
    private string _title = "";
    private string _language = "";
    private string _igUserId = "";
    private string _pageId = "";
    private string _token = "";
    private string AddLabel => Persian ? "کانال دیگر" : "Add another channel";
    private string EditLabel => Persian ? "ویرایش این کانال" : "Edit this channel";

    private bool Persian => L.LanguageCode.StartsWith("fa", StringComparison.OrdinalIgnoreCase);

    private string Intro => Persian
        ? "اینستاگرام فقط از حساب حرفه‌ای (بیزینس یا کریتور) که به یک صفحه فیسبوک وصل است پست می‌گیرد. توکن را اینجا بگذارید. خود توکن بعد از ذخیره نشان داده نمی‌شود. برای زبان یا کارکرد دیگر، کانال دیگری اضافه کنید."
        : "Instagram accepts posts only from a professional account (Business or Creator) linked to a Facebook Page. Paste the token here. It is not shown again after you save. Add another channel when the language or the purpose is different.";

    private IEnumerable<string> Steps => Persian ? StepsFa : StepsEn;

    private static readonly string[] StepsFa =
    [
        "در اینستاگرام حساب را حرفه‌ای کنید و آن را به یک صفحه فیسبوک که مدیرش هستید وصل کنید.",
        "در developers.facebook.com یک اپ از نوع Business بسازید و محصول Instagram را اضافه کنید.",
        "یک توکن کاربر با مجوزهای instagram_basic، instagram_content_publish، pages_show_list و pages_read_engagement بگیرید و آن را با App Id و App Secret به توکن بلندمدت (حدود ۶۰ روز) تبدیل کنید.",
        "با همان توکن، me/accounts را با فیلدهای access_token و instagram_business_account بخوانید. شناسه instagram_business_account همان شناسه حساب است و access_token صفحه، توکنی است که اینجا وارد می‌کنید.",
        "نشانی فایل‌ها باید https و از اینترنت عمومی در دسترس باشد. اینستاگرام localhost را نمی‌خواند. عکس کتابخانه به JPEG موقت تبدیل می‌شود و بعد از ارسال پاک می‌شود.",
        "در جدول، دکمه ارسال را بزنید. کپشن، عکس یا ویدیو، و کاور را در پنجره مشخص کنید. ارسال دوباره مجاز است و ردیف فقط نشان می‌دهد که قبلاً به اینستاگرام رفته است.",
    ];

    private static readonly string[] StepsEn =
    [
        "Switch the Instagram account to Professional (Business or Creator) and link it to a Facebook Page you manage.",
        "Create a Business app at developers.facebook.com and add the Instagram product.",
        "Create a user token with instagram_basic, instagram_content_publish, pages_show_list, and pages_read_engagement, then exchange it for a long-lived token (about 60 days) with your App Id and App Secret.",
        "Call me/accounts with that token and ask for access_token and instagram_business_account. The Instagram id is the account id. The page access_token is what you paste here.",
        "File addresses must be public https. Instagram cannot read localhost. Library photos are copied to a temporary JPEG and deleted after publishing.",
        "Use the send button on a row. Set the caption, photos or video, and the cover in the window. Sending again is allowed. The row only shows that Instagram has received it before.",
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (WebsiteId <= 0 || WebsiteId == _loadedFor) return;
        _loadedFor = WebsiteId;
        StartNew();
        _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
    }

    private IReadOnlyList<SocialChannelRow> _rows => _accounts
        .Select(account => new SocialChannelRow(account.AccountId, SocialChannelChoice.Format(account.Title, account.Username ?? account.IgUserId, account.LanguageCode)))
        .ToList();

    private void StartNew()
    {
        _accountId = 0;
        _editingHasToken = false;
        _title = "";
        _language = "";
        _igUserId = "";
        _pageId = "";
        _token = "";
    }

    private void Edit(int accountId)
    {
        var account = _accounts.FirstOrDefault(a => a.AccountId == accountId);
        if (account is null) return;
        _accountId = account.AccountId;
        _editingHasToken = account.HasToken;
        _title = account.Title;
        _language = account.LanguageCode ?? "";
        _igUserId = account.IgUserId ?? "";
        _pageId = account.PageId ?? "";
        _token = "";
    }

    private void OnHelpChanged(bool value) => _helpOpen = value;

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.SaveAsync(WebsiteId, new InstagramAccountInput
            {
                AccountId = _accountId,
                Title = _title,
                LanguageCode = _language,
                IgUserId = _igUserId,
                PageId = _pageId,
                AccessToken = _token,
            });
            _token = "";
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            StartNew();
            Snackbar.Add(L["posts.ig_saved", "Instagram account saved."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync(int accountId)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.DisconnectAsync(WebsiteId, accountId);
            if (_accountId == accountId) StartNew();
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            Snackbar.Add(L["posts.ig_disconnected", "Instagram disconnected."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
