@page "/content/posts/new"
@page "/content/posts/{Id:int}"
@attribute [Authorize(Policy = RoleKeys.PostsView)]
@inject IPostService PostService
@inject IPostTypeService PostTypeService
@inject ICategoryService CategoryService
@inject ITagService TagService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject ILanguageService LanguageService

<DNPageTitle Title=@(_isNew ? L["posts.new", "New Post"] : L["posts.edit", "Edit Post"]) />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["posts.new", "New Post"] : L["posts.edit", "Edit Post"])</MudText>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/content/posts">@L["back", "Back"]</MudButton>
</MudStack>

@if (!_loading)
{
    <DNPrerequisiteAlert Items="_prerequisites" />
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_model is not null)
{
    <MudForm @ref="_form">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
                    <MudTextField @bind-Value="_model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" Class="mb-3" />
                    <MudTextField @bind-Value="_model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Required="true" Class="mb-3" />
                    <MudTextField @bind-Value="_model.Excerpt" Label="@L["posts.excerpt", "Excerpt"]" Variant="Variant.Outlined"
                                  Lines="2" AutoGrow="true" Class="mb-3" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["posts.content", "Content"]</MudText>
                        <ContentMediaInsertButton WebsiteId="_model.WebsiteID"
                                                  CurrentHtml="@_model.Content"
                                                  HtmlChanged="OnMainContentMediaInserted" />
                    </MudStack>
                    <DNCkEditor @key="_mainEditorVersion"
                                ContentLanguage="@_defaultLanguageCode"
                                Value="@(_model.Content ?? "")"
                                OnValueChanged="@(v => _model!.Content = v)" />
                </MudPaper>

                @if (_languages.Length > 0)
                {
                <MudExpansionPanels Elevation="0" Class="mt-4">
                    <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                        </MudText>
                        @foreach (var (code, label) in _languages)
                        {
                            var t = Translation(code);
                            <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@label</MudText>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="7"><MudTextField T="string" Value="@t.Title" ValueChanged="@(v => { t.Title = v; })" Label="@L["title", "Title"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12" sm="5"><MudTextField T="string" Value="@t.Slug" ValueChanged="@(v => { t.Slug = v; })" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12"><MudTextField T="string" Value="@t.Excerpt" ValueChanged="@(v => { t.Excerpt = v; })" Label="@L["posts.excerpt", "Excerpt"]" Variant="Variant.Outlined" Lines="2" AutoGrow="true" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="12">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["posts.content", "Content"]</MudText>
                                            <ContentMediaInsertButton WebsiteId="_model!.WebsiteID"
                                                                      CurrentHtml="@t.Content"
                                                                      HtmlChanged="@(html => OnTranslationContentMediaInserted(code, html))" />
                                        </MudStack>
                                        <DNCkEditor @key="@($"{code}_{TranslationEditorVersion(code)}")"
                                                    ContentLanguage="@(code)"
                                                    Value="@(t.Content ?? "")"
                                                    OnValueChanged="@(v => t.Content = v)" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
                }
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">@L["posts.publish", "Publish"]</MudText>
                    <MudSelect T="byte" @bind-Value="_model.Status" Label="@L["status", "Status"]" Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem T="byte" Value="@((byte)0)">@L["posts.draft", "Draft"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="@((byte)1)">@L["posts.published", "Published"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="@((byte)2)">@L["posts.scheduled", "Scheduled"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="@((byte)3)">@L["posts.archived", "Archived"]</MudSelectItem>
                    </MudSelect>
                    <MudDatePicker @bind-Date="_publishedAt" Label="@L["posts.published_at", "Published at"]" Variant="Variant.Outlined" Class="mb-3" Clearable="true" />
                    <MudDatePicker @bind-Date="_scheduledAt" Label="@L["posts.scheduled_at", "Scheduled at"]" Variant="Variant.Outlined" Class="mb-3" Clearable="true" />
                    <MudSwitch T="bool" @bind-Value="_model.IsFeatured" Color="Color.Primary" Label="@L["posts.featured", "Featured"]" />
                    <MudSwitch T="bool" @bind-Value="_model.CommentsEnabled" Color="Color.Primary" Label="@L["posts.comments", "Comments enabled"]" />
                    <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="@(_model.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                               OnClick="SaveAsync" Disabled="@(_saving || !_canEdit || _postTypes.Count == 0)">@L["save", "Save"]</MudButton>
                </MudPaper>

                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">@L["posts.organize", "Organize"]</MudText>
                    <MudAutocomplete T="PostType" Value="@GetSelectedPostType()" ValueChanged="OnPostTypeChanged"
                                     SearchFunc="SearchPostTypes" ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     Label="@L["post_type", "Post Type"]" Variant="Variant.Outlined" Required="true"
                                     Class="mb-3" Clearable="false" CoerceText="false" ResetValueOnEmptyText="true" />

                    <MudAutocomplete T="Category" Value="_categoryToAdd" ValueChanged="AddCategory"
                                     SearchFunc="SearchCategoriesToAdd" ToStringFunc="CategoryPath"
                                     Label="@L["categories", "Categories"]" Variant="Variant.Outlined" Class="mb-2"
                                     Clearable="true" CoerceText="false" ResetValueOnEmptyText="true"
                                     HelperText="@L["posts.search_to_add_category", "Type to search and add a category"]" />
                    @if (_selectedCategoryIds.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var id in _selectedCategoryIds)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                         OnClose="@(() => RemoveCategory(id))">@CategoryPathById(id)</MudChip>
                            }
                        </div>

                        <MudAutocomplete T="Category" Value="@GetPrimaryCategory()" ValueChanged="OnPrimaryCategoryChanged"
                                         SearchFunc="SearchSelectedCategories" ToStringFunc="CategoryPath"
                                         Label="@L["posts.primary_category", "Primary category"]" Variant="Variant.Outlined"
                                         Class="mb-3" Clearable="true" CoerceText="false" ResetValueOnEmptyText="true" />
                    }

                    <MudAutocomplete T="Tag" Value="_tagToAdd" ValueChanged="AddTag"
                                     SearchFunc="SearchTagsToAdd" ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     Label="@L["tags", "Tags"]" Variant="Variant.Outlined"
                                     Clearable="true" CoerceText="false" ResetValueOnEmptyText="true"
                                     HelperText="@L["posts.search_to_add_tag", "Type to search and add a tag"]" />
                    @if (_selectedTagIds.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var id in _selectedTagIds)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                         OnClose="@(() => RemoveTag(id))">@TagName(id)</MudChip>
                            }
                        </div>
                    }
                </MudPaper>

                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">@L["posts.featured_image", "Featured Image"]</MudText>
                    @if (_featuredFile is not null && !string.IsNullOrEmpty(_featuredFile.CNDUrl))
                    {
                        <img src="@(_featuredFile.ThumbnailCDN ?? _featuredFile.CNDUrl)" alt="" style="max-width:100%; border-radius:8px;" class="mb-2" />
                    }
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Image" OnClick="PickImageAsync">@L["posts.choose_image", "Choose"]</MudButton>
                        @if (_model.FeaturedImageFileID is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearImage">@L["clear", "Clear"]</MudButton>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <DNValidationSummary Errors="_formErrors" />
    </MudForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool _loading = true;
    private bool _isNew;
    private bool _isMaster;
    private bool _canEdit;
    private bool _saving;
    private int _websiteId;
    private int _memberId;
    private string _defaultLanguageCode = "en";
    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();
    private Post? _model;
    private MudForm _form = null!;
    private FileRecord? _featuredFile;
    private string[]? _formErrors;

    private DateTime? _publishedAt;
    private DateTime? _scheduledAt;

    private List<PostType> _postTypes = new();
    private List<Category> _categories = new();
    private List<Tag> _tags = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private HashSet<int> _selectedCategoryIds = new();
    private HashSet<int> _selectedTagIds = new();
    private int? _primaryCategoryId;
    private Category? _categoryToAdd;
    private Tag? _tagToAdd;

    private sealed class TranslationModel { public string Title = ""; public string Slug = ""; public string Excerpt = ""; public string Content = ""; }
    private readonly Dictionary<string, TranslationModel> _translations = new(StringComparer.OrdinalIgnoreCase);
    private int _mainEditorVersion;
    private readonly Dictionary<string, int> _translationEditorVersions = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out _memberId);
        _isNew = Id is null;
        _canEdit = AdminPolicies.Allows(user, _isNew ? RoleKeys.PostsInsert : RoleKeys.PostsEdit);

        if (_isNew)
        {
            _model = new Post { WebsiteID = _websiteId, Status = 1, IsActive = true, CommentsEnabled = true, AuthorMemberID = _memberId };
        }
        else
        {
            _model = await PostService.GetByIdAsync(Id!.Value);
            if (_model is not null)
            {
                _featuredFile = _model.FeaturedImageFile;
                _publishedAt = _model.PublishedAt;
                _scheduledAt = _model.ScheduledAt;
                _selectedCategoryIds = (await PostService.GetCategoryIdsAsync(_model.PostID)).ToHashSet();
                _selectedTagIds = (await PostService.GetTagIdsAsync(_model.PostID)).ToHashSet();
                _primaryCategoryId = _model.PostCategories.FirstOrDefault(pc => pc.IsPrimary)?.CategoryID;
                foreach (var t in _model.PostTranslations)
                    _translations[t.LanguageCode] = new TranslationModel { Title = t.Title, Slug = t.Slug, Excerpt = t.Excerpt ?? "", Content = t.Content ?? "" };
            }
        }

        // Master site (website 1) uses the same per-website language rows as every other site.
        var wid = _model?.WebsiteID ?? _websiteId;
        var activeLangs = await LanguageService.GetActiveForWebsiteAsync(wid);
        _defaultLanguageCode = activeLangs.FirstOrDefault(l => l.IsDefault)?.LanguageCode
            ?? activeLangs.FirstOrDefault()?.LanguageCode
            ?? "en";
        _languages = activeLangs.Where(l => !l.IsDefault)
            .Select(x => (x.LanguageCode, x.Name)).ToArray();
        _postTypes = await PostTypeService.GetAllAsync(wid);
        _categories = await CategoryService.GetAllAsync(wid);
        _tags = await TagService.GetAllAsync(wid);
        _prerequisites = ContentPrerequisiteHelper.ForPosts(L, _postTypes, _categories.Count, _tags.Count);
        if (_isNew && _model is not null && _postTypes.Count > 0)
            _model.PostTypeID = _postTypes[0].PostTypeID;

        _loading = false;
    }

    private PostType? GetSelectedPostType() =>
        _model is null ? null : _postTypes.FirstOrDefault(t => t.PostTypeID == _model.PostTypeID);

    private void OnPostTypeChanged(PostType? type)
    {
        if (_model is null || type is null) return;
        _model.PostTypeID = type.PostTypeID;
    }

    private Task<IEnumerable<PostType>> SearchPostTypes(string value, CancellationToken ct)
    {
        IEnumerable<PostType> q = _postTypes.OrderBy(t => t.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(t => t.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private string CategoryPathById(int id) =>
        CategoryPath(_categories.FirstOrDefault(c => c.CategoryID == id)) is { Length: > 0 } path ? path : $"#{id}";

    private string CategoryPath(Category? category)
    {
        if (category is null) return string.Empty;
        var byId = _categories.ToDictionary(c => c.CategoryID);
        var parts = new List<string> { category.Name };
        var current = category;
        var guard = 0;
        while (current.ParentCategoryID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private string TagName(int id) => _tags.FirstOrDefault(t => t.TagID == id)?.Name ?? $"#{id}";

    private Category? GetPrimaryCategory() =>
        _primaryCategoryId is int id ? _categories.FirstOrDefault(c => c.CategoryID == id) : null;

    private void OnPrimaryCategoryChanged(Category? category) =>
        _primaryCategoryId = category?.CategoryID;

    private Task<IEnumerable<Category>> SearchSelectedCategories(string value, CancellationToken ct)
    {
        IEnumerable<Category> q = _categories
            .Where(c => _selectedCategoryIds.Contains(c.CategoryID))
            .OrderBy(c => c.ParentCategoryID ?? 0)
            .ThenBy(c => c.SortOrder)
            .ThenBy(c => c.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || CategoryPath(c).Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private Task<IEnumerable<Category>> SearchCategoriesToAdd(string value, CancellationToken ct)
    {
        IEnumerable<Category> q = _categories
            .Where(c => !_selectedCategoryIds.Contains(c.CategoryID))
            .OrderBy(c => c.ParentCategoryID ?? 0)
            .ThenBy(c => c.SortOrder)
            .ThenBy(c => c.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || CategoryPath(c).Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private void AddCategory(Category? category)
    {
        _categoryToAdd = null;
        if (category is null || !_selectedCategoryIds.Add(category.CategoryID)) return;
        _primaryCategoryId ??= category.CategoryID;
    }

    private void RemoveCategory(int id)
    {
        _selectedCategoryIds.Remove(id);
        if (_primaryCategoryId == id)
            _primaryCategoryId = _selectedCategoryIds.FirstOrDefault() is int first and not 0 ? first : null;
    }

    private Task<IEnumerable<Tag>> SearchTagsToAdd(string value, CancellationToken ct)
    {
        IEnumerable<Tag> q = _tags.Where(t => !_selectedTagIds.Contains(t.TagID)).OrderBy(t => t.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(t => t.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || t.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private void AddTag(Tag? tag)
    {
        _tagToAdd = null;
        if (tag is null) return;
        _selectedTagIds.Add(tag.TagID);
    }

    private void RemoveTag(int id) => _selectedTagIds.Remove(id);

    private TranslationModel Translation(string code)
    {
        if (!_translations.TryGetValue(code, out var t)) { t = new TranslationModel(); _translations[code] = t; }
        return t;
    }

    private int TranslationEditorVersion(string code) =>
        _translationEditorVersions.TryGetValue(code, out var v) ? v : 0;

    private void OnMainContentMediaInserted(string html)
    {
        if (_model is null) return;
        _model.Content = html;
        _mainEditorVersion++;
    }

    private void OnTranslationContentMediaInserted(string code, string html)
    {
        Translation(code).Content = html;
        _translationEditorVersions[code] = TranslationEditorVersion(code) + 1;
    }

    private async Task PickImageAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = _model!.WebsiteID,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
        {
            _model.FeaturedImageFileID = file.FileRecordID;
            _featuredFile = file;
        }
    }

    private void ClearImage() { _model!.FeaturedImageFileID = null; _featuredFile = null; }

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid || _model is null) return;
        if (string.IsNullOrWhiteSpace(_model.Slug)) _model.Slug = _model.Title.Trim();
        _model.PublishedAt = _publishedAt;
        _model.ScheduledAt = _scheduledAt;

        _saving = true;
        try
        {
            if (_isNew) await PostService.CreateAsync(_model);
            else await PostService.UpdateAsync(_model);

            var translations = _translations
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value.Title))
                .Select(kv => new PostTranslation
                {
                    PostID = _model.PostID, LanguageCode = kv.Key,
                    Title = kv.Value.Title, Slug = kv.Value.Slug, Excerpt = kv.Value.Excerpt, Content = kv.Value.Content,
                }).ToList();
            await PostService.SetTranslationsAsync(_model.PostID, translations);

            var categoryIds = _selectedCategoryIds.ToList();
            var primary = _primaryCategoryId is int pid && categoryIds.Contains(pid) ? pid : (int?)null;
            await PostService.SetCategoriesAsync(_model.PostID, categoryIds, primary);
            await PostService.SetTagsAsync(_model.PostID, _selectedTagIds.ToList());

            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            Nav.NavigateTo("/content/posts");
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
