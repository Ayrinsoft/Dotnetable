@page "/content/posts"
@attribute [Authorize(Policy = RoleKeys.PostsView)]
@inject IPostService PostService
@inject IPostTypeService PostTypeService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["posts", "Posts"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["posts", "Posts"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["posts.subtitle", "Blog and content posts with translations, categories and tags."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:160px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        <MudSelect T="int?" @bind-Value="_filterPostTypeId" Label="@L["post_type", "Post Type"]" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" Style="min-width:150px" SelectedValuesChanged="OnFilterChanged">
            <MudSelectItem T="int?" Value="@((int?)null)">@L["posts.all_types", "All types"]</MudSelectItem>
            @foreach (var t in _postTypes)
            {
                <MudSelectItem T="int?" Value="@t.PostTypeID">@t.Name</MudSelectItem>
            }
        </MudSelect>
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/content/posts/new">
                @L["posts.new", "New Post"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center; padding:32px;">
                <MudText Color="Color.Secondary">@L["posts.empty", "No posts yet."]</MudText>
            </td></tr>
        }
        else
        {
            @foreach (var p in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="1">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Href="@($"/content/posts/{p.PostID}")" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(p))" />
                            }
                        </MudStack>
                    </td>
                    <td>@p.Title @(p.IsFeatured ? "★" : "")</td>
                    <td>@(p.PostType?.Name ?? "-")</td>
                    <td>@StatusLabel(p.Status)</td>
                    <td>@(p.PublishedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        <MudSwitch T="bool" Value="p.IsActive" Color="Color.Success"
                                   Disabled="@(!_canEdit || _busy.Contains(p.PostID))"
                                   ValueChanged="@(v => ToggleActiveAsync(p, v))" />
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private int? _filterPostTypeId;
    private List<Post> _items = new();
    private List<PostType> _postTypes = new();
    private List<Website> _websites = new();
    private HashSet<int> _busy = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.PostsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.PostsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.PostsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        _postTypes = await PostTypeService.GetAllAsync(_websiteId);

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(Post.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["post_type", "Post Type"], ColumnName = "" },
                new() { ColumnTitle = L["status", "Status"], ColumnName = "" },
                new() { ColumnTitle = L["posts.published", "Published"], ColumnName = nameof(Post.PublishedAt), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(IEnumerable<int> _)
    {
        _postTypes = await PostTypeService.GetAllAsync(_websiteId);
        await LoadAsync();
    }
    private async Task OnFilterChanged(IEnumerable<int?> _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var filter = new PostFilter { PostTypeID = _filterPostTypeId };
        var result = await PostService.GetPagedAsync(_websiteId, filter, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ToggleActiveAsync(Post p, bool value)
    {
        if (!_busy.Add(p.PostID)) return;
        p.IsActive = value;
        try { await PostService.SetActiveAsync(p.PostID, value); }
        finally { _busy.Remove(p.PostID); }
    }

    private async Task DeleteAsync(Post p)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["posts.delete", "Delete post"],
            L["posts.delete_confirm", "Delete this post and its translations?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await PostService.DeleteAsync(p.PostID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private string StatusLabel(byte s) => s switch
    {
        0 => L["posts.draft", "Draft"],
        1 => L["posts.published", "Published"],
        2 => L["posts.scheduled", "Scheduled"],
        3 => L["posts.archived", "Archived"],
        _ => s.ToString(),
    };
}
