@using Dotnetable.Application.Social
@inject IXAccountService Accounts
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@L["posts.x_help_title", "X — connect your account"]</MudText>
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Paid">
        @BillingWarning
    </MudAlert>
    <MudExpansionPanels Elevation="0" Class="mb-3">
        <MudExpansionPanel Text="@L["posts.ig_open_help", "Show steps"]" Icon="@Icons.Material.Filled.Info" Expanded="_helpOpen" ExpandedChanged="OnHelpChanged">
            <MudText Typo="Typo.body2" Class="mb-2">@Intro</MudText>
            <ol class="mb-0" style="padding-inline-start:1.25rem">
                @foreach (var step in Steps)
                {
                    <li class="mb-1"><MudText Typo="Typo.body2">@step</MudText></li>
                }
            </ol>
        </MudExpansionPanel>
    </MudExpansionPanels>
    @if (CanEdit)
    {
        <SocialChannelList Items="_rows" EditingId="_accountId" OnEdit="Edit" OnRemove="DisconnectAsync" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@(_accountId > 0 ? EditLabel : AddLabel)</MudText>
        <SocialChannelNameFields WebsiteId="WebsiteId" @bind-Title="_title" @bind-LanguageCode="_language" />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_apiKey" Label="@L["posts.x_key", "API key"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputType="InputType.Password" HelperText="@(_editingHasKeys ? L["posts.x_keep", "Leave a field blank to keep the saved value."] : null)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_apiSecret" Label="@L["posts.x_secret", "API key secret"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_accessToken" Label="@L["posts.x_token", "Access token"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_accessSecret" Label="@L["posts.x_token_secret", "Access token secret"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">@L["posts.x_save", "Check and save"]</MudButton>
            @if (_accountId > 0)
            {
                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="StartNew">@AddLabel</MudButton>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private bool _busy;
    private bool _helpOpen;
    private int _loadedFor;
    private int _accountId;
    private bool _editingHasKeys;
    private List<XAccountStatus> _accounts = new();
    private string _title = "";
    private string _language = "";
    private string _apiKey = "";
    private string _apiSecret = "";
    private string _accessToken = "";
    private string _accessSecret = "";
    private string AddLabel => Persian ? "کانال دیگر" : "Add another channel";
    private string EditLabel => Persian ? "ویرایش این کانال" : "Edit this channel";
    private IReadOnlyList<SocialChannelRow> _rows => _accounts
        .Select(account => new SocialChannelRow(account.AccountId, SocialChannelChoice.Format(account.Title, account.Username, account.LanguageCode)))
        .ToList();
    private bool Persian => L.LanguageCode.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
    private string BillingWarning => Persian
        ? "ارسال پیام از طریق API ایکس رایگان نیست و مشمول هزینه می‌شود."
        : "Sending messages through the X API is not free. X charges for each send.";
    private string Intro => Persian
        ? "پست با کلیدهای خود کاربر در developer.x.com ارسال می‌شود. هیچ‌کدام از کلیدها بعد از ذخیره نشان داده نمی‌شوند. برای زبان یا کارکرد دیگر، کانال دیگری اضافه کنید."
        : "Posts are sent with the user keys from developer.x.com. None of the keys are shown again after you save. Add another channel when the language or the purpose is different.";
    private IEnumerable<string> Steps => Persian ? StepsFa : StepsEn;
    private static readonly string[] StepsFa =
    [
        "در developer.x.com یک پروژه و اپ بسازید.",
        "در تنظیمات احراز هویت کاربر، دسترسی را Read and Write بگذارید. اگر Callback خواست یک نشانی https بگذارید.",
        "از بخش Keys and tokens این چهار مقدار را کپی کنید: API Key، API Key Secret، Access Token و Access Token Secret. بعد از عوض کردن دسترسی، Access Token را دوباره بسازید.",
        "هر پست X حداکثر ۴ عکس دارد. عکس پنجم به بعد پاسخ همان پست می‌شود. ویدیو پست جداست و با عکس قاطی نمی‌شود. هر عکس باید کمتر از ۵ مگابایت باشد.",
        "کپشن بلندتر از ۲۸۰ نویسه را فقط حساب X Premium می‌پذیرد. در غیر این صورت خود X آن را رد می‌کند.",
        "در پنجره ارسال، X را تیک بزنید و فقط فایل‌هایی را که باید آنجا بروند انتخاب کنید. می‌توانید X را خالی بگذارید. ارسال دوباره مجاز است.",
    ];
    private static readonly string[] StepsEn =
    [
        "Create a project and an app at developer.x.com.",
        "In the user authentication settings, set the access to Read and Write. If a callback is required, any https address is enough.",
        "From Keys and tokens, copy the API key, API key secret, access token, and access token secret. Regenerate the access token after you change the permissions.",
        "One X post holds at most 4 photos. Further photos are sent as replies. A video is its own post and is not mixed with photos. Each photo must be under 5 MB.",
        "A caption longer than 280 characters is accepted only by an X Premium account. Otherwise X rejects it.",
        "In the send window, tick X and only the files that should go there. You can leave X off. Sending again is allowed.",
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (WebsiteId <= 0 || WebsiteId == _loadedFor) return;
        _loadedFor = WebsiteId;
        StartNew();
        _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
    }

    private void StartNew()
    {
        _accountId = 0;
        _editingHasKeys = false;
        _title = "";
        _language = "";
        ClearSecrets();
    }

    private void Edit(int accountId)
    {
        var account = _accounts.FirstOrDefault(a => a.AccountId == accountId);
        if (account is null) return;
        _accountId = account.AccountId;
        _editingHasKeys = account.HasKeys;
        _title = account.Title;
        _language = account.LanguageCode ?? "";
        ClearSecrets();
    }

    private void OnHelpChanged(bool value) => _helpOpen = value;

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.SaveAsync(WebsiteId, new XAccountInput
            {
                AccountId = _accountId,
                Title = _title,
                LanguageCode = _language,
                ApiKey = _apiKey,
                ApiSecret = _apiSecret,
                AccessToken = _accessToken,
                AccessTokenSecret = _accessSecret,
            });
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            StartNew();
            Snackbar.Add(L["posts.x_saved", "X account saved."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync(int accountId)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Accounts.DisconnectAsync(WebsiteId, accountId);
            if (_accountId == accountId) StartNew();
            _accounts = (await Accounts.ListAsync(WebsiteId)).ToList();
            Snackbar.Add(L["posts.x_disconnected", "X disconnected."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearSecrets()
    {
        _apiKey = "";
        _apiSecret = "";
        _accessToken = "";
        _accessSecret = "";
    }
}
