@using Microsoft.AspNetCore.Components.Forms
@using Dotnetable.Application.Social
@using Dotnetable.Infrastructure.Social
@inject IPostService Posts
@inject IProductService Products
@inject ISocialPublishService Publisher
@inject ISocialLinkSettings LinkSettings
@inject IShortLinkService ShortLinks
@inject IInstagramAccountService InstagramAccounts
@inject ITelegramAccountService TelegramAccounts
@inject IXAccountService XAccounts
@inject ILanguageService Languages
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["posts.social_send", "Send to Instagram, Telegram, or X"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">@_title</MudText>
            <MudStack Row="true" Spacing="2" Class="mb-3 flex-wrap">
                @if (_igAccounts.Count > 0)
                {
                    <MudCheckBox T="bool" Value="_sendInstagram" ValueChanged="OnSendInstagram" Color="Color.Primary"
                                 Label="@L["posts.ig_network", "Instagram"]" />
                }
                @if (_tgAccounts.Count > 0)
                {
                    <MudCheckBox T="bool" Value="_sendTelegram" ValueChanged="OnSendTelegram" Color="Color.Primary"
                                 Label="@L["posts.tg_network", "Telegram"]" />
                }
                @if (_xAccounts.Count > 0)
                {
                    <MudCheckBox T="bool" Value="_sendX" ValueChanged="OnSendX" Color="Color.Primary"
                                 Label="@L["posts.x_network", "X"]" />
                }
            </MudStack>
            @if (_igAccounts.Count == 0 && _tgAccounts.Count == 0 && _xAccounts.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@L["posts.social_missing_body", "Instagram, Telegram, and X have no saved account for this website. Open Social publishing under Website if you want to fill them in."]</MudAlert>
            }
            @if (_sendInstagram && _igAccounts.Count > 1)
            {
                <MudSelect T="int" Value="_igAccountId" ValueChanged="OnIgAccount" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="@L["posts.social_ig_channel", "Instagram channel"]">
                    @foreach (var account in _igAccounts)
                    {
                        <MudSelectItem T="int" Value="@account.AccountId">@ChannelLabel(account.Title, account.Username ?? account.IgUserId, account.LanguageCode)</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_sendTelegram && _tgAccounts.Count > 1)
            {
                <MudSelect T="int" Value="_tgAccountId" ValueChanged="OnTgAccount" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="@L["posts.social_tg_channel", "Telegram channel"]">
                    @foreach (var account in _tgAccounts)
                    {
                        <MudSelectItem T="int" Value="@account.AccountId">@ChannelLabel(account.Title, account.ChatId, account.LanguageCode)</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_sendX && _xAccounts.Count > 1)
            {
                <MudSelect T="int" Value="_xAccountId" ValueChanged="OnXAccount" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="@L["posts.social_x_channel", "X channel"]">
                    @foreach (var account in _xAccounts)
                    {
                        <MudSelectItem T="int" Value="@account.AccountId">@ChannelLabel(account.Title, account.Username, account.LanguageCode)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudCheckBox T="bool" Value="_useExcerpt" ValueChanged="OnUseExcerpt" Color="Color.Primary"
                         Label="@(ProductId > 0 ? L["products.social_use_short", "Use the short description"] : L["posts.social_use_summary", "Use the saved summary"])" />
            @if (_useExcerpt && _langs.Count > 1)
            {
                <MudSelect T="string" Value="_langCode" ValueChanged="OnLanguage" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="@L["posts.social_content_language", "Summary language"]">
                    @foreach (var lang in _langs)
                    {
                        <MudSelectItem T="string" Value="@lang.Code">@lang.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_useExcerpt)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @(string.IsNullOrWhiteSpace(_excerpt)
                        ? (ProductId > 0
                            ? L["products.social_short_empty", "This product has no short description."]
                            : L["posts.ig_excerpt_empty", "This post has no summary in the primary language."])
                        : _excerpt)
                </MudAlert>
            }
            else
            {
                <MudTextField T="string" Value="_caption" ValueChanged="OnCaption" Label="@L["posts.ig_caption", "Caption"]" Variant="Variant.Outlined"
                              Lines="4" MaxLength="2200" Counter="2200" Class="mb-3" />
            }
            @if (_keywords.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">@L["posts.social_hashtags", "Hashtags"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                    @L["posts.social_hashtags_hint", "Tick the keywords to add. Each one is sent as a hashtag on the last line."]
                </MudText>
                <MudStack Row="true" Spacing="1" Class="mb-3 flex-wrap">
                    @foreach (var word in _keywords)
                    {
                        var keyword = word;
                        <MudCheckBox T="bool" Value="_selectedKeywords.Contains(keyword)" Color="Color.Primary"
                                     ValueChanged="@(on => ToggleKeyword(keyword, on))" Label="@keyword" />
                    }
                </MudStack>
            }

            <MudCheckBox T="bool" Value="_shorten" ValueChanged="OnShorten" Color="Color.Primary"
                         Label="@L["posts.social_shorten", "Shorten the site link"]" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                @L["posts.social_shorten_hint", "A Persian address is very long after it is escaped. The short code stays the same if you later change where it goes, under Website → Short links."]
            </MudText>
            <MudText Typo="Typo.subtitle2">@L["posts.social_preview", "Message that will be sent"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                @L["posts.social_preview_hint", "This is the text that goes out. Add or change anything here. A blank line sits before the link and before the hashtags. On Telegram the address is sent as the word اینجا inside «برای اطلاعات بیشتر اینجا کلیک کنید», and the page card still loads under the message. Instagram and X keep the address itself."]
            </MudText>
            <MudTextField T="string" Value="_preview" ValueChanged="OnPreviewChanged" Variant="Variant.Outlined" Lines="8" Class="mb-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.caption" Color="@(_sendX && _preview.Length > 280 ? Color.Warning : Color.Secondary)">
                    @string.Format(L["posts.social_preview_count", "{0} characters. X keeps 280 and still includes the link."], _preview.Length)
                </MudText>
                <MudButton Variant="Variant.Text" Disabled="@(!_finalEdited)" OnClick="ResetPreviewAsync">
                    @L["posts.social_preview_reset", "Rebuild from the parts"]
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["posts.ig_media", "Photos and videos"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                @(ProductId > 0
                    ? L["products.social_media_hint", "Upload a file, paste a public https link, or use this product's photos and videos and crop them. Tick a network on each file. Instagram still needs a public https address. A file uploaded here is removed from storage when sending finishes. A photo already in the library stays."]
                    : L["posts.social_media_hint", "Upload a file, paste a public https link, or use this post's photos and crop them. Tick a network on each file. Instagram still needs a public https address. A file uploaded here is removed from storage when sending finishes. A photo already in the library stays."])
            </MudText>

            <MudStack Spacing="2" Class="mb-3">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var index = i;
                    var item = _items[i];
                    <MudPaper Outlined="true" Class="pa-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @if (!string.IsNullOrEmpty(item.PreviewUrl))
                            {
                                <img src="@item.PreviewUrl" alt="" style="width:72px;height:72px;object-fit:cover;border-radius:6px;" />
                            }
                            else
                            {
                                <MudIcon Icon="@(item.Kind == InstagramMediaKind.Video ? Icons.Material.Filled.Movie : Icons.Material.Filled.Image)" />
                            }
                            <MudStack Spacing="0" Style="flex:1;min-width:0">
                                <MudText Typo="Typo.body2">@item.Label</MudText>
                                @if (_coverIndex == index)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Primary">@L["posts.ig_cover", "Cover"]</MudText>
                                }
                                @if (item.Crop is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["posts.ig_cropped", "Cropped for Instagram"]</MudText>
                                }
                            </MudStack>
                            <MudIconButton Icon="@(_coverIndex == index ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                           Color="Color.Warning" Size="Size.Small"
                                           title="@L["posts.ig_cover", "Cover"]"
                                           OnClick="@(() => _coverIndex = index)" />
                            @if (item.Kind == InstagramMediaKind.Image)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Crop" Size="Size.Small" OnClick="@(() => CropAsync(index))" />
                            }
                            @if (_sendInstagram)
                            {
                                <MudCheckBox T="bool" Value="_items[index].ToInstagram" ValueChanged="@(v => _items[index].ToInstagram = v)" Label="IG" />
                            }
                            @if (_sendTelegram)
                            {
                                <MudCheckBox T="bool" Value="_items[index].ToTelegram" ValueChanged="@(v => _items[index].ToTelegram = v)" Label="TG" />
                            }
                            @if (_sendX)
                            {
                                <MudCheckBox T="bool" Value="_items[index].ToX" ValueChanged="@(v => _items[index].ToX = v)" Label="X" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveAt(index))" />
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudSelect T="InstagramMediaKind" @bind-Value="_linkKind" Label="@L["posts.ig_kind", "Type"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="InstagramMediaKind" Value="InstagramMediaKind.Image">@L["posts.ig_photo", "Photo"]</MudSelectItem>
                        <MudSelectItem T="InstagramMediaKind" Value="InstagramMediaKind.Video">@L["posts.ig_video", "Video"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_link" Label="@L["posts.ig_url", "Public https link"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" OnClick="AddLink">@L["add", "Add"]</MudButton>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="1" Class="mt-2 flex-wrap">
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="AddUploadsAsync" Accept="image/*,video/mp4,video/quicktime" MaximumFileCount="20">
                    <CustomContent Context="upload">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" HtmlTag="label"
                                   OnClick="@(() => upload.OpenFilePickerAsync())">@L["posts.ig_upload", "Upload"]</MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoLibrary" OnClick="AddLibraryAsync">@L["posts.ig_from_library", "Library photo"]</MudButton>
                @if (ProductId > 0)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Collections" OnClick="AddProductMediaAsync">@L["products.social_from_product", "This product's photos"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Collections" OnClick="AddPostPhotosAsync">@L["posts.ig_from_post", "This post's photos"]</MudButton>
                }
            </MudStack>

            @if (_items.Any(i => i.Kind == InstagramMediaKind.Video))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["posts.ig_video_cover", "Video cover"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                    @L["posts.ig_video_cover_hint", "Used as the thumbnail when the post is a single video. For several items, the cover marked above is the first slide."]
                </MudText>
                @if (_videoCover is not null)
                {
                    <MudChip T="string" Color="Color.Primary" OnClose="ClearVideoCover">@_videoCover.Label</MudChip>
                }
                <MudStack Row="true" Spacing="1" Class="mt-2">
                    <MudTextField @bind-Value="_coverLink" Label="@L["posts.ig_cover_url", "Cover image link"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Outlined" Class="mt-1" OnClick="AddCoverLink">@L["posts.ig_use_link", "Use link"]</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="PickCoverAsync">@L["posts.ig_from_library", "Library photo"]</MudButton>
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _loading)" OnClick="SendAsync">@L["posts.ig_publish", "Publish"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int PostId { get; set; }
    [Parameter] public int ProductId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _useExcerpt = true;
    private bool _sendInstagram;
    private bool _sendTelegram;
    private bool _sendX;
    private int _igAccountId;
    private int _tgAccountId;
    private int _xAccountId;
    private List<InstagramAccountStatus> _igAccounts = new();
    private List<TelegramAccountStatus> _tgAccounts = new();
    private List<XAccountStatus> _xAccounts = new();
    private readonly List<ContentLang> _langs = new();
    private string _langCode = "";
    private string _title = "";
    private string _excerpt = "";
    private string _caption = "";
    private string _preview = "";
    private string _composed = "";
    private bool _shorten = true;
    private bool _finalEdited;
    private bool _shortenFailed;
    private bool _longLinkLoaded;
    private string? _longLink;
    private int _websiteId;
    private bool _product;
    private string _slug = "";
    private readonly List<string> _keywords = new();
    private readonly HashSet<string> _selectedKeywords = new(StringComparer.Ordinal);
    private string _link = "";
    private string _coverLink = "";
    private InstagramMediaKind _linkKind = InstagramMediaKind.Image;
    private int _coverIndex;
    private readonly List<Draft> _items = new();
    private Draft? _videoCover;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        if (ProductId > 0)
        {
            var product = await Products.GetByIdAsync(ProductId);
            if (product is not null)
            {
                await LoadAccountsAsync(product.WebsiteID);
                _title = product.Title;
                _product = true;
                _slug = product.Slug;
                LoadProductLanguages(product);
                AddProductFiles(product);
            }
        }
        else
        {
            var post = await Posts.GetByIdAsync(PostId);
            if (post is not null)
            {
                await LoadAccountsAsync(post.WebsiteID);
                _title = post.Title;
                _slug = post.Slug;
                LoadPostLanguages(post);
                var images = await Posts.GetImagesAsync(PostId);
                foreach (var image in images.Where(i => i.FileRecord is not null))
                    AddLibraryFile(image.FileRecord!, InstagramMediaKind.Image);
                if (_items.Count == 0 && post.FeaturedImageFile is not null)
                    AddLibraryFile(post.FeaturedImageFile, InstagramMediaKind.Image);
            }
        }
        await RefreshPreviewAsync();
        _loading = false;
    }

    private async Task LoadAccountsAsync(int websiteId)
    {
        _websiteId = websiteId;
        _igAccounts = (await InstagramAccounts.ListAsync(websiteId)).Where(account => account.Connected).ToList();
        _tgAccounts = (await TelegramAccounts.ListAsync(websiteId)).Where(account => account.Connected).ToList();
        _xAccounts = (await XAccounts.ListAsync(websiteId)).Where(account => account.Connected).ToList();
        _sendInstagram = _igAccounts.Count > 0;
        _sendTelegram = _tgAccounts.Count > 0;
        _sendX = _xAccounts.Count > 0;
        _langs.Clear();
        var languages = await Languages.GetActiveForWebsiteAsync(websiteId);
        _siteLanguages = languages;
        _defaultLanguage = languages.FirstOrDefault(language => language.IsDefault)?.LanguageCode
            ?? languages.FirstOrDefault()?.LanguageCode
            ?? "";
    }

    private List<Language> _siteLanguages = new();
    private string _defaultLanguage = "";

    private void LoadPostLanguages(Post post)
    {
        if (string.IsNullOrWhiteSpace(_defaultLanguage) && post.PostTranslations.Count == 0)
        {
            _excerpt = post.Excerpt ?? "";
            FillKeywords(post.MetaKeywords);
            PickChannels();
            return;
        }
        AddLanguage(string.IsNullOrWhiteSpace(_defaultLanguage) ? "primary" : _defaultLanguage, post.Excerpt, post.MetaKeywords);
        foreach (var translation in post.PostTranslations)
        {
            if (SameLanguage(translation.LanguageCode, _defaultLanguage)) continue;
            AddLanguage(translation.LanguageCode, translation.Excerpt, translation.MetaKeywords);
        }
        ApplyLanguage(_langs.FirstOrDefault()?.Code ?? "");
        PickChannels();
    }

    private void LoadProductLanguages(Product product)
    {
        if (string.IsNullOrWhiteSpace(_defaultLanguage) && product.ProductTranslations.Count == 0)
        {
            _excerpt = product.ShortDescription ?? "";
            PickChannels();
            return;
        }
        AddLanguage(string.IsNullOrWhiteSpace(_defaultLanguage) ? "primary" : _defaultLanguage, product.ShortDescription, null);
        foreach (var translation in product.ProductTranslations)
        {
            if (SameLanguage(translation.LanguageCode, _defaultLanguage)) continue;
            AddLanguage(translation.LanguageCode, translation.ShortDescription, null);
        }
        ApplyLanguage(_langs.FirstOrDefault()?.Code ?? "");
        PickChannels();
    }

    private void AddLanguage(string? code, string? excerpt, string? keywords)
    {
        var key = string.IsNullOrWhiteSpace(code) ? _defaultLanguage : code.Trim();
        if (key.Length == 0 || _langs.Any(lang => SameLanguage(lang.Code, key))) return;
        var known = _siteLanguages.FirstOrDefault(language => SameLanguage(language.LanguageCode, key));
        _langs.Add(new ContentLang
        {
            Code = key,
            Name = known is null ? key : known.Name + " (" + known.LanguageCode + ")",
            Excerpt = excerpt ?? "",
            Keywords = keywords,
        });
    }

    private void ApplyLanguage(string code)
    {
        var lang = _langs.FirstOrDefault(item => SameLanguage(item.Code, code)) ?? _langs.FirstOrDefault();
        if (lang is null) return;
        _langCode = lang.Code;
        _excerpt = lang.Excerpt;
        FillKeywords(lang.Keywords);
    }

    private void FillKeywords(string? keywords)
    {
        _keywords.Clear();
        _selectedKeywords.Clear();
        foreach (var keyword in SocialHashtags.Split(keywords))
        {
            _keywords.Add(keyword);
            _selectedKeywords.Add(keyword);
        }
    }

    private void PickChannels()
    {
        _igAccountId = SocialChannelChoice.Prefer(_igAccounts.Select(account => (account.AccountId, account.LanguageCode)).ToList(), _langCode);
        _tgAccountId = SocialChannelChoice.Prefer(_tgAccounts.Select(account => (account.AccountId, account.LanguageCode)).ToList(), _langCode);
        _xAccountId = SocialChannelChoice.Prefer(_xAccounts.Select(account => (account.AccountId, account.LanguageCode)).ToList(), _langCode);
    }

    private static bool SameLanguage(string? left, string? right) =>
        string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string ChannelLabel(string? title, string? handle, string? language) =>
        SocialChannelChoice.Format(title, handle, language);

    private async Task OnLanguage(string code)
    {
        ApplyLanguage(code);
        PickChannels();
        _finalEdited = false;
        await RefreshPreviewAsync();
    }

    private Task OnIgAccount(int id)
    {
        _igAccountId = id;
        return Task.CompletedTask;
    }

    private Task OnTgAccount(int id)
    {
        _tgAccountId = id;
        return Task.CompletedTask;
    }

    private Task OnXAccount(int id)
    {
        _xAccountId = id;
        return Task.CompletedTask;
    }

    private async Task ToggleKeyword(string keyword, bool on)
    {
        if (on) _selectedKeywords.Add(keyword);
        else _selectedKeywords.Remove(keyword);
        await RefreshPreviewAsync();
    }

    private async Task OnUseExcerpt(bool value)
    {
        _useExcerpt = value;
        if (!value && string.IsNullOrWhiteSpace(_caption))
            _caption = _excerpt;
        await RefreshPreviewAsync();
    }

    private async Task OnCaption(string value)
    {
        _caption = value;
        await RefreshPreviewAsync();
    }

    private async Task OnShorten(bool value)
    {
        _shorten = value;
        if (value) _shortenFailed = false;
        await RefreshPreviewAsync();
    }

    private Task OnPreviewChanged(string value)
    {
        _preview = value ?? "";
        _finalEdited = !string.Equals(_preview, _composed, StringComparison.Ordinal);
        return Task.CompletedTask;
    }

    private async Task ResetPreviewAsync()
    {
        _finalEdited = false;
        await RefreshPreviewAsync();
    }

    private async Task<string?> CurrentLinkAsync()
    {
        if (!_longLinkLoaded && _websiteId > 0)
        {
            _longLinkLoaded = true;
            var status = await LinkSettings.GetAsync(_websiteId);
            _longLink = SocialLinkPaths.Build(
                status.WebsiteAddress,
                status.BaseUrl,
                _product ? status.ProductPath : status.PostPath,
                _product ? SocialLinkPaths.DefaultProduct : SocialLinkPaths.DefaultPost,
                _slug);
        }

        if (string.IsNullOrWhiteSpace(_longLink)) return null;
        if (!_shorten || _shortenFailed) return _longLink;
        try
        {
            return await ShortLinks.ToPublicAsync(_websiteId, _longLink);
        }
        catch (Exception ex)
        {
            _shortenFailed = true;
            Snackbar.Add(ex.Message, Severity.Warning);
            return _longLink;
        }
    }

    private async Task RefreshPreviewAsync()
    {
        var body = _useExcerpt ? _excerpt : _caption;
        var tags = SocialHashtags.Line(_keywords.Where(keyword => _selectedKeywords.Contains(keyword)));
        var link = await CurrentLinkAsync();
        _composed = SocialCaption.Join(body, link, tags);
        if (!_finalEdited)
            _preview = _composed;
    }
    private void OnSendInstagram(bool value) => _sendInstagram = value;
    private void OnSendTelegram(bool value) => _sendTelegram = value;
    private void OnSendX(bool value) => _sendX = value;

    private void AddLink()
    {
        var url = _link.Trim();
        if (url.Length == 0) return;
        if (_items.Count >= 20)
        {
            Snackbar.Add(L["posts.social_max", "The window holds at most 20 files. Instagram still accepts only 10 of them."], Severity.Warning);
            return;
        }
        _items.Add(new Draft
        {
            Kind = _linkKind,
            Url = url,
            Label = url,
            PreviewUrl = _linkKind == InstagramMediaKind.Image ? url : null,
        });
        _link = "";
    }

    private async Task AddUploadsAsync(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            if (_items.Count >= 20) break;
            var video = file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
            var max = video ? 50L * 1024 * 1024 : 8L * 1024 * 1024;
            if (file.Size > max)
            {
                Snackbar.Add(video
                    ? L["posts.ig_video_limit", "Upload a video under 50 MB, or paste a public link."]
                    : L["posts.ig_photo_limit", "Upload a photo under 8 MB, or paste a public link."], Severity.Warning);
                continue;
            }

            await using var stream = file.OpenReadStream(max);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            _items.Add(new Draft
            {
                Kind = video ? InstagramMediaKind.Video : InstagramMediaKind.Image,
                Content = bytes,
                FileName = file.Name,
                MimeType = file.ContentType,
                Label = file.Name,
                PreviewUrl = video ? null : $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}",
            });
        }
    }

    private async Task AddLibraryAsync() => await PickAsync(InstagramMediaKind.Image, coverOnly: false);

    private async Task PickCoverAsync() => await PickAsync(InstagramMediaKind.Image, coverOnly: true);

    private async Task PickAsync(InstagramMediaKind kind, bool coverOnly)
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.Category)] = kind == InstagramMediaKind.Video ? FileCategory.Video : FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: FileRecord file }) return;
        if (coverOnly)
        {
            _videoCover = DraftFromFile(file, InstagramMediaKind.Image);
            return;
        }
        if (_items.Count >= 20) return;
        AddLibraryFile(file, kind);
    }

    private async Task AddProductMediaAsync()
    {
        var product = await Products.GetByIdAsync(ProductId);
        if (product is null) return;
        AddProductFiles(product);
    }

    private void AddProductFiles(Product product)
    {
        var items = product.ProductMedia
            .OrderBy(m => m.SortOrder)
            .SelectMany(m => m.MediaSet?.MediaSetItems ?? [])
            .OrderBy(i => i.SortOrder);
        foreach (var item in items)
        {
            if (_items.Count >= 20) break;
            if (item.File is not null && item.File.FileCategory == (byte)FileCategory.Video)
                AddLibraryFile(item.File, InstagramMediaKind.Video);
            else if (item.File is not null && item.File.FileCategory == (byte)FileCategory.Image)
                AddLibraryFile(item.File, InstagramMediaKind.Image);
            else if (!string.IsNullOrWhiteSpace(item.ExternalVideoUrl)
                     && _items.All(i => !string.Equals(i.Url, item.ExternalVideoUrl, StringComparison.OrdinalIgnoreCase)))
            {
                _items.Add(new Draft
                {
                    Kind = InstagramMediaKind.Video,
                    Url = item.ExternalVideoUrl,
                    Label = item.ExternalVideoUrl,
                });
            }
        }

        if (_items.Count == 0 && product.FeaturedImageFile is not null)
            AddLibraryFile(product.FeaturedImageFile, InstagramMediaKind.Image);
    }

    private async Task AddPostPhotosAsync()
    {
        var images = await Posts.GetImagesAsync(PostId);
        var files = images.Select(i => i.FileRecord).Where(f => f is not null).Cast<FileRecord>().ToList();
        if (files.Count == 0)
        {
            var post = await Posts.GetByIdAsync(PostId);
            if (post?.FeaturedImageFile is not null) files.Add(post.FeaturedImageFile);
        }
        foreach (var file in files)
        {
            if (_items.Count >= 20) break;
            if (_items.Any(i => i.FileRecordId == file.FileRecordID)) continue;
            AddLibraryFile(file, InstagramMediaKind.Image);
        }
    }

    private void AddLibraryFile(FileRecord file, InstagramMediaKind kind)
    {
        if (_items.Any(i => i.FileRecordId == file.FileRecordID && i.Content is null)) return;
        _items.Add(DraftFromFile(file, kind));
    }

    private static Draft DraftFromFile(FileRecord file, InstagramMediaKind kind) => new()
    {
        Kind = kind,
        FileRecordId = file.FileRecordID,
        Label = string.IsNullOrWhiteSpace(file.Title) ? file.OriginalFileName : file.Title,
        PreviewUrl = kind == InstagramMediaKind.Image ? file.ThumbnailCDN ?? file.CNDUrl : null,
    };

    private async Task CropAsync(int index)
    {
        var item = _items[index];
        var parameters = new DialogParameters
        {
            [nameof(MediaEditDialog.ImageUrl)] = item.PreviewUrl,
            [nameof(MediaEditDialog.ReplaceExisting)] = true,
        };
        var dialog = await DialogService.ShowAsync<MediaEditDialog>(L["posts.ig_crop", "Crop for Instagram"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileEditSpec spec })
            item.Crop = spec.Crop;
    }

    private void AddCoverLink()
    {
        var url = _coverLink.Trim();
        if (url.Length == 0) return;
        _videoCover = new Draft { Kind = InstagramMediaKind.Image, Url = url, Label = url, PreviewUrl = url };
        _coverLink = "";
    }

    private void ClearVideoCover() => _videoCover = null;

    private void RemoveAt(int index)
    {
        _items.RemoveAt(index);
        if (_coverIndex >= _items.Count) _coverIndex = Math.Max(0, _items.Count - 1);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SendAsync()
    {
        if (_busy) return;
        if (!_sendInstagram && !_sendTelegram && !_sendX)
        {
            Snackbar.Add(L["posts.social_pick", "Choose Instagram, Telegram, or X."], Severity.Warning);
            return;
        }
        if (_sendInstagram && !_items.Any(i => i.ToInstagram))
        {
            Snackbar.Add(L["posts.ig_need_media", "Add a photo or a video for Instagram."], Severity.Warning);
            return;
        }
        if (_sendInstagram && _items.Count(i => i.ToInstagram) > 10)
        {
            Snackbar.Add(L["posts.ig_max", "Instagram accepts at most 10 items."], Severity.Warning);
            return;
        }
        if (_items.Count == 0 && !(_sendTelegram || _sendX))
        {
            Snackbar.Add(L["posts.ig_need_media", "Add a photo or a video."], Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var request = new InstagramPublishRequest
            {
                Caption = _finalEdited ? _preview : _caption,
                UsePrimaryExcerpt = _finalEdited ? false : _useExcerpt,
                SkipAppend = _finalEdited,
                ShortenLink = _finalEdited ? false : _shorten,
                CoverIndex = _coverIndex,
                SendInstagram = _sendInstagram,
                SendTelegram = _sendTelegram,
                SendX = _sendX,
                InstagramAccountId = _sendInstagram && _igAccountId > 0 ? _igAccountId : null,
                TelegramAccountId = _sendTelegram && _tgAccountId > 0 ? _tgAccountId : null,
                XAccountId = _sendX && _xAccountId > 0 ? _xAccountId : null,
                ContentLanguageCode = _useExcerpt && !string.IsNullOrWhiteSpace(_langCode) && !SameLanguage(_langCode, _defaultLanguage)
                    ? _langCode
                    : null,
                Hashtags = _finalEdited ? [] : _keywords.Where(keyword => _selectedKeywords.Contains(keyword)).ToList(),
                Items = _items.Select(ToItem).ToList(),
                VideoCover = _videoCover is null ? null : ToItem(_videoCover),
            };
            var sent = ProductId > 0
                ? await Publisher.PublishProductAsync(ProductId, request)
                : await Publisher.PublishAsync(PostId, request);
            foreach (var error in sent.Errors)
                Snackbar.Add(error, sent.Instagram || sent.Telegram || sent.X ? Severity.Warning : Severity.Error);
            if (!sent.Instagram && !sent.Telegram && !sent.X)
                return;
            Snackbar.Add(L["posts.social_published", "Sent to the selected networks."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(sent));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static InstagramMediaItem ToItem(Draft draft) => new()
    {
        Kind = draft.Kind,
        Url = draft.Url,
        FileRecordId = draft.FileRecordId,
        Content = draft.Content,
        FileName = draft.FileName,
        MimeType = draft.MimeType,
        Crop = draft.Crop,
        ToInstagram = draft.ToInstagram,
        ToTelegram = draft.ToTelegram,
        ToX = draft.ToX,
    };

    private sealed class Draft
    {
        public InstagramMediaKind Kind { get; set; }
        public string? Url { get; set; }
        public int? FileRecordId { get; set; }
        public byte[]? Content { get; set; }
        public string? FileName { get; set; }
        public string? MimeType { get; set; }
        public ImageCropRect? Crop { get; set; }
        public bool ToInstagram { get; set; } = true;
        public bool ToTelegram { get; set; } = true;
        public bool ToX { get; set; } = true;
        public string? PreviewUrl { get; set; }
        public string Label { get; set; } = "";
    }

    private sealed class ContentLang
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Excerpt { get; set; } = "";
        public string? Keywords { get; set; }
    }
}
