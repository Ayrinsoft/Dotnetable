@inject ICategoryService CategoryService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject ILanguageService LanguageService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="Model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="Category" Value="@GetSelectedParent()" ValueChanged="OnParentChanged"
                                     SearchFunc="SearchParents" ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                     Label="@L["categories.parent", "Parent"]" Variant="Variant.Outlined"
                                     Clearable="true" CoerceText="false" ResetValueOnEmptyText="true"
                                     HelperText="@L["categories.parent_hint", "Clear for top-level. Type to search."]" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PostType" Value="@GetSelectedPostType()" ValueChanged="OnPostTypeChanged"
                                     SearchFunc="SearchPostTypes" ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     Label="@L["post_type", "Post Type"]" Variant="Variant.Outlined"
                                     Clearable="true" CoerceText="false" ResetValueOnEmptyText="true"
                                     HelperText="@L["categories.any_type_hint", "Clear for any type. Type to search."]" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" @bind-Value="Model.SortOrder" Label="@L["categories.sort", "Sort order"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Color="Color.Success"
                               Label="@(Model.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])" />
                </MudItem>
                @if (_languages.Length > 0)
                {
                <MudItem xs="12">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                            </MudText>
                            @foreach (var (code, label) in _languages)
                            {
                                <MudGrid Spacing="2" Class="mb-1">
                                    <MudItem xs="7">
                                        <MudTextField T="string" Value="@Name(code)" ValueChanged="@(v => SetName(code, v))"
                                                      Label="@($"{label} — {L["name", "Name"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="5">
                                        <MudTextField T="string" Value="@Slug(code)" ValueChanged="@(v => SetSlug(code, v))"
                                                      Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
                }
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Category Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public IReadOnlyList<Category> AllCategories { get; set; } = Array.Empty<Category>();
    [Parameter] public IReadOnlyList<PostType> PostTypes { get; set; } = Array.Empty<PostType>();

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private readonly Dictionary<string, (string Name, string Slug)> _tr = new(StringComparer.OrdinalIgnoreCase);

    // Exclude self and descendants as parent candidates.
    private IEnumerable<Category> ParentCandidates
    {
        get
        {
            var forbidden = DescendantIds(Model.CategoryID);
            forbidden.Add(Model.CategoryID);
            return AllCategories.Where(c => !forbidden.Contains(c.CategoryID));
        }
    }

    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    protected override async Task OnInitializedAsync()
    {
        var websiteId = Model.WebsiteID > 0 ? Model.WebsiteID : L.WebsiteId;
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        if (!IsNew)
            foreach (var t in await CategoryService.GetTranslationsAsync(Model.CategoryID))
                _tr[t.LanguageCode] = (t.Name, t.Slug);
    }

    private string Name(string code) => _tr.TryGetValue(code, out var v) ? v.Name : string.Empty;
    private string Slug(string code) => _tr.TryGetValue(code, out var v) ? v.Slug : string.Empty;
    private void SetName(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (v ?? string.Empty, c.Slug ?? string.Empty); }
    private void SetSlug(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (c.Name ?? string.Empty, v ?? string.Empty); }

    private Category? GetSelectedParent() =>
        Model.ParentCategoryID is int id ? ParentCandidates.FirstOrDefault(c => c.CategoryID == id) : null;

    private void OnParentChanged(Category? parent) =>
        Model.ParentCategoryID = parent?.CategoryID;

    private Task<IEnumerable<Category>> SearchParents(string value, CancellationToken ct)
    {
        IEnumerable<Category> q = ParentCandidates.OrderBy(c => c.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private PostType? GetSelectedPostType() =>
        Model.PostTypeID is int id ? PostTypes.FirstOrDefault(t => t.PostTypeID == id) : null;

    private void OnPostTypeChanged(PostType? type) =>
        Model.PostTypeID = type?.PostTypeID;

    private Task<IEnumerable<PostType>> SearchPostTypes(string value, CancellationToken ct)
    {
        IEnumerable<PostType> q = PostTypes.OrderBy(t => t.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(t => t.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private HashSet<int> DescendantIds(int rootId)
    {
        var result = new HashSet<int>();
        if (rootId == 0) return result;
        var queue = new Queue<int>();
        queue.Enqueue(rootId);
        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            foreach (var child in AllCategories.Where(c => c.ParentCategoryID == id))
                if (result.Add(child.CategoryID)) queue.Enqueue(child.CategoryID);
        }
        return result;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;
        if (string.IsNullOrWhiteSpace(Model.Name)) return;
        if (string.IsNullOrWhiteSpace(Model.Slug)) Model.Slug = Model.Name.Trim();

        // Optional FKs: clearable MudSelect can bind 0 instead of null (breaks SQL FKs).
        if (Model.ParentCategoryID is 0) Model.ParentCategoryID = null;
        if (Model.PostTypeID is 0) Model.PostTypeID = null;
        if (Model.WebsiteID <= 0)
        {
            Snackbar.Add(L["website_required", "Select a website first."], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsNew)
                Model = await CategoryService.CreateAsync(Model);
            else
                await CategoryService.UpdateAsync(Model);
            await CategoryService.SetTranslationsAsync(Model.CategoryID, _tr);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
