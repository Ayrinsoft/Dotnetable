@page "/content/categories"
@attribute [Authorize(Policy = RoleKeys.TaxonomyView)]
@inject ICategoryService CategoryService
@inject IPostTypeService PostTypeService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["categories", "Categories"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["categories", "Categories"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["categories.subtitle", "Nested, per-post-type categories with translations."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["categories.new", "New Category"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["categories.empty", "No categories yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in _items)
            {
                <tr>
                    <td>@c.Name</td>
                    <td><code>@c.Slug</code></td>
                    <td>@(_postTypes.FirstOrDefault(p => p.PostTypeID == c.PostTypeID)?.Name ?? "-")</td>
                    <td>@c.SortOrder</td>
                    <td>@(c.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(c))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(c))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Category> _items = new();
    private List<PostType> _postTypes = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.TaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.TaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.TaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Category.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["slug", "Slug"], ColumnName = nameof(Category.Slug), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["post_type", "Post Type"], ColumnName = nameof(Category.PostTypeID), HasSort = true },
                new() { ColumnTitle = L["categories.sort", "Sort"], ColumnName = nameof(Category.SortOrder), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(Category.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await CategoryService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _postTypes = await PostTypeService.GetAllAsync(_websiteId);
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Category { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Category c)
    {
        var copy = new Category
        {
            CategoryID = c.CategoryID, WebsiteID = c.WebsiteID, PostTypeID = c.PostTypeID,
            ParentCategoryID = c.ParentCategoryID, Name = c.Name, Slug = c.Slug,
            SortOrder = c.SortOrder, IsActive = c.IsActive,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Category model, bool isNew)
    {
        var allCategories = await CategoryService.GetAllAsync(_websiteId);
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Model, model }, { x => x.IsNew, isNew },
            { x => x.AllCategories, allCategories }, { x => x.PostTypes, _postTypes },
        };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(
            isNew ? L["categories.new", "New Category"] : L["categories.edit", "Edit Category"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Category c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["categories.delete", "Delete category"],
            L["categories.delete_confirm", "Delete this category? Child categories move up to its parent."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await CategoryService.DeleteAsync(c.CategoryID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
