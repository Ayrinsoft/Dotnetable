@page "/content/redirects"
@attribute [Authorize(Policy = RoleKeys.RedirectsView)]
@inject IRedirectService RedirectService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["redirects", "Redirects"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["redirects", "Redirects"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["redirects.subtitle", "Redirect legacy or vanity URLs (301/302), with literal or regex matching."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:180px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["redirects.new", "New Redirect"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center; padding:32px;">
                <MudText Color="Color.Secondary">@L["redirects.empty", "No redirects defined."]</MudText>
            </td></tr>
        }
        else
        {
            @foreach (var r in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="1">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditAsync(r))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(r))" />
                            }
                        </MudStack>
                    </td>
                    <td><code>@r.SourcePath</code></td>
                    <td><code>@r.TargetPath</code></td>
                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@r.StatusCode</MudChip></td>
                    <td>@(r.IsRegex ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudSwitch T="bool" Value="r.IsActive" Color="Color.Success"
                                   Disabled="@(!_canEdit || _busy.Contains(r.WebsiteRedirectID))"
                                   ValueChanged="@(v => ToggleActiveAsync(r, v))" />
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<WebsiteRedirect> _items = new();
    private List<Website> _websites = new();
    private HashSet<int> _busy = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.RedirectsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.RedirectsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.RedirectsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["redirects.source", "Source"], ColumnName = nameof(WebsiteRedirect.SourcePath), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["redirects.target", "Target"], ColumnName = nameof(WebsiteRedirect.TargetPath), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["redirects.status", "Status"], ColumnName = nameof(WebsiteRedirect.StatusCode), HasSort = true },
                new() { ColumnTitle = L["redirects.regex", "Regex"], ColumnName = "" },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(WebsiteRedirect.IsActive), HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    OtherDropDownValues = new() { [L["active", "Active"]] = "true", [L["inactive", "Inactive"]] = "false" } },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(IEnumerable<int> _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await RedirectService.GetPagedAsync(_isMaster ? _websiteId : _websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ToggleActiveAsync(WebsiteRedirect r, bool value)
    {
        if (!_busy.Add(r.WebsiteRedirectID)) return;
        r.IsActive = value;
        try { await RedirectService.SetActiveAsync(r.WebsiteRedirectID, value); }
        finally { _busy.Remove(r.WebsiteRedirectID); }
    }

    private async Task CreateAsync()
    {
        var result = await ShowDialogAsync(new WebsiteRedirect { WebsiteID = _websiteId, StatusCode = 301, IsActive = true }, true);
        if (result) await LoadAsync();
    }

    private async Task EditAsync(WebsiteRedirect r)
    {
        var copy = new WebsiteRedirect
        {
            WebsiteRedirectID = r.WebsiteRedirectID, WebsiteID = r.WebsiteID,
            SourcePath = r.SourcePath, TargetPath = r.TargetPath,
            StatusCode = r.StatusCode, IsRegex = r.IsRegex, IsActive = r.IsActive,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(WebsiteRedirect model, bool isNew)
    {
        var parameters = new DialogParameters<RedirectDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<RedirectDialog>(
            isNew ? L["redirects.new", "New Redirect"] : L["redirects.edit", "Edit Redirect"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(WebsiteRedirect r)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["redirects.delete", "Delete redirect"],
            L["redirects.delete_confirm", "Delete this redirect rule?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        await RedirectService.DeleteAsync(r.WebsiteRedirectID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
