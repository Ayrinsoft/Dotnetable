@page "/content/quizzes"
@attribute [Authorize(Policy = RoleKeys.QuizzesView)]
@inject IQuizService QuizService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject NavigationManager Nav

<DNPageTitle Title=@L["quizzes", "Tests"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["quizzes", "Tests"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["quizzes.hint", "A test has a time limit, an answer key, and a score result. Put a test or a test category on a menu."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined" Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Href="/content/quiz-categories" StartIcon="@Icons.Material.Filled.Category">
            @L["quizzes.categories", "Test categories"]
        </MudButton>
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Create">
                @L["quizzes.new", "New test"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudText Color="Color.Secondary">@L["quizzes.empty", "No tests yet."]</MudText>
    }
    else
    {
        <MudTable Items="_items" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>@L["title", "Title"]</MudTh>
                <MudTh>@L["quizzes.category", "Category"]</MudTh>
                <MudTh>@L["quizzes.questions", "Questions"]</MudTh>
                <MudTh>@L["quizzes.time", "Time"]</MudTh>
                <MudTh>@L["quizzes.menu_id", "Menu id"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Title
                    @if (!context.IsPublished)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["draft", "Draft"]</MudChip>
                    }
                </MudTd>
                <MudTd>@context.CategoryTitle</MudTd>
                <MudTd>
                    @if (context.QuestionMode == (byte)QuizQuestionMode.Random)
                    {
                        @($"{context.RandomCount} / {context.QuestionCount}")
                    }
                    else
                    {
                        @context.QuestionCount
                    }
                </MudTd>
                <MudTd>@context.DurationMinutes</MudTd>
                <MudTd>@context.QuizID</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"/content/quizzes/{context.QuizID}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Title="@L["quizzes.sittings", "Sittings"]"
                                   Href="@($"/content/quizzes/{context.QuizID}/attempts")" />
                    @if (_canDelete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster, _canInsert, _canDelete;
    private int _websiteId;
    private List<QuizListItemDto> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.QuizzesInsert);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.QuizzesDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private int? Scope => _isMaster && _websiteId == 0 ? null : _websiteId;

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await QuizService.GetQuizzesAsync(Scope);
        _loading = false;
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        await LoadAsync();
    }

    private void Create()
    {
        if (_websiteId == 0)
        {
            Snackbar.Add(L["quizzes.pick_website", "Pick a website first."], Severity.Warning);
            return;
        }
        Nav.NavigateTo($"/content/quizzes/new?website={_websiteId}");
    }

    private async Task DeleteAsync(QuizListItemDto item)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(L["delete", "Delete"], item.Title, yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirm != true) return;
        var error = await QuizService.DeleteQuizAsync(item.QuizID, Scope);
        if (error is not null) Snackbar.Add(error, Severity.Error);
        else await LoadAsync();
    }
}
