@page "/content/quiz-categories"
@attribute [Authorize(Policy = RoleKeys.QuizzesView)]
@inject IQuizService QuizService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["quizzes.categories", "Test categories"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["quizzes.categories", "Test categories"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["quizzes.categories_hint", "Group tests such as personality or intelligence. A category can be a menu item, and it can also be listed on the blog."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined" Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["quizzes.category_new", "New category"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudText Color="Color.Secondary">@L["quizzes.categories_empty", "No test categories yet."]</MudText>
    }
    else
    {
        <MudTable Items="_items" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>@L["title", "Title"]</MudTh>
                <MudTh>@L["slug", "Slug"]</MudTh>
                <MudTh>@L["quizzes.count", "Tests"]</MudTh>
                <MudTh>@L["quizzes.menu_id", "Menu id"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd><code>@context.Slug</code></MudTd>
                <MudTd>@context.QuizCount</MudTd>
                <MudTd>@context.QuizCategoryID</MudTd>
                <MudTd>
                    @if (_canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
                    }
                    @if (_canDelete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<QuizCategoryListItemDto> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.QuizzesInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.QuizzesEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.QuizzesDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var scope = _isMaster && _websiteId == 0 ? (int?)null : _websiteId;
        _items = await QuizService.GetCategoriesAsync(scope);
        _loading = false;
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        await LoadAsync();
    }

    private async Task CreateAsync() => await EditModelAsync(new QuizCategoryEditorDto
    {
        WebsiteID = _websiteId,
        IsActive = true,
    });

    private async Task EditAsync(QuizCategoryListItemDto item)
    {
        var model = await QuizService.GetCategoryAsync(item.QuizCategoryID, _isMaster && _websiteId == 0 ? null : _websiteId);
        if (model is null) return;
        await EditModelAsync(model);
    }

    private async Task EditModelAsync(QuizCategoryEditorDto model)
    {
        var parameters = new DialogParameters
        {
            [nameof(QuizCategoryDialog.Model)] = model,
            [nameof(QuizCategoryDialog.Parents)] = _items,
        };
        var dialog = await DialogService.ShowAsync<QuizCategoryDialog>(L["quizzes.category", "Test category"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not QuizCategoryEditorDto saved) return;
        var (ok, error, _) = await QuizService.SaveCategoryAsync(saved);
        if (!ok) Snackbar.Add(error ?? L["save_failed", "Could not save."], Severity.Error);
        else
        {
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(QuizCategoryListItemDto item)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(L["delete", "Delete"], item.Title, yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirm != true) return;
        var error = await QuizService.DeleteCategoryAsync(item.QuizCategoryID, _isMaster && _websiteId == 0 ? null : _websiteId);
        if (error is not null) Snackbar.Add(error, Severity.Error);
        else await LoadAsync();
    }
}
