@page "/content/pages"
@using Page = Dotnetable.Domain.Entities.Page
@attribute [Authorize(Policy = RoleKeys.PagesView)]
@inject IPageService PageService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["pages", "Pages"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["pages", "Pages"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["pages.subtitle", "Static CMS pages with translations and templates."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:180px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/content/pages/new">
                @L["pages.new", "New Page"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center; padding:32px;">
                <MudText Color="Color.Secondary">@L["pages.empty", "No pages yet."]</MudText>
            </td></tr>
        }
        else
        {
            @foreach (var p in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="1">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Href="@($"/content/pages/{p.PageID}")" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(p))" />
                            }
                        </MudStack>
                    </td>
                    <td>@p.Title @(p.IsHomepage ? $"({L["pages.homepage", "Homepage"]})" : "")</td>
                    <td><code>@p.Slug</code></td>
                    <td>@StatusLabel(p.Status)</td>
                    <td>
                        <MudSwitch T="bool" Value="p.IsActive" Color="Color.Success"
                                   Disabled="@(!_canEdit || _busy.Contains(p.PageID))"
                                   ValueChanged="@(v => ToggleActiveAsync(p, v))" />
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Page> _items = new();
    private List<Website> _websites = new();
    private HashSet<int> _busy = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.PagesInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.PagesEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.PagesDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(Page.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["slug", "Slug"], ColumnName = nameof(Page.Slug), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = "" },
                new() { ColumnTitle = L["active", "Active"], ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(IEnumerable<int> _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await PageService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ToggleActiveAsync(Page p, bool value)
    {
        if (!_busy.Add(p.PageID)) return;
        p.IsActive = value;
        try { await PageService.SetActiveAsync(p.PageID, value); }
        finally { _busy.Remove(p.PageID); }
    }

    private async Task DeleteAsync(Page p)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["pages.delete", "Delete page"],
            L["pages.delete_confirm", "Delete this page and its translations?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await PageService.DeleteAsync(p.PageID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private string StatusLabel(byte s) => s switch
    {
        0 => L["pages.draft", "Draft"],
        1 => L["pages.published", "Published"],
        _ => s.ToString(),
    };
}
