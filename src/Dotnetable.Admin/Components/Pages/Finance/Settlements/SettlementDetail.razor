@page "/finance/settlements/{SettlementId:int}"
@attribute [Authorize(Policy = RoleKeys.SettlementsView)]
@inject ISettlementService SettlementService
@inject IBankAccountService BankAccountService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title="@(_s is null ? "" : $"S-{_s.SettlementID}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_s is null)
{
    <MudText Color="Color.Error">@L["settlements.not_found", "Settlement not found."]</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">S-@_s.SettlementID</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_s.CreatedAt.ToLocalTime().ToString("g")</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Color="@StatusColor(_s.Status)">@StatusLabel(_s.Status)</MudChip>
            <MudButton OnClick="@(() => Nav.NavigateTo("/finance/settlements"))">@L["back", "Back"]</MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["settlements.party", "Counterparty"]</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td>@L["settlements.target_type", "Target type"]</td><td>@((SettlementTargetType)_s.TargetType)</td></tr>
                        @if (_s.Vendor is not null)
                        {
                            <tr><td>@L["vendors", "Vendor"]</td><td>@_s.Vendor.Name</td></tr>
                        }
                        @if (_s.Supplier is not null)
                        {
                            <tr><td>@L["suppliers", "Supplier"]</td><td>@_s.Supplier.Name</td></tr>
                            @if (!string.IsNullOrEmpty(_s.Supplier.LegalName))
                            {
                                <tr><td>@L["suppliers.legal_name", "Legal name"]</td><td>@_s.Supplier.LegalName</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(_s.Supplier.TaxIdentificationNumber))
                            {
                                <tr><td>@L["suppliers.tax_id", "Tax ID"]</td><td>@_s.Supplier.TaxIdentificationNumber</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(_s.Supplier.VatNumber))
                            {
                                <tr><td>@L["suppliers.vat_number", "VAT"]</td><td>@_s.Supplier.VatNumber</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(_s.Supplier.EconomicCode))
                            {
                                <tr><td>@L["suppliers.economic_code", "Economic code"]</td><td>@_s.Supplier.EconomicCode</td></tr>
                            }
                        }
                        @if (_s.TargetWebsite is not null)
                        {
                            <tr><td>@L["website", "Website"]</td><td>@_s.TargetWebsite.BrandName (@_s.TargetWebsite.TradeName)</td></tr>
                        }
                        <tr><td>@L["settlements.period", "Period"]</td><td>@_s.PeriodFrom.ToString("yyyy-MM-dd") → @_s.PeriodTo.ToString("yyyy-MM-dd")</td></tr>
                        @if (!string.IsNullOrEmpty(_s.Note))
                        {
                            <tr><td>@L["notes", "Notes"]</td><td style="white-space:pre-wrap">@_s.Note</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(_s.PaymentRefNumber))
                        {
                            <tr><td>@L["settlements.payment_ref", "Payment ref"]</td><td>@_s.PaymentRefNumber</td></tr>
                        }
                        @if (_s.PaidAt is DateTime paid)
                        {
                            <tr><td>@L["settlements.paid_at", "Paid at"]</td><td>@paid.ToLocalTime().ToString("g")</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["settlements.lines", "Lines"]</MudText>
                @if (_s.SettlementItems.Count == 0)
                {
                    <MudText Color="Color.Secondary">@L["settlements.no_lines", "No line items."]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead>
                            <tr>
                                <th>@L["description", "Description"]</th>
                                <th class="text-end">@L["amount", "Amount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _s.SettlementItems)
                            {
                                <tr>
                                    <td>@(line.Description ?? "—")</td>
                                    <td class="text-end">@line.Amount.ToString("0.####")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["settlements.amounts", "Amounts"]</MudText>
                <MudStack Spacing="1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>@L["settlements.net", "Net"]</MudText>
                        <MudText>@_s.NetAmount.ToString("0.##") @_s.CurrencyCode</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>@L["settlements.tax", "Tax"]</MudText>
                        <MudText>@_s.TaxAmount.ToString("0.##")</MudText>
                    </MudStack>
                    @if (_s.TaxRateSnapshot is decimal rate)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption">@L["settlements.tax_rate", "Tax rate snapshot"]</MudText>
                            <MudText Typo="Typo.caption">@((rate * 100).ToString("0.##"))%</MudText>
                        </MudStack>
                    }
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2">@L["settlements.gross", "Gross"]</MudText>
                        <MudText Typo="Typo.subtitle2">@_s.TotalAmount.ToString("0.##") @_s.CurrencyCode</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <RecordAttachmentsPanel WebsiteId="_s.WebsiteID"
                                   EntityType="@Dotnetable.Application.RecordAttachments.RecordEntityTypes.Settlement"
                                   EntityId="_s.SettlementID"
                                   CanEdit="_canEdit"
                                   Title="@L["attachments.settlement", "Settlement payment proofs"]" />

            @if (_canEdit && _s.Status != (byte)SettlementStatus.Paid && _s.Status != (byte)SettlementStatus.Cancelled)
            {
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["settlements.actions", "Actions"]</MudText>
                    @if (_s.Status is (byte)SettlementStatus.Open or (byte)SettlementStatus.Draft)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true" Class="mb-2" OnClick="ApproveAsync">
                            @L["settlements.approve", "Approve"]
                        </MudButton>
                    }
                    <MudAutocomplete T="BankAccount" Value="@_bank" ValueChanged="v => _bank = v"
                                     SearchFunc="SearchBanks" ToStringFunc="BankDisplay"
                                     Label="@L["bank_accounts", "Bank account"]" Variant="Variant.Outlined" Dense="true" Class="mb-2"
                                     Clearable="true" CoerceText="false" />
                    <MudTextField @bind-Value="_paymentRef" Label="@L["settlements.payment_ref", "Payment ref"]" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mb-2" OnClick="MarkPaidAsync">
                        @L["settlements.mark_paid", "Mark paid"]
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="CancelAsync">
                        @L["settlements.cancel", "Cancel settlement"]
                    </MudButton>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int SettlementId { get; set; }

    private bool _loading = true;
    private bool _canEdit;
    private Settlement? _s;
    private List<BankAccount> _banks = new();
    private BankAccount? _bank;
    private string? _paymentRef;
    private int? _memberId;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _canEdit = AdminPolicies.Allows(user, RoleKeys.SettlementsEdit);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _memberId = mid;

        await ReloadAsync();
        if (_s is not null)
            _banks = await BankAccountService.GetByWebsiteAsync(_s.WebsiteID);
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _s = await SettlementService.GetByIdAsync(SettlementId);
        _loading = false;
    }

    private static string BankDisplay(BankAccount? b) =>
        b is null ? "" : $"{b.Title}{(string.IsNullOrEmpty(b.AccountNumber) ? "" : $" / {b.AccountNumber}")}";

    private Task<IEnumerable<BankAccount>> SearchBanks(string value, CancellationToken ct)
    {
        IEnumerable<BankAccount> q = _banks;
        if (!string.IsNullOrWhiteSpace(value))
            q = q.Where(b => b.Title.Contains(value, StringComparison.OrdinalIgnoreCase)
                             || (b.AccountNumber?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
                             || (b.OwnerName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false));
        return Task.FromResult(q);
    }

    private string StatusLabel(byte status) => ((SettlementStatus)status) switch
    {
        SettlementStatus.Draft => L["settlements.status.draft", "Draft"],
        SettlementStatus.Open => L["settlements.status.open", "Open"],
        SettlementStatus.Approved => L["settlements.status.approved", "Approved"],
        SettlementStatus.Paid => L["settlements.status.paid", "Paid"],
        SettlementStatus.Cancelled => L["settlements.status.cancelled", "Cancelled"],
        _ => status.ToString(),
    };

    private Color StatusColor(byte status) => ((SettlementStatus)status) switch
    {
        SettlementStatus.Paid => Color.Success,
        SettlementStatus.Approved => Color.Info,
        SettlementStatus.Cancelled => Color.Error,
        SettlementStatus.Open => Color.Warning,
        _ => Color.Default,
    };

    private async Task ApproveAsync()
    {
        if (!await SettlementService.ApproveAsync(SettlementId, _memberId))
        {
            Snackbar.Add(L["settlements.action_failed", "Action failed."], Severity.Error);
            return;
        }
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await ReloadAsync();
    }

    private async Task MarkPaidAsync()
    {
        if (!await SettlementService.MarkPaidAsync(SettlementId, _bank?.BankAccountID, _paymentRef, _memberId))
        {
            Snackbar.Add(L["settlements.action_failed", "Action failed."], Severity.Error);
            return;
        }
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await ReloadAsync();
    }

    private async Task CancelAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["settlements.cancel", "Cancel settlement"],
            L["settlements.cancel_confirm", "Cancel this settlement?"],
            yesText: L["yes", "Yes"], cancelText: L["no", "No"]);
        if (confirmed != true) return;
        if (!await SettlementService.CancelAsync(SettlementId, null, _memberId))
        {
            Snackbar.Add(L["settlements.action_failed", "Action failed."], Severity.Error);
            return;
        }
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await ReloadAsync();
    }
}
