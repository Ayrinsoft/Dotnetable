@page "/finance/currency-rates"
@attribute [Authorize(Policy = RoleKeys.CurrencyView)]
@inject ICurrencyRateService CurrencyRateService
@inject ICurrencyService CurrencyService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["currency_rates", "Exchange Rates"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["currency_rates", "Exchange Rates"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["currency_rates.subtitle", "USD-to-currency rates used to display prices for this website. All amounts are stored in USD internally."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:180px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["currency_rates.new", "New Rate"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_items.Count == 0)
    {
        <div style="text-align:center; padding:32px;"><MudText Color="Color.Secondary">@L["currency_rates.empty", "No exchange rates configured yet."]</MudText></div>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead><tr><th>@L["currencies.code", "Currency"]</th><th>@L["currency_rates.rate", "USD to currency"]</th><th>@L["currency_rates.default", "Default"]</th><th>@L["currency_rates.updated", "Last update"]</th><th style="width:1%"></th></tr></thead>
            <tbody>
                @foreach (var r in _items)
                {
                    <tr>
                        <td>@r.CurrencyCode — @r.CurrencyCodeNavigation.Name</td>
                        <td>@r.USDToCurrency.ToString("0.####")</td>
                        <td>
                            @if (r.IsDefault)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            }
                            else if (_canEdit)
                            {
                                <MudButton Size="Size.Small" OnClick="@(() => SetDefaultAsync(r))">@L["currency_rates.make_default", "Make default"]</MudButton>
                            }
                        </td>
                        <td>@r.LastUpdate.ToLocalTime().ToString("g")</td>
                        <td>
                            <MudStack Row="true" Spacing="0">
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(r))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(r))" />
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster, _canEdit;
    private int _websiteId;
    private List<CurrencyRate> _items = new();
    private List<Currency> _currencies = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CurrencyEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        _currencies = await CurrencyService.GetAllAsync();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(IEnumerable<int> _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await CurrencyRateService.GetByWebsiteAsync(_websiteId);
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new CurrencyRate { WebsiteID = _websiteId, USDToCurrency = 1 }, true)) await LoadAsync();
    }

    private async Task EditAsync(CurrencyRate r)
    {
        var copy = new CurrencyRate { CurrencyRateID = r.CurrencyRateID, WebsiteID = r.WebsiteID, CurrencyCode = r.CurrencyCode, USDToCurrency = r.USDToCurrency, IsDefault = r.IsDefault };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(CurrencyRate model, bool isNew)
    {
        var parameters = new DialogParameters<CurrencyRateDialog> { { x => x.Model, model }, { x => x.IsNew, isNew }, { x => x.Currencies, _currencies } };
        var dialog = await DialogService.ShowAsync<CurrencyRateDialog>(
            isNew ? L["currency_rates.new", "New Rate"] : L["currency_rates.edit", "Edit Rate"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task SetDefaultAsync(CurrencyRate r)
    {
        await CurrencyRateService.SetDefaultAsync(r.CurrencyRateID, r.WebsiteID);
        await LoadAsync();
    }

    private async Task DeleteAsync(CurrencyRate r)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["currency_rates.delete", "Delete exchange rate"], L["currency_rates.delete_confirm", "Delete this exchange rate?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await CurrencyRateService.DeleteAsync(r.CurrencyRateID, r.WebsiteID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
