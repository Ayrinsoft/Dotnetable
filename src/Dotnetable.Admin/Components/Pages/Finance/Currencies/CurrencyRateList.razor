@page "/finance/currency-rates"
@attribute [Authorize(Policy = RoleKeys.CurrencyView)]
@inject ICurrencyRateService CurrencyRateService
@inject ICurrencyService CurrencyService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["currency_rates", "Exchange Rates"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["currency_rates", "Exchange Rates"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["currency_rates.subtitle", "How many units of each currency equal 1 USD (e.g. IRR ≈ 2,000,000). Prices are stored in USD and converted for display."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync"
                       Disabled="@(_currencies.Count == 0)">
                @L["currency_rates.new", "New Rate"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<DNPrerequisiteAlert Items="_prerequisites" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="5" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["currency_rates.empty", "No exchange rates configured yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var r in _items)
            {
                <tr>
                    <td>@r.CurrencyCode — @r.CurrencyCodeNavigation.Name</td>
                    <td>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">1 USD = @FormatRate(r.USDToCurrency) @r.CurrencyCode</MudText>
                            @if (r.USDToCurrency > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">1 @r.CurrencyCode ≈ @FormatInverse(r.USDToCurrency) USD</MudText>
                            }
                        </MudStack>
                    </td>
                    <td>
                        @if (r.IsDefault)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else if (_canEdit)
                        {
                            <MudButton Size="Size.Small" OnClick="@(() => SetDefaultAsync(r))">@L["currency_rates.make_default", "Make default"]</MudButton>
                        }
                    </td>
                    <td>@r.LastUpdate.ToLocalTime().ToString("g")</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(r))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(r))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster, _canEdit;
    private int _websiteId;
    private List<CurrencyRate> _items = new();
    private List<Currency> _currencies = new();
    private List<Website> _websites = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CurrencyEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        _currencies = await CurrencyService.GetAllAsync();
        _prerequisites = ContentPrerequisiteHelper.ForCurrencyRates(L, _currencies.Count);

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["currencies.code", "Currency"], ColumnName = nameof(CurrencyRate.CurrencyCode), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["currency_rates.rate", "1 USD ="], ColumnName = nameof(CurrencyRate.USDToCurrency), HasSort = true },
                new() { ColumnTitle = L["currency_rates.default", "Default"], ColumnName = nameof(CurrencyRate.IsDefault), HasSort = true },
                new() { ColumnTitle = L["currency_rates.updated", "Last update"], ColumnName = nameof(CurrencyRate.LastUpdate), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await CurrencyRateService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new CurrencyRate { WebsiteID = _websiteId, USDToCurrency = 1 }, true)) await LoadAsync();
    }

    private async Task EditAsync(CurrencyRate r)
    {
        var copy = new CurrencyRate { CurrencyRateID = r.CurrencyRateID, WebsiteID = r.WebsiteID, CurrencyCode = r.CurrencyCode, USDToCurrency = r.USDToCurrency, IsDefault = r.IsDefault };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(CurrencyRate model, bool isNew)
    {
        var parameters = new DialogParameters<CurrencyRateDialog> { { x => x.Model, model }, { x => x.IsNew, isNew }, { x => x.Currencies, _currencies } };
        var dialog = await DialogService.ShowAsync<CurrencyRateDialog>(
            isNew ? L["currency_rates.new", "New Rate"] : L["currency_rates.edit", "Edit Rate"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task SetDefaultAsync(CurrencyRate r)
    {
        await CurrencyRateService.SetDefaultAsync(r.CurrencyRateID, r.WebsiteID);
        await LoadAsync();
    }

    private async Task DeleteAsync(CurrencyRate r)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["currency_rates.delete", "Delete exchange rate"], L["currency_rates.delete_confirm", "Delete this exchange rate?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await CurrencyRateService.DeleteAsync(r.CurrencyRateID, r.WebsiteID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private static string FormatRate(decimal rate) =>
        rate >= 1 ? rate.ToString("N2") : rate.ToString("0.######");

    private static string FormatInverse(decimal usdToCurrency) =>
        (1m / usdToCurrency).ToString("0.##########");
}
