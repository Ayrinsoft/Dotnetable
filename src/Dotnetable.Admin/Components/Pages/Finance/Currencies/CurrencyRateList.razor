@page "/finance/currency-rates"
@attribute [Authorize(Policy = RoleKeys.CurrencyView)]
@inject ICurrencyRateService CurrencyRateService
@inject ICurrencyService CurrencyService
@inject IWebsiteService WebsiteService
@inject IClientWalletService WalletService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["currency_rates", "Exchange Rates"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["currency_rates", "Exchange Rates"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_storePricesInUsd
                ? L["currency_rates.subtitle_multi", "Product multi-currency is on: catalog stays in site currency; USD dual storage enables live conversion to other storefront currencies. Customer wallets are separate — one ledger per wallet currency (not dual-stored)."]
                : L["currency_rates.subtitle_single", "Products and money operate in the site default currency. Enable product multi-currency (USD dual) only if you need multi-rate storefront conversion. Wallets always use separate accounts per currency."])
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync"
                       Disabled="@(_currencies.Count == 0)">
                @L["currency_rates.new", "New Rate"]
            </MudButton>
        }
    </MudStack>
</MudStack>

@* ── Website money mode (discoverable here, not only on super-admin website edit) ── *@
<MudPaper Elevation="0" Class="border rounded-lg pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="3">
        <MudStack Spacing="1" Class="flex-grow-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold">@L["currency_rates.site_mode", "Website currency mode"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["currency_rates.site_mode_hint", "Applies to catalog products only. Off: single site currency for prices. On: also store USD dual product prices and convert via rates for multi-currency storefront display. Customer wallets / orders / other money use site currency (or separate wallet accounts), not this dual store."]
            </MudText>
            @if (!string.IsNullOrEmpty(_defaultCurrencyCode))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @string.Format(L["currency_rates.default_currency_is", "Site default currency: {0}"], _defaultCurrencyCode)
                </MudText>
            }
        </MudStack>
        <MudStack AlignItems="AlignItems.End" Spacing="1">
            <MudSwitch T="bool" Value="_storePricesInUsd" ValueChanged="OnStorePricesInUsdChanged"
                       Color="Color.Primary" Disabled="@(!_canEdit || _savingMode || _websiteId <= 0)"
                       Label="@L["currency_rates.enable_multi", "Products: dual-store USD + multi-rate conversion"]" />
            @if (_savingMode)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
        </MudStack>
    </MudStack>
    @if (!_storePricesInUsd)
    {
        <DNDismissibleAlert StorageKey="currency-rates.single-mode-note" Class="mt-3">
            @L["currency_rates.single_mode_note", "Product single-currency mode: only the site default catalog currency is used. Extra rate rows are ignored for storefront conversion until product dual-USD is enabled."]
        </DNDismissibleAlert>
    }
</MudPaper>

@* ── Wallet currencies (separate accounts, not dual-USD) ── *@
@if (_websiteId > 0)
{
    <MudPaper Elevation="0" Class="border rounded-lg pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">@L["wallets.currencies", "Customer wallet currencies"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["wallets.currencies_hint", "Each enabled currency is a separate wallet ledger for customers (e.g. IRR and USD balances are independent). The site default is always on."]
                </MudText>
            </MudStack>
            @if (_canEdit)
            {
                <MudStack Row="true" Spacing="2">
                    <MudSelect T="string" @bind-Value="_walletCurrencyToAdd" Label="@L["currency", "Currency"]" Variant="Variant.Outlined"
                               Dense="true" Style="min-width:140px">
                        @foreach (var c in _currencies.Where(x => x.IsActive && !_walletCurrencies.Any(w => w.CurrencyCode == x.CurrencyCode && w.IsActive)))
                        {
                            <MudSelectItem T="string" Value="@c.CurrencyCode">@c.CurrencyCode — @c.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(string.IsNullOrEmpty(_walletCurrencyToAdd) || _savingWallet)"
                               OnClick="EnableWalletCurrencyAsync">
                        @L["add", "Add"]
                    </MudButton>
                </MudStack>
            }
        </MudStack>
        <MudStack Row="true" Spacing="1" Class="flex-wrap" AlignItems="AlignItems.Center">
            @foreach (var w in _walletCurrencies)
            {
                <MudChip T="string" Color="@(w.IsDefault ? Color.Primary : Color.Default)" Class="me-1">
                    @w.CurrencyCode @(w.IsDefault ? $"({L["default", "Default"]})" : "")
                </MudChip>
                @if (!w.IsDefault && _canEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="ms-n2"
                                   OnClick="@(() => DisableWalletCurrencyAsync(w.CurrencyCode))"
                                   title="@L["remove", "Remove"]" />
                }
            }
            @if (_walletCurrencies.Count == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["wallets.currencies_empty", "Default wallet currency will be created on first use."]</MudText>
            }
        </MudStack>
    </MudPaper>
}

<DNPrerequisiteAlert Items="_prerequisites" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="5" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["currency_rates.empty", "No exchange rates configured yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var r in _items)
            {
                <tr>
                    <td>@r.CurrencyCode — @r.CurrencyCodeNavigation.Name</td>
                    <td>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">1 USD = @FormatRate(r.USDToCurrency) @r.CurrencyCode</MudText>
                            @if (r.USDToCurrency > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">1 @r.CurrencyCode ≈ @FormatInverse(r.USDToCurrency) USD</MudText>
                            }
                        </MudStack>
                    </td>
                    <td>
                        @if (r.IsDefault)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else if (_canEdit)
                        {
                            <MudButton Size="Size.Small" OnClick="@(() => SetDefaultAsync(r))">@L["currency_rates.make_default", "Make default"]</MudButton>
                        }
                    </td>
                    <td>@r.LastUpdate.ToLocalTime().ToString("g")</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(r))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(r))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster, _canEdit;
    private bool _storePricesInUsd;
    private bool _savingMode, _savingWallet;
    private string _defaultCurrencyCode = "";
    private string _walletCurrencyToAdd = "";
    private int _websiteId;
    private List<CurrencyRate> _items = new();
    private List<Currency> _currencies = new();
    private List<Website> _websites = new();
    private List<WebsiteWalletCurrency> _walletCurrencies = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CurrencyEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        _currencies = await CurrencyService.GetAllAsync();
        _prerequisites = ContentPrerequisiteHelper.ForCurrencyRates(L, _currencies.Count);

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["currencies.code", "Currency"], ColumnName = nameof(CurrencyRate.CurrencyCode), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["currency_rates.rate", "1 USD ="], ColumnName = nameof(CurrencyRate.USDToCurrency), HasSort = true },
                new() { ColumnTitle = L["currency_rates.default", "Default"], ColumnName = nameof(CurrencyRate.IsDefault), HasSort = true },
                new() { ColumnTitle = L["currency_rates.updated", "Last update"], ColumnName = nameof(CurrencyRate.LastUpdate), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        if (_websiteId > 0)
        {
            var website = await WebsiteService.GetByIdAsync(_websiteId);
            _storePricesInUsd = website?.StorePricesInUsd ?? false;
            _defaultCurrencyCode = website?.DefaultCurrencyCode ?? "";
            _walletCurrencies = (await WalletService.GetEnabledWalletCurrenciesAsync(_websiteId)).ToList();
        }
        else
        {
            _storePricesInUsd = false;
            _defaultCurrencyCode = "";
            _walletCurrencies = new();
        }

        var result = await CurrencyRateService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task OnStorePricesInUsdChanged(bool value)
    {
        if (!_canEdit || _websiteId <= 0) return;
        _savingMode = true;
        try
        {
            var website = await WebsiteService.GetByIdAsync(_websiteId);
            if (website is null)
            {
                Snackbar.Add(L["website.not_found", "Website not found."], Severity.Error);
                return;
            }

            website.StorePricesInUsd = value;
            await WebsiteService.UpdateAsync(website);
            _storePricesInUsd = value;
            Snackbar.Add(
                value
                    ? L["currency_rates.multi_enabled", "Multi-currency via USD enabled for this website."]
                    : L["currency_rates.multi_disabled", "Single-currency mode: this website uses only its default currency."],
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
            // reload authoritative value
            var website = await WebsiteService.GetByIdAsync(_websiteId);
            _storePricesInUsd = website?.StorePricesInUsd ?? false;
        }
        finally
        {
            _savingMode = false;
        }
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new CurrencyRate { WebsiteID = _websiteId, USDToCurrency = 1 }, true)) await LoadAsync();
    }

    private async Task EditAsync(CurrencyRate r)
    {
        var copy = new CurrencyRate { CurrencyRateID = r.CurrencyRateID, WebsiteID = r.WebsiteID, CurrencyCode = r.CurrencyCode, USDToCurrency = r.USDToCurrency, IsDefault = r.IsDefault };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(CurrencyRate model, bool isNew)
    {
        var parameters = new DialogParameters<CurrencyRateDialog> { { x => x.Model, model }, { x => x.IsNew, isNew }, { x => x.Currencies, _currencies } };
        var dialog = await DialogService.ShowAsync<CurrencyRateDialog>(
            isNew ? L["currency_rates.new", "New Rate"] : L["currency_rates.edit", "Edit Rate"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task SetDefaultAsync(CurrencyRate r)
    {
        await CurrencyRateService.SetDefaultAsync(r.CurrencyRateID, r.WebsiteID);
        await LoadAsync();
    }

    private async Task DeleteAsync(CurrencyRate r)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["currency_rates.delete", "Delete exchange rate"], L["currency_rates.delete_confirm", "Delete this exchange rate?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await CurrencyRateService.DeleteAsync(r.CurrencyRateID, r.WebsiteID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private static string FormatRate(decimal rate) =>
        rate >= 1 ? rate.ToString("N2") : rate.ToString("0.######");

    private static string FormatInverse(decimal usdToCurrency) =>
        (1m / usdToCurrency).ToString("0.##########");

    private async Task EnableWalletCurrencyAsync()
    {
        if (_websiteId <= 0 || string.IsNullOrWhiteSpace(_walletCurrencyToAdd)) return;
        _savingWallet = true;
        try
        {
            var (ok, err) = await WalletService.EnableWalletCurrencyAsync(_websiteId, _walletCurrencyToAdd);
            if (ok)
            {
                Snackbar.Add(L["saved", "Saved."], Severity.Success);
                _walletCurrencyToAdd = "";
                _walletCurrencies = (await WalletService.GetEnabledWalletCurrenciesAsync(_websiteId)).ToList();
            }
            else Snackbar.Add(err ?? L["save_failed", "Save failed"], Severity.Warning);
        }
        finally { _savingWallet = false; }
    }

    private async Task DisableWalletCurrencyAsync(string code)
    {
        if (_websiteId <= 0) return;
        var (ok, err) = await WalletService.DisableWalletCurrencyAsync(_websiteId, code);
        if (ok)
        {
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            _walletCurrencies = (await WalletService.GetEnabledWalletCurrenciesAsync(_websiteId)).ToList();
        }
        else Snackbar.Add(err ?? L["save_failed", "Save failed"], Severity.Warning);
    }
}
