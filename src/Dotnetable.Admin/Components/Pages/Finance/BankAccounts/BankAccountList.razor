@page "/finance/bank-accounts"
@attribute [Authorize(Policy = RoleKeys.BankAccountsView)]
@inject IBankAccountService BankAccountService
@inject IBankService BankService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["bank_accounts", "Bank Accounts"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["bank_accounts", "Bank Accounts"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["bank_accounts.subtitle", "The website's own bank accounts, used to receive manual customer transfers."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["bank_accounts.new", "New Bank Account"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["bank_accounts.empty", "No bank accounts yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var a in _items)
            {
                <tr>
                    <td>@a.Title</td>
                    <td>@a.Bank.Name</td>
                    <td><code>@a.IBAN</code></td>
                    <td>@(a.IsForOfflinePayment ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>@(a.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(a))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(a))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private int _currentMemberId;
    private List<BankAccount> _items = new();
    private List<Bank> _banks = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.BankAccountsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.BankAccountsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.BankAccountsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out _currentMemberId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        _banks = await BankService.GetAllAsync();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(BankAccount.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["banks", "Bank"], ColumnName = "" },
                new() { ColumnTitle = L["bank_accounts.iban", "IBAN"], ColumnName = nameof(BankAccount.IBAN), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["bank_accounts.offline", "Offline payment"], ColumnName = nameof(BankAccount.IsForOfflinePayment), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(BankAccount.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await BankAccountService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new BankAccount { WebsiteID = _websiteId, IsActive = true, CreatedByMemberId = _currentMemberId }, true)) await LoadAsync();
    }

    private async Task EditAsync(BankAccount a)
    {
        var copy = new BankAccount
        {
            BankAccountID = a.BankAccountID, WebsiteID = a.WebsiteID, BankID = a.BankID, Title = a.Title,
            OwnerName = a.OwnerName, AccountNumber = a.AccountNumber, IBAN = a.IBAN, CardNumber = a.CardNumber,
            IsForOfflinePayment = a.IsForOfflinePayment, IsActive = a.IsActive, CreatedByMemberId = a.CreatedByMemberId,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(BankAccount model, bool isNew)
    {
        var parameters = new DialogParameters<BankAccountDialog> { { x => x.Model, model }, { x => x.IsNew, isNew }, { x => x.Banks, _banks } };
        var dialog = await DialogService.ShowAsync<BankAccountDialog>(
            isNew ? L["bank_accounts.new", "New Bank Account"] : L["bank_accounts.edit", "Edit Bank Account"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(BankAccount a)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["bank_accounts.delete", "Delete bank account"], L["bank_accounts.delete_confirm", "Delete this bank account?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await BankAccountService.DeleteAsync(a.BankAccountID, a.WebsiteID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
