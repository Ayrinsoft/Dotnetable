@inject IBankAccountService BankAccountService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudAutocomplete T="Bank" Value="@GetSelectedBank()" ValueChanged="OnBankChanged"
                                     SearchFunc="SearchBanks" ToStringFunc="@(b => b?.Name ?? string.Empty)"
                                     Label="@L["banks", "Bank"]" Variant="Variant.Outlined" Required="true"
                                     Clearable="false" CoerceText="false" ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.OwnerName" Label="@L["bank_accounts.owner", "Owner name"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.AccountNumber" Label="@L["bank_accounts.account_number", "Account number"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.IBAN" Label="@L["bank_accounts.iban", "IBAN"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.CardNumber" Label="@L["bank_accounts.card_number", "Card number"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="Model.IsForOfflinePayment" Label="@L["bank_accounts.offline", "Accept offline payments"]" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public BankAccount Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public List<Bank> Banks { get; set; } = new();

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;

    private Bank? GetSelectedBank() =>
        Model.BankID > 0 ? Banks.FirstOrDefault(b => b.BankID == Model.BankID) : null;

    private void OnBankChanged(Bank? bank)
    {
        Model.BankID = bank?.BankID ?? 0;
    }

    private Task<IEnumerable<Bank>> SearchBanks(string value, CancellationToken ct)
    {
        IEnumerable<Bank> q = Banks.OrderBy(b => b.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(b => b.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            if (IsNew) await BankAccountService.CreateAsync(Model);
            else await BankAccountService.UpdateAsync(Model);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
