@using Dotnetable.Admin.Components.Pages.Media
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject IFileService FileService
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.body2" Class="mb-1">@L["banks.logo", "Logo"]</MudText>
                    <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickLogoAsync">
                        <div style="aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                            @if (!string.IsNullOrEmpty(_logo?.CNDUrl))
                            {
                                <img src="@(_logo.ThumbnailCDN ?? _logo.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:contain;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Secondary" Size="Size.Large" />
                            }
                        </div>
                    </MudPaper>
                    @if (Model.LogoFileID is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="mt-1" OnClick="ClearLogo">@L["remove", "Remove"]</MudButton>
                    }
                </MudItem>
                <MudItem xs="12" sm="9">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="7">
                            <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="Model.BankCode" Label="@L["banks.code", "Code"]" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="Model.Active" Label="@L["active", "Active"]" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Bank Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Inject] private IBankService BankService { get; set; } = null!;

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private FileRecord? _logo;

    protected override async Task OnInitializedAsync()
    {
        if (Model.LogoFileID is int fid)
            _logo = await FileService.GetByIdAsync(fid);
    }

    private async Task PickLogoAsync()
    {
        // Banks are global; media library is per-website — use current admin website context.
        var websiteId = Model.WebsiteID is > 0 ? Model.WebsiteID.Value : L.WebsiteId;
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = websiteId,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
        {
            _logo = file;
            Model.LogoFileID = file.FileRecordID;
        }
    }

    private void ClearLogo()
    {
        _logo = null;
        Model.LogoFileID = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            if (IsNew) await BankService.CreateAsync(Model);
            else await BankService.UpdateAsync(Model);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
