@page "/menus"
@attribute [Authorize(Policy = RoleKeys.MenusView)]
@inject IMenuService MenuService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["menus", "Menus"] />

@* ── Page header ──────────────────────────────────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["menus", "Menus"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["menus.subtitle_own", "Navigation menus for your website"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["menus.new", "New Menu"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_menus.Count == 0 && !_grid.HeaderItems.Any(h => !string.IsNullOrWhiteSpace(h.SearchText)))
    {
        <div style="text-align:center; padding:32px;">
            <MudText Color="Color.Secondary">@L["menus.empty", "No menus yet."]</MudText>
        </div>
    }
    else
    {
        <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged"
                    SearchPlaceholder="@L["search", "Search…"]" AllText="@L["all", "All"]">
            @if (_menus.Count == 0)
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:32px;">
                        <MudText Color="Color.Secondary">@L["menus.no_results", "No menus match the filter."]</MudText>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var m in _menus)
                {
                    <tr>
                        <td>
                            <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small"
                                           Color="Color.Primary" Title="@L["menus.manage_items", "Manage items"]"
                                           Href="@($"/menus/{m.MenuID}")" />
                        </td>
                        <td>@m.MenuID</td>
                        <td>@m.Name</td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                                @((MenuLocation)m.Location)
                            </MudChip>
                        </td>
                        <td>@(m.MenuItems?.Count ?? 0)</td>
                        <td>
                            <MudSwitch T="bool" Value="m.IsActive" Color="Color.Success"
                                       Disabled="@(!_canEdit || _busy.Contains(m.MenuID))"
                                       ValueChanged="@(v => ToggleActiveAsync(m, v))" />
                        </td>
                        <td>
                            <MudStack Row="true" Spacing="0">
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Default" OnClick="@(() => EditAsync(m))" />
                                }
                                @if (_canDelete)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAsync(m))" />
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
            }
        </DNGridView>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert;
    private bool _canEdit;
    private bool _canDelete;
    private int _websiteId;
    private List<Menu> _menus = new();
    private List<Website> _websites = new();
    private HashSet<int> _busy = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.MenusInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.MenusEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.MenusDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "" },
                new() { ColumnTitle = L["id", "ID"], ColumnName = nameof(Menu.MenuID), HasSort = true },
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Menu.Name), HasSort = true, HasSearch = true },
                new()
                {
                    ColumnTitle = L["menus.location", "Location"],
                    ColumnName = nameof(Menu.Location),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    OtherDropDownValues = Enum.GetValues<MenuLocation>()
                        .ToDictionary(v => v.ToString(), v => ((byte)v).ToString()),
                },
                new() { ColumnTitle = L["menus.items", "Items"] },
                new()
                {
                    ColumnTitle = L["status", "Status"],
                    ColumnName = nameof(Menu.IsActive),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    OtherDropDownValues = new() { [L["active", "Active"]] = "true", [L["inactive", "Inactive"]] = "false" },
                },
                new() { ColumnTitle = "" },
            },
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await MenuService.GetMenusPagedAsync(_websiteId, _grid.ToQuery());
        _menus = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ToggleActiveAsync(Menu m, bool value)
    {
        if (!_busy.Add(m.MenuID)) return;
        m.IsActive = value;
        try { await MenuService.UpdateMenuAsync(m); }
        finally { _busy.Remove(m.MenuID); }
    }

    private async Task CreateAsync()
    {
        var result = await ShowDialogAsync(new Menu
        {
            WebsiteID = _websiteId,
            Location = (byte)MenuLocation.Header,
            IsActive = true,
        }, isNew: true);
        if (result) await LoadAsync();
    }

    private async Task EditAsync(Menu m)
    {
        var result = await ShowDialogAsync(new Menu
        {
            MenuID = m.MenuID,
            WebsiteID = m.WebsiteID,
            Name = m.Name,
            Location = m.Location,
            IsActive = m.IsActive,
        }, isNew: false);
        if (result) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Menu menu, bool isNew)
    {
        var parameters = new DialogParameters<MenuDialog>
        {
            { x => x.Model, menu },
            { x => x.IsNew, isNew },
            { x => x.AllowWebsiteEdit, _isMaster },
            { x => x.Websites, _websites },
        };
        var dialog = await DialogService.ShowAsync<MenuDialog>(
            isNew ? L["menus.new", "New Menu"] : L["menus.edit", "Edit Menu"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Menu m)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["menus.delete", "Delete menu"],
            L["menus.delete_confirm", "This deletes the menu and all its items. Continue?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        try
        {
            await MenuService.DeleteMenuAsync(m.MenuID);
            Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["delete_failed", "Delete failed"]}: {ex.Message}", Severity.Error);
        }
    }
}
