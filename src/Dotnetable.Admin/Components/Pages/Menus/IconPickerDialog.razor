@inject IPageLocalizer L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EmojiSymbols" Class="me-2" />
            @L["menus.pick_icon", "Select an icon"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_search" Placeholder="@L["search", "Search…"]" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" Class="mb-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

        @{
            var filtered = Filtered;
        }
        @if (filtered.Count == 0)
        {
            <MudText Color="Color.Secondary" Class="pa-4" Align="Align.Center">@L["picker.empty", "No icons found."]</MudText>
        }
        else
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(90px,1fr)); gap:8px; max-height:420px; overflow:auto;">
                @foreach (var name in filtered)
                {
                    var cssClass = $"bi bi-{name}";
                    <MudPaper Elevation="0" Class="border rounded-lg pa-2 d-flex flex-column align-center"
                              Style="cursor:pointer; text-align:center;" @onclick="@(() => Select(cssClass))">
                        <i class="@cssClass" style="font-size:1.5rem;"></i>
                        <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="max-width:100%;" title="@name">@name</MudText>
                    </MudPaper>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string? _search;

    private List<string> Filtered =>
