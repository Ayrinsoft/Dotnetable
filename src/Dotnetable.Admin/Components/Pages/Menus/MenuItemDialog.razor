@inject IMenuService MenuService
@inject ILanguageService LanguageService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Model.Title" Label="@TitleLabel"
                                  Variant="Variant.Outlined" Required="true"
                                  RequiredError="@L["menus.title_required", "Title is required."]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Model.SortOrder" Label="@L["menus.sort", "Sort"]"
                                     Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="MenuItemType" Value="_type" ValueChanged="OnTypeChanged"
                               Label="@L["menus.item_type", "Type"]" Variant="Variant.Outlined">
                        @foreach (var t in Enum.GetValues<MenuItemType>())
                        {
                            <MudSelectItem T="MenuItemType" Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="_parentId" Label="@L["menus.parent", "Parent"]"
                               Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">@L["menus.top_level", "— Top level —"]</MudSelectItem>
                        @foreach (var candidate in ParentCandidates)
                        {
                            <MudSelectItem T="int?" Value="@candidate.MenuItemID">@candidate.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (_type != MenuItemType.Custom)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int?" @bind-Value="_targetId"
                                         Label="@($"{_type} {L["menus.target_id", "ID"]}")"
                                         Variant="Variant.Outlined" Clearable="true" />
                    </MudItem>
                }
                <MudItem xs="12" sm="@(_type == MenuItemType.Custom ? 12 : 6)">
                    <MudTextField @bind-Value="Model.Url"
                                  Label="@(_type == MenuItemType.Custom ? L["menus.url", "URL"] : L["menus.url_override", "URL override (optional)"])"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (!string.IsNullOrWhiteSpace(Model.Icon))
                        {
                            <i class="@Model.Icon" style="font-size:1.4rem;"></i>
                        }
                        <MudTextField @bind-Value="Model.Icon" Label="@L["menus.icon", "Icon (optional)"]"
                                      Variant="Variant.Outlined" Class="flex-grow-1"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EmojiSymbols"
                                      OnAdornmentClick="PickIconAsync" AdornmentAriaLabel="@L["menus.pick_icon", "Select an icon"]" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.CssClass" Label="@L["menus.css", "CSS class (optional)"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="Model.OpenInNewTab" Color="Color.Primary"
                               Label="@L["menus.new_tab", "Open in new tab"]" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Color="Color.Success"
                               Label="@(Model.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])" />
                </MudItem>

                @* Translations for every non-default website language (root and child items alike). *@
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["other_languages", "Other languages"]</MudText>
                        @if (_loadingLanguages)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
                        }
                        else if (_otherLanguages.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                            </MudText>
                            @foreach (var lang in _otherLanguages)
                            {
                                <MudTextField T="string" Value="@GetTranslation(lang.LanguageCode)"
                                              ValueChanged="@(v => SetTranslation(lang.LanguageCode, v))"
                                              Label="@($"{lang.Name} ({lang.LanguageCode.ToUpperInvariant()}) — {L["menus.item_title", "Title"]}")"
                                              Variant="Variant.Outlined" Class="mb-2" Margin="Margin.Dense" />
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-1">
                                @L["menus.need_website_languages", "This website has only one language, so there are no extra title fields. Add more languages under Website → Languages, then edit this item again."]
                                <MudLink Href="/website/languages" Typo="Typo.body2" Class="ms-1">@L["website_languages", "Languages"]</MudLink>
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">
            @L["save", "Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public MenuItem Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    /// <summary>Every item of the menu, used to offer valid parents (self + descendants excluded).</summary>
    [Parameter] public IReadOnlyList<MenuItem> AllItems { get; set; } = Array.Empty<MenuItem>();

    /// <summary>
    /// Owning website of this menu. Prefer resolving from the menu row; this is a fallback.
    /// Content languages come from Website → Languages for this id (never the admin catalog).
    /// </summary>
    [Parameter] public int WebsiteId { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private bool _loadingLanguages = true;
    private string[]? _formErrors;
    private MenuItemType _type;
    private int? _parentId;
    private int? _targetId;
    private readonly Dictionary<string, string> _translations = new(StringComparer.OrdinalIgnoreCase);
    private List<Language> _otherLanguages = new();
    private string? _defaultLanguageName;
    private int _resolvedWebsiteId;

    private string TitleLabel => string.IsNullOrWhiteSpace(_defaultLanguageName)
        ? L["menus.item_title", "Title"]
        : $"{L["menus.item_title", "Title"]} ({_defaultLanguageName})";

    private IEnumerable<MenuItem> ParentCandidates
    {
        get
        {
            var forbidden = DescendantIds(Model.MenuItemID);
            forbidden.Add(Model.MenuItemID);
            return AllItems.Where(i => !forbidden.Contains(i.MenuItemID));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _type = (MenuItemType)Model.ItemType;
        _parentId = Model.ParentItemID;
        _targetId = CurrentTargetId();

        await L.EnsureLoadedAsync();
        await LoadWebsiteLanguagesAsync();

        if (!IsNew && Model.MenuItemID > 0)
        {
            foreach (var t in await MenuService.GetItemTranslationsAsync(Model.MenuItemID))
                _translations[t.LanguageCode] = t.Title;
        }
    }

    /// <summary>
    /// Always resolve the menu's website from the DB first (root and child items share this form).
    /// Then load that site's non-default active languages for translation fields.
    /// </summary>
    private async Task LoadWebsiteLanguagesAsync()
    {
        _loadingLanguages = true;
        try
        {
            _resolvedWebsiteId = 0;

            // 1) Authoritative: the menu row this item belongs to.
            if (Model.MenuID > 0)
            {
                var menu = await MenuService.GetMenuAsync(Model.MenuID);
                if (menu is not null)
                    _resolvedWebsiteId = menu.WebsiteID;
            }

            // 2) Parameter from MenuEdit.
            if (_resolvedWebsiteId <= 0 && WebsiteId > 0)
                _resolvedWebsiteId = WebsiteId;

            // 3) Signed-in member's website claim.
            if (_resolvedWebsiteId <= 0)
                _resolvedWebsiteId = L.WebsiteId;

            if (_resolvedWebsiteId <= 0)
            {
                _otherLanguages = new();
                _defaultLanguageName = null;
                return;
            }

            var active = await LanguageService.GetActiveForWebsiteAsync(_resolvedWebsiteId);
            var defaultLang = active.FirstOrDefault(l => l.IsDefault)
                ?? active.OrderBy(l => l.Priority).ThenBy(l => l.Name).FirstOrDefault();

            _defaultLanguageName = defaultLang?.Name;

            _otherLanguages = active.Count <= 1 || defaultLang is null
                ? new List<Language>()
                : active.Where(l => l.LanguageID != defaultLang.LanguageID).ToList();
        }
        finally
        {
            _loadingLanguages = false;
        }
    }

    private string GetTranslation(string code) => _translations.TryGetValue(code, out var v) ? v : string.Empty;
    private void SetTranslation(string code, string value) => _translations[code] = value ?? string.Empty;

    private void OnTypeChanged(MenuItemType value)
    {
        _type = value;
        Model.ItemType = (byte)value;
        _targetId = CurrentTargetId();
    }

    private int? CurrentTargetId() => _type switch
    {
        MenuItemType.Page => Model.PageID,
        MenuItemType.Post => Model.PostID,
        MenuItemType.Category => Model.CategoryID,
        MenuItemType.Product => Model.ProductID,
        MenuItemType.ProductCategory => Model.ProductCategoryID,
        MenuItemType.Brand => Model.BrandID,
        MenuItemType.Vendor => Model.VendorID,
        _ => null,
    };

    private void ApplyTargetId()
    {
        Model.PageID = _type == MenuItemType.Page ? _targetId : null;
        Model.PostID = _type == MenuItemType.Post ? _targetId : null;
        Model.CategoryID = _type == MenuItemType.Category ? _targetId : null;
        Model.ProductID = _type == MenuItemType.Product ? _targetId : null;
        Model.ProductCategoryID = _type == MenuItemType.ProductCategory ? _targetId : null;
        Model.BrandID = _type == MenuItemType.Brand ? _targetId : null;
        Model.VendorID = _type == MenuItemType.Vendor ? _targetId : null;
    }

    private HashSet<int> DescendantIds(int rootId)
    {
        var result = new HashSet<int>();
        if (rootId == 0) return result;
        var queue = new Queue<int>();
        queue.Enqueue(rootId);
        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            foreach (var child in AllItems.Where(i => i.ParentItemID == id))
                if (result.Add(child.MenuItemID))
                    queue.Enqueue(child.MenuItemID);
        }
        return result;
    }

    private async Task PickIconAsync()
    {
        var dialog = await DialogService.ShowAsync<IconPickerDialog>(L["menus.pick_icon", "Select an icon"],
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string iconClass })
            Model.Icon = iconClass;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            Model.ParentItemID = _parentId;
            Model.ItemType = (byte)_type;
            ApplyTargetId();

            if (IsNew)
                await MenuService.CreateItemAsync(Model);
            else
                await MenuService.UpdateItemAsync(Model);

            // Persist titles for every non-default website language (blank = remove translation).
            if (Model.MenuItemID > 0)
            {
                var toSave = _otherLanguages.ToDictionary(
                    l => l.LanguageCode,
                    l => GetTranslation(l.LanguageCode),
                    StringComparer.OrdinalIgnoreCase);

                // Keep any codes already saved that are no longer in the active list (don't wipe them
                // unless the user cleared them while the language was still listed).
                foreach (var existing in _translations)
                {
                    if (!toSave.ContainsKey(existing.Key))
                        toSave[existing.Key] = existing.Value;
                }

                await MenuService.SetItemTranslationsAsync(Model.MenuItemID, toSave);
            }

            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
