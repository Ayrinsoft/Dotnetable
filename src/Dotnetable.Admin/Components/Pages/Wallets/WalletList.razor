@page "/wallets"
@attribute [Authorize(Policy = RoleKeys.WalletsView)]
@inject IClientWalletService WalletService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["wallets", "Customer wallets"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 flex-wrap gap-2">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["wallets", "Customer wallets"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["wallets.list.subtitle", "Balances and ledgers per customer. Open a wallet to see deposits, withdrawals, and adjustments."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/wallets/withdrawals"
                   StartIcon="@Icons.Material.Filled.Outbound">
            @L["wallets.withdrawals", "Withdrawals"]
        </MudButton>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["wallets.empty", "No customer wallets yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var w in _items)
            {
                <tr>
                    <td>
                        <MudLink Href="@($"/wallets/client?ClientId={w.WebsiteClientID}")">
                            @ClientLabel(w.WebsiteClient)
                        </MudLink>
                    </td>
                    <td>@(w.WebsiteClient?.Email ?? "—")</td>
                    <td>@(w.WebsiteClient?.Cellphone ?? "—")</td>
                    <td>@w.CurrencyCode</td>
                    <td>@MoneyFormat.GroupWithCode(w.Balance, w.CurrencyCode)</td>
                    <td>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Href="@($"/wallets/client?ClientId={w.WebsiteClientID}")">
                            @L["wallets.history", "Transaction History"]
                        </MudButton>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private List<ClientWallet> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["clients", "Customer"], ColumnName = "Fullname", HasSearch = true },
                new() { ColumnTitle = L["email", "Email"], ColumnName = "Email", HasSearch = true },
                new() { ColumnTitle = L["cellphone", "Cellphone"], ColumnName = "Cellphone", HasSearch = true },
                new() { ColumnTitle = L["currency", "Currency"], ColumnName = nameof(ClientWallet.CurrencyCode), HasSearch = true },
                new() { ColumnTitle = L["wallets.balance", "Balance"], ColumnName = nameof(ClientWallet.Balance), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var websiteId = _isMaster && _websiteId <= 0 ? (int?)null : _websiteId;
        var result = await WalletService.GetPagedAsync(websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private static string ClientLabel(WebsiteClient? c)
    {
        if (c is null) return "—";
        var name = $"{c.Givenname} {c.Surname}".Trim();
        return string.IsNullOrEmpty(name) ? (c.Email ?? c.Cellphone ?? $"#{c.WebsiteClientID}") : name;
    }
}
