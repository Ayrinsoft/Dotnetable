@page "/wallets/client"
@attribute [Authorize(Policy = RoleKeys.WalletsView)]
@inject IClientWalletService WalletService
@inject IWebsiteClientService ClientService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["wallets.client_wallet", "Customer Wallet"] />

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pb-2" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_client is null)
{
    <MudAlert Severity="Severity.Error">@L["clients.not_found", "Customer not found."]</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">@(_client.Email ?? _client.Cellphone ?? $"#{_client.WebsiteClientID}")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["wallets.client_wallet", "Customer Wallet"] —
                @L["wallets.multi_currency_hint", "Separate balance per currency"]
            </MudText>
        </MudStack>
        @if (_canAdjust)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tune" OnClick="OpenAdjustDialog">
                @L["wallets.adjust", "Adjust Balance"]
            </MudButton>
        }
    </MudStack>

    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var w in _wallets)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="border rounded-lg pa-4"
                          Style="@(_selectedCurrency == w.CurrencyCode ? "outline:2px solid var(--mud-palette-primary)" : null)"
                          @onclick="@(() => SelectCurrency(w.CurrencyCode))">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2">@w.CurrencyCode</MudText>
                        @if (string.Equals(w.CurrencyCode, _defaultCurrency, StringComparison.OrdinalIgnoreCase))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["default", "Default"]</MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.h5" Class="fw-bold mt-1">
                        @MoneyFormat.GroupWithCode(w.Balance, w.CurrencyCode)
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">
                @L["wallets.history", "Transaction History"]
                @if (!string.IsNullOrEmpty(_selectedCurrency))
                {
                    <span>(@_selectedCurrency)</span>
                }
            </MudText>
        </MudStack>
        @if (_historyLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
            @if (_transactions.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align:center; padding:32px;">
                        <MudText Color="Color.Secondary">@L["wallets.history.empty", "No transactions yet."]</MudText>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var t in _transactions)
                {
                    <tr>
                        <td>@t.ClientWalletTransactionID</td>
                        <td>
                            @TypeName(t.Type)
                            @if (t.CreatedByMemberID is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="ms-1">
                                    @L["wallets.manual_admin", "Registered by admin"]
                                </MudChip>
                            }
                        </td>
                        <td style="color:@(t.Amount < 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)")">
                            @(t.Amount < 0 ? "" : "+")@MoneyFormat.Group(t.Amount, _selectedCurrency)
                        </td>
                        <td>@MoneyFormat.Group(t.BalanceAfter, _selectedCurrency)</td>
                        <td>@(t.Note ?? "—")</td>
                        <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
        </DNGridView>
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery] public int ClientId { get; set; }

    private bool _loading = true;
    private bool _historyLoading = true;
    private bool _canAdjust;
    private WebsiteClient? _client;
    private List<ClientWallet> _wallets = new();
    private string _selectedCurrency = "";
    private string _defaultCurrency = "";
    private List<ClientWalletTransaction> _transactions = new();
    private GridViewHeaderParameters _grid = new();

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["dashboard", "Dashboard"], "/"),
        new(L["wallets", "Customer wallets"], "/wallets"),
        new($"#{ClientId}", null, true),
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _canAdjust = AdminPolicies.Allows(user, RoleKeys.WalletsAdjust);

        _client = await ClientService.GetByIdAsync(ClientId);
        _loading = false;
        if (_client is null) return;

        var website = await WebsiteService.GetByIdAsync(_client.WebsiteID);
        _defaultCurrency = website?.DefaultCurrencyCode ?? "";

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 20 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["id", "ID"], ColumnName = nameof(ClientWalletTransaction.ClientWalletTransactionID), HasSort = true },
                new() { ColumnTitle = L["type", "Type"], ColumnName = nameof(ClientWalletTransaction.Type) },
                new() { ColumnTitle = L["amount", "Amount"], ColumnName = nameof(ClientWalletTransaction.Amount) },
                new() { ColumnTitle = L["wallets.balance_after", "Balance After"], ColumnName = nameof(ClientWalletTransaction.BalanceAfter) },
                new() { ColumnTitle = L["note", "Note"], ColumnName = nameof(ClientWalletTransaction.Note) },
                new() { ColumnTitle = L["wallets.date", "Date"], ColumnName = nameof(ClientWalletTransaction.CreatedAt), HasSort = true },
            }
        };

        await ReloadWalletsAsync();
    }

    private async Task ReloadWalletsAsync()
    {
        if (_client is null) return;
        _wallets = (await WalletService.ListForClientAsync(_client.WebsiteID, ClientId)).ToList();
        if (string.IsNullOrEmpty(_selectedCurrency) || _wallets.All(w => w.CurrencyCode != _selectedCurrency))
            _selectedCurrency = _wallets.FirstOrDefault()?.CurrencyCode ?? _defaultCurrency;
        await LoadHistoryAsync();
    }

    private async Task SelectCurrency(string code)
    {
        _selectedCurrency = code;
        _grid.Pagination.PageIndex = 1;
        await LoadHistoryAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadHistoryAsync();

    private async Task LoadHistoryAsync()
    {
        if (_client is null) return;
        _historyLoading = true;
        var result = await WalletService.GetHistoryAsync(_client.WebsiteID, ClientId, _grid.ToQuery(), _selectedCurrency);
        _transactions = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _historyLoading = false;
    }

    private string TypeName(byte type) => (ClientWalletTransactionType)type switch
    {
        ClientWalletTransactionType.RefundCredit => L["wallets.type.refund_credit", "Refund Credit"],
        ClientWalletTransactionType.PurchaseUse => L["wallets.type.purchase_use", "Purchase Use"],
        ClientWalletTransactionType.WithdrawalHold => L["wallets.type.withdrawal_hold", "Withdrawal Hold"],
        ClientWalletTransactionType.WithdrawalReversed => L["wallets.type.withdrawal_reversed", "Withdrawal Reversed"],
        ClientWalletTransactionType.AdminAdjustment => L["wallets.type.admin_adjustment", "Admin Adjustment"],
        ClientWalletTransactionType.AdminDeposit => L["wallets.type.admin_deposit", "Admin deposit"],
        _ => type.ToString(),
    };

    private async Task OpenAdjustDialog()
    {
        var parameters = new DialogParameters<AdjustWalletDialog>
        {
            { x => x.WebsiteId, _client!.WebsiteID },
            { x => x.ClientId, ClientId },
            { x => x.CurrencyCode, _selectedCurrency },
        };
        var dialog = await DialogService.ShowAsync<AdjustWalletDialog>(L["wallets.adjust", "Adjust Balance"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await ReloadWalletsAsync();
    }
}
