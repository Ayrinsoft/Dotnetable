@inject IClientWalletService WalletService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="_currencyCode" Label="@L["currency", "Currency"]"
                               Variant="Variant.Outlined" Dense="true" Required="true">
                        @foreach (var c in _currencies)
                        {
                            <MudSelectItem T="string" Value="@c.CurrencyCode">
                                @c.CurrencyCode @(c.IsDefault ? $"({L["default", "Default"]})" : "")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <DNMoneyField @bind-Value="_delta"
                                  Label="@L["wallets.adjust.delta", "Amount change (+/-)"]"
                                  DecimalDigits="@MoneyFormat.EffectiveDigits(_currencyCode)"
                                  Min="@null" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_note" Label="@L["note", "Note"]" Variant="Variant.Outlined" Lines="2" Required="true"
                                  RequiredError="@L["required", "This field is required."]" />
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int WebsiteId { get; set; }
    [Parameter] public int ClientId { get; set; }
    [Parameter] public string? CurrencyCode { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private decimal _delta;
    private string? _note;
    private string _currencyCode = "";
    private List<WebsiteWalletCurrency> _currencies = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _currencies = (await WalletService.GetEnabledWalletCurrenciesAsync(WebsiteId)).ToList();
        _currencyCode = !string.IsNullOrWhiteSpace(CurrencyCode)
            ? CurrencyCode
            : (_currencies.FirstOrDefault(c => c.IsDefault)?.CurrencyCode ?? _currencies.FirstOrDefault()?.CurrencyCode ?? "");
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid || _delta == 0 || string.IsNullOrWhiteSpace(_note) || string.IsNullOrWhiteSpace(_currencyCode)) return;

        _saving = true;
        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var memberId);

            await WalletService.ApplyAsync(
                WebsiteId, ClientId,
                (byte)ClientWalletTransactionType.AdminAdjustment,
                _delta,
                (byte)ClientWalletSourceType.AdminManual,
                null,
                _note,
                memberId,
                _currencyCode);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
