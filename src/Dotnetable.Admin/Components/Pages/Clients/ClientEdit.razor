@page "/clients/new"
@page "/clients/{Id:int}"
@attribute [Authorize(Policy = RoleKeys.ClientsView)]
@inject IWebsiteClientService ClientService
@inject IWebsiteClientAddressService AddressService
@inject ILocationService LocationService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@(_isNew ? L["clients.new", "New Customer"] : L["clients.edit", "Edit Customer"]) />

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pb-2" />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["clients.new", "New Customer"] : L["clients.edit", "Edit Customer"])</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_isNew ? L["clients.new_subtitle", "Register a new customer"] : $"{L["clients.editing", "Editing customer"]} #{Id}")
        </MudText>
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_client is not null)
{
    <MudForm @ref="_form">
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ContactMail" Size="Size.Small" Class="me-1" />
                        @L["account", "Account"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_client.Email" Label="@L["email", "Email"]"
                                          Variant="Variant.Outlined" InputType="InputType.Email" Disabled="@(!_canEdit)" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_client.CountryCode" Label="@L["country_code", "Country Code"]"
                                          Variant="Variant.Outlined" MaxLength="3" Placeholder="98" Disabled="@(!_canEdit)" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_client.Cellphone" Label="@L["cellphone", "Cellphone"]"
                                          Variant="Variant.Outlined" MaxLength="12" Disabled="@(!_canEdit)" />
                        </MudItem>
                        @if (_isNew)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_password" Label="@L["password", "Password"]"
                                              Variant="Variant.Outlined" InputType="InputType.Password" Required="true"
                                              RequiredError="@L["required", "This field is required."]" />
                            </MudItem>
                        }
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ClientLevel" @bind-Value="ClientLevelValue" Label="@L["client_level", "Level"]"
                                       Variant="Variant.Outlined" Disabled="@(!_canEdit)">
                                @foreach (var level in Enum.GetValues<ClientLevel>())
                                {
                                    <MudSelectItem T="ClientLevel" Value="@level">@level</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (_isMaster && _isNew)
                            {
                                <WebsiteSelector Value="_client.WebsiteID" ValueChanged="@(id => _client.WebsiteID = id)" Websites="_websites"
                                                 Label="@L["website", "Website"]" Variant="Variant.Outlined" Required="true" />
                            }
                            else
                            {
                                <MudTextField Value="@($"#{_client.WebsiteID}")" Label="@L["website", "Website"]"
                                              Variant="Variant.Outlined" ReadOnly="true" Disabled="true" />
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Class="me-1" />
                        @L["profile", "Profile"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_client.Givenname" Label="@L["given_name", "Given Name"]"
                                          Variant="Variant.Outlined" Disabled="@(!_canEdit)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_client.Surname" Label="@L["surname", "Surname"]"
                                          Variant="Variant.Outlined" Disabled="@(!_canEdit)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="bool?" @bind-Value="_client.Gender" Label="@L["gender", "Gender"]"
                                       Variant="Variant.Outlined" Disabled="@(!_canEdit)">
                                <MudSelectItem T="bool?" Value="@((bool?)null)">—</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)true)">@L["male", "Male"]</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)false)">@L["female", "Female"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudSwitch T="bool" @bind-Value="_client.Active" Color="Color.Primary" Disabled="@(!_canEdit)"
                               Label="@(_client.Active ? L["active_hint", "Active — can sign in"] : L["inactive_hint", "Inactive — cannot sign in"])" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <DNValidationSummary Errors="_formErrors" />

        <MudStack Row="true" Class="mt-4" Spacing="2">
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @(_isNew ? L["clients.create", "Create Customer"] : L["save", "Save Changes"])
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Href="/clients">
                @L["cancel", "Cancel"]
            </MudButton>
        </MudStack>
    </MudForm>

    @if (!_isNew)
    {
    <MudPaper Elevation="0" Class="border rounded-lg pa-6 mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="me-1" />
                @L["clients.addresses", "Addresses"]
            </MudText>
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAddressDialog"
                           Disabled="@(_addresses.Count >= AppConstants.MaxClientAddresses)">
                    @L["clients.addresses.add", "Add Address"]
                </MudButton>
            }
        </MudStack>

        @if (_addresses.Count >= AppConstants.MaxClientAddresses)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                @L["clients.addresses.max_reached", $"This customer has reached the maximum of {AppConstants.MaxClientAddresses} addresses."]
            </MudAlert>
        }

        @if (_addressesLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_addresses.Count == 0)
        {
            <div style="text-align:center; padding:24px;">
                <MudText Color="Color.Secondary">@L["clients.addresses.empty", "No addresses saved."]</MudText>
            </div>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead>
                    <tr>
                        <th>@L["clients.addresses.title_col", "Title"]</th>
                        <th>@L["clients.addresses.receiver", "Receiver"]</th>
                        <th>@L["clients.addresses.location", "Location"]</th>
                        <th>@L["clients.addresses.address_line", "Address"]</th>
                        <th>@L["clients.addresses.phone", "Phone"]</th>
                        <th>@L["clients.addresses.default", "Default"]</th>
                        <th style="width:1%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _addresses)
                    {
                        <tr>
                            <td>@(a.Title ?? "—")</td>
                            <td>@(a.ReceiverName ?? "—")</td>
                            <td>@(string.Join(", ", new[] { a.City?.Title, a.Country?.Title }.Where(s => !string.IsNullOrWhiteSpace(s))))</td>
                            <td>@a.AddressLine</td>
                            <td>@(a.Phone ?? "—")</td>
                            <td>
                                @if (a.IsDefault)
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@L["clients.addresses.default", "Default"]</MudChip>
                                }
                                else if (_canEdit)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetDefaultAddressAsync(a))">
                                        @L["clients.addresses.set_default", "Set default"]
                                    </MudButton>
                                }
                            </td>
                            <td>
                                @if (_canEdit)
                                {
                                    <MudStack Row="true" Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditAddressDialog(a))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAddressAsync(a))" />
                                    </MudStack>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <MudDialog @bind-Visible="_addressDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">
                @(_editAddress?.WebsiteClientAddressID == 0
                    ? L["clients.addresses.dialog_add", "Add Address"]
                    : L["clients.addresses.dialog_edit", "Edit Address"])
            </MudText>
        </TitleContent>
        <DialogContent>
            @if (_editAddress is not null)
            {
                <MudForm @ref="_addressForm">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editAddress.Title" Label="@L["clients.addresses.title_col", "Title"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editAddress.ReceiverName" Label="@L["clients.addresses.receiver", "Receiver"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <CountrySelector Value="_editAddress.CountryId" ValueChanged="OnAddressCountryIdChanged"
                                             Countries="_countries" Label="@L["country", "Country"]" Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <CitySelector Value="_editAddress.CityId" ValueChanged="@(id => _editAddress.CityId = id)"
                                          Cities="_addressCities" Label="@L["city", "City"]" Clearable="true"
                                          Disabled="@(_editAddress.CountryId is null)" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_editAddress.AddressLine" Label="@L["clients.addresses.address_line", "Address"]"
                                          Variant="Variant.Outlined" Lines="2" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editAddress.PostalCode" Label="@L["clients.addresses.postal_code", "Postal Code"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editAddress.Phone" Label="@L["clients.addresses.phone", "Phone"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="_editAddress.Latitude" Label="@L["clients.addresses.latitude", "Latitude"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="_editAddress.Longitude" Label="@L["clients.addresses.longitude", "Longitude"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="_editAddress.IsDefault" Color="Color.Primary" Label="@L["clients.addresses.default", "Default"]" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _addressDialogOpen = false)" Variant="Variant.Text">@L["cancel", "Cancel"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAddressAsync" Disabled="@_addressSaving">
                @if (_addressSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @L["save_short", "Save"]
            </MudButton>
        </DialogActions>
    </MudDialog>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm _form = null!;
    private WebsiteClient? _client;
    private string _password = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _isMaster;
    private bool _canEdit;
    private int _websiteId;
    private List<Website> _websites = new();
    private string[]? _formErrors;
    private bool _isNew => Id == 0;

    private List<WebsiteClientAddress> _addresses = new();
    private bool _addressesLoading = true;
    private List<Country> _countries = new();
    private List<City> _addressCities = new();
    private bool _addressDialogOpen;
    private bool _addressSaving;
    private WebsiteClientAddress? _editAddress;
    private MudForm _addressForm = null!;

    private ClientLevel ClientLevelValue
    {
        get => _client!.ClientLevel.ToEnum<ClientLevel>();
        set => _client!.ClientLevel = value.ToByte();
    }

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["dashboard", "Dashboard"], "/"),
        new(L["clients", "Customers"], "/clients"),
        new(_isNew ? L["new", "New"] : $"#{Id}", null, true),
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        // Creating requires the insert permission; editing an existing customer requires edit.
        _canEdit = AdminPolicies.Allows(user, _isNew ? RoleKeys.ClientsInsert : RoleKeys.ClientsEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isNew)
        {
            _client = new WebsiteClient
            {
                Active = true,
                WebsiteID = _websiteId,
                ClientLevel = (byte)ClientLevel.Normal,
            };
            if (_isMaster)
            {
                _websites = (await WebsiteService.GetAllAsync()).ToList();
                _client.WebsiteID = _websites.FirstOrDefault()?.WebsiteID ?? AppConstants.MasterWebsiteId;
            }
            _loading = false;
            return;
        }

        _client = await ClientService.GetByIdAsync(Id);
        if (_client is null || (!_isMaster && _client.WebsiteID != _websiteId))
        {
            Nav.NavigateTo("/clients");
            return;
        }

        _countries = (await LocationService.GetAllCountriesAsync()).ToList();
        _loading = false;

        await LoadAddressesAsync();
    }

    private async Task LoadAddressesAsync()
    {
        _addressesLoading = true;
        _addresses = await AddressService.GetByClientIdAsync(Id);
        _addressesLoading = false;
    }

    private async Task OnAddressCountryIdChanged(int? countryId)
    {
        _editAddress!.CountryId = countryId;
        _editAddress.CityId = null;
        _addressCities = countryId is int id
            ? (await LocationService.GetCitiesByCountryAsync(id)).ToList()
            : new();
    }

    private void OpenAddAddressDialog()
    {
        _editAddress = new WebsiteClientAddress { WebsiteClientAddressID = 0, WebsiteClientID = Id, AddressLine = string.Empty };
        _addressCities = new();
        _addressDialogOpen = true;
    }

    private async Task OpenEditAddressDialog(WebsiteClientAddress a)
    {
        _editAddress = new WebsiteClientAddress
        {
            WebsiteClientAddressID = a.WebsiteClientAddressID,
            WebsiteClientID = Id,
            Title = a.Title,
            ReceiverName = a.ReceiverName,
            CountryId = a.CountryId,
            CityId = a.CityId,
            AddressLine = a.AddressLine,
            PostalCode = a.PostalCode,
            Phone = a.Phone,
            Latitude = a.Latitude,
            Longitude = a.Longitude,
            IsDefault = a.IsDefault,
        };
        _addressCities = a.CountryId is int countryId
            ? (await LocationService.GetCitiesByCountryAsync(countryId)).ToList()
            : new();
        _addressDialogOpen = true;
    }

    private async Task SaveAddressAsync()
    {
        if (!_canEdit) return; // Guard against a stale/forged client state.

        await _addressForm.ValidateAsync();
        if (!_addressForm.IsValid) return;

        _addressSaving = true;
        try
        {
            var result = _editAddress!.WebsiteClientAddressID == 0
                ? await AddressService.CreateAsync(_editAddress)
                : await AddressService.UpdateAsync(_editAddress);

            switch (result)
            {
                case AddressSaveResult.LimitReached:
                    Snackbar.Add(L["clients.addresses.max_reached", $"This customer has reached the maximum of {AppConstants.MaxClientAddresses} addresses."], Severity.Warning);
                    break;
                case AddressSaveResult.NotFound:
                    Snackbar.Add(L["clients.addresses.not_found", "Address not found."], Severity.Error);
                    break;
                default:
                    Snackbar.Add(L["saved", "Changes saved successfully."], Severity.Success);
                    _addressDialogOpen = false;
                    await LoadAddressesAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _addressSaving = false;
        }
    }

    private async Task DeleteAddressAsync(WebsiteClientAddress a)
    {
        if (!_canEdit) return;
        await AddressService.DeleteAsync(a.WebsiteClientAddressID, Id);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAddressesAsync();
    }

    private async Task SetDefaultAddressAsync(WebsiteClientAddress a)
    {
        if (!_canEdit) return;
        await AddressService.SetDefaultAsync(a.WebsiteClientAddressID, Id);
        await LoadAddressesAsync();
    }

    private async Task SaveAsync()
    {
        if (!_canEdit) return; // Guard against a stale/forged client state.

        await _form.ValidateAsync();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _client!.Email = Normalize(_client.Email);
        _client.Cellphone = Normalize(_client.Cellphone);
        _client.CountryCode = _client.Cellphone is not null ? Normalize(_client.CountryCode) : null;

        _saving = true;
        try
        {
            ClientSaveResult result;
            if (_isNew)
            {
                (result, _) = await ClientService.CreateAsync(_client, _password);
                if (result == ClientSaveResult.Success)
                    Snackbar.Add(L["clients.created", "Customer created successfully."], Severity.Success);
            }
            else
            {
                result = await ClientService.UpdateAsync(_client);
                if (result == ClientSaveResult.Success)
                    Snackbar.Add(L["saved", "Changes saved successfully."], Severity.Success);
            }

            if (result == ClientSaveResult.Duplicate)
            {
                Snackbar.Add(L["clients.duplicate", "This email or cellphone is already used by another customer on this website."], Severity.Error);
                return;
            }

            Nav.NavigateTo("/clients");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Normalize(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
