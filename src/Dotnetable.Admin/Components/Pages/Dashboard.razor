@page "/"
@attribute [Authorize]
@inject IWebsiteService WebsiteService
@inject IAdminNotificationService NotificationService
@inject IAdminTaskService TaskService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["dashboard", "Dashboard"] />

@* ── Page header ─────────────────────────────────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["dashboard", "Dashboard"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @($"{L["dashboard.welcome", "Welcome back"]}, {_userName}")
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_openTasks.Count > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.TaskAlt"
                     OnClick='() => Nav.NavigateTo("/notifications")'>
                @_openTasks.Sum(t => t.Count) @L["tasks.open_short", "tasks"]
            </MudChip>
        }
        @if (_unreadCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Notifications"
                     OnClick='() => Nav.NavigateTo("/notifications")'>
                @_unreadCount @L["notifications.unread", "unread"]
            </MudChip>
        }
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                 Color="@(_isShop ? Color.Warning : Color.Primary)"
                 Icon="@(_isShop ? Icons.Material.Filled.ShoppingCart : Icons.Material.Filled.Language)">
            @(_isShop ? L["store", "Store"] : L["website", "Website"])
        </MudChip>
    </MudStack>
</MudStack>

@* Live queues: orders / bank payments / withdrawals *@
<AdminOpenTasksPanel Tasks="_openTasks" ShowEmpty="@_showTasksPanel" />

@if (_notifications.Count > 0 || _memberId > 0)
{
    <MudPaper Elevation="0" Class="app-card rounded-lg mb-4">
        <div class="pa-4 d-flex align-center justify-space-between" style="border-bottom:1px solid var(--mud-palette-lines-default);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["notifications.todo", "Things to do"]</MudText>
                @if (_unreadCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@_unreadCount</MudChip>
                }
            </MudStack>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       OnClick='() => Nav.NavigateTo("/notifications")'>
                @L["notifications.view_all", "View all"]
            </MudButton>
        </div>
        @if (_notifications.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="1">
                <MudText Color="Color.Secondary">@L["notifications.empty", "No notifications yet."]</MudText>
            </MudStack>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Class="mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>@L["title", "Title"]</th>
                        <th>@L["message", "Message"]</th>
                        <th>@L["date", "Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in _notifications)
                    {
                        <tr style="cursor:pointer;@(!n.IsRead ? "font-weight:600;" : null)"
                            @onclick="@(() => OpenNotificationAsync(n))">
                            <td style="width:48px;">
                                @if (!n.IsRead)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Primary" Size="Size.Small" />
                                }
                            </td>
                            <td>@n.Title</td>
                            <td>@n.Message</td>
                            <td style="white-space:nowrap;">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@if (_isShop)
{
    @* ════════════════ STORE DASHBOARD (v3) ════════════════ *@
    <MudGrid Spacing="3">
        @StatBox("#348fe2", L["dashboard.total_sales", "Total Sales"], "$0.00", Icons.Material.Filled.AttachMoney, L["dashboard.total_sales_sub", "Total orders: 0 · Avg: $0.00"])
        @StatBox("#49b6d6", L["dashboard.conversion_rate", "Conversion Rate"], "0.00%", Icons.Material.Filled.TrendingUp, L["dashboard.conversion_rate_sub", "Added to cart · Checkout · Converted"])
        @StatBox("#f59c1a", L["dashboard.store_sessions", "Store Sessions"], "0", Icons.Material.Filled.Devices, L["dashboard.store_sessions_sub", "Mobile · Desktop · Tablet"])
        @StatBox("#727cb6", L["dashboard.total_page_views", "Total Page Views"], "0K", Icons.Material.Filled.Visibility, L["dashboard.total_page_views_sub", "New & returning visitors"])
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="app-card rounded-lg">
                <div class="pa-4 d-flex align-center gap-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["dashboard.top_products", "Top Products by Units Sold"]</MudText>
                </div>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary">@L["dashboard.no_sales", "No sales data yet."]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="app-card rounded-lg">
                <div class="pa-4 d-flex align-center gap-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["dashboard.sessions_by_location", "Sessions by Location"]</MudText>
                </div>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary">@L["dashboard.no_sessions", "No session data yet."]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    @* ════════════════ WEBSITE DASHBOARD (v2) ════════════════ *@
    <MudGrid Spacing="3">
        @StatBox("#348fe2", L["dashboard.todays_visits", "Today's Visits"], "0", Icons.Material.Filled.PeopleAlt, L["dashboard.vs_last_week", "vs last week"])
        @StatBox("#49b6d6", L["dashboard.page_views", "Page Views"], "0", Icons.Material.Filled.Visibility, L["dashboard.vs_last_week", "vs last week"])
        @StatBox("#f59c1a", L["dashboard.new_members", "New Members"], "0", Icons.Material.Filled.PersonAdd, L["dashboard.vs_last_week", "vs last week"])
        @StatBox("#ff5b57", L["dashboard.new_comments", "New Comments"], "0", Icons.Material.Filled.Comment, L["dashboard.vs_last_week", "vs last week"])
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="app-card rounded-lg">
                <div class="pa-4 d-flex align-center gap-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.InsertChartOutlined" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["dashboard.visitors_analytics", "Visitors Analytics"]</MudText>
                </div>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary">@L["dashboard.no_analytics", "No analytics data yet."]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="app-card rounded-lg h-100">
                <div class="pa-4 d-flex align-center gap-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["dashboard.quick_actions", "Quick Actions"]</MudText>
                </div>
                <MudList T="string" Class="py-1">
                    <AuthorizeView Policy="@RoleKeys.MembersView" Context="_">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.People" OnClick='() => Nav.NavigateTo("/members")'>
                            @L["dashboard.manage_members", "Manage Members"]
                        </MudListItem>
                    </AuthorizeView>
                    <AuthorizeView Policy="@RoleKeys.LocalizationEdit" Context="_">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Language" OnClick='() => Nav.NavigateTo("/website/languages")'>
                            @L["website_languages", "Languages"]
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Translate" OnClick='() => Nav.NavigateTo("/website/translations")'>
                            @L["website_translations", "Translations"]
                        </MudListItem>
                    </AuthorizeView>
                    <AuthorizeView Policy="@AdminPolicies.SuperAdminOnly" Context="_">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Language" OnClick='() => Nav.NavigateTo("/websites")'>
                            @L["websites", "Websites"]
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Settings" OnClick='() => Nav.NavigateTo("/settings")'>
                            @L["settings", "Settings"]
                        </MudListItem>
                    </AuthorizeView>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private string? _userName;
    private bool _isMaster;
    private bool _isShop;
    private bool _showTasksPanel;
    private int _websiteId;
    private int _memberId;
    private int _unreadCount;
    private List<AdminNotification> _notifications = new();
    private IReadOnlyList<AdminOpenTask> _openTasks = Array.Empty<AdminOpenTask>();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _userName = user.Identity?.Name;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out _memberId);

        if (!_isMaster && _websiteId > 0)
        {
            var site = await WebsiteService.GetByIdAsync(_websiteId);
            _isShop = site?.WebsiteType.GetCategory() == WebsiteCategory.Commerce;
        }

        var includeOrders = _isMaster || AdminPolicies.Allows(user, RoleKeys.OrdersView);
        var includePayments = _isMaster || AdminPolicies.Allows(user, RoleKeys.PaymentsView);
        var includeRefunds = _isMaster || AdminPolicies.Allows(user, RoleKeys.PaymentsRefund);
        var includeWithdrawals = _isMaster || AdminPolicies.Allows(user, RoleKeys.WalletsView);
        _showTasksPanel = includeOrders || includePayments || includeRefunds || includeWithdrawals;

        if (_showTasksPanel)
        {
            int? scope = _isMaster || _websiteId <= 0 ? null : _websiteId;
            _openTasks = await TaskService.GetOpenTasksAsync(
                scope, includeOrders, includePayments, includeRefunds, includeWithdrawals);
        }

        if (_memberId > 0)
        {
            _notifications = (await NotificationService.GetRecentAsync(_memberId, 8)).ToList();
            _unreadCount = await NotificationService.GetUnreadCountAsync(_memberId);
        }
    }

    private async Task OpenNotificationAsync(AdminNotification n)
    {
        if (!n.IsRead)
            await NotificationService.MarkReadAsync(n.AdminNotificationID, _memberId);
        if (!string.IsNullOrWhiteSpace(n.ActionUrl))
            Nav.NavigateTo(n.ActionUrl);
        else
            Nav.NavigateTo("/notifications");
    }

    private RenderFragment StatBox(string color, string label, string value, string icon, string sub) =>
        @<MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="app-stat rounded-lg pa-4" Style="@($"background:{color};")">
                <MudIcon Icon="@icon" Class="app-stat-icon" />
                <div class="app-stat-label">@label</div>
                <div class="app-stat-value">@value</div>
                <div style="font-size:.72rem; opacity:.8; margin-top:6px;">@sub</div>
            </MudPaper>
        </MudItem>;
}
