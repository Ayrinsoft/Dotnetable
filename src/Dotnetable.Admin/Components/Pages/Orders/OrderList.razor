@page "/orders"
@attribute [Authorize(Policy = RoleKeys.OrdersView)]
@inject IOrderService OrderService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["orders", "Orders"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["orders", "Orders"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudSelect T="byte?" @bind-Value="_statusFilter" Label="@L["status", "Status"]" Variant="Variant.Outlined" Dense="true" Clearable="true" SelectedValuesChanged="@(_ => LoadAsync())">
            @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
            {
                <MudSelectItem T="byte?" Value="@((byte?)s)">@s</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="4" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["orders.empty", "No orders yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var o in _items)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/orders/{o.OrderID}"))">
                    <td>@o.OrderNumber</td>
                    <td>@o.GrandTotal.ToString("0.##") @o.CurrencyCode</td>
                    <td>@((OrderStatus)o.Status)</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private byte? _statusFilter;
    private List<Order> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["orders.number", "Order #"], ColumnName = nameof(Order.OrderNumber), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["orders.total", "Total"], ColumnName = nameof(Order.GrandTotal), HasSort = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(Order.Status), HasSort = true },
                new() { ColumnTitle = L["orders.date", "Date"], ColumnName = nameof(Order.CreatedAt), HasSort = true },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await OrderService.GetPagedAsync(_websiteId, _statusFilter, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }
}
