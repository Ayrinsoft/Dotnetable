@page "/orders"
@attribute [Authorize(Policy = RoleKeys.OrdersView)]
@inject IOrderService OrderService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["orders", "Orders"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["orders", "Orders"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canCreate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Href="/orders/new">
                @L["orders.create", "Create order"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<StatusQueueBar Items="_statusChips"
                SelectedValue="_statusFilter"
                SelectedValueChanged="OnStatusChipChanged"
                ShowAll="true"
                AllLabel="@L["all", "All"]"
                ShowAllCount="true"
                AllCount="_actionableTotal" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="4" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["orders.empty", "No orders yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var o in _items)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/orders/{o.OrderID}"))">
                    <td>@o.OrderNumber</td>
                    <td>@MoneyFormat.GroupWithCode(o.GrandTotal, o.CurrencyCode)</td>
                    <td>@((OrderStatus)o.Status)</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canCreate;
    private int _websiteId;
    private byte? _statusFilter;
    private List<Order> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();
    private List<StatusQueueBar.Item> _statusChips = new();
    private int _actionableTotal;
    private Dictionary<byte, int> _statusCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canCreate = AdminPolicies.Allows(user, RoleKeys.OrdersEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["orders.number", "Order #"], ColumnName = nameof(Order.OrderNumber), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["orders.total", "Total"], ColumnName = nameof(Order.GrandTotal), HasSort = true },
                new()
                {
                    ColumnTitle = L["status", "Status"],
                    ColumnName = nameof(Order.Status),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    OtherDropDownValues = Enum.GetValues<OrderStatus>()
                        .ToDictionary(v => v.ToString(), v => ((byte)v).ToString())
                },
                new() { ColumnTitle = L["orders.date", "Date"], ColumnName = nameof(Order.CreatedAt), HasSort = true },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task OnStatusChipChanged(byte? status)
    {
        _statusFilter = status;
        SetGridStatusSearch(status);
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _)
    {
        SyncStatusFromGrid();
        return LoadAsync();
    }

    private void SyncStatusFromGrid()
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(Order.Status));
        if (col is null || string.IsNullOrWhiteSpace(col.SearchText))
            _statusFilter = null;
        else if (byte.TryParse(col.SearchText, out var b))
            _statusFilter = b;
    }

    private void SetGridStatusSearch(byte? status)
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(Order.Status));
        if (col is not null)
            col.SearchText = status?.ToString() ?? "";
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await RefreshCountsAsync();

        var query = _grid.ToQuery();
        // Explicit queue filter wins; keep in sync with grid dropdown.
        var statusFilter = _statusFilter;
        if (statusFilter is null
            && query.Search is not null
            && query.Search.TryGetValue(nameof(Order.Status), out var statusText)
            && byte.TryParse(statusText, out var statusByte))
        {
            statusFilter = statusByte;
        }

        var result = await OrderService.GetPagedAsync(_websiteId, statusFilter, query);
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task RefreshCountsAsync()
    {
        _statusCounts = (await OrderService.GetStatusCountsAsync(_websiteId)).ToDictionary(kv => kv.Key, kv => kv.Value);
        _statusChips = OrderStatusQueues.Actionable
            .Select(s => new StatusQueueBar.Item(
                (byte)s,
                StatusLabel(s),
                _statusCounts.GetValueOrDefault((byte)s)))
            .ToList();
        _actionableTotal = _statusChips.Sum(c => c.Count);
    }

    private string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.PendingPayment => L["orders.status.pending_payment", "Pending payment"],
        OrderStatus.Paid => L["orders.status.paid", "Paid"],
        OrderStatus.Processing => L["orders.status.processing", "Processing"],
        OrderStatus.Shipped => L["orders.status.shipped", "Shipped"],
        OrderStatus.Completed => L["orders.status.completed", "Completed"],
        OrderStatus.Cancelled => L["orders.status.cancelled", "Cancelled"],
        OrderStatus.Refunded => L["orders.status.refunded", "Refunded"],
        _ => s.ToString(),
    };
}
