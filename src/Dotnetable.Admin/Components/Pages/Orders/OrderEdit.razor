@page "/orders/{OrderId:int}"
@attribute [Authorize(Policy = RoleKeys.OrdersView)]
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject IBankAccountService BankAccountService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L
@using Dotnetable.Domain.Enums

<DNPageTitle Title="@(_order is null ? "" : $"{L["orders.order", "Order"]} {_order.OrderNumber}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_order is null)
{
    <MudText Color="Color.Error">@L["orders.not_found", "Order not found."]</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5" Class="fw-bold">@_order.OrderNumber</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Color="Color.Primary">@((OrderStatus)_order.Status)</MudChip>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Receipt"
                       Href="@($"/orders/{OrderId}/invoice")">@L["invoice", "Invoice"]</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LocalShipping"
                       Href="@($"/orders/{OrderId}/shipping-label")">@L["orders.shipping_label", "Shipping label"]</MudButton>
            <MudButton OnClick="@(() => Nav.NavigateTo("/orders"))">@L["back", "Back"]</MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.items", "Items"]</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>@L["title", "Title"]</th>
                            <th>@L["variants.sku", "SKU"]</th>
                            <th>@L["quantity", "Qty"]</th>
                            <th>@L["orders.catalog_price", "Catalog"]</th>
                            <th>@L["orders.charged_price", "Charged"]</th>
                            <th>@L["orders.markup", "Markup"]</th>
                            <th>@L["orders.line_total", "Total"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _order.OrderItems)
                        {
                            <tr>
                                <td>@item.TitleSnapshot</td>
                                <td><code>@item.SkuSnapshot</code></td>
                                <td>@item.Quantity</td>
                                <td>@item.CatalogUnitPrice.ToString("0.##")</td>
                                <td>@item.UnitPrice.ToString("0.##")</td>
                                <td>@item.UnitMarkup.ToString("0.##")</td>
                                <td>@item.TotalPrice.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["payments", "Payments"]</MudText>
                @if (_order.Payments.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["payments.none", "No payments recorded yet."]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead>
                            <tr>
                                <th>@L["method", "Method"]</th>
                                <th>@L["amount", "Amount"]</th>
                                <th>@L["status", "Status"]</th>
                                <th>@L["payments.recorded_by", "Recorded by"]</th>
                                <th>@L["reference", "Reference"]</th>
                                <th>@L["date", "Date"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _order.Payments.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td>@MethodLabel((PaymentMethod)p.Method)</td>
                                    <td>@p.Amount.ToString("0.##") @p.CurrencyCode</td>
                                    <td>@((PaymentStatus)p.Status)</td>
                                    <td>
                                        <MudText Typo="Typo.body2">@RecordedByLabel(p)</MudText>
                                        @if (p.VerifiedByMember is not null && p.CreatedByMemberID is null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @L["payments.verified_by", "Verified by"]: @MemberName(p.VerifiedByMember)
                                            </MudText>
                                        }
                                    </td>
                                    <td>@(p.TrackingCode ?? p.GatewayRefNumber ?? "—")</td>
                                    <td>@((p.PaidAt ?? p.CreatedAt).ToLocalTime().ToString("g"))</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.history", "Status History"]</MudText>
                <MudTimeline>
                    @foreach (var h in _order.OrderStatusHistories.OrderBy(h => h.CreatedAt))
                    {
                        <MudTimelineItem Size="Size.Small">
                            <MudText Typo="Typo.body2">@((OrderStatus)h.ToStatus) — @h.CreatedAt.ToLocalTime().ToString("g")</MudText>
                            @if (!string.IsNullOrEmpty(h.Note))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@h.Note</MudText>
                            }
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.totals", "Totals"]</MudText>
                <MudStack Spacing="1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudText>@L["orders.subtotal", "Subtotal"]</MudText><MudText>@MoneyFormat.GroupWithCode(_order.SubTotal, _order.CurrencyCode)</MudText></MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudText>@L["orders.discount", "Discount"]</MudText><MudText>-@MoneyFormat.Group(_order.DiscountTotal, _order.CurrencyCode)</MudText></MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudText>@L["shipping", "Shipping"]</MudText><MudText>@MoneyFormat.Group(_order.ShippingTotal, _order.CurrencyCode)</MudText></MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudText>@L["tax", "Tax"]</MudText><MudText>@MoneyFormat.Group(_order.TaxTotal, _order.CurrencyCode)</MudText></MudStack>
                    @if (_order.MarkupTotal > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText>@L["orders.markup_total", "Markup total"]</MudText>
                            <MudText>@MoneyFormat.Group(_order.MarkupTotal, _order.CurrencyCode)</MudText>
                        </MudStack>
                    }
                    @if (_order.PricesIncludeTax)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["invoice.prices_include_tax", "Prices include tax"]</MudText>
                    }
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudText Typo="Typo.subtitle2">@L["orders.grand_total", "Grand Total"]</MudText><MudText Typo="Typo.subtitle2">@MoneyFormat.GroupWithCode(_order.GrandTotal, _order.CurrencyCode)</MudText></MudStack>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.meta", "Order info"]</MudText>
                <MudStack Spacing="1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>@L["orders.sales_channel", "Sales channel"]</MudText>
                        <MudText>@ChannelLabel((OrderSalesChannel)_order.SalesChannel)</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>@L["orders.report_to_tax", "Report to tax"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(_order.ReportToTax ? Color.Success : Color.Warning)">
                            @(_order.ReportToTax ? L["yes", "Yes"] : L["no", "No"])
                        </MudChip>
                    </MudStack>
                    @if (_order.CreatedByMemberID is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["orders.created_by_admin", "Created by admin"]
                        </MudText>
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.address", "Shipping Address"]</MudText>
                <MudText Typo="Typo.body2">@_order.AddressSnapshot</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2" StartIcon="@Icons.Material.Filled.Print"
                           Href="@($"/orders/{OrderId}/shipping-label")">
                    @L["orders.print_address", "Print address label"]
                </MudButton>
            </MudPaper>

            @if (_canEdit)
            {
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["orders.transition", "Change Status"]</MudText>
                    <MudSelect T="OrderStatus" @bind-Value="_newStatus" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                        @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
                        {
                            <MudSelectItem T="OrderStatus" Value="@s">@s</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_note" Label="@L["orders.note", "Note (optional)"]" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="TransitionAsync">@L["save", "Save"]</MudButton>
                </MudPaper>
            }

            @if (_canRecordPayment && CanShowRecordPayment)
            {
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["payments.record_received", "Record payment received"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                        @L["payments.record_received_hint", "Use when the customer paid cash on delivery, cash/POS in person, or another offline channel that is not a bank-receipt queue item."]
                    </MudText>
                    <MudSelect T="PaymentMethod" @bind-Value="_receiveMethod" Variant="Variant.Outlined" Dense="true" Class="mb-2"
                               Label="@L["method", "Method"]">
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.BankTransfer">@L["payments.method.bank", "Bank transfer / card-to-card"]</MudSelectItem>
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.CashOnDelivery">@L["payments.method.cod", "Cash on delivery"]</MudSelectItem>
                        <MudSelectItem T="PaymentMethod" Value="PaymentMethod.Manual">@L["payments.method.manual", "Manual / cash / POS"]</MudSelectItem>
                    </MudSelect>
                    <MudNumericField T="decimal" @bind-Value="_receiveAmount" Label="@($"{L["amount", "Amount"]} ({_order.CurrencyCode})")"
                                    Variant="Variant.Outlined" Dense="true" Min="0" Class="mb-2" />
                    <MudDatePicker @bind-Date="_receiveDate" Label="@L["payments.paid_date", "Payment date"]" Variant="Variant.Outlined"
                                   Dense="true" Class="mb-2" Editable="true" Required="true"
                                   RequiredError="@L["required", "This field is required."]" />
                    <MudSwitch T="bool" @bind-Value="_receiveIncludeTime" Color="Color.Primary" Class="mb-2"
                               Label="@L["payments.include_time", "Include payment time"]" />
                    @if (_receiveIncludeTime)
                    {
                        <MudTimePicker @bind-Time="_receiveTime" Label="@L["payments.paid_time", "Payment time"]" Variant="Variant.Outlined"
                                       Dense="true" Class="mb-2" Editable="true" AmPm="false" />
                    }
                    <MudTextField @bind-Value="_receiveReference" Label="@L["reference", "Reference (optional)"]" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    <MudTextField @bind-Value="_receiveNote" Label="@L["orders.note", "Note (optional)"]" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    @if (_receiveMethod == PaymentMethod.BankTransfer)
                    {
                        <MudAutocomplete T="BankAccount" Value="@GetReceiveBankAccount()" ValueChanged="OnReceiveBankChanged"
                                         SearchFunc="SearchBankAccounts" ToStringFunc="BankAccountDisplay"
                                         Label="@L["bank_accounts", "Bank Account"]" Variant="Variant.Outlined"
                                         Dense="true" Class="mb-2" Clearable="true"
                                         CoerceText="false" ResetValueOnEmptyText="true" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile"
                                       OnClick="PickReceiptAsync">
                                @L["orders.upload_receipt", "Upload / pick receipt"]
                            </MudButton>
                            @if (_receiveReceiptFileId is not null)
                            {
                                <MudChip T="string" Size="Size.Small" OnClose="() => _receiveReceiptFileId = null">
                                    #@_receiveReceiptFileId
                                </MudChip>
                            }
                        </MudStack>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="RecordReceivedAsync"
                               Disabled="_savingReceive">
                        @L["payments.record_received", "Record payment received"]
                    </MudButton>
                </MudPaper>
            }

            @if (_canRefund && CanShowRefund)
            {
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["payments.refund", "Refund"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                        @L["payments.refund_hint", "Record money returned to the customer: wallet credit, bank transfer (queue), or cash/manual hand-back."]
                    </MudText>
                    <MudNumericField T="decimal" @bind-Value="_refundAmount" Label="@L["orders.total", "Amount (USD)"]" Variant="Variant.Outlined" Dense="true" Min="0" Class="mb-2" />
                    <MudTextField @bind-Value="_refundReason" Label="@L["payments.reason", "Reason"]" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    <MudSelect T="string" @bind-Value="_refundDestination" Variant="Variant.Outlined" Dense="true" Class="mb-2"
                               Label="@L["payments.refund_destination", "Refund destination"]">
                        <MudSelectItem T="string" Value="@("wallet")">@L["payments.refund_to_wallet", "Customer wallet"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("bank")">@L["payments.refund_to_bank", "Bank transfer (manual)"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("cash")">@L["payments.refund_to_cash", "Cash / manual hand-back"]</MudSelectItem>
                    </MudSelect>
                    @if (_refundDestination == "bank")
                    {
                        <MudAutocomplete T="BankAccount" Value="@GetRefundBankAccount()" ValueChanged="OnRefundBankChanged"
                                         SearchFunc="SearchBankAccounts" ToStringFunc="BankAccountDisplay"
                                         Label="@L["bank_accounts", "Bank Account"]" Variant="Variant.Outlined"
                                         Dense="true" Class="mb-2" Clearable="true"
                                         CoerceText="false" ResetValueOnEmptyText="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@L["payments.bank_refund_hint", "The transfer must be performed manually outside the system; this only records the refund as pending until you mark it completed on the Bank Refunds queue."]</MudText>
                    }
                    else if (_refundDestination == "cash")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@L["payments.cash_refund_hint", "Marks the refund completed immediately with no wallet credit and no bank queue item — use when cash was returned in person."]</MudText>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" OnClick="RefundAsync" Disabled="_savingRefund">
                        @L["payments.refund", "Refund"]
                    </MudButton>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int OrderId { get; set; }

    private bool _loading = true, _canEdit, _canRefund, _canRecordPayment;
    private bool _savingReceive, _savingRefund;
    private Order? _order;
    private OrderStatus _newStatus;
    private string? _note;
    private int? _currentMemberId;

    private PaymentMethod _receiveMethod = PaymentMethod.CashOnDelivery;
    private decimal _receiveAmount;
    private string? _receiveReference;
    private string? _receiveNote;
    private int? _receiveBankAccountId;
    private int? _receiveReceiptFileId;
    private DateTime? _receiveDate = DateTime.Today;
    private bool _receiveIncludeTime;
    private TimeSpan? _receiveTime;

    private decimal _refundAmount;
    private string? _refundReason;
    private string _refundDestination = "wallet";
    private int? _refundBankAccountId;
    private List<BankAccount> _bankAccounts = new();

    private bool CanShowRecordPayment =>
        _order is not null
        && _order.Status is not ((byte)OrderStatus.Cancelled or (byte)OrderStatus.Refunded)
        && !_order.Payments.Any(p => p.Status == (byte)PaymentStatus.Paid);

    private bool CanShowRefund =>
        _order is not null
        && _order.Status is not ((byte)OrderStatus.Cancelled or (byte)OrderStatus.Refunded)
        && _order.Payments.Any(p => p.Status == (byte)PaymentStatus.Paid);

    private BankAccount? GetRefundBankAccount() =>
        _refundBankAccountId is int id ? _bankAccounts.FirstOrDefault(b => b.BankAccountID == id) : null;

    private void OnRefundBankChanged(BankAccount? account) =>
        _refundBankAccountId = account?.BankAccountID;

    private BankAccount? GetReceiveBankAccount() =>
        _receiveBankAccountId is int id ? _bankAccounts.FirstOrDefault(b => b.BankAccountID == id) : null;

    private void OnReceiveBankChanged(BankAccount? account) =>
        _receiveBankAccountId = account?.BankAccountID;

    private string ChannelLabel(OrderSalesChannel ch) => ch switch
    {
        OrderSalesChannel.Online => L["orders.channel.online", "Online store"],
        OrderSalesChannel.Instagram => L["orders.channel.instagram", "Instagram"],
        OrderSalesChannel.WhatsApp => L["orders.channel.whatsapp", "WhatsApp"],
        OrderSalesChannel.Telegram => L["orders.channel.telegram", "Telegram"],
        OrderSalesChannel.Phone => L["orders.channel.phone", "Phone"],
        OrderSalesChannel.InPerson => L["orders.channel.in_person", "In person"],
        OrderSalesChannel.Store => L["orders.channel.store", "Store / shop"],
        _ => L["orders.channel.other", "Other"],
    };

    private async Task PickReceiptAsync()
    {
        if (_order is null) return;
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = _order.WebsiteID,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
            _receiveReceiptFileId = file.FileRecordID;
    }

    private string BankAccountDisplay(BankAccount? b) =>
        b is null ? string.Empty : $"{b.Bank?.Name ?? "Bank"} — {b.Title}";

    private Task<IEnumerable<BankAccount>> SearchBankAccounts(string value, CancellationToken ct)
    {
        IEnumerable<BankAccount> q = _bankAccounts.OrderBy(b => b.Title);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(b =>
                b.Title.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || (b.Bank?.Name?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(q);
    }

    private string MethodLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Wallet => L["payments.method.wallet", "Wallet"],
        PaymentMethod.BankTransfer => L["payments.method.bank", "Bank transfer"],
        PaymentMethod.Manual => L["payments.method.manual", "Manual / cash / POS"],
        PaymentMethod.CashOnDelivery => L["payments.method.cod", "Cash on delivery"],
        _ => method.ToString(),
    };

    private static string MemberName(Member m) =>
        $"{m.Givenname} {m.Surname}".Trim() is { Length: > 0 } name ? name : m.Username;

    private static string ClientName(WebsiteClient c) =>
        $"{c.Givenname} {c.Surname}".Trim() is { Length: > 0 } name ? name : (c.Email ?? c.Cellphone ?? $"#{c.WebsiteClientID}");

    /// <summary>Admin-created when <see cref="Payment.CreatedByMemberID"/> is set; otherwise customer self-service.</summary>
    private string RecordedByLabel(Payment p)
    {
        if (p.CreatedByMember is not null)
            return $"{L["payments.actor.admin", "Admin"]} — {MemberName(p.CreatedByMember)}";
        if (p.CreatedByMemberID is int)
            return $"{L["payments.actor.admin", "Admin"]} — #{p.CreatedByMemberID}";

        var customer = p.WebsiteClient ?? _order?.WebsiteClient;
        if (customer is not null)
            return $"{L["payments.actor.customer", "Customer"]} — {ClientName(customer)}";
        return L["payments.actor.customer", "Customer"];
    }

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _canEdit = AdminPolicies.Allows(user, RoleKeys.OrdersEdit);
        _canRefund = AdminPolicies.Allows(user, RoleKeys.PaymentsRefund);
        _canRecordPayment = AdminPolicies.Allows(user, RoleKeys.PaymentsVerify);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid)) _currentMemberId = mid;
        await LoadAsync();
        if ((_canRefund || _canRecordPayment) && _order is not null)
            _bankAccounts = await BankAccountService.GetByWebsiteAsync(_order.WebsiteID);
    }

    private async Task RecordReceivedAsync()
    {
        if (_order is null || _currentMemberId is null) return;
        if (_receiveAmount <= 0)
        {
            Snackbar.Add(L["payments.amount_required", "Enter a valid amount."], Severity.Warning);
            return;
        }
        if (_receiveDate is null)
        {
            Snackbar.Add(L["payments.paid_date_required", "Payment date is required."], Severity.Warning);
            return;
        }

        _savingReceive = true;
        try
        {
            var paidAtUtc = BuildPaidAtUtc(_receiveDate.Value, _receiveIncludeTime, _receiveTime);
            var (success, error, _) = await PaymentService.RecordReceivedPaymentAsync(
                _order.OrderID, _receiveMethod, _receiveAmount, _receiveReference, _receiveNote, _currentMemberId.Value,
                _receiveBankAccountId, _receiveReceiptFileId, markAsPaid: true, paidAtUtc: paidAtUtc);
            if (success)
            {
                Snackbar.Add(L["saved", "Saved."], Severity.Success);
                _receiveReference = null;
                _receiveNote = null;
                _receiveReceiptFileId = null;
                await LoadAsync();
            }
            else Snackbar.Add(error ?? L["save_failed", "Save failed"], Severity.Error);
        }
        finally { _savingReceive = false; }
    }

    private static DateTime BuildPaidAtUtc(DateTime date, bool includeTime, TimeSpan? time)
    {
        var local = includeTime && time is TimeSpan t
            ? date.Date.Add(t)
            : date.Date;
        return DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime();
    }

    private async Task RefundAsync()
    {
        if (_order is null || _currentMemberId is null) return;
        var payment = _order.Payments.FirstOrDefault(p => p.Status == (byte)PaymentStatus.Paid);
        if (payment is null) return;
        if (_refundAmount <= 0)
        {
            Snackbar.Add(L["payments.amount_required", "Enter a valid amount."], Severity.Warning);
            return;
        }
        if (_refundDestination == "bank" && _refundBankAccountId is null)
        {
            Snackbar.Add(L["payments.bank_account_required", "Select a bank account."], Severity.Warning);
            return;
        }

        var toWallet = _refundDestination == "wallet";
        int? bankId = _refundDestination == "bank" ? _refundBankAccountId : null;

        _savingRefund = true;
        try
        {
            var (success, error, _) = await PaymentService.RefundAsync(
                payment.PaymentID, _refundAmount, _refundReason, toWallet, bankId, _currentMemberId.Value);
            if (success) { Snackbar.Add(L["saved", "Saved."], Severity.Success); await LoadAsync(); }
            else Snackbar.Add(error ?? L["save_failed", "Save failed"], Severity.Error);
        }
        finally { _savingRefund = false; }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _order = await OrderService.GetByIdAsync(OrderId);
        if (_order is not null)
        {
            _newStatus = (OrderStatus)_order.Status;
            if (_receiveAmount <= 0) _receiveAmount = _order.GrandTotal;
            if (_refundAmount <= 0) _refundAmount = _order.GrandTotalUsd;
        }
        _loading = false;
    }

    private async Task TransitionAsync()
    {
        if (_order is null) return;
        var ok = await OrderService.TransitionStatusAsync(_order.OrderID, _newStatus, _currentMemberId, _note);
        if (ok) { Snackbar.Add(L["saved", "Saved."], Severity.Success); _note = null; await LoadAsync(); }
        else Snackbar.Add(L["save_failed", "Save failed"], Severity.Error);
    }
}
