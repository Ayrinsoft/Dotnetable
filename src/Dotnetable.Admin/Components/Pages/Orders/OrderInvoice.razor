@page "/orders/{OrderId:int}/invoice"
@attribute [Authorize(Policy = RoleKeys.OrdersView)]
@inject ITaxReportService TaxReportService
@inject IEmailService EmailService
@inject NavigationManager Nav
@inject IPageLocalizer L
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<DNPageTitle Title="@(_inv is null ? L["invoice", "Invoice"] : $"{L["invoice", "Invoice"]} {_inv.OrderNumber}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_inv is null)
{
    <MudText Color="Color.Error">@L["orders.not_found", "Order not found."]</MudText>
}
else
{
    <div class="print-doc-toolbar no-print">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo($"/orders/{OrderId}"))">@L["back", "Back"]</MudButton>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintAsync">
                    @L["print_pdf", "Print PDF"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Email" OnClick="SendEmailAsync"
                           Disabled="@(_sendingEmail || string.IsNullOrWhiteSpace(_shareEmail))">
                    @(_sendingEmail ? L["sending", "Sending…"] : L["invoice.send_email", "Email customer"])
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Chat" OnClick="OpenWhatsAppAsync"
                           Disabled="@string.IsNullOrWhiteSpace(_sharePhone)">
                    @L["invoice.send_whatsapp", "WhatsApp"]
                </MudButton>
            </MudStack>
        </MudStack>
    </div>

    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4 print-doc-share no-print mb-3">
        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["invoice.share", "Send this invoice to the customer"]</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            @L["invoice.share_help", "Edit the address if needed, then email a formatted copy or open WhatsApp with a text summary of the same totals (markup is already included in prices)."]
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_shareEmail" Label="@L["email", "Email"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_sharePhone" Label="@L["phone", "Phone / WhatsApp"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@L["invoice.phone_help", "Include country code when possible (e.g. 98912…)."]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
            </MudItem>
        </MudGrid>
        @if (!_emailConfigured)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Variant="Variant.Outlined">
                @L["invoice.email_not_configured", "No sales email account is configured for this website — set one under Email accounts before sending."]
            </MudAlert>
        }
    </MudPaper>

    <div id="order-invoice-print" class="print-doc invoice-doc">
        <div class="print-doc-sheet">
            <header class="print-doc-header">
                <div>
                    <h1 class="print-doc-title">@L["invoice", "Tax invoice"]</h1>
                    <p class="print-doc-subtitle">#@_inv.OrderNumber</p>
                    <p class="print-doc-meta">
                        @L["date", "Date"]: @_inv.CreatedAt.ToLocalTime().ToString("g")
                        @if (_inv.PaidAt is DateTime paid)
                        {
                            <span> · @L["orders.paid_at", "Paid"]: @paid.ToLocalTime().ToString("g")</span>
                        }
                    </p>
                </div>
                <div class="@StatusBadgeClass(_inv.Status)">@StatusLabel(_inv.Status)</div>
            </header>

            <div class="print-doc-parties">
                <section class="print-doc-party">
                    <h2 class="print-doc-party-label">@L["invoice.seller", "Seller"]</h2>
                    <p class="print-doc-party-name">@(_inv.Seller.LegalName ?? _inv.Seller.Name)</p>
                    <div class="print-doc-party-fields">
                        @if (!string.IsNullOrEmpty(_inv.Seller.TaxId))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["website.seller_tax_id", "Tax ID"]</span><span class="v">@_inv.Seller.TaxId</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Seller.EconomicCode))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["website.seller_economic_code", "Economic code"]</span><span class="v">@_inv.Seller.EconomicCode</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Seller.VatNumber))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["website.seller_vat", "VAT"]</span><span class="v">@_inv.Seller.VatNumber</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Seller.RegistrationNumber))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["website.seller_registration", "Registration"]</span><span class="v">@_inv.Seller.RegistrationNumber</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Seller.Email))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["email", "Email"]</span><span class="v">@_inv.Seller.Email</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Seller.Phone))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["phone", "Phone"]</span><span class="v">@_inv.Seller.Phone</span></div>
                        }
                    </div>
                </section>
                <section class="print-doc-party">
                    <h2 class="print-doc-party-label">@L["invoice.buyer", "Buyer"]</h2>
                    <p class="print-doc-party-name">@(string.IsNullOrWhiteSpace(_inv.Buyer.Name) ? "—" : _inv.Buyer.Name)</p>
                    <div class="print-doc-party-fields">
                        @if (!string.IsNullOrEmpty(_inv.Buyer.Email))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["email", "Email"]</span><span class="v">@_inv.Buyer.Email</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Buyer.Phone))
                        {
                            <div class="print-doc-party-row"><span class="k">@L["phone", "Phone"]</span><span class="v">@_inv.Buyer.Phone</span></div>
                        }
                        @if (!string.IsNullOrEmpty(_inv.Buyer.Address))
                        {
                            <div class="print-doc-party-row print-doc-party-row-block">
                                <span class="k">@L["address", "Address"]</span>
                                <span class="v">@_inv.Buyer.Address</span>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <table class="print-doc-lines">
                <thead>
                    <tr>
                        <th style="width:38%">@L["title", "Title"]</th>
                        <th>@L["products.code", "Code"]</th>
                        <th>@L["variants.sku", "SKU"]</th>
                        <th class="text-end">@L["quantity", "Qty"]</th>
                        <th class="text-end">@L["variants.price", "Unit"]</th>
                        <th class="text-end">@L["orders.line_total", "Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _inv.Lines)
                    {
                        <tr>
                            <td>@line.Title</td>
                            <td><code>@(string.IsNullOrWhiteSpace(line.ProductCode) ? "—" : line.ProductCode)</code></td>
                            <td><code>@(line.Sku ?? "—")</code></td>
                            <td class="text-end">@line.Quantity</td>
                            <td class="text-end">@MoneyFormat.Group(line.UnitPrice, _inv.CurrencyCode)</td>
                            <td class="text-end">@MoneyFormat.Group(line.LineTotal, _inv.CurrencyCode)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="print-doc-footer-grid">
                <div class="print-doc-notes">
                    <p class="print-doc-notes-title">@L["invoice.notes", "Notes"]</p>
                    @if (_inv.PricesIncludeTax)
                    {
                        <div>@L["invoice.prices_include_tax", "Catalog prices include tax; tax line is reported for disclosure."]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_inv.Note))
                    {
                        <div class="mt-1">@_inv.Note</div>
                    }
                    @if (string.IsNullOrWhiteSpace(_inv.Note) && !_inv.PricesIncludeTax)
                    {
                        <div>—</div>
                    }
                </div>
                <div class="print-doc-totals">
                    <table>
                        @* Markup is folded into unit prices / subtotal / grand total — never a separate customer line. *@
                        <tr>
                            <td>@L["orders.subtotal", "Subtotal"]</td>
                            <td class="text-end">@MoneyFormat.GroupWithCode(_inv.SubTotal, _inv.CurrencyCode)</td>
                        </tr>
                        <tr>
                            <td>@L["orders.discount", "Discount"]</td>
                            <td class="text-end">-@MoneyFormat.Group(_inv.DiscountTotal, _inv.CurrencyCode)</td>
                        </tr>
                        <tr>
                            <td>@L["shipping", "Shipping"]</td>
                            <td class="text-end">@MoneyFormat.GroupWithCode(_inv.ShippingTotal, _inv.CurrencyCode)</td>
                        </tr>
                        <tr>
                            <td>@L["tax", "Tax"]</td>
                            <td class="text-end">@MoneyFormat.GroupWithCode(_inv.TaxTotal, _inv.CurrencyCode)</td>
                        </tr>
                        <tr>
                            <td>@L["orders.grand_total", "Grand total"]</td>
                            <td class="text-end">@MoneyFormat.GroupWithCode(_inv.GrandTotal, _inv.CurrencyCode)</td>
                        </tr>
                    </table>
                </div>
            </div>

            <footer class="print-doc-stamp">
                @(_inv.Seller.LegalName ?? _inv.Seller.Name) · @L["invoice", "Invoice"] #@_inv.OrderNumber
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public int OrderId { get; set; }

    private bool _loading = true;
    private bool _sendingEmail;
    private bool _emailConfigured;
    private OrderInvoiceDto? _inv;
    private string _shareEmail = "";
    private string _sharePhone = "";

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _inv = await TaxReportService.GetOrderInvoiceAsync(OrderId);
        if (_inv is not null)
        {
            _shareEmail = _inv.Buyer.Email?.Trim() ?? "";
            _sharePhone = _inv.Buyer.Phone?.Trim() ?? "";
            try
            {
                _emailConfigured = await EmailService.IsConfiguredAsync(_inv.WebsiteId);
            }
            catch
            {
                _emailConfigured = false;
            }
        }
        _loading = false;
    }

    private string StatusLabel(byte status) => ((OrderStatus)status) switch
    {
        OrderStatus.PendingPayment => L["orders.status.pending_payment", "Pending payment"],
        OrderStatus.Paid => L["orders.status.paid", "Paid"],
        OrderStatus.Processing => L["orders.status.processing", "Processing"],
        OrderStatus.Shipped => L["orders.status.shipped", "Shipped"],
        OrderStatus.Completed => L["orders.status.completed", "Completed"],
        OrderStatus.Cancelled => L["orders.status.cancelled", "Cancelled"],
        OrderStatus.Refunded => L["orders.status.refunded", "Refunded"],
        _ => ((OrderStatus)status).ToString(),
    };

    private static string StatusBadgeClass(byte status) => ((OrderStatus)status) switch
    {
        OrderStatus.Paid or OrderStatus.Completed => "print-doc-badge print-doc-badge-success",
        OrderStatus.PendingPayment => "print-doc-badge print-doc-badge-warn",
        OrderStatus.Cancelled or OrderStatus.Refunded => "print-doc-badge print-doc-badge-muted",
        _ => "print-doc-badge print-doc-badge-info",
    };

    private async Task PrintAsync() =>
        await Js.InvokeVoidAsync("dotnetablePrint.printElement", "order-invoice-print",
            _inv is null ? L["invoice", "Invoice"] : $"{L["invoice", "Invoice"]} {_inv.OrderNumber}");

    private async Task SendEmailAsync()
    {
        if (_inv is null) return;
        var to = _shareEmail.Trim();
        if (string.IsNullOrWhiteSpace(to) || !to.Contains('@'))
        {
            Snackbar.Add(L["invoice.email_invalid", "Enter a valid customer email."], Severity.Warning);
            return;
        }

        _sendingEmail = true;
        try
        {
            var subject = string.Format(
                L["invoice.email_subject", "Invoice #{0} — {1}"],
                _inv.OrderNumber,
                _inv.Seller.Name);

            // Full invoice HTML so the customer sees line prices (markup already included) — not only a link.
            await EmailService.SendAsync(
                _inv.WebsiteId, EmailAccountType.Sales, to, subject, BuildInvoiceEmailHtml());

            Snackbar.Add(L["invoice.email_sent", "Invoice email sent."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sendingEmail = false;
        }
    }

    private async Task OpenWhatsAppAsync()
    {
        if (_inv is null) return;
        var digits = NormalizePhoneDigits(_sharePhone);
        if (digits.Length < 8)
        {
            Snackbar.Add(L["invoice.phone_invalid", "Enter a valid phone number for WhatsApp."], Severity.Warning);
            return;
        }

        var text = BuildWhatsAppText();
        var url = $"https://wa.me/{digits}?text={Uri.EscapeDataString(text)}";
        await Js.InvokeVoidAsync("dotnetablePrint.openExternal", url);
    }

    private string BuildWhatsAppText()
    {
        var inv = _inv!;
        var seller = inv.Seller.LegalName ?? inv.Seller.Name;
        var buyer = string.IsNullOrWhiteSpace(inv.Buyer.Name) ? "—" : inv.Buyer.Name;
        var lines = string.Join("\n", inv.Lines.Select(l =>
            $"• {l.Title} × {l.Quantity} = {MoneyFormat.GroupWithCode(l.LineTotal, inv.CurrencyCode)}"));

        return
            $"{L["invoice", "Invoice"]} #{inv.OrderNumber}\n" +
            $"{L["invoice.seller", "Seller"]}: {seller}\n" +
            $"{L["invoice.buyer", "Buyer"]}: {buyer}\n" +
            $"{L["date", "Date"]}: {inv.CreatedAt.ToLocalTime():g}\n\n" +
            $"{lines}\n\n" +
            $"{L["orders.subtotal", "Subtotal"]}: {MoneyFormat.GroupWithCode(inv.SubTotal, inv.CurrencyCode)}\n" +
            $"{L["orders.discount", "Discount"]}: -{MoneyFormat.Group(inv.DiscountTotal, inv.CurrencyCode)}\n" +
            $"{L["shipping", "Shipping"]}: {MoneyFormat.GroupWithCode(inv.ShippingTotal, inv.CurrencyCode)}\n" +
            $"{L["tax", "Tax"]}: {MoneyFormat.GroupWithCode(inv.TaxTotal, inv.CurrencyCode)}\n" +
            $"{L["orders.grand_total", "Grand total"]}: {MoneyFormat.GroupWithCode(inv.GrandTotal, inv.CurrencyCode)}";
    }

    private string BuildInvoiceEmailHtml()
    {
        var inv = _inv!;
        static string H(string? s) => global::System.Net.WebUtility.HtmlEncode(s ?? "");

        var seller = H(inv.Seller.LegalName ?? inv.Seller.Name);
        var buyer = H(string.IsNullOrWhiteSpace(inv.Buyer.Name) ? "—" : inv.Buyer.Name);
        var sb = new global::System.Text.StringBuilder();
        sb.Append("<div style=\"font-family:Segoe UI,Tahoma,Arial,sans-serif;color:#111;max-width:640px;margin:0 auto;\">");
        sb.Append($"<h2 style=\"margin:0 0 4px;border-bottom:2px solid #111;padding-bottom:10px;\">{H(L["invoice", "Invoice"])} #{H(inv.OrderNumber)}</h2>");
        sb.Append($"<p style=\"margin:0 0 16px;font-size:13px;color:#333;\">{H(L["date", "Date"])}: {inv.CreatedAt.ToLocalTime():g}</p>");
        sb.Append("<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:16px;\"><tr>");
        sb.Append($"<td width=\"50%\" style=\"vertical-align:top;padding:10px;border:1px solid #333;\"><strong>{H(L["invoice.seller", "Seller"])}</strong><br/>{seller}</td>");
        sb.Append($"<td width=\"50%\" style=\"vertical-align:top;padding:10px;border:1px solid #333;\"><strong>{H(L["invoice.buyer", "Buyer"])}</strong><br/>{buyer}</td>");
        sb.Append("</tr></table>");
        sb.Append("<table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:13px;margin-bottom:16px;\">");
        sb.Append("<thead><tr style=\"background:#f0f2f4;\">");
        sb.Append($"<th align=\"left\" style=\"border-bottom:2px solid #111;\">{H(L["title", "Title"])}</th>");
        sb.Append($"<th align=\"left\" style=\"border-bottom:2px solid #111;\">{H(L["products.code", "Code"])}</th>");
        sb.Append($"<th align=\"right\" style=\"border-bottom:2px solid #111;\">{H(L["quantity", "Qty"])}</th>");
        sb.Append($"<th align=\"right\" style=\"border-bottom:2px solid #111;\">{H(L["variants.price", "Unit"])}</th>");
        sb.Append($"<th align=\"right\" style=\"border-bottom:2px solid #111;\">{H(L["orders.line_total", "Total"])}</th>");
        sb.Append("</tr></thead><tbody>");
        foreach (var line in inv.Lines)
        {
            sb.Append("<tr>");
            sb.Append($"<td style=\"border-bottom:1px solid #ccc;\">{H(line.Title)}</td>");
            sb.Append($"<td style=\"border-bottom:1px solid #ccc;\">{H(string.IsNullOrWhiteSpace(line.ProductCode) ? "—" : line.ProductCode)}</td>");
            sb.Append($"<td align=\"right\" style=\"border-bottom:1px solid #ccc;\">{line.Quantity}</td>");
            sb.Append($"<td align=\"right\" style=\"border-bottom:1px solid #ccc;\">{MoneyFormat.Group(line.UnitPrice, inv.CurrencyCode)}</td>");
            sb.Append($"<td align=\"right\" style=\"border-bottom:1px solid #ccc;\">{MoneyFormat.Group(line.LineTotal, inv.CurrencyCode)}</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");
        sb.Append("<table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\" style=\"font-size:13px;max-width:280px;margin-left:auto;border:1px solid #222;\">");
        AppendTotalRow(sb, L["orders.subtotal", "Subtotal"], MoneyFormat.GroupWithCode(inv.SubTotal, inv.CurrencyCode));
        AppendTotalRow(sb, L["orders.discount", "Discount"], "-" + MoneyFormat.Group(inv.DiscountTotal, inv.CurrencyCode));
        AppendTotalRow(sb, L["shipping", "Shipping"], MoneyFormat.GroupWithCode(inv.ShippingTotal, inv.CurrencyCode));
        AppendTotalRow(sb, L["tax", "Tax"], MoneyFormat.GroupWithCode(inv.TaxTotal, inv.CurrencyCode));
        AppendTotalRow(sb, L["orders.grand_total", "Grand total"], MoneyFormat.GroupWithCode(inv.GrandTotal, inv.CurrencyCode), bold: true);
        sb.Append("</table></div>");
        return sb.ToString();
    }

    private static void AppendTotalRow(global::System.Text.StringBuilder sb, string label, string value, bool bold = false)
    {
        var weight = bold ? "font-weight:700;border-top:2px solid #111;" : "border-bottom:1px solid #eee;";
        var left = global::System.Net.WebUtility.HtmlEncode(label);
        var right = global::System.Net.WebUtility.HtmlEncode(value);
        sb.Append("<tr><td style=\"padding:8px 12px;").Append(weight).Append("\">").Append(left)
            .Append("</td><td align=\"right\" style=\"padding:8px 12px;").Append(weight).Append("\">")
            .Append(right).Append("</td></tr>");
    }

    /// <summary>Digits only for wa.me; strips leading 00; keeps country code when present.</summary>
    private static string NormalizePhoneDigits(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("00", StringComparison.Ordinal))
            digits = digits[2..];
        // Common Iran local mobile: 09xxxxxxxxx → 989xxxxxxxxx
        if (digits.Length == 11 && digits.StartsWith('0'))
            digits = "98" + digits[1..];
        return digits;
    }
}
