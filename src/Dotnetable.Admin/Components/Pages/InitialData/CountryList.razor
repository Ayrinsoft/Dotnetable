@page "/initial-data/countries"
@attribute [Authorize(Policy = AdminPolicies.SuperAdminOnly)]
@inject ILocationService LocationService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject IJSRuntime JS

<DNPageTitle Title=@L["countries", "Countries"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["countries", "Countries"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["country.subtitle", "Manage country reference data"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DownloadSampleAsync" Disabled="_busy">
            @L["import.sample", "Sample Excel"]
        </MudButton>
        <MudFileUpload T="IBrowserFile" FilesChanged="ImportAsync" Accept=".xlsx" Class="flex-grow-0" Style="width:auto">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           Disabled="_busy">@L["import.excel", "Import Excel"]</MudButton>
            </ActivatorContent>
        </MudFileUpload>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/initial-data/countries/new">
            @L["country.new", "New Country"]
        </MudButton>
    </MudStack>
</MudStack>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
    @L["country.import_hint", "Download the sample Excel (.xlsx), fill CountryCode and Title, then import. Duplicate country codes are skipped."]
</MudAlert>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["country.empty", "No countries found."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in _items)
            {
                <tr>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Color="Color.Primary" Href="@($"/initial-data/countries/{c.CountryID}")" />
                    </td>
                    <td>@c.CountryID</td>
                    <td>@c.CountryCode</td>
                    <td>@c.Title</td>
                    <td>@c.PhonePerfix</td>
                    <td>@c.LanguageCode</td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _busy;
    private List<Country> _items = new();
    private GridViewHeaderParameters _grid = new();
    private const long MaxImportBytes = 16L * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["id", "ID"], ColumnName = nameof(Country.CountryID), HasSort = true },
                new() { ColumnTitle = L["code", "Code"], ColumnName = nameof(Country.CountryCode), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(Country.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["phone_prefix", "Phone Prefix"], ColumnName = nameof(Country.PhonePerfix) },
                new() { ColumnTitle = L["language", "Language"], ColumnName = nameof(Country.LanguageCode) },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await LocationService.GetCountriesPagedAsync(_grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task DownloadSampleAsync()
    {
        try
        {
            var bytes = LocationService.GetCountryImportSample();
            await JS.InvokeVoidAsync("dotnetableFile.download", "countries-sample.xlsx",
                Convert.ToBase64String(bytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["import.sample_failed", "Sample download failed"]}: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null) return;
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await LocationService.ImportCountriesAsync(buffer);
            var summary = $"{L["import.done", "Import finished"]}: {result.Added} {L["import.added", "added"]}, {result.Skipped} {L["import.skipped", "skipped"]}.";
            Snackbar.Add(summary, result.HasErrors ? Severity.Warning : Severity.Success);
            foreach (var error in result.Errors.Take(5))
                Snackbar.Add(error, Severity.Warning);
            if (result.Errors.Count > 5)
                Snackbar.Add($"…and {result.Errors.Count - 5} more issue(s).", Severity.Warning);

            _grid.Pagination.PageIndex = 1;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["import.failed", "Import failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }
}
