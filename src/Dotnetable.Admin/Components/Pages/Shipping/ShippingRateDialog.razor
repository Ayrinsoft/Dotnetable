@inject IShippingService ShippingService
@inject ILocationService LocationService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <CountrySelector Value="Model.CountryID" ValueChanged="OnCountryIdChanged"
                                     Countries="_countries" Label="@L["country", "Country"]" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <StateSelector Value="Model.StateID" ValueChanged="OnStateIdChanged"
                                   States="_states" Label="@L["state", "State"]" Clearable="true"
                                   Disabled="@(Model.CountryID is null)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <CitySelector Value="Model.CityID" ValueChanged="@(id => Model.CityID = id)"
                                  Cities="_cities" Label="@L["city", "City"]" Clearable="true"
                                  Disabled="@(Model.CountryID is null)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="Model.MinWeightKg" Label="@L["min_weight", "Min Weight (kg)"]" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="Model.MaxWeightKg" Label="@L["max_weight", "Max Weight (kg)"]" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="Model.Price" Label="@L["price", "Price (site currency)"]" Variant="Variant.Outlined" Min="0" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ShippingRate Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private List<Country> _countries = new();
    private List<State> _states = new();
    private List<City> _cities = new();

    protected override async Task OnInitializedAsync()
    {
        _countries = (await LocationService.GetAllCountriesAsync()).ToList();
        if (Model.CountryID is int countryId)
        {
            _states = (await LocationService.GetStatesByCountryAsync(countryId)).ToList();
            _cities = (await LocationService.GetCitiesByCountryAsync(countryId)).ToList();
        }
    }

    private async Task OnCountryIdChanged(int? countryId)
    {
        Model.CountryID = countryId;
        Model.StateID = null;
        Model.CityID = null;
        if (countryId is int id)
        {
            _states = (await LocationService.GetStatesByCountryAsync(id)).ToList();
            _cities = (await LocationService.GetCitiesByCountryAsync(id)).ToList();
        }
        else
        {
            _states = new();
            _cities = new();
        }
    }

    private Task OnStateIdChanged(int? stateId)
    {
        Model.StateID = stateId;
        Model.CityID = null;
        return Task.CompletedTask;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            if (IsNew) await ShippingService.CreateRateAsync(Model);
            else await ShippingService.UpdateRateAsync(Model);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
