@page "/sales/shipping"
@attribute [Authorize(Policy = RoleKeys.ShippingView)]
@inject IShippingService ShippingService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["shipping", "Shipping Methods"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["shipping", "Shipping Methods"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["shipping.subtitle", "Carriers (Tipax, Post, Chapar…) with logo, prepaid and COD pricing."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["shipping.new", "New Method"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["shipping.empty", "No shipping methods yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var m in _items)
            {
                <tr>
                    <td style="width:56px">
                        @if (!string.IsNullOrEmpty(m.LogoFile?.ThumbnailCDN ?? m.LogoFile?.CNDUrl))
                        {
                            <img src="@(m.LogoFile!.ThumbnailCDN ?? m.LogoFile.CNDUrl)" alt=""
                                 style="width:40px; height:40px; object-fit:contain; border-radius:6px;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Secondary" />
                        }
                    </td>
                    <td>@m.Title</td>
                    <td>@(m.CarrierName ?? "-")</td>
                    <td>
                        <MudStack Spacing="0">
                            @if (m.SupportsPrepaid)
                            {
                                <MudText Typo="Typo.caption">@L["shipping.prepaid_short", "Prepaid"]: @m.PrepaidMinPrice.ToString("0.##")</MudText>
                            }
                            @if (m.SupportsCod)
                            {
                                <MudText Typo="Typo.caption">@L["shipping.cod_short", "COD"]: @m.CodMinPrice.ToString("0.##")</MudText>
                            }
                        </MudStack>
                    </td>
                    <td>@m.SortOrder</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@(m.IsActive ? Color.Success : Color.Default)">
                            @(m.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                        </MudChip>
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small"
                                           Href="@($"/sales/shipping/{m.ShippingMethodID}/rates")"
                                           title="@L["shipping.rates", "Rates"]" />
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(m))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(m))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<ShippingMethod> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.ShippingInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.ShippingEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.ShippingDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(ShippingMethod.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["carrier", "Carrier"], ColumnName = nameof(ShippingMethod.CarrierName), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["shipping.pricing", "Pricing"], ColumnName = "" },
                new() { ColumnTitle = L["sort_order", "Sort Order"], ColumnName = nameof(ShippingMethod.SortOrder), HasSort = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(ShippingMethod.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await ShippingService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new ShippingMethod
            {
                WebsiteID = _websiteId,
                IsActive = true,
                SupportsPrepaid = true,
                SupportsCod = true,
            }, true))
            await LoadAsync();
    }

    private async Task EditAsync(ShippingMethod m)
    {
        var copy = new ShippingMethod
        {
            ShippingMethodID = m.ShippingMethodID,
            WebsiteID = m.WebsiteID,
            Title = m.Title,
            CarrierName = m.CarrierName,
            LogoFileID = m.LogoFileID,
            SupportsPrepaid = m.SupportsPrepaid,
            SupportsCod = m.SupportsCod,
            PrepaidMinPrice = m.PrepaidMinPrice,
            PrepaidMinPriceUsd = m.PrepaidMinPriceUsd,
            CodMinPrice = m.CodMinPrice,
            CodMinPriceUsd = m.CodMinPriceUsd,
            IsActive = m.IsActive,
            SortOrder = m.SortOrder,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(ShippingMethod model, bool isNew)
    {
        var parameters = new DialogParameters<ShippingMethodDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<ShippingMethodDialog>(
            isNew ? L["shipping.new", "New Method"] : L["shipping.edit", "Edit Method"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(ShippingMethod m)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["shipping.delete", "Delete shipping method"],
            L["shipping.delete_confirm", "Delete this shipping method and all of its rates?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await ShippingService.DeleteAsync(m.ShippingMethodID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
