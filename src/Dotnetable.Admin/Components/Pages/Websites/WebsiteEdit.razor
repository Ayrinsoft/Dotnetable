@page "/websites/new"
@page "/websites/{Id:int}"
@attribute [Authorize(Policy = AdminPolicies.SuperAdminOnly)]
@inject IWebsiteService WebsiteService
@inject IShippingService ShippingService
@inject IFileService FileService
@inject ICurrencyService CurrencyService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@(_isNew ? L["website.new", "New Website"] : L["website.edit", "Edit Website"]) />

@* ── Breadcrumbs ───────────────────────────────────────────────── *@
<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pb-2" />

@* ── Page header ──────────────────────────────────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["website.new", "New Website"] : L["website.edit", "Edit Website"])</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_isNew ? L["website.new_subtitle", "Register a new website in the system"] : $"{L["website.editing", "Editing website"]} #{Id}")
        </MudText>
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_website is not null)
{
    <MudForm @ref="_form">
        <MudGrid Spacing="4">

            @* ── Basic info ──────────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="me-1" />
                        @L["website.section.basic", "Basic Information"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.TradeName" Label="@L["trade_name", "Trade Name"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.BrandName" Label="@L["brand_name", "Brand Name"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.WebsiteAddress" Label="@L["website_address", "Website Address"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]"
                                          Placeholder="example.com" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.DefaultLanguageCode" Label="@L["default_language_code", "Default Language Code"]"
                                          Variant="Variant.Outlined" MaxLength="2" Placeholder="en" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="byte" @bind-Value="_website.WebsiteType" Label="@L["website_type", "Website Type"]"
                                       Variant="Variant.Outlined"
                                       HelperText="@L["website.type_hint", "Sets default feature modules and the Basic/General admin menu for members of this site (Advanced shows everything they have roles for). Always changeable later."]">
                                <MudListSubheader>@L["website.category.informational", "Informational / Brochure"]</MudListSubheader>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Corporate)">@L["website.type.corporate", "Corporate Website"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Personal)">@L["website.type.personal", "Personal Website"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.LandingPage)">@L["website.type.landing_page", "Landing Page"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Resume)">@L["website.type.resume", "Resume / CV Site"]</MudSelectItem>

                                <MudListSubheader>@L["website.category.commerce", "Commerce"]</MudListSubheader>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.ECommerce)">@L["website.type.ecommerce", "Online Store (E-commerce)"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.DigitalCatalog)">@L["website.type.digital_catalog", "Digital Catalog"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Auction)">@L["website.type.auction", "Auction Site"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Crowdfunding)">@L["website.type.crowdfunding", "Crowdfunding"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.RealEstate)">@L["website.type.real_estate", "Real Estate Listing"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Restaurant)">@L["website.type.restaurant", "Restaurant / Online Menu"]</MudSelectItem>

                                <MudListSubheader>@L["website.category.content", "Content Showcase"]</MudListSubheader>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Gallery)">@L["website.type.gallery", "Photo & Video Gallery"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Portfolio)">@L["website.type.portfolio", "Portfolio"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Blog)">@L["website.type.blog", "Blog"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.News)">@L["website.type.news", "News / Magazine"]</MudSelectItem>

                                <MudListSubheader>@L["website.category.educational", "Educational / Professional"]</MudListSubheader>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.ELearning)">@L["website.type.elearning", "E-learning / Online Courses"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Membership)">@L["website.type.membership", "Membership / Subscription Site"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.Booking)">@L["website.type.booking", "Booking / Reservation (hotel, ticket, ...)"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.MedicalBooking)">@L["website.type.medical_booking", "Medical Appointment Booking"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="@((byte)WebsiteType.BeautyBooking)">@L["website.type.beauty_booking", "Beauty / Salon Appointment Booking"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Currency" Value="@GetSelectedCurrency()" ValueChanged="OnCurrencySelected"
                                             SearchFunc="SearchCurrencies" ToStringFunc="CurrencyDisplay"
                                             Label="@L["default_currency_code", "Default Currency"]"
                                             Variant="Variant.Outlined" Required="true"
                                             RequiredError="@L["required", "This field is required."]"
                                             Clearable="false" CoerceText="false" ResetValueOnEmptyText="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DNDismissibleAlert StorageKey="website.currency-mode-hint" Class="mt-1">
                                @L["website.currency_mode_hint", "Single vs multi-currency (USD dual) is configured under Finance → Exchange Rates for each website — where rate tables are managed."]
                                @if (!_isNew && Id > 0)
                                {
                                    <div class="mt-2">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   Href="/finance/currency-rates"
                                                   StartIcon="@Icons.Material.Filled.CurrencyExchange">
                                            @L["currency_rates", "Exchange Rates"]
                                        </MudButton>
                                    </div>
                                }
                            </DNDismissibleAlert>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* ── Contact info ─────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ContactPhone" Size="Size.Small" Class="me-1" />
                        @L["website.section.contact", "Contact Information"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_website.Manager" Label="@L["manager", "Manager"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_website.Mobile" Label="@L["mobile", "Mobile"]"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_website.Email" Label="@L["email", "Email"]"
                                          Variant="Variant.Outlined" InputType="InputType.Email"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* ── Branding ─────────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Class="me-1" />
                        @L["website.section.branding", "Branding"]
                    </MudText>
                    @if (_isNew)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["website.branding_hint", "Save the website first, then pick a logo and favicon from its media library."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Class="mb-1">@L["logo", "Logo"]</MudText>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <div class="border rounded" style="width:64px; height:64px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:var(--mud-palette-background-grey);">
                                        @if (_logoFile is { CNDUrl: not null })
                                        {
                                            <img src="@(_logoFile.ThumbnailCDN ?? _logoFile.CNDUrl)" style="width:100%; height:100%; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" />
                                        }
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="PickLogoAsync">@L["choose", "Choose"]</MudButton>
                                    @if (_website!.LogoFileID is not null)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="ClearLogo" />
                                    }
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Class="mb-1">@L["favicon", "Favicon"]</MudText>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <div class="border rounded" style="width:64px; height:64px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:var(--mud-palette-background-grey);">
                                        @if (_faveFile is { CNDUrl: not null })
                                        {
                                            <img src="@(_faveFile.ThumbnailCDN ?? _faveFile.CNDUrl)" style="width:100%; height:100%; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" />
                                        }
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="PickFaveAsync">@L["choose", "Choose"]</MudButton>
                                    @if (_website!.FaveIconFileID is not null)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="ClearFave" />
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>

            @* ── Tax & seller identity ─────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Class="me-1" />
                        @L["website.section.tax", "Tax & seller registration"]
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @L["website.tax_hint", "Controls checkout VAT/sales tax for this site and dual-site settlement tax when selling through another marketplace host. Rate tables are under Sales → Tax Rates."]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="4">
                            <MudSwitch T="bool" @bind-Value="_website.TaxEnabled" Color="Color.Primary"
                                       Label="@L["website.tax_enabled", "Tax enabled at checkout"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSwitch T="bool" @bind-Value="_website.PricesIncludeTax" Color="Color.Primary"
                                       Label="@L["website.prices_include_tax", "Prices include tax"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSwitch T="bool" @bind-Value="_website.TaxOnShipping" Color="Color.Primary"
                                       Label="@L["website.tax_on_shipping", "Tax may apply to shipping"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.SellerLegalName" Label="@L["website.seller_legal_name", "Seller legal name"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?" @bind-Value="_website.TaxCountryID"
                                             Label="@L["website.tax_country_id", "Default tax country ID"]"
                                             Variant="Variant.Outlined" Min="1"
                                             HelperText="@L["website.tax_country_hint", "Optional CountryID for seller jurisdiction / fallback matching"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.SellerTaxId" Label="@L["website.seller_tax_id", "Seller tax ID / national ID"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.SellerEconomicCode" Label="@L["website.seller_economic_code", "Economic code"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.SellerVatNumber" Label="@L["website.seller_vat", "VAT / GST number"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_website.SellerRegistrationNumber" Label="@L["website.seller_registration", "Registration number"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* ── Shipping & COD ────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="me-1" />
                        @L["website.section.shipping", "Shipping & delivery"]
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @L["website.shipping_hint", "Delivery options come from methods defined under Sales → Shipping (e.g. post, motorcycle courier). Use the switches below for site-wide COD and free-shipping rules."]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudSwitch T="bool" @bind-Value="_website.AllowCashOnDelivery" Color="Color.Primary"
                                       Label="@L["website.allow_cod", "Allow cash on delivery (COD)"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @L["website.allow_cod_help", "When off, COD is hidden at checkout even if a shipping method supports it. Goods paid at the door is COD."]
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DNMoneyField @bind-Value="_website.FreeShippingMinOrderAmount"
                                          Label="@L["website.free_shipping_min", "Free shipping min order (site currency)"]"
                                          HelperText="@L["website.free_shipping_min_help", "0 = disabled. When cart reaches this amount, all shipping methods are free (in addition to per-method thresholds)."]" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudText Typo="Typo.subtitle2">@L["website.shipping_methods", "Shipping methods for this site"]</MudText>
                                @if (!_isNew)
                                {
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.OpenInNew" Href="/sales/shipping">
                                        @L["website.manage_shipping", "Manage shipping"]
                                    </MudButton>
                                }
                            </MudStack>
                            @if (_isNew)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["website.shipping_after_create", "Save the website first, then define methods under Sales → Shipping."]
                                </MudText>
                            }
                            else if (_shippingMethods.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                                    @L["website.shipping_empty", "No shipping methods yet. Add post, courier, or other methods under Sales → Shipping."]
                                </MudAlert>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-1">
                                    <thead>
                                        <tr>
                                            <th>@L["title", "Title"]</th>
                                            <th>@L["carrier", "Carrier"]</th>
                                            <th>@L["shipping.prepaid_short", "Prepaid"]</th>
                                            <th>@L["shipping.cod_short", "COD"]</th>
                                            <th>@L["status", "Status"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in _shippingMethods)
                                        {
                                            <tr>
                                                <td>@m.Title</td>
                                                <td>@(m.CarrierName ?? "—")</td>
                                                <td>@(m.SupportsPrepaid ? MoneyFormat.Group(m.PrepaidMinPrice) : "—")</td>
                                                <td>@(m.SupportsCod ? MoneyFormat.Group(m.CodMinPrice) : "—")</td>
                                                <td>
                                                    <MudChip T="string" Size="Size.Small" Color="@(m.IsActive ? Color.Success : Color.Default)">
                                                        @(m.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                                                    </MudChip>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* ── Status ───────────────────────────────────── *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ToggleOn" Size="Size.Small" Class="me-1" />
                        @L["status", "Status"]
                    </MudText>
                    <MudSwitch T="bool" @bind-Value="_website.Active" Color="Color.Primary"
                               Label="@(_website.Active ? L["website.active_on", "Active — visible and accessible"] : L["website.active_off", "Inactive — hidden from users"])" />
                </MudPaper>
            </MudItem>

        </MudGrid>

        <DNValidationSummary Errors="_formErrors" />

        @* ── Action buttons ───────────────────────────────────────── *@
        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="@_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @(_isNew ? L["website.create", "Create Website"] : L["save", "Save Changes"])
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/websites">
                @L["cancel", "Cancel"]
            </MudButton>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm _form = null!;
    private Website? _website;
    private FileRecord? _logoFile;
    private FileRecord? _faveFile;
    private List<Currency> _currencies = new();
    private List<ShippingMethod> _shippingMethods = new();
    private bool _loading = true;
    private bool _saving;
    private string[]? _formErrors;
    private bool _isNew => Id == 0;

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["dashboard", "Dashboard"], "/"),
        new(L["websites", "Websites"], "/websites"),
        new(_isNew ? L["new", "New"] : $"#{Id}", null, true),
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        _currencies = await CurrencyService.GetAllAsync();

        if (_isNew)
        {
            _website = new Website
            {
                Active = true,
                TaxEnabled = true,
                AllowCashOnDelivery = true,
                DefaultLanguageCode = "en",
                DefaultCurrencyCode = _currencies.FirstOrDefault()?.CurrencyCode ?? string.Empty,
            };
        }
        else
        {
            _website = await WebsiteService.GetByIdAsync(Id);
            if (_website is null) Nav.NavigateTo("/websites");
            else
            {
                if (_website.LogoFileID is int logoId) _logoFile = await FileService.GetByIdAsync(logoId);
                if (_website.FaveIconFileID is int faveId) _faveFile = await FileService.GetByIdAsync(faveId);
                _shippingMethods = await ShippingService.GetAllAsync(Id);
            }
        }
        _loading = false;
    }

    private async Task PickLogoAsync()
    {
        var picked = await PickImageAsync();
        if (picked is not null) { _website!.LogoFileID = picked.FileRecordID; _logoFile = picked; }
    }

    private async Task PickFaveAsync()
    {
        var picked = await PickImageAsync();
        if (picked is not null) { _website!.FaveIconFileID = picked.FileRecordID; _faveFile = picked; }
    }

    private void ClearLogo() { _website!.LogoFileID = null; _logoFile = null; }
    private void ClearFave() { _website!.FaveIconFileID = null; _faveFile = null; }

    private Currency? GetSelectedCurrency() =>
        string.IsNullOrEmpty(_website?.DefaultCurrencyCode)
            ? null
            : _currencies.FirstOrDefault(c => c.CurrencyCode == _website.DefaultCurrencyCode);

    private string CurrencyDisplay(Currency? c) =>
        c is null ? string.Empty : $"{c.CurrencyCode} — {c.Name}";

    private void OnCurrencySelected(Currency? currency) =>
        _website!.DefaultCurrencyCode = currency?.CurrencyCode ?? string.Empty;

    private Task<IEnumerable<Currency>> SearchCurrencies(string value, CancellationToken ct)
    {
        IEnumerable<Currency> q = _currencies.OrderBy(c => c.CurrencyCode);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c =>
                c.CurrencyCode.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private async Task<FileRecord?> PickImageAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = Id,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: FileRecord file } ? file : null;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            if (_website!.FreeShippingMinOrderAmount <= 0)
            {
                _website.FreeShippingMinOrderAmount = 0;
                _website.FreeShippingMinOrderAmountUsd = 0;
            }

            if (_isNew)
            {
                _website.RegisterDate = DateOnly.FromDateTime(DateTime.UtcNow);
                _website.AuthCode = Guid.NewGuid();
                _website.AllowAllIP = true;
                await WebsiteService.CreateAsync(_website);
                Snackbar.Add(L["website.created", "Website created successfully."], Severity.Success);
            }
            else
            {
                await WebsiteService.UpdateAsync(_website);
                Snackbar.Add(L["saved", "Changes saved successfully."], Severity.Success);
            }
            Nav.NavigateTo("/websites");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
