@page "/sales/tax"
@attribute [Authorize(Policy = RoleKeys.TaxView)]
@inject ITaxService TaxService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["tax_rates", "Tax Rates"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["tax_rates", "Tax Rates"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["tax_rates.subtitle", "Rates stack — every matching active rate applies to the subtotal."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["tax_rates.new", "New Tax Rate"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["tax_rates.empty", "No tax rates yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var r in _items)
            {
                <tr>
                    <td>@r.Title</td>
                    <td>@((r.Rate * 100).ToString("0.##"))%</td>
                    <td>@(r.Country?.Title ?? L["any", "Any"])</td>
                    <td>@(r.State?.Title ?? L["any", "Any"])</td>
                    <td>@r.Priority</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@(r.IsActive ? Color.Success : Color.Default)">
                            @(r.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                        </MudChip>
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(r))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(r))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<TaxRate> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.TaxInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.TaxEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.TaxDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(TaxRate.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["rate", "Rate"], ColumnName = nameof(TaxRate.Rate), HasSort = true },
                new() { ColumnTitle = L["country", "Country"], ColumnName = "" },
                new() { ColumnTitle = L["state", "State"], ColumnName = "" },
                new() { ColumnTitle = L["priority", "Priority"], ColumnName = nameof(TaxRate.Priority), HasSort = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(TaxRate.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await TaxService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new TaxRate { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(TaxRate r)
    {
        var copy = new TaxRate
        {
            TaxRateID = r.TaxRateID,
            WebsiteID = r.WebsiteID,
            Title = r.Title,
            Rate = r.Rate,
            CountryID = r.CountryID,
            StateID = r.StateID,
            Priority = r.Priority,
            IsActive = r.IsActive,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(TaxRate model, bool isNew)
    {
        var parameters = new DialogParameters<TaxRateDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<TaxRateDialog>(
            isNew ? L["tax_rates.new", "New Tax Rate"] : L["tax_rates.edit", "Edit Tax Rate"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(TaxRate r)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["tax_rates.delete", "Delete tax rate"],
            L["tax_rates.delete_confirm", "Delete this tax rate?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await TaxService.DeleteAsync(r.TaxRateID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
