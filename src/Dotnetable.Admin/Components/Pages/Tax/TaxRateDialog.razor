@inject ITaxService TaxService
@inject ILocationService LocationService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="Model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudNumericField T="decimal" @bind-Value="_ratePercent" Label="@L["rate_percent", "Rate (%)"]" Variant="Variant.Outlined" Min="0" Max="100" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.TaxCode" Label="@L["tax_rates.code", "Tax code"]" Variant="Variant.Outlined"
                                  HelperText="@L["tax_rates.code_hint", "Invoice / export code, e.g. VAT9"]" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="byte" @bind-Value="Model.TaxKind" Label="@L["tax_rates.kind", "Tax kind"]" Variant="Variant.Outlined">
                        <MudSelectItem T="byte" Value="(byte)TaxKind.Vat">@L["tax_rates.kind.vat", "VAT / GST"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="(byte)TaxKind.SalesTax">@L["tax_rates.kind.sales", "Sales tax"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="(byte)TaxKind.Other">@L["tax_rates.kind.other", "Other"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <CountrySelector Value="Model.CountryID" ValueChanged="OnCountryIdChanged"
                                     Countries="_countries" Label="@L["country", "Country"]" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <StateSelector Value="Model.StateID" ValueChanged="@(id => Model.StateID = id)"
                                   States="_states" Label="@L["state", "State"]" Clearable="true"
                                   Disabled="@(Model.CountryID is null)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Model.Priority" Label="@L["priority", "Priority"]" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Model.ApplyToShipping" Label="@L["tax_rates.apply_shipping", "Apply to shipping"]" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                </MudItem>
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaxRate Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private decimal _ratePercent;
    private List<Country> _countries = new();
    private List<State> _states = new();

    protected override async Task OnInitializedAsync()
    {
        _ratePercent = Model.Rate * 100m;
        _countries = (await LocationService.GetAllCountriesAsync()).ToList();
        if (Model.CountryID is int countryId)
            _states = (await LocationService.GetStatesByCountryAsync(countryId)).ToList();
    }

    private async Task OnCountryIdChanged(int? countryId)
    {
        Model.CountryID = countryId;
        Model.StateID = null;
        _states = countryId is int id
            ? (await LocationService.GetStatesByCountryAsync(id)).ToList()
            : new();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        Model.Rate = _ratePercent / 100m;

        _saving = true;
        try
        {
            if (IsNew) await TaxService.CreateAsync(Model);
            else await TaxService.UpdateAsync(Model);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
