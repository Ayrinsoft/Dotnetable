@inject ITaxService TaxService
@inject ILocationService LocationService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="Model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudNumericField T="decimal" @bind-Value="_ratePercent" Label="@L["rate_percent", "Rate (%)"]" Variant="Variant.Outlined" Min="0" Max="100" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="Model.CountryID" Label="@L["country", "Country"]" Variant="Variant.Outlined"
                               Clearable="true" SelectedValuesChanged="OnCountryChanged">
                        @foreach (var c in _countries)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.CountryID)">@c.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="Model.StateID" Label="@L["state", "State"]" Variant="Variant.Outlined"
                               Clearable="true" Disabled="@(Model.CountryID is null)">
                        @foreach (var s in _states)
                        {
                            <MudSelectItem T="int?" Value="@((int?)s.StateID)">@s.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" @bind-Value="Model.Priority" Label="@L["priority", "Priority"]" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaxRate Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private decimal _ratePercent;
    private List<Country> _countries = new();
    private List<State> _states = new();

    protected override async Task OnInitializedAsync()
    {
        _ratePercent = Model.Rate * 100m;
        _countries = (await LocationService.GetAllCountriesAsync()).ToList();
        if (Model.CountryID is int countryId)
            _states = (await LocationService.GetStatesByCountryAsync(countryId)).ToList();
    }

    private async Task OnCountryChanged(IEnumerable<int?> _)
    {
        Model.StateID = null;
        _states = Model.CountryID is int countryId
            ? (await LocationService.GetStatesByCountryAsync(countryId)).ToList()
            : new();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        Model.Rate = _ratePercent / 100m;

        _saving = true;
        try
        {
            if (IsNew) await TaxService.CreateAsync(Model);
            else await TaxService.UpdateAsync(Model);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
