@page "/website/seo"
@attribute [Authorize(Policy = RoleKeys.WebsiteEdit)]
@using Dotnetable.Application.Seo
@inject IWebsiteSettingService SettingService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["seo_settings", "SEO Settings"] />

<MudStack Spacing="0" Class="mb-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">@L["seo_settings", "SEO Settings"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["seo.subtitle", "Search engine optimization configuration"]</MudText>
        </MudStack>
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="me-1" />
                    @L["seo.section.meta", "Meta Tags"]
                </MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_setting.DefaultMetaTitle" Label="@L["seo.meta_title", "Default Meta Title"]"
                                      Variant="Variant.Outlined" MaxLength="40"
                                      HelperText="@L["seo.meta_title_hint", "Used when page has no title. E.g. 'Page | SiteName'"]" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_setting.TitleSeparator" Label="@L["seo.title_separator", "Title Separator"]"
                                      Variant="Variant.Outlined" MaxLength="3"
                                      Placeholder=" | " HelperText="@L["seo.title_separator_hint", "Between page and site name"]" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_setting.DefaultMetaDescription" Label="@L["seo.meta_description", "Default Meta Description"]"
                                      Variant="Variant.Outlined" Lines="3" MaxLength="158"
                                      HelperText="@L["seo.meta_description_hint", "Shown in search results when page has no description (max 158 chars)"]" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="me-1" />
                    @L["options", "Options"]
                </MudText>
                <MudSwitch T="bool" @bind-Value="_setting.SitemapEnabled" Color="Color.Primary"
                           Label="@L["seo.enable_sitemap", "Enable Sitemap (sitemap.xml)"]" Class="mb-2" />
                <MudSwitch T="bool" @bind-Value="_setting.RobotsEnabled" Color="Color.Primary"
                           Label="@L["seo.enable_robots", "Enable Robots.txt"]" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Small" Class="me-1" />
                    @L["seo.indexnow", "IndexNow (Bing)"]
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @L["seo.indexnow.help", "After you save a published page, post, or product, its public URL is sent to IndexNow. Bing, Yandex, Naver, Seznam, and Yep share that notice. Google does not use IndexNow; it keeps discovering URLs from sitemap.xml. Google's Indexing API is only for job postings and livestreams, so it is not used for these pages."]
                </MudText>
                <MudSwitch T="bool" @bind-Value="_setting.IndexNowEnabled" Color="Color.Primary"
                           Label="@L["seo.indexnow.enable", "Submit changed URLs with IndexNow"]" Class="mb-3" />
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_setting.IndexNowKey" Label="@L["seo.indexnow.key", "IndexNow key"]"
                                      Variant="Variant.Outlined" MaxLength="128"
                                      HelperText="@L["seo.indexnow.key_hint", "8–128 letters, digits, or dashes. The storefront publishes this key as a text file so search engines can verify the site."]" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.VpnKey"
                                   OnClick="GenerateKey">
                            @L["seo.indexnow.generate", "Generate key"]
                        </MudButton>
                    </MudItem>
                </MudGrid>
                @if (KeyFileUrl is string keyFile)
                {
                    <MudText Typo="Typo.body2" Class="mt-3">
                        @L["seo.indexnow.file", "Key file"] :
                        <MudLink Href="@keyFile" Target="_blank">@keyFile</MudLink>
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Class="me-1" />
                    @L["seo.custom_robots", "Custom robots.txt"]
                </MudText>
                <MudTextField @bind-Value="_setting.CustomRobotsTxt" Label="@L["seo.robots_content", "robots.txt content"]"
                              Variant="Variant.Outlined" Lines="6"
                              Style="font-family: monospace; font-size: 13px;"
                              Placeholder="User-agent: *&#10;Disallow: /admin/" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Class="mt-4" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @L["seo.save", "Save SEO Settings"]
        </MudButton>
    </MudStack>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _isMaster;
    private int _websiteId;
    private string? _siteAddress;
    private List<Website> _websites = new();
    private WebsiteSeoSetting _setting = new() { CustomRobotsTxt = string.Empty };

    private string? KeyFileUrl
    {
        get
        {
            var key = _setting.IndexNowKey?.Trim();
            if (!IndexNowKeyRules.IsValid(key)) return null;
            return IndexNowOrigins.TryParse(_siteAddress, out var origin, out _)
                ? $"{origin}/{key}.txt"
                : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var existing = await SettingService.GetSeoSettingAsync(_websiteId);
        _setting = existing ?? new WebsiteSeoSetting { WebsiteID = _websiteId, CustomRobotsTxt = string.Empty };
        var site = await WebsiteService.GetByIdAsync(_websiteId);
        _siteAddress = site?.WebsiteAddress;
        _loading = false;
    }

    private void GenerateKey() => _setting.IndexNowKey = IndexNowKeyRules.Generate();

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _setting.WebsiteID = _websiteId;
            _setting.IndexNowKey = string.IsNullOrWhiteSpace(_setting.IndexNowKey) ? null : _setting.IndexNowKey.Trim();
            if (_setting.IndexNowEnabled && !IndexNowKeyRules.IsValid(_setting.IndexNowKey))
            {
                Snackbar.Add(L["seo.indexnow.key_invalid", "IndexNow needs a key of 8–128 letters, digits, or dashes."], Severity.Warning);
                return;
            }

            await SettingService.SaveSeoSettingAsync(_setting);
            Snackbar.Add(L["seo.saved", "SEO settings saved."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }
}
