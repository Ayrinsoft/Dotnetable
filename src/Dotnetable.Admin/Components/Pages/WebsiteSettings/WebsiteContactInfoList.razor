@page "/website/contact-info"
@using Dotnetable.Domain.Enums
@attribute [Authorize(Policy = AdminPolicies.WebsiteContactAccess)]
@inject IWebsiteSettingService SettingService
@inject IWebsiteService WebsiteService
@inject ILanguageService LanguageService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject IDialogService DialogService

<DNPageTitle Title=@L["contact_info", "Contact Info"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["contact_info.heading", "Contact Information"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["contact_info.subtitle", "Manage the phone numbers, emails, addresses and working hours shown on the public Contact Us page"]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            @L["contact_info.add", "Add Contact Info"]
        </MudButton>
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["contact_info.empty", "No contact info defined."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Primary" OnClick="@(() => OpenEditDialog(c))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="@(() => DeleteAsync(c))" />
                        </MudStack>
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <i class="@(string.IsNullOrWhiteSpace(c.Icon) ? DefaultIcon((ContactInfoType)c.ContactType) : c.Icon)" style="font-size:1.1rem;"></i>
                            <MudText Typo="Typo.body2">@TypeLabel((ContactInfoType)c.ContactType)</MudText>
                        </MudStack>
                    </td>
                    <td>@(c.GroupTitle ?? "-")</td>
                    <td>@c.Title</td>
                    <td>@(c.ContactType == (byte)ContactInfoType.Location ? $"{c.Latitude?.ToString("0.######")}, {c.Longitude?.ToString("0.######")}" : c.Value)</td>
                    <td>@c.SortOrder</td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@* ── Dialog ────────────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_dialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editItem?.WebsiteContactInfoID == 0 ? L["contact_info.dialog_add", "Add Contact Info"] : L["contact_info.dialog_edit", "Edit Contact Info"])</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editItem is not null)
        {
            <MudForm @ref="_form">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="ContactInfoType" Value="_type" ValueChanged="OnTypeChanged"
                                   Label="@L["contact_info.type", "Type"]" Variant="Variant.Outlined" Required="true">
                            @foreach (var t in Enum.GetValues<ContactInfoType>())
                            {
                                <MudSelectItem T="ContactInfoType" Value="@t">@TypeLabel(t)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_editItem.GroupTitle" Label="@L["contact_info.group", "Group (e.g. Sales Office, Factory)"]"
                                      Variant="Variant.Outlined" Placeholder="@L["contact_info.group_placeholder", "Sales Office"]" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_editItem.Title" Label="@L["title", "Title"]"
                                      Variant="Variant.Outlined" Required="true"
                                      RequiredError="@L["required", "This field is required."]"
                                      HelperText="@L["contact_info.title_help", "Shown next to the value — customize it (e.g. \"Sales Office Phone\") or keep the type's default."]" />
                    </MudItem>
                    @if (_type == ContactInfoType.Location)
                    {
                        <MudItem xs="6" sm="3">
                            <MudNumericField T="decimal?" @bind-Value="_editItem.Latitude" Label="@L["contact_info.latitude", "Latitude"]"
                                              Variant="Variant.Outlined" Required="true"
                                              RequiredError="@L["required", "This field is required."]"
                                              Format="0.######" Min="-90" Max="90" Placeholder="35.715298" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudNumericField T="decimal?" @bind-Value="_editItem.Longitude" Label="@L["contact_info.longitude", "Longitude"]"
                                              Variant="Variant.Outlined" Required="true"
                                              RequiredError="@L["required", "This field is required."]"
                                              Format="0.######" Min="-180" Max="180" Placeholder="51.404343" />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editItem.Value" Label="@ValueLabel(_type)"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]"
                                          Placeholder="@ValuePlaceholder(_type)" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_editItem.SortOrder" Label="@L["contact_info.sort_order", "Sort Order"]"
                                         Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <i class="@(string.IsNullOrWhiteSpace(_editItem.Icon) ? DefaultIcon(_type) : _editItem.Icon)" style="font-size:1.4rem;"></i>
                            <MudTextField @bind-Value="_editItem.Icon" Label="@L["contact_info.icon", "Icon CSS Class (optional — defaults to the type's icon)"]"
                                          Variant="Variant.Outlined" Class="flex-grow-1"
                                          Placeholder="@DefaultIcon(_type)"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EmojiSymbols"
                                          OnAdornmentClick="PickIconAsync" AdornmentAriaLabel="@L["menus.pick_icon", "Select an icon"]" />
                        </MudStack>
                    </MudItem>
                    @if (_languages.Length > 0)
                    {
                        <MudItem xs="12">
                            <MudExpansionPanels Elevation="0">
                                <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                        @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                                    </MudText>
                                    @foreach (var (code, label) in _languages)
                                    {
                                        <MudGrid Spacing="2" Class="mb-1">
                                            <MudItem xs="12" sm="4">
                                                <MudTextField T="string" Value="@GroupTitleTr(code)" ValueChanged="@(v => SetGroupTitleTr(code, v))"
                                                              Label="@($"{label} — {L["contact_info.group", "Group"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField T="string" Value="@TitleTr(code)" ValueChanged="@(v => SetTitleTr(code, v))"
                                                              Label="@($"{label} — {L["title", "Title"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField T="string" Value="@ValueTr(code)" ValueChanged="@(v => SetValueTr(code, v))"
                                                              Label="@($"{label} — {L["value", "Value"]}")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                              HelperText="@L["contact_info.value_optional", "Leave blank to reuse the default value."]" />
                                            </MudItem>
                                        </MudGrid>
                                    }
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </MudItem>
                    }
                </MudGrid>

                <DNValidationSummary Errors="_formErrors" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)" Variant="Variant.Text">@L["cancel", "Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveDialogAsync" Disabled="@_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" /> }
            @L["save_short", "Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private List<WebsiteContactInfo> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    private bool _dialogOpen;
    private bool _saving;
    private WebsiteContactInfo? _editItem;
    private ContactInfoType _type;
    private MudForm _form = null!;
    private string[]? _formErrors;

    private readonly Dictionary<string, (string Title, string GroupTitle, string Value)> _tr = new(StringComparer.OrdinalIgnoreCase);
    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    /// <summary>Bootstrap Icons class offered by default for each type, used to pre-fill the Icon
    /// field and shown in the grid when no custom icon was set.</summary>
    private static readonly Dictionary<ContactInfoType, string> _defaultIcons = new()
    {
        [ContactInfoType.Phone] = "bi bi-telephone",
        [ContactInfoType.Email] = "bi bi-envelope",
        [ContactInfoType.Address] = "bi bi-geo-alt",
        [ContactInfoType.Location] = "bi bi-pin-map",
        [ContactInfoType.WorkingHours] = "bi bi-clock",
        [ContactInfoType.Other] = "bi bi-info-circle",
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["contact_info.type", "Type"], ColumnName = "" },
                new() { ColumnTitle = L["contact_info.group", "Group"], ColumnName = "" },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(WebsiteContactInfo.Title), HasSearch = true },
                new() { ColumnTitle = L["value", "Value"], ColumnName = "" },
                new() { ColumnTitle = L["contact_info.sort_order", "Sort Order"], ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task OpenAddDialog()
    {
        _type = ContactInfoType.Phone;
        _editItem = new WebsiteContactInfo
        {
            WebsiteContactInfoID = 0,
            WebsiteID = _websiteId,
            ContactType = (byte)_type,
            Title = TypeLabel(_type),
            Value = string.Empty,
        };
        _tr.Clear();
        await LoadLanguagesAsync();
        _dialogOpen = true;
    }

    private async Task LoadLanguagesAsync()
    {
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(_websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();
    }

    private string GroupTitleTr(string code) => _tr.TryGetValue(code, out var v) ? v.GroupTitle : string.Empty;
    private string TitleTr(string code) => _tr.TryGetValue(code, out var v) ? v.Title : string.Empty;
    private string ValueTr(string code) => _tr.TryGetValue(code, out var v) ? v.Value : string.Empty;
    private void SetGroupTitleTr(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (c.Title ?? string.Empty, v ?? string.Empty, c.Value ?? string.Empty); }
    private void SetTitleTr(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (v ?? string.Empty, c.GroupTitle ?? string.Empty, c.Value ?? string.Empty); }
    private void SetValueTr(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (c.Title ?? string.Empty, c.GroupTitle ?? string.Empty, v ?? string.Empty); }

    /// <summary>Auto-fills the Icon field with the type's default icon, and the Title field with the
    /// type's label, unless the admin already customized either away from the previous type's default
    /// — mirrors the same pattern used for Social Links so switching type doesn't clobber edits.</summary>
    private void OnTypeChanged(ContactInfoType type)
    {
        var previousDefaultIcon = _defaultIcons.GetValueOrDefault(_type);
        var previousDefaultTitle = TypeLabel(_type);

        _type = type;
        _editItem!.ContactType = (byte)type;

        if (type == ContactInfoType.Location)
        {
            _editItem.Value = string.Empty; // coordinates carry the value now, not free text
        }
        else if (_editItem.Latitude is not null || _editItem.Longitude is not null)
        {
            _editItem.Latitude = null;
            _editItem.Longitude = null;
        }

        if (string.IsNullOrWhiteSpace(_editItem.Icon) || _editItem.Icon == previousDefaultIcon)
            _editItem.Icon = null; // cleared so the grid/dialog fall back to the new type's default live

        if (string.IsNullOrWhiteSpace(_editItem.Title) || _editItem.Title == previousDefaultTitle)
            _editItem.Title = TypeLabel(type);
    }

    private async Task PickIconAsync()
    {
        var dialog = await DialogService.ShowAsync<IconPickerDialog>(L["menus.pick_icon", "Select an icon"],
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string iconClass })
            _editItem!.Icon = iconClass;
    }

    private async Task OpenEditDialog(WebsiteContactInfo c)
    {
        _type = (ContactInfoType)c.ContactType;
        _editItem = new WebsiteContactInfo
        {
            WebsiteContactInfoID = c.WebsiteContactInfoID,
            WebsiteID = c.WebsiteID,
            ContactType = c.ContactType,
            GroupTitle = c.GroupTitle,
            Title = c.Title,
            Value = c.Value,
            Latitude = c.Latitude,
            Longitude = c.Longitude,
            Icon = c.Icon,
            SortOrder = c.SortOrder,
        };

        _tr.Clear();
        await LoadLanguagesAsync();
        foreach (var t in await SettingService.GetContactInfoTranslationsAsync(c.WebsiteContactInfoID))
            _tr[t.LanguageCode] = (t.Title, t.GroupTitle ?? string.Empty, t.Value ?? string.Empty);

        _dialogOpen = true;
    }

    private async Task SaveDialogAsync()
    {
        await _form.ValidateAsync();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            // Empty icon means "use the type's default" — resolve it now so the public page (which
            // has no notion of ContactInfoType icon defaults) always gets a concrete icon class.
            if (string.IsNullOrWhiteSpace(_editItem!.Icon))
                _editItem.Icon = DefaultIcon(_type);

            if (_editItem.WebsiteContactInfoID == 0)
            {
                _editItem.WebsiteID = _websiteId;
                await SettingService.CreateContactInfoAsync(_editItem);
                Snackbar.Add(L["contact_info.added", "Contact info added."], Severity.Success);
            }
            else
            {
                await SettingService.UpdateContactInfoAsync(_editItem);
                Snackbar.Add(L["contact_info.updated", "Contact info updated."], Severity.Success);
            }

            await SettingService.SetContactInfoTranslationsAsync(_editItem.WebsiteContactInfoID, _tr.ToDictionary(
                kv => kv.Key,
                kv => (kv.Value.Title, (string?)kv.Value.GroupTitle, (string?)kv.Value.Value)));

            _dialogOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(WebsiteContactInfo c)
    {
        await SettingService.DeleteContactInfoAsync(c.WebsiteContactInfoID);
        Snackbar.Add(L["contact_info.deleted", "Contact info deleted."], Severity.Success);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await SettingService.GetContactInfosPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private string DefaultIcon(ContactInfoType type) =>
        _defaultIcons.GetValueOrDefault(type, "bi bi-info-circle");

    private string TypeLabel(ContactInfoType type) => type switch
    {
        ContactInfoType.Phone => L["contact_info.type_phone", "Phone"],
        ContactInfoType.Email => L["contact_info.type_email", "Email"],
        ContactInfoType.Address => L["contact_info.type_address", "Address"],
        ContactInfoType.Location => L["contact_info.type_location", "Location"],
        ContactInfoType.WorkingHours => L["contact_info.type_workinghours", "Working Hours"],
        _ => L["contact_info.type_other", "Other"],
    };

    private string ValueLabel(ContactInfoType type) => type switch
    {
        ContactInfoType.Phone => L["contact_info.value_phone", "Phone Number"],
        ContactInfoType.Email => L["contact_info.value_email", "Email Address"],
        ContactInfoType.Address => L["contact_info.value_address", "Address"],
        ContactInfoType.Location => L["contact_info.value_location", "Map Link"],
        ContactInfoType.WorkingHours => L["contact_info.value_workinghours", "Hours"],
        _ => L["value", "Value"],
    };

    private string ValuePlaceholder(ContactInfoType type) => type switch
    {
        ContactInfoType.Phone => "+98 21 1234 5678",
        ContactInfoType.Email => "info@example.com",
        ContactInfoType.Address => L["contact_info.value_address_placeholder", "No. 12, Example St, Tehran"],
        ContactInfoType.Location => "https://maps.google.com/...",
        ContactInfoType.WorkingHours => L["contact_info.value_hours_placeholder", "Sat–Wed 9:00–17:00"],
        _ => "",
    };
}
