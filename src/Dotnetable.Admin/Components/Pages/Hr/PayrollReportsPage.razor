@page "/hr/payroll/reports"
@attribute [Authorize(Policy = RoleKeys.PayrollView)]
@inject IPayrollService Payroll
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<DNPageTitle Title=@L["hr.payroll_reports", "Payroll reports"] />
<MudText Typo="Typo.h5" Class="fw-bold mb-3">@L["hr.payroll_reports", "Insurance & tax reports"]</MudText>
@if (_isMaster) { <WebsiteSelector Value="_websiteId" ValueChanged="async id=>{_websiteId=id;}" Websites="_websites" Class="mb-3" Style="max-width:200px" /> }
<MudStack Row="true" Class="mb-3 gap-2 flex-wrap">
    <MudDatePicker @bind-Date="_from" Label="From" Dense="true" />
    <MudDatePicker @bind-Date="_to" Label="To" Dense="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">@L["run", "Run"]</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAll" Disabled="_lines.Count==0">
        @L["hr.export_all", "Export Excel (all)"]
    </MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="ExportIns" Disabled="_lines.Count==0">
        @L["hr.export_insurance", "Insurance payable"]
    </MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="ExportTax" Disabled="_lines.Count==0">
        @L["hr.export_tax", "Tax payable"]
    </MudButton>
</MudStack>
@if (_lines.Count > 0)
{
    <MudPaper Class="app-card pa-4 mb-3">
        <MudText>@L["hr.emp_ins_total", "Employee insurance total"]: @_lines.Sum(l => l.EmployeeInsurance).ToString("0.##")</MudText>
        <MudText>@L["hr.er_ins_total", "Employer insurance total"]: @_lines.Sum(l => l.EmployerInsurance).ToString("0.##")</MudText>
        <MudText>@L["hr.tax_total", "Income tax total"]: @_lines.Sum(l => l.IncomeTax).ToString("0.##")</MudText>
        <MudText>@L["hr.net_total", "Net paid total"]: @_lines.Sum(l => l.Net).ToString("0.##")</MudText>
    </MudPaper>
    <MudPaper Class="app-card pa-4">
        <MudSimpleTable Dense="true">
            <thead><tr><th>Employee</th><th>Run</th><th>Gross</th><th>Emp ins</th><th>Er ins</th><th>Tax</th><th>Net</th></tr></thead>
            <tbody>
                @foreach (var l in _lines)
                {
                    <tr>
                        <td>@l.Employee?.GivenName @l.Employee?.Surname</td>
                        <td>@l.PayrollRun?.RunNumber</td>
                        <td>@l.Gross.ToString("0.##")</td>
                        <td>@l.EmployeeInsurance.ToString("0.##")</td>
                        <td>@l.EmployerInsurance.ToString("0.##")</td>
                        <td>@l.IncomeTax.ToString("0.##")</td>
                        <td>@l.Net.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}
@code {
    private bool _isMaster; private int _websiteId;
    private List<Website> _websites = new(); private List<PayrollLine> _lines = new();
    private DateTime? _from = new(DateTime.Today.Year, 1, 1), _to = DateTime.Today;
    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var u = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = u.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(u.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
    }
    private async Task Load()
    {
        if (_websiteId <= 0 || _from is null || _to is null) return;
        _lines = (await Payroll.GetInsuranceReportAsync(_websiteId, DateOnly.FromDateTime(_from.Value), DateOnly.FromDateTime(_to.Value))).ToList();
    }

    private async Task ExportAll()
    {
        if (_websiteId <= 0 || _from is null || _to is null) return;
        var bytes = await Payroll.ExportStatutoryExcelAsync(_websiteId, DateOnly.FromDateTime(_from.Value), DateOnly.FromDateTime(_to.Value));
        await Download("payroll-statutory.xlsx", bytes);
    }
    private async Task ExportIns()
    {
        if (_websiteId <= 0 || _from is null || _to is null) return;
        var bytes = await Payroll.ExportInsurancePayableExcelAsync(_websiteId, DateOnly.FromDateTime(_from.Value), DateOnly.FromDateTime(_to.Value));
        await Download("payroll-insurance-payable.xlsx", bytes);
    }
    private async Task ExportTax()
    {
        if (_websiteId <= 0 || _from is null || _to is null) return;
        var bytes = await Payroll.ExportTaxPayableExcelAsync(_websiteId, DateOnly.FromDateTime(_from.Value), DateOnly.FromDateTime(_to.Value));
        await Download("payroll-tax-payable.xlsx", bytes);
    }
    private async Task Download(string name, byte[] bytes)
    {
        await JS.InvokeVoidAsync("dotnetableFile.download", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        Snackbar.Add(L["hr.export_done", "Excel downloaded."], Severity.Success);
    }
}
