@page "/advertisements"
@attribute [Authorize(Policy = RoleKeys.AdvertisementsView)]
@inject IAdvertisementService AdvertisementService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["ads", "Advertisements"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["ads", "Advertisements"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["ads.subtitle", "Keyword links shown on the public site, with per-language text and a display location."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["ads.new", "New advertisement"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["ads.empty", "No advertisements yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var a in _items)
            {
                <tr>
                    <td>@LocationLabel(a.Location)</td>
                    <td>@a.Keyword</td>
                    <td><code>@a.Url</code></td>
                    <td>@a.SortOrder</td>
                    <td>
                        <MudSwitch T="bool" Value="a.IsActive" Color="Color.Success"
                                   Disabled="@(!_canEdit || _busy.Contains(a.AdvertisementID))"
                                   ValueChanged="@(v => ToggleActiveAsync(a, v))" />
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(a))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(a))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Advertisement> _items = new();
    private List<Website> _websites = new();
    private HashSet<int> _busy = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.AdvertisementsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.AdvertisementsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.AdvertisementsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["ads.location", "Location"], ColumnName = nameof(Advertisement.Location), HasSort = true },
                new() { ColumnTitle = L["ads.keyword", "Keyword"], ColumnName = nameof(Advertisement.Keyword), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["ads.url", "Link"], ColumnName = nameof(Advertisement.Url), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["ads.sort", "Order"], ColumnName = nameof(Advertisement.SortOrder), HasSort = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(Advertisement.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();
    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private string LocationLabel(byte location) => (AdvertisementLocation)location switch
    {
        AdvertisementLocation.Header => L["ads.location.header", "Header"],
        AdvertisementLocation.Footer => L["ads.location.footer", "Footer"],
        AdvertisementLocation.Sidebar => L["ads.location.sidebar", "Sidebar"],
        AdvertisementLocation.Home => L["ads.location.home", "Home"],
        AdvertisementLocation.Product => L["ads.location.product", "Product page"],
        AdvertisementLocation.Blog => L["ads.location.blog", "Blog"],
        AdvertisementLocation.Page => L["ads.location.page", "CMS page"],
        _ => location.ToString(),
    };

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await AdvertisementService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ToggleActiveAsync(Advertisement a, bool value)
    {
        if (!_busy.Add(a.AdvertisementID)) return;
        a.IsActive = value;
        try { await AdvertisementService.UpdateAsync(a); }
        catch (Exception ex)
        {
            a.IsActive = !value;
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy.Remove(a.AdvertisementID); }
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Advertisement
        {
            WebsiteID = _websiteId,
            Location = (byte)AdvertisementLocation.Header,
            OpenInNewTab = true,
            IsActive = true,
        }, true)) await LoadAsync();
    }

    private async Task EditAsync(Advertisement a)
    {
        var copy = new Advertisement
        {
            AdvertisementID = a.AdvertisementID,
            WebsiteID = a.WebsiteID,
            Location = a.Location,
            Keyword = a.Keyword,
            Url = a.Url,
            OpenInNewTab = a.OpenInNewTab,
            SortOrder = a.SortOrder,
            IsActive = a.IsActive,
            CreatedAt = a.CreatedAt,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Advertisement model, bool isNew)
    {
        var parameters = new DialogParameters<AdvertisementDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<AdvertisementDialog>(
            isNew ? L["ads.new", "New advertisement"] : L["ads.edit", "Edit advertisement"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Advertisement a)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["ads.delete", "Delete advertisement"],
            L["ads.delete_confirm", "Delete this advertisement? It will disappear from the public site."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await AdvertisementService.DeleteAsync(a.AdvertisementID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
