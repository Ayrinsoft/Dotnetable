@page "/themes"
@attribute [Authorize(Policy = RoleKeys.ThemesView)]
@using Dotnetable.Application.DTOs
@inject IThemeService ThemeService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject IJSRuntime JS

<DNPageTitle Title=@L["themes", "Themes"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["themes", "Themes"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["themes.subtitle", "Install a theme package (zip) and activate it for this website’s public storefront — like WordPress."]
        </MudText>
    </MudStack>
    @if (_canEdit)
    {
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept=".zip,application/zip"
                       MaximumFileCount="1" Class="d-inline-flex">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           Disabled="@_uploading">
                    @if (_uploading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @L["themes.upload", "Upload theme"]
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
    }
</MudStack>

@if (_isMaster)
{
    <MudPaper Elevation="0" Class="app-card rounded-lg pa-3 mb-4">
        <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged"
                         Websites="_websites" Label="@L["website", "Website"]"
                         Variant="Variant.Outlined" />
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
else if (_websiteId <= 0)
{
    <MudAlert Severity="Severity.Info" Elevation="0">
        @L["themes.pick_website", "Select a website to manage its themes."]
    </MudAlert>
}
else if (_themes.Count == 0)
{
    <MudAlert Severity="Severity.Info" Elevation="0">
        @L["themes.empty", "No themes available."]
    </MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var t in _themes)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Elevation="0" Class="app-card rounded-lg overflow-hidden d-flex flex-column"
                          Style="@(t.IsActive ? "outline:2px solid var(--mud-palette-primary);" : null)">
                    <div style="height:160px;background:linear-gradient(135deg,#2d353c 0%,#4a5560 100%);display:flex;align-items:center;justify-content:center;position:relative;">
                        @if (t.HasScreenshot)
                        {
                            <img src="@ScreenshotUrl(t)" alt="@t.Name"
                                 style="width:100%;height:160px;object-fit:cover;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Large" Style="color:#a8acb1;" />
                        }
                        @if (t.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ma-2"
                                     Style="position:absolute;top:0;inset-inline-start:0;">
                                @L["themes.active", "Active"]
                            </MudChip>
                        }
                        @if (t.IsBuiltin)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ma-2"
                                     Style="position:absolute;top:0;inset-inline-end:0;">
                                @L["themes.builtin", "Built-in"]
                            </MudChip>
                        }
                    </div>
                    <div class="pa-3 d-flex flex-column flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@t.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @t.Slug
                            @if (!string.IsNullOrWhiteSpace(t.Version))
                            {
                                <span> · v@t.Version</span>
                            }
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(t.Author))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Author</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1" Style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @t.Description
                            </MudText>
                        }
                        <MudStack Row="true" Spacing="1" Class="mt-3" Justify="Justify.FlexEnd">
                            <MudTooltip Text="@L["themes.download", "Download zip"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                               Color="Color.Default" OnClick="@(() => DownloadAsync(t))"
                                               Disabled="@_busy" />
                            </MudTooltip>
                            @if (_canEdit)
                            {
                                @if (!t.IsActive)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="@(() => ActivateAsync(t))" Disabled="@_busy">
                                        @L["themes.activate", "Activate"]
                                    </MudButton>
                                }
                                @if (!t.IsBuiltin)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" Disabled="@(t.IsActive || _busy)"
                                                   OnClick="@(() => DeleteAsync(t))" />
                                }
                            }
                        </MudStack>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private const long MaxZipBytes = 50 * 1024 * 1024;

    private bool _loading = true;
    private bool _uploading;
    private bool _busy;
    private bool _isMaster;
    private bool _canEdit;
    private int _websiteId;
    private List<ThemePackageDto> _themes = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, RoleKeys.ThemesEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId <= 0 && _websites.Count > 0)
                _websiteId = _websites[0].WebsiteID;
        }

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_websiteId <= 0)
        {
            _themes = new();
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            _themes = await ThemeService.GetThemesAsync(_websiteId);
        }
        finally
        {
            _loading = false;
        }
    }

    private string ScreenshotUrl(ThemePackageDto t) =>
        $"/theme-files/{t.WebsiteID}/{Uri.EscapeDataString(t.Slug)}/screenshot?v={t.CreatedAt?.Ticks ?? 0}";

    private async Task ActivateAsync(ThemePackageDto theme)
    {
        _busy = true;
        try
        {
            await ThemeService.ActivateThemeAsync(_websiteId, theme.Slug);
            Snackbar.Add(L["themes.activated", "Theme activated."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["themes.activate_failed", "Activate failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(ThemePackageDto theme)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["themes.delete", "Delete theme"],
            L["themes.delete_confirm", "Delete this theme package from the website?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        _busy = true;
        try
        {
            await ThemeService.DeleteThemeAsync(_websiteId, theme.Slug);
            Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["delete_failed", "Delete failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task DownloadAsync(ThemePackageDto theme)
    {
        _busy = true;
        try
        {
            var (bytes, fileName) = await ThemeService.ExportZipAsync(_websiteId, theme.Slug);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("dotnetableFile.download", fileName, b64, "application/zip");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["themes.download_failed", "Download failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null || _websiteId <= 0) return;
        if (file.Size > MaxZipBytes)
        {
            Snackbar.Add(L["themes.zip_too_large", "Theme zip must be 50 MB or smaller."], Severity.Error);
            return;
        }

        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxZipBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var installed = await ThemeService.InstallFromZipAsync(_websiteId, ms, file.Name);
            Snackbar.Add(L["themes.installed", "Theme installed: {0}"].Replace("{0}", installed.Name), Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["themes.install_failed", "Install failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _uploading = false; }
    }
}
