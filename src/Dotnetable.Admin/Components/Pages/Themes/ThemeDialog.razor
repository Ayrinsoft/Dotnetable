@inject IThemeService ThemeService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="@(AllowWebsiteEdit ? 8 : 12)">
                    <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]"
                                  Variant="Variant.Outlined" Required="true"
                                  RequiredError="@L["themes.name_required", "Name is required."]" />
                </MudItem>
                @if (AllowWebsiteEdit)
                {
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int" @bind-Value="Model.WebsiteID" Label="@L["website", "Website"]"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                }

                @* ── Common tokens with dedicated inputs ─────────────── *@
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_primary" Label="@L["themes.primary", "Primary color"]"
                                  Variant="Variant.Outlined" Placeholder="#4f46e5"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Circle"
                                  AdornmentColor="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_secondary" Label="@L["themes.secondary", "Secondary color"]"
                                  Variant="Variant.Outlined" Placeholder="#0ea5e9" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_background" Label="@L["themes.background", "Background color"]"
                                  Variant="Variant.Outlined" Placeholder="#ffffff" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_text" Label="@L["themes.text", "Text color"]"
                                  Variant="Variant.Outlined" Placeholder="#1f2937" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_fontFamily" Label="@L["themes.font", "Font family"]"
                                  Variant="Variant.Outlined" Placeholder="system-ui, sans-serif" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_radius" Label="@L["themes.radius", "Corner radius"]"
                                  Variant="Variant.Outlined" Placeholder="12px" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="_darkMode" Color="Color.Primary"
                               Label="@L["themes.dark", "Dark mode default"]" />
                </MudItem>

                @* ── Full JSON for advanced tokens ───────────────────── *@
                <MudItem xs="12">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@L["themes.advanced", "Advanced (full JSON)"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["themes.json_hint", "The complete token bag sent to the front-end. Editing the fields above rewrites the matching keys on save."]
                            </MudText>
                            <MudTextField @bind-Value="Model.SettingsJson" Variant="Variant.Outlined"
                                          Lines="12" Style="font-family:monospace" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">
            @L["save", "Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Starter token bag for new themes — matches what the React SPA understands.</summary>
    public const string DefaultSettingsJson = """
    {
      "colors": {
        "primary": "#4f46e5",
        "secondary": "#0ea5e9",
        "background": "#ffffff",
        "surface": "#f8fafc",
        "text": "#1f2937",
        "muted": "#6b7280"
      },
      "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "radius": "12px",
      "darkMode": false
    }
    """;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public WebsiteTheme Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool AllowWebsiteEdit { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string _primary = "";
    private string _secondary = "";
    private string _background = "";
    private string _text = "";
    private string _fontFamily = "";
    private string _radius = "";
    private bool _darkMode;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Model.SettingsJson))
            Model.SettingsJson = DefaultSettingsJson;

        try
        {
            using var doc = global::System.Text.Json.JsonDocument.Parse(Model.SettingsJson);
            var root = doc.RootElement;
            if (root.TryGetProperty("colors", out var colors))
            {
                _primary = GetString(colors, "primary");
                _secondary = GetString(colors, "secondary");
                _background = GetString(colors, "background");
                _text = GetString(colors, "text");
            }
            _fontFamily = GetString(root, "fontFamily");
            _radius = GetString(root, "radius");
            _darkMode = root.TryGetProperty("darkMode", out var dark) && dark.ValueKind == global::System.Text.Json.JsonValueKind.True;
        }
        catch (global::System.Text.Json.JsonException) { /* keep raw JSON editable in the advanced panel */ }
    }

    private static string GetString(global::System.Text.Json.JsonElement element, string name) =>
        element.TryGetProperty(name, out var value) && value.ValueKind == global::System.Text.Json.JsonValueKind.String
            ? value.GetString() ?? "" : "";

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            Model.SettingsJson = MergeTokens(Model.SettingsJson);
            if (IsNew)
                await ThemeService.CreateThemeAsync(Model);
            else
                await ThemeService.UpdateThemeAsync(Model);

            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(Model.WebsiteThemeID));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    /// <summary>Writes the dedicated inputs back into the JSON token bag (preserving any extra
    /// keys the admin added in the advanced editor).</summary>
    private string MergeTokens(string json)
    {
        global::System.Text.Json.Nodes.JsonObject root;
        try
        {
            root = global::System.Text.Json.Nodes.JsonNode.Parse(json) as global::System.Text.Json.Nodes.JsonObject
                ?? new global::System.Text.Json.Nodes.JsonObject();
        }
        catch (global::System.Text.Json.JsonException)
        {
            root = new global::System.Text.Json.Nodes.JsonObject();
        }

        if (root["colors"] is not global::System.Text.Json.Nodes.JsonObject colors)
            root["colors"] = colors = new global::System.Text.Json.Nodes.JsonObject();

        SetIfFilled(colors, "primary", _primary);
        SetIfFilled(colors, "secondary", _secondary);
        SetIfFilled(colors, "background", _background);
        SetIfFilled(colors, "text", _text);
        SetIfFilled(root, "fontFamily", _fontFamily);
        SetIfFilled(root, "radius", _radius);
        root["darkMode"] = _darkMode;

        return root.ToJsonString(new global::System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private static void SetIfFilled(global::System.Text.Json.Nodes.JsonObject target, string key, string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            target[key] = value.Trim();
    }
}
