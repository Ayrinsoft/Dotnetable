@page "/catalog/products"
@attribute [Authorize(Policy = RoleKeys.ProductsView)]
@inject IProductService ProductService
@inject IBrandService BrandService
@inject IProductCategoryService CategoryService
@inject ICurrencyConversionService CurrencyConversion
@inject IVendorProductService VendorProductService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L
@inject IJSRuntime JS

<DNPageTitle Title=@L["products", "Products"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["products", "Products"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["products.subtitle", "Catalog products with variants, categories and media."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                   OnClick="ExportPriceStockAsync" Disabled="@(_excelBusy || _websiteId <= 0)">
            @L["products.export_price_stock", "Export price & stock"]
        </MudButton>
        @if (_canEdit)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="ImportPriceStockAsync" Accept=".xlsx" Class="d-inline-flex">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.UploadFile"
                               Disabled="@(_excelBusy || _websiteId <= 0)">
                        @L["products.import_price_stock", "Import price & stock"]
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/catalog/products/new"))"
                       Disabled="@(_prerequisites.Count > 0)">
                @L["products.new", "New Product"]
            </MudButton>
        }
    </MudStack>
</MudStack>

@if (_websiteId > 0)
{
    <DNDismissibleAlert StorageKey="products.price-stock-excel-hint">
        @L["products.price_stock_excel_hint", "Export seller listings (price & stock) for the current website. Sellers only get their own rows. Edit Price/Stock in Excel, keep VendorProductID unchanged, then import. File name ends with today’s date."]
    </DNDismissibleAlert>
}

<DNPrerequisiteAlert Items="_prerequisites" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["products.empty", "No products yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in _items)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/catalog/products/{p.ProductID}"))">
                    <td style="width:48px">
                        @if (!string.IsNullOrEmpty(p.FeaturedImageUrl))
                        {
                            <img src="@p.FeaturedImageUrl" style="width:36px;height:36px;object-fit:cover;border-radius:6px" />
                        }
                    </td>
                    <td>
                        <MudText Typo="Typo.caption" Class="fw-bold">@p.ProductCode</MudText>
                        @p.Title
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Slug</MudText>
                    </td>
                    <td>@(p.BrandName ?? "-")</td>
                    <td>@FormatMinPrice(p.MinPrice ?? p.MinPriceUsd)</td>
                    <td>@(p.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td @onclick:stopPropagation="true">
                        @if (_canDelete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(p.ProductID))" />
                        }
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private const long MaxImportBytes = 20 * 1024 * 1024;

    private bool _loading = true;
    private bool _excelBusy;
    private bool _isMaster;
    private bool _canInsert, _canDelete, _canEdit;
    private int _websiteId;
    private int? _vendorMemberId;
    private int? _vendorId;
    private List<ProductListItemDto> _items = new();
    private List<Website> _websites = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private GridViewHeaderParameters _grid = new();
    private string _displayCurrency = "USD";
    private decimal _usdToCurrency = 1m;
    private int _localDigits = 2;
    private bool _isUsdSite = true;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.ProductsInsert);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.ProductsDelete);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.ProductsEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        // Vendor members only manage products they created.
        if (user.HasClaim(c => c.Type == AdminClaimTypes.VendorId)
            && int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _vendorMemberId = mid;
        if (int.TryParse(user.FindFirst(AdminClaimTypes.VendorId)?.Value, out var vid) && vid > 0)
            _vendorId = vid;
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["products.code_title", "Code / Title"], ColumnName = nameof(ProductListItemDto.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["brand", "Brand"], ColumnName = nameof(ProductListItemDto.BrandName), HasSort = true },
                new() { ColumnTitle = L["products.min_price", "Min price"], ColumnName = "" },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(ProductListItemDto.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var query = _grid.ToQuery();
        var search = query.GetSearch(nameof(ProductListItemDto.Title));
        var result = await ProductService.GetPagedAsync(_websiteId, new ProductFilter(), query, search, _vendorMemberId);
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;

        var brands = await BrandService.GetAllAsync(_websiteId);
        var categories = await CategoryService.GetAllAsync(_websiteId);
        var rates = await CurrencyConversion.GetActiveRatesAsync(_websiteId);
        var rate = rates.FirstOrDefault(r => r.IsDefault) ?? rates.FirstOrDefault();
        if (rate is null)
        {
            _displayCurrency = "USD";
            _usdToCurrency = 1m;
            _isUsdSite = true;
            _localDigits = 2;
        }
        else
        {
            _displayCurrency = rate.CurrencyCode;
            _usdToCurrency = rate.USDToCurrency <= 0 ? 1m : rate.USDToCurrency;
            _isUsdSite = string.Equals(_displayCurrency, "USD", StringComparison.OrdinalIgnoreCase);
            _localDigits = rate.CurrencyCodeNavigation?.DecimalDigits ?? 0;
        }
        _prerequisites = ContentPrerequisiteHelper.ForProducts(L, brands.Count, categories.Count, rates.Count);

        _loading = false;
    }

    private string FormatMinPrice(decimal? minSiteCurrency)
    {
        if (minSiteCurrency is null) return "-";
        // MinPrice is already in site operational currency (or USD when site is USD / legacy).
        var digits = MoneyFormat.EffectiveDigits(_displayCurrency, _localDigits);
        return MoneyFormat.GroupWithCode(minSiteCurrency.Value, _displayCurrency, digits);
    }

    private async Task DeleteAsync(int productId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["products.delete", "Delete product"],
            L["products.delete_confirm", "Delete this product and all its variants?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await ProductService.DeleteAsync(productId);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private async Task ExportPriceStockAsync()
    {
        if (_websiteId <= 0) return;
        _excelBusy = true;
        try
        {
            var bytes = await VendorProductService.ExportListingsExcelAsync(
                _websiteId, vendorId: _vendorId, actingMemberId: _vendorMemberId);
            var scope = _vendorId is int v
                ? $"w{_websiteId}-vendor{v}"
                : $"w{_websiteId}";
            var fileName = $"price-stock-{scope}-{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("dotnetableFile.download", fileName, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["products.export_failed", "Export failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _excelBusy = false; }
    }

    private async Task ImportPriceStockAsync(IBrowserFile? file)
    {
        if (file is null || _websiteId <= 0 || !_canEdit) return;
        _excelBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await VendorProductService.ImportListingsExcelAsync(
                _websiteId, buffer, vendorId: _vendorId, actingMemberId: _vendorMemberId);

            var summary = string.Format(
                L["products.import_price_stock_result", "Import finished: {0} updated, {1} unchanged, {2} skipped."],
                result.Updated, result.Unchanged, result.Skipped);
            Snackbar.Add(summary, result.HasErrors ? Severity.Warning : Severity.Success);
            foreach (var error in result.Errors.Take(8))
                Snackbar.Add(error, Severity.Warning);
            if (result.Errors.Count > 8)
                Snackbar.Add(string.Format(L["import.more_errors", "…and {0} more issue(s)."], result.Errors.Count - 8), Severity.Warning);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["products.import_failed", "Import failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _excelBusy = false; }
    }
}
