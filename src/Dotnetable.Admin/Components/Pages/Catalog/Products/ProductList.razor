@page "/catalog/products"
@attribute [Authorize(Policy = RoleKeys.ProductsView)]
@inject IProductService ProductService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L

<DNPageTitle Title=@L["products", "Products"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["products", "Products"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["products.subtitle", "Catalog products with variants, categories and media."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/catalog/products/new"))">
                @L["products.new", "New Product"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["products.empty", "No products yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in _items)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/catalog/products/{p.ProductID}"))">
                    <td style="width:48px">
                        @if (!string.IsNullOrEmpty(p.FeaturedImageUrl))
                        {
                            <img src="@p.FeaturedImageUrl" style="width:36px;height:36px;object-fit:cover;border-radius:6px" />
                        }
                    </td>
                    <td>@p.Title <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Slug</MudText></td>
                    <td>@(p.BrandName ?? "-")</td>
                    <td>@(p.MinPriceUsd?.ToString("0.##") ?? "-")</td>
                    <td>@(p.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td @onclick:stopPropagation="true">
                        @if (_canDelete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(p.ProductID))" />
                        }
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canDelete;
    private int _websiteId;
    private int? _vendorMemberId;
    private List<ProductListItemDto> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.ProductsInsert);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.ProductsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        // Vendor members only manage products they created.
        if (user.HasClaim(c => c.Type == AdminClaimTypes.VendorId)
            && int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _vendorMemberId = mid;
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(ProductListItemDto.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["brand", "Brand"], ColumnName = nameof(ProductListItemDto.BrandName), HasSort = true },
                new() { ColumnTitle = L["products.min_price", "Min price (USD)"], ColumnName = "" },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(ProductListItemDto.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var query = _grid.ToQuery();
        var search = query.GetSearch(nameof(ProductListItemDto.Title));
        var result = await ProductService.GetPagedAsync(_websiteId, new ProductFilter(), query, search, _vendorMemberId);
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task DeleteAsync(int productId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["products.delete", "Delete product"],
            L["products.delete_confirm", "Delete this product and all its variants?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await ProductService.DeleteAsync(productId);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
