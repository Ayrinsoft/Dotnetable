    private async Task AddSellerStockAsync()
    {
        if (_addSellerVendorId is not int vendorId || _addSellerVariantId is not int variantId) return;

        var variant = _variants.FirstOrDefault(v => v.ProductVariantID == variantId);
        if (variant is null) return;

        // Resolve existing listing (form state, grid, or DB) so we update instead of failing.
        var existingId = _addSellerExistingId;
        if (existingId is null)
        {
            var row = _sellerStocks.FirstOrDefault(r => r.VendorID == vendorId && r.ProductVariantID == variantId);
            if (row is not null) existingId = row.VendorProductID;
            else
            {
                var found = await VendorProductService.FindAsync(vendorId, variantId);
                if (found is not null) existingId = found.VendorProductID;
            }
        }

        // Prefer explicit form price; fall back to catalog variant price for brand-new assigns.
        var priceInput = _addSellerPrice > 0
            ? _addSellerPrice
            : DisplayPrice(variant);
        if (priceInput <= 0)
            priceInput = 0.01m;
        var (local, usd) = SellerPriceDual(priceInput);

        // Keep delivery days / active from existing row when updating.
        var existingRow = existingId is int eid
            ? _sellerStocks.FirstOrDefault(r => r.VendorProductID == eid)
            : null;
        if (existingRow?.IsSiteLinked == true)
        {
            Snackbar.Add(L["products.seller_stock_site_readonly", "Site-link listings cannot be edited here."], Severity.Warning);
            return;
        }

        var model = new VendorProduct
        {
            VendorProductID = existingId ?? 0,
            VendorID = vendorId,
            ProductVariantID = variantId,
            ReferencePrice = local,
            ReferencePriceUsd = usd > 0 ? usd : 0.01m,
            OverridePriceLocal = null,
            OverridePrice = null,
            StockQuantity = _addSellerStock < 0 && IsDigital ? -1 : Math.Max(0, _addSellerStock),
            DeliveryDays = existingRow?.DeliveryDays > 0 ? existingRow.DeliveryDays : 1,
            IsActive = existingRow?.IsActive ?? true,
        };
        var (ok, err, item) = await VendorProductService.UpsertAsync(model, actingMemberId: null);
        if (!ok || item is null)
        {
            Snackbar.Add(err ?? L["save_failed", "Save failed"], Severity.Error);
            return;
        }

        _addSellerVendorId = null;
        _addSellerVariantId = null;
        _addSellerPrice = 0;
        _addSellerStock = 0;
        _addSellerExistingId = null;
        await LoadSellerStocksAsync();
        // Host variant stock totals are derived from store listings.
        await LoadVariantStockAsync(_variants);
        Snackbar.Add(
            existingId is int
                ? L["products.seller_stock_updated", "Seller listing updated."]
                : L["saved", "Saved."],
            Severity.Success);
    }

    private async Task RemoveSellerStockAsync(SellerStockEditRow row)
    {
        if (row.IsSiteLinked) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["products.seller_stock_remove", "Remove seller stock"],
            string.Format(L["products.seller_stock_remove_confirm", "Remove {0} stock for {1}?"], row.VendorName, row.Sku),
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;

        var (ok, err) = await VendorProductService.DeleteAsync(row.VendorProductID);
        if (!ok)
        {
            Snackbar.Add(err ?? L["save_failed", "Save failed"], Severity.Error);
            return;
        }
        await LoadSellerStocksAsync();
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
    }

    private async Task PersistSellerStocksAsync()
    {
        foreach (var row in _sellerStocks.Where(r => !r.IsSiteLinked))
        {
            var amount = row.ReferencePrice > 0 ? row.ReferencePrice : 0.01m;
            var (local, usd) = SellerPriceDual(amount);
            // Grid edits set this seller's list price; clear promo override so the typed amount is what they sell at.
            var (ok, err, _) = await VendorProductService.UpsertAsync(new VendorProduct
            {
                VendorProductID = row.VendorProductID,
                VendorID = row.VendorID,
                ProductVariantID = row.ProductVariantID,
                ReferencePrice = local,
                ReferencePriceUsd = usd > 0 ? usd : 0.01m,
                OverridePriceLocal = null,
                OverridePrice = null,
                StockQuantity = row.StockQuantity < 0 ? -1 : Math.Max(0, row.StockQuantity),
                DeliveryDays = Math.Max(0, row.DeliveryDays),
                IsActive = row.IsActive,
            });
            if (!ok)
                throw new InvalidOperationException(err ?? $"Failed to save seller listing for {row.VendorName} / {row.Sku}");
        }
    }

    private async Task PersistMemberVendorStockAsync(Dictionary<string, int> stockBySku)
    {
        if (_vendorId is not int vendorId) return;

        foreach (var v in _variants)
        {
            if (!stockBySku.TryGetValue(v.Sku, out var desired))
                desired = 0;

            // Member seller: their listing price tracks the variant price they edit on this form.
            var amount = v.ReferencePrice > 0 ? v.ReferencePrice : (v.ReferencePriceUsd > 0 ? v.ReferencePriceUsd : 0.01m);
            var (local, usd) = SellerPriceDual(amount);

            var (ok, err, _) = await VendorProductService.UpsertAsync(new VendorProduct
            {
                VendorID = vendorId,
                ProductVariantID = v.ProductVariantID,
                ReferencePrice = local,
                ReferencePriceUsd = usd > 0 ? usd : 0.01m,
                OverridePriceLocal = null,
                OverridePrice = null,
                StockQuantity = desired < 0 && IsDigital ? -1 : Math.Max(0, desired),
                DeliveryDays = 1,
                IsActive = true,
            }, actingMemberId: _memberId);
            if (!ok)
                throw new InvalidOperationException(err ?? $"Failed to save seller listing for {v.Sku}");
        }
    }

