                    </MudAlert>
                    @foreach (var (row, idx) in _warranties.Select((w, i) => (w, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="4">
                                    <MudAutocomplete T="Warranty" Value="@GetSelectedWarranty(row)" ValueChanged="@(plan => OnWarrantyCatalogChanged(row, plan))"
                                                     Label="@L["products.warranty_plan", "Catalog plan"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     SearchFunc="@( (value, ct) => SearchWarranties(value, row, ct) )"
                                                     ToStringFunc="WarrantyDisplay"
                                                     Clearable="true" Dense="true"
                                                     ResetValueOnEmptyText="true" CoerceText="false"
                                                     HelperText="@L["products.warranty_plan_hint", "Type to search registered warranties. Clear for custom text only."]" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="row.CustomTitle" Label="@L["products.warranty_custom_title", "Custom title / override"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  HelperText="@L["products.warranty_custom_title_hint", "Required if no catalog plan. Optional override when a plan is selected."]" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudCheckBox T="bool" @bind-Value="row.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="2" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _warranties.RemoveAt(idx))" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="row.CustomDescription" Label="@L["products.warranty_notes", "Description / notes"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                                  HelperText="@L["products.warranty_notes_hint", "Extra terms or full text for non-catalog warranties."]" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddWarrantyRow">
                        @L["products.add_warranty", "Add warranty"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.related", "Related Products"]">
                <div class="pa-2">
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudItem xs="12" sm="8">
                            <MudAutocomplete T="ProductListItemDto" Label="@L["products.search_to_add", "Search a product to add"]" Variant="Variant.Outlined"
                                             SearchFunc="SearchProductsAsync" ToStringFunc="@(p => p?.Title ?? string.Empty)"
                                             ValueChanged="AddRelatedProduct" ResetValueOnEmptyText="true" CoerceText="true" />
                        </MudItem>
                    </MudGrid>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>@L["title", "Title"]</th><th>@L["products.relation_type", "Relation"]</th><th style="width:1%"></th></tr></thead>
                        <tbody>
                            @foreach (var (rel, idx) in _relatedProducts.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td>@RelatedTitle(rel.RelatedProductID)</td>
                                    <td>
                                        <MudSelect T="byte" Value="@rel.RelationType" ValueChanged="@(t => { rel.RelationType = t; })" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem T="byte" Value="(byte)0">@L["products.relation_related", "Related"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)1">@L["products.relation_upsell", "Up-sell"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)2">@L["products.relation_crosssell", "Cross-sell"]</MudSelectItem>
                                        </MudSelect>
                                    </td>
                                    <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _relatedProducts.RemoveAt(idx))" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter] public int? ProductId { get; set; }

    private bool _loading = true, _saving;
    private bool _isNew;
    private bool _isMaster, _canEdit;
    private string[]? _formErrors;
    private bool _showFieldErrors;
    private int _websiteId;
    private int? _memberId;
    private int? _vendorId;
    private string _defaultLanguageCode = "en";
    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();
    private Brand? _selectedBrand;
    private ProductCategory? _selectedCategory;
    private Product Model { get; set; } = new() { IsActive = true, ProductType = (byte)ProductType.Physical, RequiresShipping = true };
    private FileRecord? _featuredImage;
    private bool _slugManuallyEdited;
    private readonly HashSet<ProductVariant> _variantTitleManual = new();
    private bool IsDigital => Model.ProductType != (byte)ProductType.Physical;
    private string MediaTabLabel =>
        string.Format(L["products.media_tab", "Media ({0})"],
            (_featuredImage is null ? 0 : 1) + _gallery.Count);

    private List<Brand> _brands = new();
    private List<ProductCategory> _categories = new();
    private List<ProductVariant> _variants = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private string _displayCurrency = "USD";
    private decimal _usdToCurrency = 1m;
    private int _localDigits = 0;
    private bool _hasRate;
    private bool _isUsdSite = true;
    private bool _storePricesInUsd;
    private readonly Dictionary<string, (string Title, string Slug, string? Short, string? Content, string? ExpertReview)> _tr = new(StringComparer.OrdinalIgnoreCase);
    private int _mainEditorVersion;
    private int _mainExpertReviewEditorVersion;
    private readonly Dictionary<string, int> _translationEditorVersions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _translationExpertReviewEditorVersions = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Session-only site-currency edit buffers. <see cref="ProductVariant.ReferencePrice"/> is the persisted authority.</summary>
    private readonly Dictionary<ProductVariant, decimal> _localPrice = new();
    private readonly Dictionary<ProductVariant, decimal?> _localCompareAt = new();
    /// <summary>On-hand stock per variant: member-vendor listing, or host total of store listings (read-only on host).</summary>
    private readonly Dictionary<ProductVariant, int> _stockOnHand = new();
    /// <summary>Reserved quantity (read-only hint) loaded from inventory; sales already hold this stock.</summary>
    private readonly Dictionary<ProductVariant, int> _stockReserved = new();
    /// <summary>Per-seller marketplace stock rows (VendorProduct) for this product — Display/Member vendors.</summary>
    private List<SellerStockEditRow> _sellerStocks = new();
    private List<Vendor> _marketplaceVendors = new();
    private int? _addSellerVendorId;
    private int? _addSellerVariantId;
    private decimal _addSellerPrice;
    private int _addSellerStock;
    /// <summary>When seller+variant already has a listing, its VendorProductID for in-place update.</summary>
    private int? _addSellerExistingId;

    private List<(int MediaSetId, FileRecord File)> _gallery = new();
    /// <summary>All active product-level (non-variant) attributes for the website, with options loaded.</summary>
    private List<AttributeDefinition> _allProductLevelAttributes = new();
    /// <summary>Catalog attributes marked as variant (color, size, …) for this website.</summary>
    private List<AttributeDefinition> _variantAttributes = new();
    /// <summary>Variant attribute definition IDs used by this product (product options).</summary>
    private readonly List<int> _productVariantAttrIds = new();
    /// <summary>Option IDs offered on this product, per attribute definition (ordered).</summary>
    private readonly Dictionary<int, List<int>> _productVariantOptionIds = new();
    /// <summary>Per-variant picks: defId → optionId. Kept off the EF graph until SetVariantsAsync.</summary>
    private readonly Dictionary<ProductVariant, Dictionary<int, int>> _variantAttrPicks = new();
    private AttributeDefinition? _addVariantAttrPick;
    /// <summary>Attribute definition IDs mapped to the selected category (and ancestors), ordered.</summary>
    private List<int> _categoryAttributeIds = new();
    /// <summary>Extra product-only attribute IDs added on this form (not from category mapping).</summary>
    private readonly List<int> _extraAttributeIds = new();
    private AttributeDefinition? _addAttributePick;
    private Dictionary<int, ProductAttributeValue> _attrValues = new();

    private List<AttributeDefinition> AddableVariantAttributes =>
        _variantAttributes.Where(a => !_productVariantAttrIds.Contains(a.AttributeDefinitionID)).ToList();

    private bool CanGenerateCombinations =>
        _productVariantAttrIds.Count > 0
        && _productVariantAttrIds.All(id => _productVariantOptionIds.TryGetValue(id, out var opts) && opts.Count > 0);

    private int CombinationCount
    {
        get
        {
            if (!CanGenerateCombinations) return 0;
            var n = 1;
            foreach (var id in _productVariantAttrIds)
                n *= _productVariantOptionIds[id].Count;
            return n;
        }
    }

    private List<AttributeDefinition> DisplayedProductAttributes
    {
        get
        {
            var byId = _allProductLevelAttributes.ToDictionary(a => a.AttributeDefinitionID);
            var ordered = new List<AttributeDefinition>();
            var seen = new HashSet<int>();

            foreach (var id in _categoryAttributeIds)
            {
                if (seen.Add(id) && byId.TryGetValue(id, out var def))
                    ordered.Add(def);
            }

            foreach (var id in _extraAttributeIds)
            {
                if (seen.Add(id) && byId.TryGetValue(id, out var def))
                    ordered.Add(def);
            }

            // Existing saved values not in category/extra (legacy) still show so they can be cleared.
            foreach (var id in _attrValues.Keys.OrderBy(x => x))
            {
                if (seen.Add(id) && byId.TryGetValue(id, out var def))
                    ordered.Add(def);
            }

            return ordered;
        }
    }

    private List<AttributeDefinition> AddableProductAttributes
    {
        get
        {
            var shown = DisplayedProductAttributes.Select(a => a.AttributeDefinitionID).ToHashSet();
            return _allProductLevelAttributes
                .Where(a => !shown.Contains(a.AttributeDefinitionID))
                .OrderBy(a => a.SortOrder).ThenBy(a => a.Name)
                .ToList();
        }
    }
    private List<ProductWarning> _warnings = new();
    private List<ProductWarranty> _warranties = new();
    private List<Warranty> _warrantyCatalog = new();
    private List<ProductRelation> _relatedProducts = new();
    private Dictionary<int, string> _relatedTitles = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, ProductId is null ? RoleKeys.ProductsInsert : RoleKeys.ProductsEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _memberId = mid;
        if (int.TryParse(user.FindFirst(AdminClaimTypes.VendorId)?.Value, out var vendorId))
            _vendorId = vendorId;
        _isNew = ProductId is null;

        if (!_isNew)
        {
            var product = await ProductService.GetByIdAsync(ProductId!.Value);
            if (product is null) { Nav.NavigateTo("/catalog/products"); return; }
            // Vendor members may only open their own products.
            if (_vendorId is not null && _memberId is int ownerId && product.CreatedByMemberID != ownerId)
            {
                Snackbar.Add(L["products.vendor_forbidden", "You can only manage your own products."], Severity.Error);
                Nav.NavigateTo("/catalog/products");
                return;
            }
            Model = product;
            _websiteId = product.WebsiteID;
            _variants = product.ProductVariants.ToList();
            _slugManuallyEdited = !string.IsNullOrWhiteSpace(product.Slug);
            if (_vendorId is null)
                await LoadSellerStocksAsync();
            await LoadVariantStockAsync(_variants);
            if (product.FeaturedImageFileID is int fid)
                _featuredImage = product.FeaturedImageFile;
            foreach (var t in product.ProductTranslations)
                _tr[t.LanguageCode] = (t.Title, t.Slug, t.ShortDescription, t.Content, t.ExpertReview);

            _gallery = product.ProductMedia.OrderBy(m => m.SortOrder)
                .Select(m => (m.MediaSetID, m.MediaSet.MediaSetItems.OrderBy(i => i.SortOrder).FirstOrDefault()?.File))
                .Where(e => e.File is not null)
                .Select(e => (e.MediaSetID, e.File!))
                .ToList();
            foreach (var v in product.ProductAttributeValues)
                _attrValues[v.AttributeDefinitionID] = v;
            _warnings = product.ProductWarnings.ToList();
            _warranties = product.ProductWarranties.OrderBy(w => w.SortOrder).ToList();
            _relatedProducts = product.ProductRelationProducts.ToList();
            foreach (var r in product.ProductRelationProducts)
                if (r.RelatedProduct is not null) _relatedTitles[r.RelatedProductID] = r.RelatedProduct.Title;
        }
        else
        {
            Model.WebsiteID = _websiteId;
            // New products start with one blank variant so price/SKU are always visible.
            if (_variants.Count == 0)
                AddVariant();
        }

        // Master site (website 1) uses per-website language rows like every other site.
        var activeLangs = await LanguageService.GetActiveForWebsiteAsync(_websiteId);
        _defaultLanguageCode = activeLangs.FirstOrDefault(l => l.IsDefault)?.LanguageCode
            ?? activeLangs.FirstOrDefault()?.LanguageCode
            ?? "en";
        _languages = activeLangs.Where(l => !l.IsDefault)
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        _brands = await BrandService.GetAllAsync(_websiteId);
        _categories = await CategoryService.GetAllAsync(_websiteId);
        // Load all plans so inactive ones already linked to the product still resolve in the autocomplete.
        _warrantyCatalog = await WarrantyService.GetAllAsync(_websiteId, activeOnly: false);
        if (_vendorId is null)
        {
            // Display + Member sellers only (site-link stock lives on the source website inventory).
            _marketplaceVendors = (await VendorService.GetAllAsync(_websiteId))
                .Where(v => v.IsActive && v.VendorType != (byte)VendorType.Site)
                .OrderBy(v => v.Name)
                .ToList();
        }

        if (!_isNew)
        {
            if (Model.BrandID is int brandId)
                _selectedBrand = _brands.FirstOrDefault(b => b.BrandID == brandId);
            var primaryMap = Model.ProductCategoryMaps.FirstOrDefault(m => m.IsPrimary)
                             ?? Model.ProductCategoryMaps.FirstOrDefault();
            if (primaryMap is not null)
                _selectedCategory = _categories.FirstOrDefault(c => c.ProductCategoryID == primaryMap.ProductCategoryID);
        }

        await LoadCurrencyAsync();
        SyncVariantLocalPrices();

        _prerequisites = ContentPrerequisiteHelper.ForProducts(L, _brands.Count, _categories.Count, _hasRate ? 1 : 0);

        var allAttrs = await AttributeDefinitionService.GetAllAsync(_websiteId);
        var productLevel = new List<AttributeDefinition>();
        var variantLevel = new List<AttributeDefinition>();
        foreach (var a in allAttrs.Where(a => a.Active))
        {
            var full = await AttributeDefinitionService.GetByIdAsync(a.AttributeDefinitionID) ?? a;
            // Variant attributes store an option ID only (select/color). Skip free-text/numeric defs here.
            if (a.IsVariantAttribute)
            {
                if (full.InputType is 1 or 2)
                    variantLevel.Add(full);
            }
            else
            {
                productLevel.Add(full);
            }
        }
        _allProductLevelAttributes = productLevel.OrderBy(a => a.SortOrder).ThenBy(a => a.Name).ToList();
        _variantAttributes = variantLevel.OrderBy(a => a.SortOrder).ThenBy(a => a.Name).ToList();

        // After variant attribute definitions (with options) are loaded, hydrate row picks.
        CaptureVariantAttributeOptions(_variants);

        // Product-only extras: saved values that are not on the category mapping.
        await ReloadCategoryAttributesAsync();
        SeedExtraAttributesFromExistingValues();

        _loading = false;
    }

    private async Task ReloadCategoryAttributesAsync()
    {
        _categoryAttributeIds.Clear();
        if (_selectedCategory is null) return;

        var defs = await CategoryService.GetAttributesForCategoryAsync(
            _selectedCategory.ProductCategoryID, includeAncestors: true);
        _categoryAttributeIds = defs.Select(d => d.AttributeDefinitionID).ToList();

        // Ensure full option sets for category defs (service may already include them).
        var known = _allProductLevelAttributes.Select(a => a.AttributeDefinitionID).ToHashSet();
        foreach (var d in defs)
        {
            if (known.Contains(d.AttributeDefinitionID)) continue;
            var full = await AttributeDefinitionService.GetByIdAsync(d.AttributeDefinitionID) ?? d;
            if (!full.IsVariantAttribute && full.Active)
            {
                _allProductLevelAttributes.Add(full);
                known.Add(full.AttributeDefinitionID);
            }
        }
    }

    private void SeedExtraAttributesFromExistingValues()
    {
        _extraAttributeIds.Clear();
        var categorySet = _categoryAttributeIds.ToHashSet();
        foreach (var defId in _attrValues.Keys.OrderBy(x => x))
        {
            if (!categorySet.Contains(defId) && !_extraAttributeIds.Contains(defId))
                _extraAttributeIds.Add(defId);
        }
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            _storePricesInUsd = await CurrencyConversion.GetStorePricesInUsdAsync(_websiteId);
            var rates = await CurrencyConversion.GetActiveRatesAsync(_websiteId);
            var rate = rates.FirstOrDefault(r => r.IsDefault) ?? rates.FirstOrDefault();
            if (rate is null)
            {
                _hasRate = false;
                _displayCurrency = "USD";
                _usdToCurrency = 1m;
                _isUsdSite = true;
                return;
            }

            _hasRate = true;
            _displayCurrency = rate.CurrencyCode;
            _usdToCurrency = rate.USDToCurrency <= 0 ? 1m : rate.USDToCurrency;
            _localDigits = rate.CurrencyCodeNavigation?.DecimalDigits ?? 0;
            _isUsdSite = string.Equals(_displayCurrency, "USD", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _hasRate = false;
            _isUsdSite = true;
            _displayCurrency = "USD";
            _usdToCurrency = 1m;
            _localDigits = 2;
        }
    }

    private void SyncVariantLocalPrices()
    {
        foreach (var v in _variants)
        {
            // Prefer stored site-currency price (no rate drift); fall back to USD × rate for legacy rows.
            if (v.ReferencePrice > 0)
                _localPrice[v] = RoundLocal(v.ReferencePrice);
            else if (!_isUsdSite && _hasRate)
                _localPrice[v] = RoundLocal(v.ReferencePriceUsd * _usdToCurrency);
            else
                _localPrice[v] = RoundLocal(v.ReferencePriceUsd);

            if (v.CompareAtPrice is decimal cmpLocal && cmpLocal > 0)
                _localCompareAt[v] = RoundLocal(cmpLocal);
            else if (v.CompareAtPriceUsd is decimal cmpUsd && !_isUsdSite && _hasRate)
                _localCompareAt[v] = RoundLocal(cmpUsd * _usdToCurrency);
            else
                _localCompareAt[v] = v.CompareAtPriceUsd;
        }
    }

    private decimal RoundLocal(decimal amount) => Math.Round(amount, _localDigits, MidpointRounding.AwayFromZero);
    private decimal RoundUsd(decimal amount) => Math.Round(amount, 4, MidpointRounding.AwayFromZero);

    private static string FormatRate(decimal rate) =>
        rate >= 1 ? rate.ToString("N2") : rate.ToString("0.######");

    /// <summary>Single price label: "Price (IRR)" or "Price (USD)" — never both.</summary>
    private string PriceFieldLabel =>
        string.Format(L["variants.price_in_currency", "Price ({0})"], _displayCurrency);

    /// <summary>Optional strikethrough/list price in the same site currency only.</summary>
    private string CompareFieldLabel =>
        string.Format(L["variants.compare_in_currency", "Compare at ({0})"], _displayCurrency);

    private bool UseLocalCurrencyInput => !_isUsdSite && _hasRate;

    /// <summary>The one editable amount the admin types — always in site display currency.</summary>
    private decimal DisplayPrice(ProductVariant v)
    {
        if (_localPrice.TryGetValue(v, out var local)) return local;
        if (v.ReferencePrice > 0) return RoundLocal(v.ReferencePrice);
        if (!UseLocalCurrencyInput) return v.ReferencePriceUsd;
        return RoundLocal(v.ReferencePriceUsd * _usdToCurrency);
    }

    private decimal? DisplayCompareAt(ProductVariant v)
    {
        if (_localCompareAt.TryGetValue(v, out var local)) return local;
        if (v.CompareAtPrice is decimal cmp) return RoundLocal(cmp);
        if (!UseLocalCurrencyInput) return v.CompareAtPriceUsd;
        if (v.CompareAtPriceUsd is decimal cmpUsd)
            return RoundLocal(cmpUsd * _usdToCurrency);
        return null;
    }

    private void SetDisplayPrice(ProductVariant v, decimal amount)
    {
        if (amount < 0) amount = 0;
        _localPrice[v] = amount;
        // Site currency is the stored authority.
        v.ReferencePrice = RoundLocal(amount);
        // Always maintain USD bridge (required for multi-currency display); dual-store flag is website-level policy.
        v.ReferencePriceUsd = UseLocalCurrencyInput
            ? (_usdToCurrency == 0 ? 0 : RoundUsd(amount / _usdToCurrency))
            : RoundUsd(amount);
    }

    private void SetDisplayCompareAt(ProductVariant v, decimal? amount)
    {
        if (amount is < 0) amount = 0;
        _localCompareAt[v] = amount;
        v.CompareAtPrice = amount is null ? null : RoundLocal(amount.Value);
        if (amount is null)
            v.CompareAtPriceUsd = null;
        else if (UseLocalCurrencyInput)
            v.CompareAtPriceUsd = _usdToCurrency == 0 ? null : RoundUsd(amount.Value / _usdToCurrency);
        else
            v.CompareAtPriceUsd = amount;
    }

    private Task<IEnumerable<Brand>> SearchBrands(string value, CancellationToken ct)
    {
        IEnumerable<Brand> q = _brands.Where(b => b.IsActive || (_selectedBrand is not null && b.BrandID == _selectedBrand.BrandID))
            .OrderBy(b => b.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(b => b.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || b.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private void OnBrandChanged(Brand? brand) => _selectedBrand = brand;

    private void OnTitleChanged(string title)
    {
        Model.Title = title ?? string.Empty;
        if (!_slugManuallyEdited)
            Model.Slug = Slugify(Model.Title);
    }

    private void OnSlugChanged(string slug)
    {
        Model.Slug = slug ?? string.Empty;
        _slugManuallyEdited = true;
    }

    /// <summary>URL-safe slug from title.</summary>
    private static string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var s = text.Trim().ToLowerInvariant();
        var chars = new List<char>(s.Length);
        var prevDash = false;
        foreach (var c in s)
        {
            if (char.IsLetterOrDigit(c))
            {
                chars.Add(c);
                prevDash = false;
            }
            else if (c is ' ' or '-' or '_' || char.IsWhiteSpace(c))
            {
                if (!prevDash && chars.Count > 0)
                {
                    chars.Add('-');
                    prevDash = true;
                }
            }
            // Keep common non-Latin letters via IsLetter; skip punctuation.
        }
        while (chars.Count > 0 && chars[^1] == '-')
            chars.RemoveAt(chars.Count - 1);
        return new string(chars.ToArray());
    }

    /// <summary>CKEditor empty shells must not be saved as real content (storefront hides empty tabs).</summary>
    private static string? NormalizeEmptyRichText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var s = html.Trim();
        // Use global:: — razor components under Pages.* would otherwise resolve "System" to Pages.System.
        var stripped = global::System.Text.RegularExpressions.Regex.Replace(
            s, @"<(p|div|span|h[1-6])(\s[^>]*)?>(\s|&nbsp;|<br\s*/?>)*</\1>",
            string.Empty,
            global::System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        stripped = global::System.Text.RegularExpressions.Regex.Replace(stripped, @"<br\s*/?>", " ", global::System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        stripped = global::System.Text.RegularExpressions.Regex.Replace(stripped, @"<[^>]+>", " ");
        stripped = global::System.Net.WebUtility.HtmlDecode(stripped);
        stripped = global::System.Text.RegularExpressions.Regex.Replace(stripped, @"\s+", " ").Trim();
        return string.IsNullOrWhiteSpace(stripped) ? null : s;
    }

