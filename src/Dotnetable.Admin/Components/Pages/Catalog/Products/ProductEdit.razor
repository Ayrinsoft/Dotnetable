    private void SetAttrOption(int attributeDefinitionId, int? optionId)
    {
        if (optionId is null or <= 0)
        {
            if (_attrValues.TryGetValue(attributeDefinitionId, out var existing))
            {
                existing.AttributeOptionID = null;
                if (!HasMeaningfulAttrValue(existing))
                    _attrValues.Remove(attributeDefinitionId);
            }
            return;
        }
        GetOrCreateAttrValue(attributeDefinitionId).AttributeOptionID = optionId;
    }

    private void SetAttrNumeric(int attributeDefinitionId, decimal? value)
    {
        if (value is null)
        {
            if (_attrValues.TryGetValue(attributeDefinitionId, out var existing))
            {
                existing.NumericValue = null;
                if (!HasMeaningfulAttrValue(existing))
                    _attrValues.Remove(attributeDefinitionId);
            }
            return;
        }
        GetOrCreateAttrValue(attributeDefinitionId).NumericValue = value;
    }

    private void SetAttrText(int attributeDefinitionId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            if (_attrValues.TryGetValue(attributeDefinitionId, out var existing))
            {
                existing.CustomValue = null;
                if (!HasMeaningfulAttrValue(existing))
                    _attrValues.Remove(attributeDefinitionId);
            }
            return;
        }
        GetOrCreateAttrValue(attributeDefinitionId).CustomValue = value;
    }

    private void SetAttrFeatured(int attributeDefinitionId, bool featured)
    {
        // Featured alone is not enough to persist — only set when a real value exists (or will).
        if (!_attrValues.ContainsKey(attributeDefinitionId) && !featured)
            return;
        if (!_attrValues.ContainsKey(attributeDefinitionId) && featured)
            return; // no value yet; ignore featured-only
        GetOrCreateAttrValue(attributeDefinitionId).IsFeatured = featured;
        if (_attrValues.TryGetValue(attributeDefinitionId, out var v) && !HasMeaningfulAttrValue(v))
            _attrValues.Remove(attributeDefinitionId);
    }

    private static bool HasMeaningfulAttrValue(ProductAttributeValue v) =>
        (v.AttributeOptionID is int oid && oid > 0)
        || v.NumericValue is not null
        || !string.IsNullOrWhiteSpace(v.CustomValue);

