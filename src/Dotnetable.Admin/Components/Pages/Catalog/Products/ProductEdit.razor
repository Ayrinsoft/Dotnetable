    private async Task AddProductOptionValueAsync(AttributeDefinition def)
    {
        var used = _productVariantOptionIds.GetValueOrDefault(def.AttributeDefinitionID)?.ToHashSet()
                   ?? new HashSet<int>();
        var catalogLeft = def.AttributeOptions
            .Where(o => !used.Contains(o.AttributeOptionID))
            .OrderBy(o => o.SortOrder).ThenBy(o => o.Value)
            .ToList();

        var parameters = new DialogParameters<VariantOptionValueDialog>
        {
            { x => x.Definition, def },
            { x => x.CatalogOptions, catalogLeft },
        };
        var dialog = await DialogService.ShowAsync<VariantOptionValueDialog>(
            def.InputType == 2
                ? L["variants.add_color_title", "Add color"]
                : L["variants.add_value", "Add value"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: AttributeOption option }) return;

        AttachOptionToDefinition(def, option);
        if (!_productVariantOptionIds.TryGetValue(def.AttributeDefinitionID, out var list))
        {
            list = new List<int>();
            _productVariantOptionIds[def.AttributeDefinitionID] = list;
        }
        if (!list.Contains(option.AttributeOptionID))
            list.Add(option.AttributeOptionID);
    }

