    private Task<IEnumerable<ProductCategory>> SearchCategories(string value, CancellationToken ct)
    {
        IEnumerable<ProductCategory> q = _categories
            .Where(c => c.IsActive || (_selectedCategory is not null && c.ProductCategoryID == _selectedCategory.ProductCategoryID))
            .OrderBy(c => CategoryPath(c), StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || CategoryPath(c).Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private string CategoryPath(ProductCategory? category)
    {
        if (category is null) return string.Empty;
        var byId = _categories.ToDictionary(c => c.ProductCategoryID);
        var parts = new List<string> { category.Name };
        var current = category;
        var guard = 0;
        while (current.ParentCategoryID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

