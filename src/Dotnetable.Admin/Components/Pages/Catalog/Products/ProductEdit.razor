    private void SetVariantOptionId(ProductVariant variant, int attributeDefinitionId, int? optionId)
    {
        if (!_variantAttrPicks.TryGetValue(variant, out var map))
        {
            map = new Dictionary<int, int>();
            _variantAttrPicks[variant] = map;
        }
        if (optionId is null or <= 0)
            map.Remove(attributeDefinitionId);
        else
            map[attributeDefinitionId] = optionId.Value;

        // Auto-fill title from options until the admin edits the title manually.
        if (!_variantTitleManual.Contains(variant))
        {
            var auto = BuildVariantTitleFromPicks(variant);
            if (!string.IsNullOrWhiteSpace(auto))
                variant.Title = auto;
        }
    }

    private string BuildVariantTitleFromPicks(ProductVariant variant)
    {
        if (!_variantAttrPicks.TryGetValue(variant, out var map) || map.Count == 0)
            return string.Empty;
        var parts = new List<string>();
        foreach (var defId in _productVariantAttrIds)
        {
            if (!map.TryGetValue(defId, out var optId)) continue;
            var def = GetVariantDef(defId);
            var opt = def?.AttributeOptions.FirstOrDefault(o => o.AttributeOptionID == optId);
            if (opt is not null && !string.IsNullOrWhiteSpace(opt.Value))
                parts.Add(opt.Value);
        }
        return string.Join(" / ", parts);
    }

    private void GenerateVariantCombinations()
    {
        if (!CanGenerateCombinations) return;

        var axes = _productVariantAttrIds
            .Select(defId => (
                DefId: defId,
                Options: _productVariantOptionIds[defId].ToList()))
            .ToList();

        var combos = new List<Dictionary<int, int>> { new() };
        foreach (var axis in axes)
        {
            var next = new List<Dictionary<int, int>>();
            foreach (var partial in combos)
            {
                foreach (var optId in axis.Options)
                {
                    var copy = new Dictionary<int, int>(partial) { [axis.DefId] = optId };
                    next.Add(copy);
                }
            }
            combos = next;
        }

        // Index existing variants by sorted (defId, optionId) signature.
        string Sig(Dictionary<int, int> picks) =>
            string.Join("|", picks.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}:{kv.Value}"));

        var existing = new HashSet<string>(StringComparer.Ordinal);
        foreach (var v in _variants)
        {
            if (!_variantAttrPicks.TryGetValue(v, out var map) || map.Count == 0) continue;
            existing.Add(Sig(map));
        }

        var added = 0;
        foreach (var combo in combos)
        {
            var sig = Sig(combo);
            if (!existing.Add(sig)) continue;

            var v = new ProductVariant
            {
                IsActive = true,
                IsDefault = _variants.Count == 0 && added == 0,
                Title = string.Empty,
                Sku = string.Empty,
            };
            _variants.Add(v);
            _variantAttrPicks[v] = new Dictionary<int, int>(combo);
            v.Title = BuildVariantTitleFromPicks(v);
            _stockOnHand[v] = 0;
            _stockReserved[v] = 0;
            if (UseLocalCurrencyInput)
            {
                _localPrice[v] = 0;
                _localCompareAt[v] = null;
            }
            added++;
        }

        // Drop a single empty placeholder row if we just generated real combinations.
        if (added > 0 && _variants.Count > added)
        {
            for (var i = _variants.Count - 1; i >= 0; i--)
            {
                var v = _variants[i];
                var emptyPicks = !_variantAttrPicks.TryGetValue(v, out var m) || m.Count == 0;
                var emptyMeta = string.IsNullOrWhiteSpace(v.Title) && string.IsNullOrWhiteSpace(v.Sku)
                                && DisplayPrice(v) <= 0;
                if (emptyPicks && emptyMeta && v.ProductVariantID == 0)
                    RemoveVariantAt(i);
            }
        }

        if (added == 0)
            Snackbar.Add(L["variants.generate_none", "All combinations already exist."], Severity.Info);
        else
            Snackbar.Add(string.Format(L["variants.generate_added", "Added {0} variant(s). Set price and SKU on each row."], added), Severity.Success);
    }

    /// <summary>Builds option-id payload for SetVariantsAsync (only product option attributes).</summary>
    private List<IReadOnlyList<(int AttributeDefinitionID, int AttributeOptionID)>> BuildVariantAttributeOptionsPayload()
    {
        var payload = new List<IReadOnlyList<(int, int)>>(_variants.Count);
        var allowedAttrs = _productVariantAttrIds.ToHashSet();
        foreach (var v in _variants)
        {
            if (!_variantAttrPicks.TryGetValue(v, out var map) || map.Count == 0)
            {
                payload.Add(Array.Empty<(int, int)>());
                continue;
            }
            payload.Add(map
                .Where(kv => allowedAttrs.Contains(kv.Key) && kv.Value > 0)
                .Select(kv => (kv.Key, kv.Value))
                .ToList());
        }
        return payload;
    }

    private static void AttachOptionToDefinition(AttributeDefinition def, AttributeOption option)
    {
        if (def.AttributeOptions.Any(o => o.AttributeOptionID == option.AttributeOptionID))
        {
            var existing = def.AttributeOptions.First(o => o.AttributeOptionID == option.AttributeOptionID);
            existing.Value = option.Value;
            existing.ColorHex = option.ColorHex;
            return;
        }
        def.AttributeOptions.Add(option);
    }

