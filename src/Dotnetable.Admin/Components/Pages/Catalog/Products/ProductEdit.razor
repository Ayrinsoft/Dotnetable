@page "/catalog/products/new"
@page "/catalog/products/{ProductId:int}"
@using Dotnetable.Admin.Components.Pages.Media
@attribute [Authorize(Policy = RoleKeys.ProductsView)]
@inject IProductService ProductService
@inject IProductCategoryService CategoryService
@inject IBrandService BrandService
@inject IAttributeDefinitionService AttributeDefinitionService
@inject ICurrencyConversionService CurrencyConversion
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L
@inject ILanguageService LanguageService

<DNPageTitle Title="@(_isNew ? L["products.new", "New Product"] : L["products.edit", "Edit Product"])" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["products.new", "New Product"] : Model.Title)</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton OnClick="@(() => Nav.NavigateTo("/catalog/products"))">@L["back", "Back"]</MudButton>
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_saving || _prerequisites.Count > 0)">@L["save", "Save"]</MudButton>
            }
        </MudStack>
    </MudStack>

    <DNPrerequisiteAlert Items="_prerequisites" />

    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
        <MudTabs Elevation="0" Rounded="true">
            <MudTabPanel Text="@L["products.general", "General"]">
                <MudGrid Spacing="3" Class="pa-2">
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.body2" Class="mb-1">@L["products.featured_image", "Featured image"]</MudText>
                        <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickFeaturedImageAsync">
                            <div style="aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                                @if (!string.IsNullOrEmpty(_featuredImage?.CNDUrl))
                                {
                                    <img src="@(_featuredImage.ThumbnailCDN ?? _featuredImage.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="9">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="7">
                                <MudTextField @bind-Value="Model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="Model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="Brand" Value="_selectedBrand" ValueChanged="OnBrandChanged"
                                                 Label="@L["brand", "Brand"]" Variant="Variant.Outlined"
                                                 SearchFunc="SearchBrands" ToStringFunc="@(b => b?.Name ?? "")"
                                                 Clearable="false" ResetValueOnEmptyText="true" CoerceText="false"
                                                 Required="true"
                                                 HelperText="@L["products.brand_required_hint", "Required. Type to search brands."]" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="byte" @bind-Value="Model.Status" Label="@L["status", "Status"]" Variant="Variant.Outlined">
                                    <MudSelectItem T="byte" Value="(byte)0">@L["products.draft", "Draft"]</MudSelectItem>
                                    <MudSelectItem T="byte" Value="(byte)1">@L["products.published", "Published"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudAutocomplete T="ProductCategory" Value="_selectedCategory" ValueChanged="OnCategoryChanged"
                                                 Label="@L["products.category", "Category"]" Variant="Variant.Outlined"
                                                 SearchFunc="SearchCategories" ToStringFunc="CategoryPath"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                 HelperText="@L["products.category_hint", "Pick one category. Type to search by name or path (e.g. Digital / Headphones)."]" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Model.ShortDescription" Label="@L["products.short_description", "Short description"]"
                                              Variant="Variant.Outlined" Lines="3" AutoGrow="true" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" @bind-Value="Model.IsCatalogOnly" Label="@L["products.catalog_only", "Catalog only (not purchasable)"]" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" Value="@(_variants.Count > 1)" Disabled="true" Label="@L["products.has_variants", "Has variants"]" Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    @if (_languages.Length > 0)
                    {
                    <MudItem xs="12">
                        <MudExpansionPanels Elevation="0">
                            <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                                </MudText>
                                @foreach (var (code, label) in _languages)
                                {
                                    <MudGrid Spacing="2" Class="mb-1">
                                        <MudItem xs="6">
                                            <MudTextField T="string" Value="@TrTitle(code)" ValueChanged="@(v => SetTrTitle(code, v))"
                                                          Label="@($"{label} — {L["title", "Title"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField T="string" Value="@TrSlug(code)" ValueChanged="@(v => SetTrSlug(code, v))"
                                                          Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField T="string" Value="@TrShort(code)" ValueChanged="@(v => SetTrShort(code, v))"
                                                          Label="@L["products.short_description", "Short description"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    </MudGrid>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.variants", "Variants"]">
                <div class="pa-2">
                    @if (!_isUsdSite && _hasRate)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                            @string.Format(
                                L["products.price_dual_hint", "Site currency is {0}. Enter the local price; USD is converted with rate 1 USD = {1:0.####} {0}. Both values are saved."],
                                _displayCurrency, _usdToCurrency)
                        </MudAlert>
                    }
                    @foreach (var (v, idx) in _variants.Select((v, i) => (v, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="2">
                                    <MudTextField T="string" @bind-Value="v.Sku" Label="@L["variants.sku", "SKU"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                @if (!_isUsdSite && _hasRate)
                                {
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal" Value="@LocalPrice(v)" ValueChanged="@(val => SetLocalPrice(v, val))"
                                                         Label="@($"{L["variants.price", "Price"]} ({_displayCurrency})")"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal" Value="@v.ReferencePriceUsd" ValueChanged="@(val => SetUsdPrice(v, val))"
                                                         Label="@L["variants.price_usd", "Price (USD)"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal?" Value="@LocalCompareAt(v)" ValueChanged="@(val => SetLocalCompareAt(v, val))"
                                                         Label="@($"{L["variants.compare_price", "Compare at"]} ({_displayCurrency})")"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal?" Value="@v.CompareAtPriceUsd" ValueChanged="@(val => SetUsdCompareAt(v, val))"
                                                         Label="@L["variants.compare_usd", "Compare at (USD)"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal" @bind-Value="v.ReferencePriceUsd"
                                                         Label="@L["variants.price", "Price (USD)"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal?" @bind-Value="v.CompareAtPriceUsd"
                                                         Label="@L["variants.compare_price", "Compare at (USD)"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                    </MudItem>
                                }
                                <MudItem xs="6" sm="2">
                                    <MudNumericField T="decimal?" @bind-Value="v.Weight" Label="@L["variants.weight", "Weight (kg)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudTextField T="string" @bind-Value="v.Barcode" Label="@L["variants.barcode", "Barcode"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6" sm="1">
                                    <MudCheckBox T="bool" @bind-Value="v.IsDefault" Label="@L["variants.default", "Default"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _variants.RemoveAt(idx))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddVariant">@L["variants.add", "Add variant"]</MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.gallery", "Gallery"]">
                <div class="pa-2">
                    <MudGrid Spacing="2">
                        @foreach (var (entry, idx) in _gallery.Select((g, i) => (g, i)))
                        {
                            <MudItem xs="6" sm="3" md="2">
                                <MudPaper Elevation="0" Class="border rounded-lg pa-1">
                                    <div style="aspect-ratio:1/1; position:relative; overflow:hidden; border-radius:6px;">
                                        <img src="@(entry.File.ThumbnailCDN ?? entry.File.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:cover;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Style="position:absolute; top:2px; right:2px; background:rgba(255,255,255,.8);"
                                                       OnClick="@(() => _gallery.RemoveAt(idx))" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                        <MudItem xs="6" sm="3" md="2">
                            <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center;" @onclick="AddGalleryImageAsync">
                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.attributes", "Attributes"]">
                <div class="pa-2">
                    @foreach (var def in _nonVariantAttributes)
                    {
                        var value = _attrValues.TryGetValue(def.AttributeDefinitionID, out var v) ? v : null;
                        <MudGrid Spacing="2" Class="mb-1" AlignItems="AlignItems.Center">
                            <MudItem xs="12" sm="3">
                                <MudText Typo="Typo.body2">@def.Name @(string.IsNullOrEmpty(def.Unit) ? "" : $"({def.Unit})")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="7">
                                @if (def.InputType is 1 or 2)
                                {
                                    <MudSelect T="int?" Value="@(value?.AttributeOptionID)" ValueChanged="@(o => SetAttrOption(def.AttributeDefinitionID, o))"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                        @foreach (var opt in def.AttributeOptions)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)opt.AttributeOptionID)">@opt.Value</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else if (def.InputType == 3)
                                {
                                    <MudNumericField T="decimal?" Value="@(value?.NumericValue)" ValueChanged="@(n => SetAttrNumeric(def.AttributeDefinitionID, n))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                                else
                                {
                                    <MudTextField T="string" Value="@(value?.CustomValue)" ValueChanged="@(s => SetAttrText(def.AttributeDefinitionID, s))"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                            </MudItem>
                            <MudItem xs="12" sm="2">
                                <MudCheckBox T="bool" Value="@(value?.IsFeatured ?? false)" ValueChanged="@(f => SetAttrFeatured(def.AttributeDefinitionID, f))"
                                             Label="@L["attributes.featured", "Featured"]" Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    }
                    @if (_nonVariantAttributes.Count == 0)
                    {
                        <MudText Color="Color.Secondary">@L["products.no_attributes", "No product-level attributes defined for this website."]</MudText>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.content_sections", "Content"]">
                <div class="pa-2">
                    @foreach (var (section, idx) in _contentSections.Select((s, i) => (s, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="2">
                                    <MudSelect T="byte" @bind-Value="section.SectionType" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["products.section_type", "Type"]">
                                        <MudSelectItem T="byte" Value="(byte)0">@L["products.section_text", "Text"]</MudSelectItem>
                                        <MudSelectItem T="byte" Value="(byte)1">@L["products.section_image", "Image"]</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (section.SectionType == 1)
                                {
                                    <MudItem xs="12" sm="8">
                                        <MudButton StartIcon="@Icons.Material.Filled.Image" OnClick="@(() => PickContentImageAsync(section))">
                                            @(section.File?.CNDUrl is null ? L["select_file", "Select a file"] : L["change", "Change"])
                                        </MudButton>
                                        @if (section.File?.ThumbnailCDN is not null || section.File?.CNDUrl is not null)
                                        {
                                            <img src="@(section.File.ThumbnailCDN ?? section.File.CNDUrl)" style="height:48px; margin-left:8px; border-radius:4px; vertical-align:middle;" />
                                        }
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="section.HtmlContent" Label="@L["products.html_content", "Content (HTML)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" AutoGrow="true" />
                                    </MudItem>
                                }
                                <MudItem xs="6" sm="1">
                                    <MudCheckBox T="bool" @bind-Value="section.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _contentSections.RemoveAt(idx))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _contentSections.Add(new ProductContentSection { IsActive = true, SortOrder = _contentSections.Count }))">
                        @L["products.add_section", "Add section"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.warnings", "Warnings"]">
                <div class="pa-2">
                    @foreach (var (warning, idx) in _warnings.Select((w, i) => (w, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="2">
                                    <MudSelect T="string" @bind-Value="warning.Severity" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["products.severity", "Severity"]">
                                        <MudSelectItem T="string" Value="@("info")">@L["products.severity_info", "Info"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("warning")">@L["products.severity_warning", "Warning"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("danger")">@L["products.severity_danger", "Danger"]</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="7">
                                    <MudTextField @bind-Value="warning.Text" Label="@L["products.warning_text", "Text"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudCheckBox T="bool" @bind-Value="warning.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _warnings.RemoveAt(idx))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _warnings.Add(new ProductWarning { Severity = "info", Text = string.Empty, IsActive = true }))">
                        @L["products.add_warning", "Add warning"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.related", "Related Products"]">
                <div class="pa-2">
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudItem xs="12" sm="8">
                            <MudAutocomplete T="ProductListItemDto" Label="@L["products.search_to_add", "Search a product to add"]" Variant="Variant.Outlined"
                                             SearchFunc="SearchProductsAsync" ToStringFunc="@(p => p?.Title ?? string.Empty)"
                                             ValueChanged="AddRelatedProduct" ResetValueOnEmptyText="true" CoerceText="true" />
                        </MudItem>
                    </MudGrid>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>@L["title", "Title"]</th><th>@L["products.relation_type", "Relation"]</th><th style="width:1%"></th></tr></thead>
                        <tbody>
                            @foreach (var (rel, idx) in _relatedProducts.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td>@RelatedTitle(rel.RelatedProductID)</td>
                                    <td>
                                        <MudSelect T="byte" Value="@rel.RelationType" ValueChanged="@(t => { rel.RelationType = t; })" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem T="byte" Value="(byte)0">@L["products.relation_related", "Related"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)1">@L["products.relation_upsell", "Up-sell"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)2">@L["products.relation_crosssell", "Cross-sell"]</MudSelectItem>
                                        </MudSelect>
                                    </td>
                                    <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _relatedProducts.RemoveAt(idx))" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter] public int? ProductId { get; set; }

    private bool _loading = true, _saving;
    private bool _isNew;
    private bool _isMaster, _canEdit;
    private int _websiteId;
    private int? _memberId;
    private int? _vendorId;
    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();
    private Brand? _selectedBrand;
    private ProductCategory? _selectedCategory;
    private Product Model { get; set; } = new() { IsActive = true };
    private FileRecord? _featuredImage;
    private List<Brand> _brands = new();
    private List<ProductCategory> _categories = new();
    private List<ProductVariant> _variants = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private string _displayCurrency = "USD";
    private decimal _usdToCurrency = 1m;
    private int _localDigits = 0;
    private bool _hasRate;
    private bool _isUsdSite = true;
    private readonly Dictionary<string, (string Title, string Slug, string? Short)> _tr = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<ProductVariant, decimal?> _localCompareAt = new();

    private List<(int MediaSetId, FileRecord File)> _gallery = new();
    private List<AttributeDefinition> _nonVariantAttributes = new();
    private Dictionary<int, ProductAttributeValue> _attrValues = new();
    private List<ProductContentSection> _contentSections = new();
    private List<ProductWarning> _warnings = new();
    private List<ProductRelation> _relatedProducts = new();
    private Dictionary<int, string> _relatedTitles = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, ProductId is null ? RoleKeys.ProductsInsert : RoleKeys.ProductsEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _memberId = mid;
        if (int.TryParse(user.FindFirst(AdminClaimTypes.VendorId)?.Value, out var vendorId))
            _vendorId = vendorId;
        _isNew = ProductId is null;

        if (!_isNew)
        {
            var product = await ProductService.GetByIdAsync(ProductId!.Value);
            if (product is null) { Nav.NavigateTo("/catalog/products"); return; }
            // Vendor members may only open their own products.
            if (_vendorId is not null && _memberId is int ownerId && product.CreatedByMemberId != ownerId)
            {
                Snackbar.Add(L["products.vendor_forbidden", "You can only manage your own products."], Severity.Error);
                Nav.NavigateTo("/catalog/products");
                return;
            }
            Model = product;
            _websiteId = product.WebsiteID;
            _variants = product.ProductVariants.ToList();
            if (product.FeaturedImageFileID is int fid)
                _featuredImage = product.FeaturedImageFile;
            foreach (var t in product.ProductTranslations)
                _tr[t.LanguageCode] = (t.Title, t.Slug, t.ShortDescription);

            _gallery = product.ProductMedia.OrderBy(m => m.SortOrder)
                .Select(m => (m.MediaSetID, m.MediaSet.MediaSetItems.OrderBy(i => i.SortOrder).FirstOrDefault()?.File))
                .Where(e => e.File is not null)
                .Select(e => (e.MediaSetID, e.File!))
                .ToList();
            foreach (var v in product.ProductAttributeValues)
                _attrValues[v.AttributeDefinitionID] = v;
            _contentSections = product.ProductContentSections.OrderBy(s => s.SortOrder).ToList();
            _warnings = product.ProductWarnings.ToList();
            _relatedProducts = product.ProductRelationProducts.ToList();
            foreach (var r in product.ProductRelationProducts)
                if (r.RelatedProduct is not null) _relatedTitles[r.RelatedProductID] = r.RelatedProduct.Title;
        }
        else
        {
            Model.WebsiteID = _websiteId;
        }

        // Master site (website 1) uses per-website language rows like every other site.
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(_websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        _brands = await BrandService.GetAllAsync(_websiteId);
        _categories = await CategoryService.GetAllAsync(_websiteId);

        if (!_isNew)
        {
            if (Model.BrandID is int brandId)
                _selectedBrand = _brands.FirstOrDefault(b => b.BrandID == brandId);
            var primaryMap = Model.ProductCategoryMaps.FirstOrDefault(m => m.IsPrimary)
                             ?? Model.ProductCategoryMaps.FirstOrDefault();
            if (primaryMap is not null)
                _selectedCategory = _categories.FirstOrDefault(c => c.ProductCategoryID == primaryMap.ProductCategoryID);
        }

        await LoadCurrencyAsync();
        SyncVariantLocalPrices();

        _prerequisites = ContentPrerequisiteHelper.ForProducts(L, _brands.Count, _categories.Count, _hasRate ? 1 : 0);

        var allAttrs = await AttributeDefinitionService.GetAllAsync(_websiteId);
        var withOptions = new List<AttributeDefinition>();
        foreach (var a in allAttrs.Where(a => !a.IsVariantAttribute && a.Active))
        {
            var full = await AttributeDefinitionService.GetByIdAsync(a.AttributeDefinitionID);
            withOptions.Add(full ?? a);
        }
        _nonVariantAttributes = withOptions;

        _loading = false;
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var rates = await CurrencyConversion.GetActiveRatesAsync(_websiteId);
            var rate = rates.FirstOrDefault(r => r.IsDefault) ?? rates.FirstOrDefault();
            if (rate is null)
            {
                _hasRate = false;
                _displayCurrency = "USD";
                _usdToCurrency = 1m;
                _isUsdSite = true;
                return;
            }

            _hasRate = true;
            _displayCurrency = rate.CurrencyCode;
            _usdToCurrency = rate.USDToCurrency <= 0 ? 1m : rate.USDToCurrency;
            _localDigits = rate.CurrencyCodeNavigation?.DecimalDigits ?? 0;
            _isUsdSite = string.Equals(_displayCurrency, "USD", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _hasRate = false;
            _isUsdSite = true;
            _displayCurrency = "USD";
            _usdToCurrency = 1m;
            _localDigits = 2;
        }
    }

    private void SyncVariantLocalPrices()
    {
        if (_isUsdSite || !_hasRate) return;
        foreach (var v in _variants)
        {
            if (v.OverridePrice is null or 0)
                v.OverridePrice = RoundLocal(v.ReferencePriceUsd * _usdToCurrency);
            if (v.CompareAtPriceUsd is decimal cmp)
                _localCompareAt[v] = RoundLocal(cmp * _usdToCurrency);
        }
    }

    private decimal RoundLocal(decimal amount) => Math.Round(amount, _localDigits, MidpointRounding.AwayFromZero);
    private decimal RoundUsd(decimal amount) => Math.Round(amount, 4, MidpointRounding.AwayFromZero);

    private decimal LocalPrice(ProductVariant v) =>
        v.OverridePrice ?? (_hasRate && !_isUsdSite ? RoundLocal(v.ReferencePriceUsd * _usdToCurrency) : v.ReferencePriceUsd);

    private decimal? LocalCompareAt(ProductVariant v)
    {
        if (_localCompareAt.TryGetValue(v, out var local)) return local;
        if (v.CompareAtPriceUsd is decimal cmp && _hasRate && !_isUsdSite)
            return RoundLocal(cmp * _usdToCurrency);
        return v.CompareAtPriceUsd;
    }

    private void SetLocalPrice(ProductVariant v, decimal local)
    {
        if (local < 0) local = 0;
        v.OverridePrice = local;
        v.ReferencePriceUsd = _usdToCurrency == 0 ? 0 : RoundUsd(local / _usdToCurrency);
    }

    private void SetUsdPrice(ProductVariant v, decimal usd)
    {
        if (usd < 0) usd = 0;
        v.ReferencePriceUsd = usd;
        if (!_isUsdSite && _hasRate)
            v.OverridePrice = RoundLocal(usd * _usdToCurrency);
    }

    private void SetLocalCompareAt(ProductVariant v, decimal? local)
    {
        _localCompareAt[v] = local;
        if (local is null)
            v.CompareAtPriceUsd = null;
        else
            v.CompareAtPriceUsd = _usdToCurrency == 0 ? 0 : RoundUsd(local.Value / _usdToCurrency);
    }

    private void SetUsdCompareAt(ProductVariant v, decimal? usd)
    {
        v.CompareAtPriceUsd = usd;
        if (usd is null)
            _localCompareAt[v] = null;
        else if (!_isUsdSite && _hasRate)
            _localCompareAt[v] = RoundLocal(usd.Value * _usdToCurrency);
    }

    private Task<IEnumerable<Brand>> SearchBrands(string value, CancellationToken ct)
    {
        IEnumerable<Brand> q = _brands.Where(b => b.IsActive || (_selectedBrand is not null && b.BrandID == _selectedBrand.BrandID))
            .OrderBy(b => b.Name);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(b => b.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || b.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private void OnBrandChanged(Brand? brand) => _selectedBrand = brand;

    private Task<IEnumerable<ProductCategory>> SearchCategories(string value, CancellationToken ct)
    {
        IEnumerable<ProductCategory> q = _categories
            .Where(c => c.IsActive || (_selectedCategory is not null && c.ProductCategoryID == _selectedCategory.ProductCategoryID))
            .OrderBy(c => CategoryPath(c), StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || CategoryPath(c).Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private string CategoryPath(ProductCategory? category)
    {
        if (category is null) return string.Empty;
        var byId = _categories.ToDictionary(c => c.ProductCategoryID);
        var parts = new List<string> { category.Name };
        var current = category;
        var guard = 0;
        while (current.ParentCategoryID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private void OnCategoryChanged(ProductCategory? category) => _selectedCategory = category;

    private void AddVariant()
    {
        var v = new ProductVariant { IsActive = true, IsDefault = _variants.Count == 0 };
        _variants.Add(v);
    }

    private string TrTitle(string c) => _tr.TryGetValue(c, out var v) ? v.Title : string.Empty;
    private string TrSlug(string c) => _tr.TryGetValue(c, out var v) ? v.Slug : string.Empty;
    private string TrShort(string c) => _tr.TryGetValue(c, out var v) ? v.Short ?? string.Empty : string.Empty;
    private void SetTrTitle(string c, string v) { var cur = _tr.GetValueOrDefault(c); _tr[c] = (v ?? string.Empty, cur.Slug ?? string.Empty, cur.Short); }
    private void SetTrSlug(string c, string v) { var cur = _tr.GetValueOrDefault(c); _tr[c] = (cur.Title ?? string.Empty, v ?? string.Empty, cur.Short); }
    private void SetTrShort(string c, string v) { var cur = _tr.GetValueOrDefault(c); _tr[c] = (cur.Title ?? string.Empty, cur.Slug ?? string.Empty, v); }

