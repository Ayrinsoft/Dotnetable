        if (result is { Canceled: false, Data: FileRecord file })
        {
            var mediaSetId = await ProductService.CreateSimpleMediaSetAsync(_websiteId, file.FileRecordID);
            _gallery.Add((mediaSetId, file));
        }
    }

    private ProductAttributeValue GetOrCreateAttrValue(int attributeDefinitionId)
    {
        if (!_attrValues.TryGetValue(attributeDefinitionId, out var v))
        {
            v = new ProductAttributeValue { ProductID = Model.ProductID, AttributeDefinitionID = attributeDefinitionId };
            _attrValues[attributeDefinitionId] = v;
        }
        return v;
    }

    private void SetAttrOption(int attributeDefinitionId, int? optionId) => GetOrCreateAttrValue(attributeDefinitionId).AttributeOptionID = optionId;
    private void SetAttrNumeric(int attributeDefinitionId, decimal? value) => GetOrCreateAttrValue(attributeDefinitionId).NumericValue = value;
    private void SetAttrText(int attributeDefinitionId, string? value) => GetOrCreateAttrValue(attributeDefinitionId).CustomValue = value;
    private void SetAttrFeatured(int attributeDefinitionId, bool featured) => GetOrCreateAttrValue(attributeDefinitionId).IsFeatured = featured;

    private AttributeOption? GetSelectedAttrOption(AttributeDefinition def, ProductAttributeValue? value) =>
        value?.AttributeOptionID is int id
            ? def.AttributeOptions.FirstOrDefault(o => o.AttributeOptionID == id)
            : null;

    private AttributeOption? GetSelectedVariantAttrOption(ProductVariant variant, AttributeDefinition def)
    {
        if (!_variantAttrOptions.TryGetValue(variant, out var map)
            || !map.TryGetValue(def.AttributeDefinitionID, out var optionId)
            || optionId <= 0)
            return null;
        return def.AttributeOptions.FirstOrDefault(o => o.AttributeOptionID == optionId);
    }

    private void SetVariantAttrOption(ProductVariant variant, int attributeDefinitionId, int? optionId)
    {
        if (!_variantAttrOptions.TryGetValue(variant, out var map))
        {
            map = new Dictionary<int, int>();
            _variantAttrOptions[variant] = map;
        }

        if (optionId is null or <= 0)
            map.Remove(attributeDefinitionId);
        else
            map[attributeDefinitionId] = optionId.Value;
    }

    private static string FormatAttributeOptionLabel(AttributeDefinition def, AttributeOption? option)
    {
        if (option is null) return string.Empty;
        if (def.InputType == 2 && !string.IsNullOrWhiteSpace(option.ColorHex))
            return $"{option.Value} ({option.ColorHex})";
        return option.Value;
    }

    private Task<IEnumerable<AttributeOption>> SearchAttrOptions(AttributeDefinition def, string search, CancellationToken ct)
    {
        IEnumerable<AttributeOption> q = def.AttributeOptions.OrderBy(o => o.SortOrder).ThenBy(o => o.Value);
        if (!string.IsNullOrWhiteSpace(search))
        {
            var needle = search.Trim();
            q = q.Where(o => o.Value.Contains(needle, StringComparison.OrdinalIgnoreCase)
                             || (!string.IsNullOrEmpty(o.ColorHex) && o.ColorHex.Contains(needle, StringComparison.OrdinalIgnoreCase)));
        }
        return Task.FromResult(q);
    }

    private string RelatedTitle(int productId) => _relatedTitles.TryGetValue(productId, out var t) ? t : $"#{productId}";

    private async Task<IEnumerable<ProductListItemDto>> SearchProductsAsync(string search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search)) return Array.Empty<ProductListItemDto>();
        var result = await ProductService.GetPagedAsync(_websiteId, new ProductFilter(), new GridQuery { PageIndex = 1, PageSize = 10 }, search, null, ct);
        return result.Items.Where(p => p.ProductID != Model.ProductID);
    }

    private void AddRelatedProduct(ProductListItemDto? product)
    {
        if (product is null || _relatedProducts.Any(r => r.RelatedProductID == product.ProductID)) return;
        _relatedProducts.Add(new ProductRelation { ProductID = Model.ProductID, RelatedProductID = product.ProductID, RelationType = 0, SortOrder = _relatedProducts.Count });
        _relatedTitles[product.ProductID] = product.Title;
    }

    private bool IsVariantTitleError(ProductVariant v) =>
        _showFieldErrors && string.IsNullOrWhiteSpace(v.Title);

    private bool IsVariantSkuError(ProductVariant v) =>
        _showFieldErrors && string.IsNullOrWhiteSpace(v.Sku);

    private bool IsVariantPriceError(ProductVariant v) =>
        _showFieldErrors && DisplayPrice(v) <= 0;

    /// <summary>Client-side checks before any DB call so incomplete variants/fields never hit SaveChanges.</summary>
    private List<string> ValidateBeforeSave()
    {
        var errors = new List<string>();

        if (_prerequisites.Count > 0)
            errors.Add(L["products.prereq_block", "Finish the setup warnings above before saving."]);

        if (string.IsNullOrWhiteSpace(Model.Title))
            errors.Add(L["products.title_required", "Title is required."]);

        if (_selectedBrand is null)
            errors.Add(L["products.brand_required", "Brand is required. Select a brand before saving."]);

        if (_selectedCategory is null)
            errors.Add(L["products.category_required", "Category is required. Select one category before saving."]);

        if (!_hasRate)
            errors.Add(L["products.rate_required", "Configure an exchange rate before setting product prices."]);

        if (_variants.Count == 0)
            errors.Add(L["variants.at_least_one", "Add at least one variant with SKU and price."]);

        var seenSkus = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < _variants.Count; i++)
        {
            var v = _variants[i];
            var label = string.Format(L["variants.row", "Variant {0}"], i + 1);

            if (string.IsNullOrWhiteSpace(v.Title))
            {
                errors.Add(string.Format(L["variants.title_required_row", "{0}: title is required (e.g. Black T-shirt · Size XL)."], label));
            }
            else if (v.Title.Trim().Length > 200)
            {
                errors.Add(string.Format(L["variants.title_too_long", "{0}: title must be at most 200 characters."], label));
            }

            if (string.IsNullOrWhiteSpace(v.Sku))
            {
                errors.Add(string.Format(L["variants.sku_required_row", "{0}: SKU is required."], label));
            }
            else
            {
                var sku = v.Sku.Trim();
                if (sku.Length > 100)
                    errors.Add(string.Format(L["variants.sku_too_long", "{0}: SKU must be at most 100 characters."], label));
                else if (!seenSkus.Add(sku))
                    errors.Add(string.Format(L["variants.sku_duplicate", "{0}: SKU \"{1}\" is duplicated."], label, sku));
            }

            var price = DisplayPrice(v);
            if (price <= 0)
                errors.Add(string.Format(L["variants.price_required_row", "{0}: price must be greater than zero."], label));

            var cmp = DisplayCompareAt(v);
            if (cmp is decimal c && c > 0 && c < price)
                errors.Add(string.Format(L["variants.compare_below_price", "{0}: compare-at price should be greater than or equal to the sale price."], label));

            var stock = StockOnHand(v);
            if (stock < 0)
                errors.Add(string.Format(L["variants.stock_negative", "{0}: stock cannot be negative."], label));
            if (_stockReserved.TryGetValue(v, out var reserved) && stock < reserved)
                errors.Add(string.Format(
                    L["variants.stock_below_reserved", "{0}: stock ({1}) cannot be below reserved quantity ({2})."],
                    label, stock, reserved));
        }

        if (_variants.Count > 0 && !_variants.Any(v => v.IsDefault))
            errors.Add(L["variants.default_required", "Mark one variant as default."]);

        return errors;
    }

    private async Task SaveAsync()
    {
        _showFieldErrors = true;
        var validation = ValidateBeforeSave();
        if (validation.Count > 0)
        {
            _formErrors = validation.ToArray();
            Snackbar.Add(L["products.fix_invalid", "Please fix the highlighted fields before saving."], Severity.Warning);
            return;
        }

        _formErrors = null;
        if (string.IsNullOrWhiteSpace(Model.Slug)) Model.Slug = Model.Title.Trim();

        // Persist site-currency price (authority) + USD bridge. Catalog OverridePrice unused.
        foreach (var v in _variants)
        {
            v.Title = (v.Title ?? string.Empty).Trim();
            v.Sku = (v.Sku ?? string.Empty).Trim();

            // Re-apply display price so save always matches what the user typed.
            SetDisplayPrice(v, DisplayPrice(v));
            SetDisplayCompareAt(v, DisplayCompareAt(v));

            v.OverridePrice = null;
            v.IsActive = true;
        }

        // Exactly one default when multiple variants exist.
        if (_variants.Count(v => v.IsDefault) != 1)
        {
            foreach (var v in _variants) v.IsDefault = false;
            _variants[0].IsDefault = true;
        }

        Model.WebsiteID = _websiteId;
        Model.BrandID = _selectedBrand!.BrandID;
        Model.HasVariants = _variants.Count > 1;
        if (_isNew && _memberId is int creatorId)
            Model.CreatedByMemberID = creatorId;

        _saving = true;
        try
        {
            if (_isNew)
            {
                var created = await ProductService.CreateAsync(Model);
                Model = created;
            }
            else
            {
                await ProductService.UpdateAsync(Model);
            }

            await ProductService.SetTranslationsAsync(Model.ProductID,
                _tr.Select(kv => new ProductTranslation
                {
                    ProductID = Model.ProductID, LanguageCode = kv.Key,
                    Title = kv.Value.Title, Slug = kv.Value.Slug, ShortDescription = kv.Value.Short,
                    Content = kv.Value.Content,
                    ExpertReview = kv.Value.ExpertReview,
                }).ToList());
            var categoryId = _selectedCategory!.ProductCategoryID;
            await ProductService.SetCategoriesAsync(Model.ProductID, new[] { categoryId }, categoryId);

            // Capture stock by SKU before replace-all variants (new rows get IDs after save).
            var stockBySku = _variants
                .Where(v => !string.IsNullOrWhiteSpace(v.Sku))
                .GroupBy(v => v.Sku.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => StockOnHand(g.First()), StringComparer.OrdinalIgnoreCase);

            await ProductService.SetVariantsAsync(
                Model.ProductID,
                _variants,
                _memberId,
                BuildVariantAttributeOptionsPayload());
            await ProductService.SetMediaAsync(Model.ProductID, _gallery.Select(g => g.MediaSetId).ToList());
            await ProductService.SetAttributeValuesAsync(Model.ProductID, _attrValues.Values.ToList());
            await ProductService.SetWarningsAsync(Model.ProductID, _warnings);
            await ProductService.SetWarrantiesAsync(Model.ProductID, _warranties);
            await ProductService.SetRelatedProductsAsync(Model.ProductID,
                _relatedProducts.Select(r => (r.RelatedProductID, r.RelationType, r.SortOrder)).ToList());

            // Reload children so variant/warranty IDs and price-history buttons stay in sync after save.
            var refreshed = await ProductService.GetByIdAsync(Model.ProductID);
            if (refreshed is not null)
            {
                _variants = refreshed.ProductVariants.ToList();
                CaptureVariantAttributeOptions(_variants);
                SyncVariantLocalPrices();
                _warnings = refreshed.ProductWarnings.ToList();
                _warranties = refreshed.ProductWarranties.OrderBy(w => w.SortOrder).ToList();

                if (_vendorId is not null)
                {
                    // Member seller is a store: stock lives only on their VendorProduct listing.
                    await PersistMemberVendorStockAsync(stockBySku);
                }
                else
                {
                    // Host: stock only via store listings (Display / Member / Site) — no warehouse path.
                    await PersistSellerStocksAsync();
                    await LoadSellerStocksAsync();
                    foreach (var variantId in _variants.Select(v => v.ProductVariantID).Where(id => id != 0).Distinct())
                        await VendorProductService.SyncInventoryOnHandFromListingsAsync(_websiteId, variantId);

                    if (_sellerStocks.Count == 0)
                        Snackbar.Add(L["products.no_store_stock_warn", "No store stock assigned. This product is not sellable until you assign stock to a store on the Seller stock tab."], Severity.Warning);
                }

                await LoadVariantStockAsync(_variants);
            }

            _showFieldErrors = false;
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            if (_isNew) Nav.NavigateTo($"/catalog/products/{Model.ProductID}");
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
