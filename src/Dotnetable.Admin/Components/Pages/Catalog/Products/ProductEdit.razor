        _relatedTitles[product.ProductID] = product.Title;
    }

    private bool IsVariantTitleError(ProductVariant v) =>
        _showFieldErrors && string.IsNullOrWhiteSpace(v.Title);

    private bool IsVariantSkuError(ProductVariant v) =>
