    /// <summary>Site-currency amount → dual store (local authority + USD bridge) for a seller listing.</summary>
    private (decimal Local, decimal Usd) SellerPriceDual(decimal amount)
    {
        if (amount < 0) amount = 0;
        var local = RoundLocal(amount);
        var usd = UseLocalCurrencyInput
            ? (_usdToCurrency == 0 ? 0 : RoundUsd(local / _usdToCurrency))
            : RoundUsd(local);
        return (local, usd);
    }

