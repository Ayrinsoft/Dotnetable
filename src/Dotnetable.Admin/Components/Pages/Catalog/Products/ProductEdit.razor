@page "/catalog/products/new"
@page "/catalog/products/{ProductId:int}"
@using Dotnetable.Admin.Components.Pages.Media
@attribute [Authorize(Policy = RoleKeys.ProductsView)]
@inject IProductService ProductService
@inject IProductCategoryService CategoryService
@inject IBrandService BrandService
@inject IAttributeDefinitionService AttributeDefinitionService
@inject ICurrencyConversionService CurrencyConversion
@inject IVendorProductService VendorProductService
@inject IVendorService VendorService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IPageLocalizer L
@inject ILanguageService LanguageService
@inject IWarrantyService WarrantyService

<DNPageTitle Title="@(_isNew ? L["products.new", "New Product"] : L["products.edit", "Edit Product"])" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["products.new", "New Product"] : Model.Title)</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton OnClick="@(() => Nav.NavigateTo("/catalog/products"))">@L["back", "Back"]</MudButton>
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_saving || _prerequisites.Count > 0)">@L["save", "Save"]</MudButton>
            }
        </MudStack>
    </MudStack>

    <DNPrerequisiteAlert Items="_prerequisites" />
    <DNValidationSummary Errors="_formErrors" />

    <MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
        <MudTabs Elevation="0" Rounded="true">
            <MudTabPanel Text="@L["products.general", "General"]">
                <MudGrid Spacing="3" Class="pa-2">
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.body2" Class="mb-1">@L["products.featured_image", "Featured image"]</MudText>
                        <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickFeaturedImageAsync">
                            <div style="aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                                @if (!string.IsNullOrEmpty(_featuredImage?.CNDUrl))
                                {
                                    <img src="@(_featuredImage.ThumbnailCDN ?? _featuredImage.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="9">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="7">
                                <MudTextField @bind-Value="Model.Title" Label="@L["title", "Title"]" Variant="Variant.Outlined" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="Model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="Brand" Value="_selectedBrand" ValueChanged="OnBrandChanged"
                                                 Label="@L["brand", "Brand"]" Variant="Variant.Outlined"
                                                 SearchFunc="SearchBrands" ToStringFunc="@(b => b?.Name ?? "")"
                                                 Clearable="false" ResetValueOnEmptyText="true" CoerceText="false"
                                                 Required="true"
                                                 HelperText="@L["products.brand_required_hint", "Required. Type to search brands."]" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="byte" @bind-Value="Model.Status" Label="@L["status", "Status"]" Variant="Variant.Outlined">
                                    <MudSelectItem T="byte" Value="(byte)0">@L["products.draft", "Draft"]</MudSelectItem>
                                    <MudSelectItem T="byte" Value="(byte)1">@L["products.published", "Published"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudAutocomplete T="ProductCategory" Value="_selectedCategory" ValueChanged="OnCategoryChanged"
                                                 Label="@L["products.category", "Category"]" Variant="Variant.Outlined"
                                                 SearchFunc="SearchCategories" ToStringFunc="CategoryPath"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                 HelperText="@L["products.category_hint", "Pick one category. Type to search by name or path (e.g. Digital / Headphones)."]" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Model.ShortDescription" Label="@L["products.short_description", "Short description"]"
                                              Variant="Variant.Outlined" Lines="3" AutoGrow="true" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" @bind-Value="Model.IsCatalogOnly" Label="@L["products.catalog_only", "Catalog only (not purchasable)"]" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSwitch T="bool" Value="@(_variants.Count > 1)" Disabled="true" Label="@L["products.has_variants", "Has variants"]" Color="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="byte" Value="Model.ProductType" ValueChanged="OnProductTypeChanged"
                                           Label="@L["products.type", "Product type"]" Variant="Variant.Outlined">
                                    <MudSelectItem T="byte" Value="@((byte)ProductType.Physical)">@L["products.type.physical", "Physical (shipping required)"]</MudSelectItem>
                                    <MudSelectItem T="byte" Value="@((byte)ProductType.DigitalDownload)">@L["products.type.download", "Digital download"]</MudSelectItem>
                                    <MudSelectItem T="byte" Value="@((byte)ProductType.DigitalCode)">@L["products.type.code", "Digital code / license"]</MudSelectItem>
                                    <MudSelectItem T="byte" Value="@((byte)ProductType.DigitalService)">@L["products.type.service", "Digital service / URL"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="d-flex align-center">
                                <MudSwitch T="bool" Value="Model.RequiresShipping" Disabled="true"
                                           Label="@(Model.RequiresShipping
                                               ? L["products.requires_shipping", "Requires shipping / freight"]
                                               : L["products.no_shipping", "No shipping (digital delivery)"])"
                                           Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    @if (_languages.Length > 0)
                    {
                    <MudItem xs="12">
                        <MudExpansionPanels Elevation="0">
                            <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                                </MudText>
                                @foreach (var (code, label) in _languages)
                                {
                                    <MudGrid Spacing="2" Class="mb-1">
                                        <MudItem xs="6">
                                            <MudTextField T="string" Value="@TrTitle(code)" ValueChanged="@(v => SetTrTitle(code, v))"
                                                          Label="@($"{label} — {L["title", "Title"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField T="string" Value="@TrSlug(code)" ValueChanged="@(v => SetTrSlug(code, v))"
                                                          Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField T="string" Value="@TrShort(code)" ValueChanged="@(v => SetTrShort(code, v))"
                                                          Label="@L["products.short_description", "Short description"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    </MudGrid>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            @if (IsDigital)
            {
            <MudTabPanel Text="@L["products.digital", "Digital delivery"]">
                <div class="pa-2">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                        @L["products.digital_hint", "Digital products do not need freight. Use stock -1 on seller listings for unlimited sales (e.g. PDF books)."]
                    </MudAlert>
                    <MudGrid Spacing="3">
                        @if (Model.ProductType == (byte)ProductType.DigitalDownload)
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Model.DigitalDownloadUrl"
                                              Label="@L["products.digital_download_url", "Download URL"]"
                                              Variant="Variant.Outlined"
                                              HelperText="@L["products.digital_download_url_hint", "External link only — the file is not stored on this server (e.g. https://cdn.example.com/book.pdf)."]" />
                            </MudItem>
                        }
                        @if (Model.ProductType == (byte)ProductType.DigitalService)
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Model.DigitalServiceUrl"
                                              Label="@L["products.digital_service_url", "Service URL / path"]"
                                              Variant="Variant.Outlined"
                                              HelperText="@L["products.digital_service_url_hint", "Endpoint or path delivered after purchase (e.g. /api/access/… or https://…)."]" />
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Model.DigitalDeliveryNote" Lines="4" AutoGrow="true"
                                          Label="@L["products.digital_note", "Delivery note / code text"]"
                                          Variant="Variant.Outlined"
                                          HelperText="@L["products.digital_note_hint", "For license codes: the text/code template. For downloads/services: post-purchase instructions."]" />
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>
            }

            <MudTabPanel Text="@L["products.variants", "Variants"]">
                <div class="pa-2">
                    @if (_vendorId is null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                            @L["products.catalog_price_hint", "Price on this tab is the catalog default. Each store sets its own selling price and stock on the Seller stock & prices tab — products without store stock are not sellable."]
                        </MudAlert>
                    }
                    @if (IsDigital)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                            @L["products.unlimited_stock_hint", "Digital: set seller stock to -1 for unlimited quantity (never depletes)."]
                        </MudAlert>
                    }
                    @if (_hasRate && !_isUsdSite)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                            @if (_storePricesInUsd)
                            {
                                @string.Format(
                                    L["products.price_enter_local_and_usd", "Enter prices in {0}. USD is also stored (1 USD = {1} {0}) for multi-currency conversion."],
                                    _displayCurrency, FormatRate(_usdToCurrency))
                            }
                            else
                            {
                                @string.Format(
                                    L["products.price_enter_local_only", "Enter prices in {0} only. Amounts are stored in site currency. Other storefront currencies convert through the USD rate table (1 USD = {1} {0})."],
                                    _displayCurrency, FormatRate(_usdToCurrency))
                            }
                        </MudAlert>
                    }
                    @if (_variantAttributes.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                            @L["variants.attributes_hint", "Pick the option for each variant attribute (color, size, …) on every row. These options identify the variant on the storefront."]
                        </MudAlert>
                    }
                    @foreach (var (v, idx) in _variants.Select((v, i) => (v, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="4" md="3">
                                    <MudTextField T="string" @bind-Value="v.Title" Label="@L["variants.title", "Variant title"]"
                                                  Placeholder="@L["variants.title_placeholder", "e.g. Black T-shirt · Size XL"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="200"
                                                  RequiredError="@L["variants.title_required", "Variant title is required"]"
                                                  Error="@IsVariantTitleError(v)" ErrorText="@L["variants.title_required", "Variant title is required"]" />
                                </MudItem>
                                <MudItem xs="12" sm="4" md="3">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="0">
                                        <MudTextField T="string" @bind-Value="v.Sku" Label="@L["variants.sku", "SKU"]"
                                                      Placeholder="NK-TSH-M-BLK-XL"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="100"
                                                      Class="flex-grow-1"
                                                      RequiredError="@L["variants.sku_required", "SKU is required"]"
                                                      Error="@IsVariantSkuError(v)" ErrorText="@L["variants.sku_required", "SKU is required"]" />
                                        <MudTooltip Text="@L["variants.sku_help_tooltip", "SKU format guide"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary"
                                                           Size="Size.Medium" Class="mt-1"
                                                           aria-label="@L["variants.sku_help_tooltip", "SKU format guide"]"
                                                           OnClick="ShowSkuGuideAsync" />
                                        </MudTooltip>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="6" sm="2" md="2">
                                    <MudNumericField T="decimal" Value="@DisplayPrice(v)" ValueChanged="@(val => SetDisplayPrice(v, val))"
                                                     Label="@PriceFieldLabel"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Immediate="true"
                                                     Required="true"
                                                     Error="@IsVariantPriceError(v)" ErrorText="@L["variants.price_required", "Price must be greater than zero"]" />
                                </MudItem>
                                <MudItem xs="6" sm="2" md="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="0">
                                        <MudNumericField T="decimal?" Value="@DisplayCompareAt(v)" ValueChanged="@(val => SetDisplayCompareAt(v, val))"
                                                         Label="@CompareFieldLabel"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Immediate="true"
                                                         Class="flex-grow-1" />
                                        <MudTooltip Text="@L["variants.compare_help_tooltip", "What is Compare at?"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary"
                                                           Size="Size.Medium" Class="mt-1"
                                                           aria-label="@L["variants.compare_help_tooltip", "What is Compare at?"]"
                                                           OnClick="ShowCompareAtGuideAsync" />
                                        </MudTooltip>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="6" sm="2" md="1">
                                    <MudNumericField T="decimal?" @bind-Value="v.Weight" Label="@L["variants.weight", "Weight (kg)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                                </MudItem>
                                <MudItem xs="6" sm="2" md="2">
                                    <MudTextField T="string" @bind-Value="v.Barcode" Label="@L["variants.barcode", "Barcode"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6" sm="2" md="2">
                                    <MudNumericField T="int" Value="@StockOnHand(v)" ValueChanged="@(val => SetStockOnHand(v, val))"
                                                     Label="@VariantStockLabel"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Min="@(IsDigital ? -1 : 0)" Immediate="true"
                                                     Disabled="@(!_canEdit || IsWarehouseStockReadOnly(v))"
                                                     HelperText="@StockHelper(v)" />
                                </MudItem>
                                <MudItem xs="6" sm="1" md="1">
                                    <MudCheckBox T="bool" @bind-Value="v.IsDefault" Label="@L["variants.default", "Default"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="1" md="1">
                                    <MudStack Row="true" Spacing="0">
                                        @if (v.ProductVariantID != 0)
                                        {
                                            <MudTooltip Text="@L["products.price_history", "Price history"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Primary"
                                                               OnClick="@(() => ShowPriceHistoryAsync(v))" />
                                            </MudTooltip>
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _variants.RemoveAt(idx))" />
                                    </MudStack>
                                </MudItem>
                                @if (_variantAttributes.Count > 0)
                                {
                                    <MudItem xs="12">
                                        <MudGrid Spacing="2">
                                            @foreach (var def in _variantAttributes)
                                            {
                                                <MudItem xs="12" sm="4" md="3">
                                                    <MudAutocomplete T="AttributeOption"
                                                                     Value="@GetSelectedVariantAttrOption(v, def)"
                                                                     ValueChanged="@(o => SetVariantAttrOption(v, def.AttributeDefinitionID, o?.AttributeOptionID))"
                                                                     SearchFunc="@( (s, ct) => SearchAttrOptions(def, s, ct) )"
                                                                     ToStringFunc="@(o => FormatAttributeOptionLabel(def, o))"
                                                                     Label="@def.Name"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                     Clearable="true" Dense="true"
                                                                     Disabled="@(!_canEdit)"
                                                                     CoerceText="false" ResetValueOnEmptyText="true" />
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddVariant">@L["variants.add", "Add variant"]</MudButton>
                </div>
            </MudTabPanel>

            @if (!_isNew && _vendorId is null)
            {
            <MudTabPanel Text="@L["products.seller_stock", "Seller stock & prices"]">
                <div class="pa-2">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @L["products.seller_stock_hint", "Every unit belongs to a store (even a display-name-only store). Register stock once per store here. Inventory total = sum of store stocks. Checkout reserves; payment deducts. Without store stock the product is not sellable."]
                    </MudAlert>

                    <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-3">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["products.seller_stock_add", "Assign listing to a seller"]</MudText>
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <MudItem xs="12" sm="3">
                                <MudAutocomplete T="Vendor" Value="@GetAddSellerVendor()" ValueChanged="OnAddSellerVendorChanged"
                                                 SearchFunc="SearchMarketplaceVendors" ToStringFunc="@(v => v?.Name ?? string.Empty)"
                                                 Label="@L["vendor", "Seller"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Clearable="true" Dense="true" CoerceText="false" ResetValueOnEmptyText="true" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudSelect T="int?" Value="_addSellerVariantId" ValueChanged="OnAddSellerVariantChanged"
                                           Label="@L["variants.title", "Variant"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Clearable="true" Dense="true">
                                    @foreach (var v in _variants.Where(x => x.ProductVariantID != 0))
                                    {
                                        <MudSelectItem T="int?" Value="@v.ProductVariantID">
                                            @(string.IsNullOrWhiteSpace(v.Title) ? v.Sku : $"{v.Title} ({v.Sku})")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudNumericField T="decimal" @bind-Value="_addSellerPrice"
                                                 Label="@PriceFieldLabel" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudNumericField T="int" @bind-Value="_addSellerStock"
                                                 Label="@L["stock", "Stock"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="@(IsDigital ? -1 : 0)"
                                                 HelperText="@(IsDigital ? L["products.unlimited_stock_hint_short", "-1 = unlimited"] : null)" />
                            </MudItem>
                            <MudItem xs="12" sm="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSellerStockAsync"
                                           Disabled="@(!_canEdit || _addSellerVendorId is null || _addSellerVariantId is null)">
                                    @L["products.seller_stock_assign", "Assign"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @if (_sellerStocks.Count == 0)
                    {
                        <MudText Color="Color.Secondary">
                            @L["products.seller_stock_empty", "No seller listings yet. Assign a Display or Member seller above, or add a listing under Catalog → Vendors."]
                        </MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="border rounded-lg">
                            <thead>
                                <tr>
                                    <th>@L["vendor", "Seller"]</th>
                                    <th>@L["variants.title", "Variant"]</th>
                                    <th>@L["sku", "SKU"]</th>
                                    <th style="min-width:130px">@PriceFieldLabel</th>
                                    <th style="min-width:120px">@L["stock", "Stock"]</th>
                                    <th style="min-width:90px">@L["inventory.reserved", "Reserved"]</th>
                                    <th style="min-width:100px">@L["vendors.delivery_days", "Delivery days"]</th>
                                    <th>@L["active", "Active"]</th>
                                    <th style="width:1%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _sellerStocks)
                                {
                                    <tr>
                                        <td>
                                            <MudText Typo="Typo.body2">@row.VendorName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@VendorTypeLabel(row.VendorType)</MudText>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(row.VariantTitle) ? "—" : row.VariantTitle)</td>
                                        <td><code>@row.Sku</code></td>
                                        <td>
                                            <MudNumericField T="decimal" @bind-Value="row.ReferencePrice" Margin="Margin.Dense"
                                                            Variant="Variant.Outlined" Min="0" Disabled="@(!_canEdit || row.IsSiteLinked)"
                                                            Style="max-width:140px"
                                                            HelperText="@(row.OverridePriceLocal is decimal ov ? string.Format(L["products.seller_override_hint", "Promo override: {0}"], ov.ToString("0.##")) : null)" />
                                        </td>
                                        <td>
                                            <MudNumericField T="int" @bind-Value="row.StockQuantity" Margin="Margin.Dense"
                                                            Variant="Variant.Outlined"
                                                            Min="@(IsDigital ? -1 : Math.Max(0, row.QuantityReserved))"
                                                            Disabled="@(!_canEdit || row.IsSiteLinked)"
                                                            Style="max-width:110px"
                                                            HelperText="@(row.StockQuantity < 0
                                                                ? L["products.unlimited", "Unlimited"]
                                                                : (row.QuantityReserved > 0
                                                                    ? string.Format(L["products.seller_available_hint", "Available: {0}"], Math.Max(0, row.StockQuantity - row.QuantityReserved))
                                                                    : null))" />
                                        </td>
                                        <td>@row.QuantityReserved</td>
                                        <td>
                                            <MudNumericField T="int" @bind-Value="row.DeliveryDays" Margin="Margin.Dense"
                                                            Variant="Variant.Outlined" Min="0" Disabled="@(!_canEdit || row.IsSiteLinked)"
                                                            Style="max-width:100px" />
                                        </td>
                                        <td>
                                            <MudSwitch T="bool" @bind-Value="row.IsActive" Color="Color.Primary" Disabled="@(!_canEdit || row.IsSiteLinked)" />
                                        </td>
                                        <td>
                                            @if (_canEdit && !row.IsSiteLinked)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => RemoveSellerStockAsync(row))" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            </MudTabPanel>
            }

            <MudTabPanel Text="@L["products.gallery", "Gallery"]">
                <div class="pa-2">
                    <MudGrid Spacing="2">
                        @foreach (var (entry, idx) in _gallery.Select((g, i) => (g, i)))
                        {
                            <MudItem xs="6" sm="3" md="2">
                                <MudPaper Elevation="0" Class="border rounded-lg pa-1">
                                    <div style="aspect-ratio:1/1; position:relative; overflow:hidden; border-radius:6px;">
                                        <img src="@(entry.File.ThumbnailCDN ?? entry.File.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:cover;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Style="position:absolute; top:2px; right:2px; background:rgba(255,255,255,.8);"
                                                       OnClick="@(() => _gallery.RemoveAt(idx))" />
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                        <MudItem xs="6" sm="3" md="2">
                            <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center;" @onclick="AddGalleryImageAsync">
                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.attributes", "Attributes"]">
                <div class="pa-2">
                    @foreach (var def in _nonVariantAttributes)
                    {
                        var value = _attrValues.TryGetValue(def.AttributeDefinitionID, out var v) ? v : null;
                        <MudGrid Spacing="2" Class="mb-1" AlignItems="AlignItems.Center">
                            <MudItem xs="12" sm="3">
                                <MudText Typo="Typo.body2">@def.Name @(string.IsNullOrEmpty(def.Unit) ? "" : $"({def.Unit})")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="7">
                                @if (def.InputType is 1 or 2)
                                {
                                    <MudAutocomplete T="AttributeOption"
                                                     Value="@GetSelectedAttrOption(def, value)"
                                                     ValueChanged="@(o => SetAttrOption(def.AttributeDefinitionID, o?.AttributeOptionID))"
                                                     SearchFunc="@( (s, ct) => SearchAttrOptions(def, s, ct) )"
                                                     ToStringFunc="@(o => o?.Value ?? string.Empty)"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Clearable="true" Dense="true"
                                                     CoerceText="false" ResetValueOnEmptyText="true" />
                                }
                                else if (def.InputType == 3)
                                {
                                    <MudNumericField T="decimal?" Value="@(value?.NumericValue)" ValueChanged="@(n => SetAttrNumeric(def.AttributeDefinitionID, n))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                                else
                                {
                                    <MudTextField T="string" Value="@(value?.CustomValue)" ValueChanged="@(s => SetAttrText(def.AttributeDefinitionID, s))"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                            </MudItem>
                            <MudItem xs="12" sm="2">
                                <MudCheckBox T="bool" Value="@(value?.IsFeatured ?? false)" ValueChanged="@(f => SetAttrFeatured(def.AttributeDefinitionID, f))"
                                             Label="@L["attributes.featured", "Featured"]" Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    }
                    @if (_nonVariantAttributes.Count == 0)
                    {
                        <MudText Color="Color.Secondary">@L["products.no_attributes", "No product-level attributes defined for this website."]</MudText>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.content", "Content"]">
                <div class="pa-2">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @L["products.content_hint", "One rich description per product (like posts). Format text and insert images inside the editor — they appear on the product page as written."]
                    </MudAlert>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["products.content", "Content"]</MudText>
                        <ContentMediaInsertButton WebsiteId="_websiteId"
                                                  CurrentHtml="@(Model.Content ?? "")"
                                                  HtmlChanged="OnMainContentMediaInserted" />
                    </MudStack>
                    <DNCkEditor @key="_mainEditorVersion"
                                ContentLanguage="@_defaultLanguageCode"
                                Value="@(Model.Content ?? "")"
                                OnValueChanged="@(v => Model.Content = v)" />

                    @if (_languages.Length > 0)
                    {
                        <MudExpansionPanels Elevation="0" Class="mt-4">
                            <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    @L["products.content_tr_hint", "Optional localized body. Leave blank to use the default-language content."]
                                </MudText>
                                @foreach (var (code, label) in _languages)
                                {
                                    <MudPaper Elevation="0" Class="pa-3 mb-2 border rounded-lg">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">@label</MudText>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["products.content", "Content"]</MudText>
                                            <ContentMediaInsertButton WebsiteId="_websiteId"
                                                                      CurrentHtml="@TrContent(code)"
                                                                      HtmlChanged="@(html => OnTranslationContentMediaInserted(code, html))" />
                                        </MudStack>
                                        <DNCkEditor @key="@($"{code}_{TranslationEditorVersion(code)}")"
                                                    ContentLanguage="@(code)"
                                                    Value="@TrContent(code)"
                                                    OnValueChanged="@(v => SetTrContent(code, v))" />
                                    </MudPaper>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.expert_review", "Expert review"]">
                <div class="pa-2">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @L["products.expert_review_hint", "Optional expert/technical review for this product. Same editor as the introduction content — format text and insert images as needed."]
                    </MudAlert>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["products.expert_review", "Expert review"]</MudText>
                        <ContentMediaInsertButton WebsiteId="_websiteId"
                                                  CurrentHtml="@(Model.ExpertReview ?? "")"
                                                  HtmlChanged="OnMainExpertReviewMediaInserted" />
                    </MudStack>
                    <DNCkEditor @key="_mainExpertReviewEditorVersion"
                                ContentLanguage="@_defaultLanguageCode"
                                Value="@(Model.ExpertReview ?? "")"
                                OnValueChanged="@(v => Model.ExpertReview = v)" />

                    @if (_languages.Length > 0)
                    {
                        <MudExpansionPanels Elevation="0" Class="mt-4">
                            <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    @L["products.expert_review_tr_hint", "Optional localized expert review. Leave blank to use the default-language text."]
                                </MudText>
                                @foreach (var (code, label) in _languages)
                                {
                                    <MudPaper Elevation="0" Class="pa-3 mb-2 border rounded-lg">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">@label</MudText>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["products.expert_review", "Expert review"]</MudText>
                                            <ContentMediaInsertButton WebsiteId="_websiteId"
                                                                      CurrentHtml="@TrExpertReview(code)"
                                                                      HtmlChanged="@(html => OnTranslationExpertReviewMediaInserted(code, html))" />
                                        </MudStack>
                                        <DNCkEditor @key="@($"er_{code}_{TranslationExpertReviewEditorVersion(code)}")"
                                                    ContentLanguage="@(code)"
                                                    Value="@TrExpertReview(code)"
                                                    OnValueChanged="@(v => SetTrExpertReview(code, v))" />
                                    </MudPaper>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.warnings", "Warnings"]">
                <div class="pa-2">
                    @foreach (var (warning, idx) in _warnings.Select((w, i) => (w, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="2">
                                    <MudSelect T="string" @bind-Value="warning.Severity" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["products.severity", "Severity"]">
                                        <MudSelectItem T="string" Value="@("info")">@L["products.severity_info", "Info"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("warning")">@L["products.severity_warning", "Warning"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("danger")">@L["products.severity_danger", "Danger"]</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="7">
                                    <MudTextField @bind-Value="warning.Text" Label="@L["products.warning_text", "Text"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudCheckBox T="bool" @bind-Value="warning.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _warnings.RemoveAt(idx))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _warnings.Add(new ProductWarning { Severity = "info", Text = string.Empty, IsActive = true }))">
                        @L["products.add_warning", "Add warning"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.warranties", "Warranties"]">
                <div class="pa-2">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @L["products.warranties_hint", "Optional. Pick a plan from Catalog → Warranties, or enter free text for seller/non-company warranties. Leave empty if the product has no warranty."]
                    </MudAlert>
                    @foreach (var (row, idx) in _warranties.Select((w, i) => (w, i)))
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3 mb-2">
                            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="4">
                                    <MudAutocomplete T="Warranty" Value="@GetSelectedWarranty(row)" ValueChanged="@(plan => OnWarrantyCatalogChanged(row, plan))"
                                                     Label="@L["products.warranty_plan", "Catalog plan"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     SearchFunc="@( (value, ct) => SearchWarranties(value, row, ct) )"
                                                     ToStringFunc="WarrantyDisplay"
                                                     Clearable="true" Dense="true"
                                                     ResetValueOnEmptyText="true" CoerceText="false"
                                                     HelperText="@L["products.warranty_plan_hint", "Type to search registered warranties. Clear for custom text only."]" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="row.CustomTitle" Label="@L["products.warranty_custom_title", "Custom title / override"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  HelperText="@L["products.warranty_custom_title_hint", "Required if no catalog plan. Optional override when a plan is selected."]" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudCheckBox T="bool" @bind-Value="row.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6" sm="2" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _warranties.RemoveAt(idx))" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="row.CustomDescription" Label="@L["products.warranty_notes", "Description / notes"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                                  HelperText="@L["products.warranty_notes_hint", "Extra terms or full text for non-catalog warranties."]" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddWarrantyRow">
                        @L["products.add_warranty", "Add warranty"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@L["products.related", "Related Products"]">
                <div class="pa-2">
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudItem xs="12" sm="8">
                            <MudAutocomplete T="ProductListItemDto" Label="@L["products.search_to_add", "Search a product to add"]" Variant="Variant.Outlined"
                                             SearchFunc="SearchProductsAsync" ToStringFunc="@(p => p?.Title ?? string.Empty)"
                                             ValueChanged="AddRelatedProduct" ResetValueOnEmptyText="true" CoerceText="true" />
                        </MudItem>
                    </MudGrid>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>@L["title", "Title"]</th><th>@L["products.relation_type", "Relation"]</th><th style="width:1%"></th></tr></thead>
                        <tbody>
                            @foreach (var (rel, idx) in _relatedProducts.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td>@RelatedTitle(rel.RelatedProductID)</td>
                                    <td>
                                        <MudSelect T="byte" Value="@rel.RelationType" ValueChanged="@(t => { rel.RelationType = t; })" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem T="byte" Value="(byte)0">@L["products.relation_related", "Related"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)1">@L["products.relation_upsell", "Up-sell"]</MudSelectItem>
                                            <MudSelectItem T="byte" Value="(byte)2">@L["products.relation_crosssell", "Cross-sell"]</MudSelectItem>
                                        </MudSelect>
                                    </td>
                                    <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _relatedProducts.RemoveAt(idx))" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter] public int? ProductId { get; set; }

    private bool _loading = true, _saving;
    private bool _isNew;
    private bool _isMaster, _canEdit;
    private string[]? _formErrors;
    private bool _showFieldErrors;
    private int _websiteId;
    private int? _memberId;
    private int? _vendorId;
    private string _defaultLanguageCode = "en";
    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();
    private Brand? _selectedBrand;
    private ProductCategory? _selectedCategory;
    private Product Model { get; set; } = new() { IsActive = true, ProductType = (byte)ProductType.Physical, RequiresShipping = true };
    private FileRecord? _featuredImage;
    private bool IsDigital => Model.ProductType != (byte)ProductType.Physical;
    private List<Brand> _brands = new();
    private List<ProductCategory> _categories = new();
    private List<ProductVariant> _variants = new();
    private List<DNPrerequisiteAlert.Item> _prerequisites = new();
    private string _displayCurrency = "USD";
    private decimal _usdToCurrency = 1m;
    private int _localDigits = 0;
    private bool _hasRate;
    private bool _isUsdSite = true;
    private bool _storePricesInUsd;
    private readonly Dictionary<string, (string Title, string Slug, string? Short, string? Content, string? ExpertReview)> _tr = new(StringComparer.OrdinalIgnoreCase);
    private int _mainEditorVersion;
    private int _mainExpertReviewEditorVersion;
    private readonly Dictionary<string, int> _translationEditorVersions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _translationExpertReviewEditorVersions = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>Session-only site-currency edit buffers. <see cref="ProductVariant.ReferencePrice"/> is the persisted authority.</summary>
    private readonly Dictionary<ProductVariant, decimal> _localPrice = new();
    private readonly Dictionary<ProductVariant, decimal?> _localCompareAt = new();
    /// <summary>On-hand stock per variant: member-vendor listing, or host total of store listings (read-only on host).</summary>
    private readonly Dictionary<ProductVariant, int> _stockOnHand = new();
    /// <summary>Reserved quantity (read-only hint) loaded from inventory; sales already hold this stock.</summary>
    private readonly Dictionary<ProductVariant, int> _stockReserved = new();
    /// <summary>Per-seller marketplace stock rows (VendorProduct) for this product — Display/Member vendors.</summary>
    private List<SellerStockEditRow> _sellerStocks = new();
    private List<Vendor> _marketplaceVendors = new();
    private int? _addSellerVendorId;
    private int? _addSellerVariantId;
    private decimal _addSellerPrice;
    private int _addSellerStock;

    private List<(int MediaSetId, FileRecord File)> _gallery = new();
    private List<AttributeDefinition> _nonVariantAttributes = new();
    /// <summary>Active catalog attributes marked as variant (color, size, …) — option pickers on each variant row.</summary>
    private List<AttributeDefinition> _variantAttributes = new();
    /// <summary>
    /// Session-only option picks per variant (defId → optionId). Kept off the EF graph until SetVariantsAsync
    /// so UpdateAsync does not try to insert partial VariantAttributeValue rows.
    /// </summary>
    private readonly Dictionary<ProductVariant, Dictionary<int, int>> _variantAttrOptions = new();
    private Dictionary<int, ProductAttributeValue> _attrValues = new();
    private List<ProductWarning> _warnings = new();
    private List<ProductWarranty> _warranties = new();
    private List<Warranty> _warrantyCatalog = new();
    private List<ProductRelation> _relatedProducts = new();
    private Dictionary<int, string> _relatedTitles = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canEdit = AdminPolicies.Allows(user, ProductId is null ? RoleKeys.ProductsInsert : RoleKeys.ProductsEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid))
            _memberId = mid;
        if (int.TryParse(user.FindFirst(AdminClaimTypes.VendorId)?.Value, out var vendorId))
            _vendorId = vendorId;
        _isNew = ProductId is null;

        if (!_isNew)
        {
            var product = await ProductService.GetByIdAsync(ProductId!.Value);
            if (product is null) { Nav.NavigateTo("/catalog/products"); return; }
            // Vendor members may only open their own products.
            if (_vendorId is not null && _memberId is int ownerId && product.CreatedByMemberID != ownerId)
            {
                Snackbar.Add(L["products.vendor_forbidden", "You can only manage your own products."], Severity.Error);
                Nav.NavigateTo("/catalog/products");
                return;
            }
            Model = product;
            _websiteId = product.WebsiteID;
            _variants = product.ProductVariants.ToList();
            CaptureVariantAttributeOptions(_variants);
            if (_vendorId is null)
                await LoadSellerStocksAsync();
            await LoadVariantStockAsync(_variants);
            if (product.FeaturedImageFileID is int fid)
                _featuredImage = product.FeaturedImageFile;
            foreach (var t in product.ProductTranslations)
                _tr[t.LanguageCode] = (t.Title, t.Slug, t.ShortDescription, t.Content, t.ExpertReview);

            _gallery = product.ProductMedia.OrderBy(m => m.SortOrder)
                .Select(m => (m.MediaSetID, m.MediaSet.MediaSetItems.OrderBy(i => i.SortOrder).FirstOrDefault()?.File))
                .Where(e => e.File is not null)
                .Select(e => (e.MediaSetID, e.File!))
                .ToList();
            foreach (var v in product.ProductAttributeValues)
                _attrValues[v.AttributeDefinitionID] = v;
            _warnings = product.ProductWarnings.ToList();
            _warranties = product.ProductWarranties.OrderBy(w => w.SortOrder).ToList();
            _relatedProducts = product.ProductRelationProducts.ToList();
            foreach (var r in product.ProductRelationProducts)
                if (r.RelatedProduct is not null) _relatedTitles[r.RelatedProductID] = r.RelatedProduct.Title;
        }
        else
        {
            Model.WebsiteID = _websiteId;
            // New products start with one blank variant so price/SKU are always visible.
            if (_variants.Count == 0)
                AddVariant();
        }

        // Master site (website 1) uses per-website language rows like every other site.
        var activeLangs = await LanguageService.GetActiveForWebsiteAsync(_websiteId);
        _defaultLanguageCode = activeLangs.FirstOrDefault(l => l.IsDefault)?.LanguageCode
            ?? activeLangs.FirstOrDefault()?.LanguageCode
            ?? "en";
        _languages = activeLangs.Where(l => !l.IsDefault)
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        _brands = await BrandService.GetAllAsync(_websiteId);
        _categories = await CategoryService.GetAllAsync(_websiteId);
        // Load all plans so inactive ones already linked to the product still resolve in the autocomplete.
        _warrantyCatalog = await WarrantyService.GetAllAsync(_websiteId, activeOnly: false);
        if (_vendorId is null)
        {
            // Display + Member sellers only (site-link stock lives on the source website inventory).
            _marketplaceVendors = (await VendorService.GetAllAsync(_websiteId))
                .Where(v => v.IsActive && v.VendorType != (byte)VendorType.Site)
                .OrderBy(v => v.Name)
                .ToList();
        }

        if (!_isNew)
        {
            if (Model.BrandID is int brandId)
                _selectedBrand = _brands.FirstOrDefault(b => b.BrandID == brandId);
            var primaryMap = Model.ProductCategoryMaps.FirstOrDefault(m => m.IsPrimary)
                             ?? Model.ProductCategoryMaps.FirstOrDefault();
            if (primaryMap is not null)
                _selectedCategory = _categories.FirstOrDefault(c => c.ProductCategoryID == primaryMap.ProductCategoryID);
        }

        await LoadCurrencyAsync();
        SyncVariantLocalPrices();

        _prerequisites = ContentPrerequisiteHelper.ForProducts(L, _brands.Count, _categories.Count, _hasRate ? 1 : 0);

        var allAttrs = await AttributeDefinitionService.GetAllAsync(_websiteId);
        var productLevel = new List<AttributeDefinition>();
        var variantLevel = new List<AttributeDefinition>();
        foreach (var a in allAttrs.Where(a => a.Active))
        {
            var full = await AttributeDefinitionService.GetByIdAsync(a.AttributeDefinitionID) ?? a;
            // Variant attributes store an option ID only (select/color). Skip free-text/numeric defs here.
            if (a.IsVariantAttribute)
            {
                if (full.InputType is 1 or 2)
                    variantLevel.Add(full);
            }
            else
            {
                productLevel.Add(full);
            }
        }
        _nonVariantAttributes = productLevel.OrderBy(a => a.SortOrder).ThenBy(a => a.Name).ToList();
        _variantAttributes = variantLevel.OrderBy(a => a.SortOrder).ThenBy(a => a.Name).ToList();

        _loading = false;
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            _storePricesInUsd = await CurrencyConversion.GetStorePricesInUsdAsync(_websiteId);
            var rates = await CurrencyConversion.GetActiveRatesAsync(_websiteId);
            var rate = rates.FirstOrDefault(r => r.IsDefault) ?? rates.FirstOrDefault();
            if (rate is null)
            {
                _hasRate = false;
                _displayCurrency = "USD";
                _usdToCurrency = 1m;
                _isUsdSite = true;
                return;
            }

            _hasRate = true;
            _displayCurrency = rate.CurrencyCode;
            _usdToCurrency = rate.USDToCurrency <= 0 ? 1m : rate.USDToCurrency;
            _localDigits = rate.CurrencyCodeNavigation?.DecimalDigits ?? 0;
            _isUsdSite = string.Equals(_displayCurrency, "USD", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _hasRate = false;
            _isUsdSite = true;
            _displayCurrency = "USD";
            _usdToCurrency = 1m;
            _localDigits = 2;
        }
    }

    private void SyncVariantLocalPrices()
    {
        foreach (var v in _variants)
        {
            // Prefer stored site-currency price (no rate drift); fall back to USD × rate for legacy rows.
            if (v.ReferencePrice > 0)
                _localPrice[v] = RoundLocal(v.ReferencePrice);
            else if (!_isUsdSite && _hasRate)
                _localPrice[v] = RoundLocal(v.ReferencePriceUsd * _usdToCurrency);
            else
                _localPrice[v] = RoundLocal(v.ReferencePriceUsd);

            if (v.CompareAtPrice is decimal cmpLocal && cmpLocal > 0)
                _localCompareAt[v] = RoundLocal(cmpLocal);
            else if (v.CompareAtPriceUsd is decimal cmpUsd && !_isUsdSite && _hasRate)
                _localCompareAt[v] = RoundLocal(cmpUsd * _usdToCurrency);
            else
                _localCompareAt[v] = v.CompareAtPriceUsd;
        }
    }

    private decimal RoundLocal(decimal amount) => Math.Round(amount, _localDigits, MidpointRounding.AwayFromZero);
    private decimal RoundUsd(decimal amount) => Math.Round(amount, 4, MidpointRounding.AwayFromZero);

    private static string FormatRate(decimal rate) =>
        rate >= 1 ? rate.ToString("N2") : rate.ToString("0.######");

    /// <summary>Single price label: "Price (IRR)" or "Price (USD)" — never both.</summary>
    private string PriceFieldLabel =>
        string.Format(L["variants.price_in_currency", "Price ({0})"], _displayCurrency);

    /// <summary>Optional strikethrough/list price in the same site currency only.</summary>
    private string CompareFieldLabel =>
        string.Format(L["variants.compare_in_currency", "Compare at ({0})"], _displayCurrency);

    private bool UseLocalCurrencyInput => !_isUsdSite && _hasRate;

    /// <summary>The one editable amount the admin types — always in site display currency.</summary>
    private decimal DisplayPrice(ProductVariant v)
    {
        if (_localPrice.TryGetValue(v, out var local)) return local;
        if (v.ReferencePrice > 0) return RoundLocal(v.ReferencePrice);
        if (!UseLocalCurrencyInput) return v.ReferencePriceUsd;
        return RoundLocal(v.ReferencePriceUsd * _usdToCurrency);
    }

    private decimal? DisplayCompareAt(ProductVariant v)
    {
        if (_localCompareAt.TryGetValue(v, out var local)) return local;
        if (v.CompareAtPrice is decimal cmp) return RoundLocal(cmp);
        if (!UseLocalCurrencyInput) return v.CompareAtPriceUsd;
        if (v.CompareAtPriceUsd is decimal cmpUsd)
            return RoundLocal(cmpUsd * _usdToCurrency);
        return null;
    }

    private void SetDisplayPrice(ProductVariant v, decimal amount)
    {
        if (amount < 0) amount = 0;
        _localPrice[v] = amount;
        // Site currency is the stored authority.
        v.ReferencePrice = RoundLocal(amount);
        // Always maintain USD bridge (required for multi-currency display); dual-store flag is website-level policy.
        v.ReferencePriceUsd = UseLocalCurrencyInput
            ? (_usdToCurrency == 0 ? 0 : RoundUsd(amount / _usdToCurrency))
            : RoundUsd(amount);
    }

    private void SetDisplayCompareAt(ProductVariant v, decimal? amount)
    {
        if (amount is < 0) amount = 0;
        _localCompareAt[v] = amount;
        v.CompareAtPrice = amount is null ? null : RoundLocal(amount.Value);
        if (amount is null)
            v.CompareAtPriceUsd = null;
        else if (UseLocalCurrencyInput)
            v.CompareAtPriceUsd = _usdToCurrency == 0 ? null : RoundUsd(amount.Value / _usdToCurrency);
        else
            v.CompareAtPriceUsd = amount;
    }

