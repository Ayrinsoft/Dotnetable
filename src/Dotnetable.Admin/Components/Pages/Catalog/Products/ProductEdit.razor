    /// <summary>
    /// When both seller and variant are chosen, load the existing listing into price/stock (if any);
    /// otherwise seed price from the catalog variant and stock 0 for a new assign.
    /// </summary>
    private async Task SyncAddSellerFormFromSelectionAsync()
    {
        _addSellerExistingId = null;

        if (_addSellerVendorId is not int vendorId || _addSellerVariantId is not int variantId)
        {
            if (_addSellerVariantId is int onlyVariantId)
            {
                var v = _variants.FirstOrDefault(x => x.ProductVariantID == onlyVariantId);
                if (v is not null) _addSellerPrice = DisplayPrice(v);
            }
            return;
        }

        // Prefer in-memory grid (already loaded for this product).
        var row = _sellerStocks.FirstOrDefault(r => r.VendorID == vendorId && r.ProductVariantID == variantId);
        if (row is not null)
        {
            _addSellerExistingId = row.VendorProductID;
            _addSellerPrice = row.ReferencePrice;
            _addSellerStock = row.StockQuantity;
            return;
        }

        // Fallback: DB lookup (e.g. stale UI after external change).
        var listing = await VendorProductService.FindAsync(vendorId, variantId);
        if (listing is not null)
        {
            _addSellerExistingId = listing.VendorProductID;
            var local = listing.OverridePriceLocal is decimal ov && ov > 0
                ? ov
                : (listing.ReferencePrice > 0 ? listing.ReferencePrice : listing.ReferencePriceUsd);
            _addSellerPrice = RoundLocal(local);
            _addSellerStock = listing.StockQuantity;
            return;
        }

        // New listing: seed price from catalog variant.
        var variant = _variants.FirstOrDefault(v => v.ProductVariantID == variantId);
        _addSellerPrice = variant is not null ? DisplayPrice(variant) : 0;
        _addSellerStock = 0;
    }

    /// <summary>Site-currency amount → dual store (local authority + USD bridge) for a seller listing.</summary>
    private (decimal Local, decimal Usd) SellerPriceDual(decimal amount)
    {
        if (amount < 0) amount = 0;
        var local = RoundLocal(amount);
        var usd = UseLocalCurrencyInput
            ? (_usdToCurrency == 0 ? 0 : RoundUsd(local / _usdToCurrency))
            : RoundUsd(local);
        return (local, usd);
    }

