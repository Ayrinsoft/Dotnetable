    private void CaptureVariantAttributeOptions(IEnumerable<ProductVariant> variants)
    {
        _variantAttrOptions.Clear();
        foreach (var v in variants)
        {
            var map = new Dictionary<int, int>();
            foreach (var a in v.VariantAttributeValues)
            {
                if (a.AttributeDefinitionID > 0 && a.AttributeOptionID > 0)
                    map[a.AttributeDefinitionID] = a.AttributeOptionID;
            }
            _variantAttrOptions[v] = map;
        }
    }

    /// <summary>Index-aligned option lists for SetVariantsAsync (keeps picks off the EF graph).</summary>
    private List<IReadOnlyList<(int AttributeDefinitionID, int AttributeOptionID)>> BuildVariantAttributeOptionsPayload()
    {
        var payload = new List<IReadOnlyList<(int, int)>>(_variants.Count);
        foreach (var v in _variants)
        {
            var map = _variantAttrOptions.TryGetValue(v, out var m) ? m : null;
            if (map is null || map.Count == 0)
            {
                payload.Add(Array.Empty<(int, int)>());
                continue;
            }

            payload.Add(map
                .Where(kv => kv.Key > 0 && kv.Value > 0)
                .Select(kv => (kv.Key, kv.Value))
                .ToList());
        }
        return payload;
    }

    private async Task LoadVariantStockAsync(IReadOnlyList<ProductVariant> variants)
    {
        _stockOnHand.Clear();
        _stockReserved.Clear();

        // Member vendors: stock lives on their VendorProduct listing, not shared warehouse inventory.
        if (_vendorId is int vendorId)
        {
            foreach (var v in variants)
            {
                if (v.ProductVariantID == 0)
                {
                    _stockOnHand[v] = 0;
                    _stockReserved[v] = 0;
                    continue;
                }
                var listing = await VendorProductService.FindAsync(vendorId, v.ProductVariantID);
                _stockOnHand[v] = listing?.StockQuantity ?? 0;
                _stockReserved[v] = listing?.QuantityReserved ?? 0;
            }
            return;
        }

        // Host admin: stock is always the sum of store listings (0 when no store assigned ⇒ not sellable).
        foreach (var v in variants)
        {
            if (v.ProductVariantID == 0)
            {
                _stockOnHand[v] = 0;
                _stockReserved[v] = 0;
                continue;
            }
            var rows = _sellerStocks.Where(r => r.ProductVariantID == v.ProductVariantID).ToList();
            _stockOnHand[v] = rows.Sum(r => r.StockQuantity);
            _stockReserved[v] = rows.Sum(r => r.QuantityReserved);
        }
    }

    private async Task LoadSellerStocksAsync()
    {
        if (Model.ProductID == 0)
        {
            _sellerStocks = new();
            return;
        }

        var listings = await VendorProductService.GetByProductIdAsync(Model.ProductID);
        _sellerStocks = listings.Select(x => new SellerStockEditRow
        {
            VendorProductID = x.VendorProductID,
            VendorID = x.VendorID,
            VendorName = x.VendorName,
            VendorType = x.VendorType,
            ProductVariantID = x.ProductVariantID,
            VariantTitle = x.VariantTitle,
            Sku = x.Sku,
            StockQuantity = x.StockQuantity,
            QuantityReserved = x.QuantityReserved,
            DeliveryDays = x.DeliveryDays,
            // Effective listing price in site currency (override wins when set).
            ReferencePrice = RoundLocal(
                x.OverridePriceLocal is decimal ov && ov > 0
                    ? ov
                    : (x.ReferencePrice > 0 ? x.ReferencePrice : x.ReferencePriceUsd)),
            OverridePriceLocal = x.OverridePriceLocal,
            ReferencePriceUsd = x.ReferencePriceUsd,
            OverridePrice = x.OverridePrice,
            IsActive = x.IsActive,
        }).ToList();
    }

