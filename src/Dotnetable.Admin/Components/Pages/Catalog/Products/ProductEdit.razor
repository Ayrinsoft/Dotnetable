    private Task<IEnumerable<Warranty>> SearchWarranties(string value, ProductWarranty row, CancellationToken ct)
    {
        var selectedId = row.WarrantyID;
        IEnumerable<Warranty> q = _warrantyCatalog
            .Where(w => w.IsActive || (selectedId is int sid && w.WarrantyID == sid))
            .OrderBy(w => w.SortOrder)
            .ThenBy(w => w.Title);

        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(w =>
                w.Title.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || (w.ProviderName?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
                || (w.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
                || (w.DurationMonths?.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return Task.FromResult(q);
    }

