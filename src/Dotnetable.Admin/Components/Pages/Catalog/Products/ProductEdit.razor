    /// <summary>Hydrate product options + per-row picks from saved variant attribute values.</summary>
    private void CaptureVariantAttributeOptions(IEnumerable<ProductVariant> variants)
    {
        _variantAttrPicks.Clear();
        _productVariantAttrIds.Clear();
        _productVariantOptionIds.Clear();

        var attrOrder = new List<int>();
        var optionsByAttr = new Dictionary<int, List<int>>();

        foreach (var v in variants)
        {
            var map = new Dictionary<int, int>();
            foreach (var a in v.VariantAttributeValues
                         .Where(x => x.AttributeDefinitionID > 0 && x.AttributeOptionID > 0)
                         .OrderBy(x => x.AttributeDefinitionID))
            {
                map[a.AttributeDefinitionID] = a.AttributeOptionID;
                if (!attrOrder.Contains(a.AttributeDefinitionID))
                    attrOrder.Add(a.AttributeDefinitionID);
                if (!optionsByAttr.TryGetValue(a.AttributeDefinitionID, out var list))
                {
                    list = new List<int>();
                    optionsByAttr[a.AttributeDefinitionID] = list;
                }
                if (!list.Contains(a.AttributeOptionID))
                    list.Add(a.AttributeOptionID);
            }
            _variantAttrPicks[v] = map;
        }

        // Keep only attrs that still exist in the catalog as variant attributes.
        var catalogIds = _variantAttributes.Select(a => a.AttributeDefinitionID).ToHashSet();
        foreach (var id in attrOrder.Where(catalogIds.Contains))
        {
            _productVariantAttrIds.Add(id);
            if (optionsByAttr.TryGetValue(id, out var opts))
                _productVariantOptionIds[id] = opts;
            else
                _productVariantOptionIds[id] = new List<int>();
        }
    }

    private AttributeDefinition? GetVariantDef(int attributeDefinitionId) =>
