    private List<AttributeOption> GetProductOptions(AttributeDefinition def)
    {
        if (!_productVariantOptionIds.TryGetValue(def.AttributeDefinitionID, out var ids) || ids.Count == 0)
            return new List<AttributeOption>();
        var byId = def.AttributeOptions.ToDictionary(o => o.AttributeOptionID);
        var list = new List<AttributeOption>();
        foreach (var id in ids)
        {
            if (byId.TryGetValue(id, out var o))
                list.Add(o);
        }
        return list;
    }

