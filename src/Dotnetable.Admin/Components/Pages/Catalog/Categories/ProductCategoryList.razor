@page "/catalog/categories"
@attribute [Authorize(Policy = RoleKeys.CatalogTaxonomyView)]
@inject IProductCategoryService ProductCategoryService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["catalog.categories", "Product Categories"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["catalog.categories", "Product Categories"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["catalog.categories.subtitle", "Nested product categories with translations."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["catalog.categories.new", "New Category"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_items.Count == 0)
    {
        <div style="text-align:center; padding:32px;"><MudText Color="Color.Secondary">@L["catalog.categories.empty", "No categories yet."]</MudText></div>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead>
                <tr>
                    <th>@L["name", "Name"]</th>
                    <th>@L["slug", "Slug"]</th>
                    <th>@L["catalog.categories.sort", "Sort"]</th>
                    <th>@L["active", "Active"]</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Ordered())
                {
                    <tr>
                        <td><span style="@($"padding-left:{Depth(c) * 20}px")">@(Depth(c) > 0 ? "└ " : "")@c.Name</span></td>
                        <td><code>@c.Slug</code></td>
                        <td>@c.SortOrder</td>
                        <td>@(c.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                        <td>
                            <MudStack Row="true" Spacing="0">
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(c))" />
                                }
                                @if (_canDelete)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(c))" />
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<ProductCategory> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await ProductCategoryService.GetAllAsync(_websiteId);
        _loading = false;
    }

    private int Depth(ProductCategory c)
    {
        var depth = 0; var parent = c.ParentCategoryID;
        while (parent is int pid && depth < 10)
        {
            depth++;
            parent = _items.FirstOrDefault(x => x.ProductCategoryID == pid)?.ParentCategoryID;
        }
        return depth;
    }

    private IEnumerable<ProductCategory> Ordered()
    {
        var byParent = _items.GroupBy(c => c.ParentCategoryID).ToDictionary(g => g.Key, g => g.OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList());
        var result = new List<ProductCategory>();
        void Walk(int? parent)
        {
            if (!byParent.TryGetValue(parent, out var children)) return;
            foreach (var c in children) { result.Add(c); Walk(c.ProductCategoryID); }
        }
        Walk(null);
        result.AddRange(_items.Where(c => !result.Contains(c)));
        return result;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new ProductCategory { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(ProductCategory c)
    {
        var copy = new ProductCategory
        {
            ProductCategoryID = c.ProductCategoryID, WebsiteID = c.WebsiteID,
            ParentCategoryID = c.ParentCategoryID, Name = c.Name, Slug = c.Slug,
            ImageFileID = c.ImageFileID, SortOrder = c.SortOrder, IsActive = c.IsActive,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(ProductCategory model, bool isNew)
    {
        var parameters = new DialogParameters<ProductCategoryDialog>
        {
            { x => x.Model, model }, { x => x.IsNew, isNew }, { x => x.AllCategories, _items },
        };
        var dialog = await DialogService.ShowAsync<ProductCategoryDialog>(
            isNew ? L["catalog.categories.new", "New Category"] : L["catalog.categories.edit", "Edit Category"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(ProductCategory c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["catalog.categories.delete", "Delete category"],
            L["catalog.categories.delete_confirm", "Delete this category? Child categories move up to its parent."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await ProductCategoryService.DeleteAsync(c.ProductCategoryID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
