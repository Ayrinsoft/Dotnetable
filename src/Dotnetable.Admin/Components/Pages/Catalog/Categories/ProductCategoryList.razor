@page "/catalog/categories"
@attribute [Authorize(Policy = RoleKeys.CatalogTaxonomyView)]
@inject IProductCategoryService ProductCategoryService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["catalog.categories", "Product Categories"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["catalog.categories", "Product Categories"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["catalog.categories.subtitle", "Nested product categories with translations."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => CreateAsync(null))">
                @L["catalog.categories.new", "New Category"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3" Style="flex-wrap:wrap;">
        <MudTextField @bind-Value="_search"
                      Placeholder="@L["catalog.categories.search", "Search categories…"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Style="min-width:220px; max-width:360px;" />
        <MudSelect T="string" @bind-Value="_sortBy" Label="@L["sort", "Sort"]" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Dense="true" Style="min-width:160px;">
            <MudSelectItem T="string" Value="@("SortOrder")">@L["catalog.categories.sort", "Sort order"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("Name")">@L["name", "Name"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("Slug")">@L["slug", "Slug"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("Active")">@L["active", "Active"]</MudSelectItem>
        </MudSelect>
        <MudToggleIconButton @bind-Toggled="_sortDesc"
                             Icon="@Icons.Material.Filled.ArrowUpward"
                             ToggledIcon="@Icons.Material.Filled.ArrowDownward"
                             title="@L["catalog.categories.sort_dir", "Toggle sort direction"]"
                             Size="Size.Medium" />
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore"
                   OnClick="ExpandAll">@L["expand_all", "Expand all"]</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess"
                   OnClick="CollapseAll">@L["collapse_all", "Collapse all"]</MudButton>
    </MudStack>

    @if (_items.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="pa-6" Align="Align.Center">
            @L["catalog.categories.empty", "No categories yet."]
        </MudText>
    }
    else if (VisibleRoots.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="pa-6" Align="Align.Center">
            @L["catalog.categories.search_empty", "No categories match your search."]
        </MudText>
    }
    else
    {
        <div class="dn-category-tree-head d-none d-md-flex">
            <span class="dn-category-tree-col-name">@L["name", "Name"]</span>
            <span class="dn-category-tree-col-slug">@L["slug", "Slug"]</span>
            <span class="dn-category-tree-col-sort">@L["catalog.categories.sort", "Sort"]</span>
            <span class="dn-category-tree-col-status">@L["status", "Status"]</span>
            <span class="dn-category-tree-col-actions"></span>
        </div>
        <ul class="dn-tree dn-tree-root">
            @foreach (var c in VisibleRoots)
            {
                @RenderNode(c, 0)
            }
        </ul>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private string? _search;
    private string _sortBy = "SortOrder";
    private bool _sortDesc;
    private List<ProductCategory> _items = new();
    private List<Website> _websites = new();
    private readonly HashSet<int> _expanded = new();

    private IReadOnlyList<ProductCategory> VisibleRoots
    {
        get
        {
            var visible = ComputeVisibleIds();
            return OrderSiblings(_items.Where(c => c.ParentCategoryID is null && visible.Contains(c.ProductCategoryID))).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await ProductCategoryService.GetAllAsync(_websiteId);
        _expanded.Clear();
        foreach (var root in _items.Where(c => c.ParentCategoryID is null))
            _expanded.Add(root.ProductCategoryID);
        _loading = false;
    }

    private HashSet<int> ComputeVisibleIds()
    {
        if (string.IsNullOrWhiteSpace(_search))
            return _items.Select(c => c.ProductCategoryID).ToHashSet();

        var needle = _search.Trim();
        var matchIds = _items
            .Where(c => c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                        || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.ProductCategoryID)
            .ToHashSet();

        var byId = _items.ToDictionary(c => c.ProductCategoryID);
        var visible = new HashSet<int>(matchIds);
        foreach (var id in matchIds.ToList())
        {
            var current = byId.GetValueOrDefault(id);
            while (current?.ParentCategoryID is int parentId)
            {
                visible.Add(parentId);
                _expanded.Add(parentId);
                if (!byId.TryGetValue(parentId, out current)) break;
            }
        }
        return visible;
    }

    private IEnumerable<ProductCategory> ChildrenOf(int parentId)
    {
        var visible = ComputeVisibleIds();
        return OrderSiblings(_items.Where(c => c.ParentCategoryID == parentId && visible.Contains(c.ProductCategoryID)));
    }

    private IEnumerable<ProductCategory> OrderSiblings(IEnumerable<ProductCategory> source)
    {
        if (_sortDesc)
        {
            return _sortBy switch
            {
                "Name" => source.OrderByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase),
                "Slug" => source.OrderByDescending(c => c.Slug, StringComparer.OrdinalIgnoreCase),
                "Active" => source.OrderBy(c => c.IsActive).ThenByDescending(c => c.SortOrder).ThenByDescending(c => c.Name),
                _ => source.OrderByDescending(c => c.SortOrder).ThenByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase),
            };
        }

        return _sortBy switch
        {
            "Name" => source.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
            "Slug" => source.OrderBy(c => c.Slug, StringComparer.OrdinalIgnoreCase),
            "Active" => source.OrderByDescending(c => c.IsActive).ThenBy(c => c.SortOrder).ThenBy(c => c.Name),
            _ => source.OrderBy(c => c.SortOrder).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase),
        };
    }

    private bool HasChildren(int id) => _items.Any(c => c.ParentCategoryID == id);

    private void ToggleExpand(int id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private void ExpandAll()
    {
        foreach (var c in _items)
            _expanded.Add(c.ProductCategoryID);
    }

    private void CollapseAll() => _expanded.Clear();

    private string ParentPath(ProductCategory c)
    {
        if (c.ParentCategoryID is null) return string.Empty;
        var byId = _items.ToDictionary(x => x.ProductCategoryID);
        var parts = new List<string>();
        var current = c;
        var guard = 0;
        while (current.ParentCategoryID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private async Task CreateAsync(int? parentCategoryId)
    {
        var model = new ProductCategory
        {
            WebsiteID = _websiteId,
            IsActive = true,
            ParentCategoryID = parentCategoryId,
        };
        if (await ShowDialogAsync(model, true)) await LoadAsync();
    }

    private async Task EditAsync(ProductCategory c)
    {
        var copy = new ProductCategory
        {
            ProductCategoryID = c.ProductCategoryID,
            WebsiteID = c.WebsiteID,
            ParentCategoryID = c.ParentCategoryID,
            Name = c.Name,
            Slug = c.Slug,
            ImageFileID = c.ImageFileID,
            SortOrder = c.SortOrder,
            IsActive = c.IsActive,
            ImageFile = c.ImageFile,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(ProductCategory model, bool isNew)
    {
        var allCategories = await ProductCategoryService.GetAllAsync(_websiteId);
        var parameters = new DialogParameters<ProductCategoryDialog>
        {
            { x => x.Model, model },
            { x => x.IsNew, isNew },
            { x => x.AllCategories, allCategories },
        };
        var dialog = await DialogService.ShowAsync<ProductCategoryDialog>(
            isNew ? L["catalog.categories.new", "New Category"] : L["catalog.categories.edit", "Edit Category"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(ProductCategory c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["catalog.categories.delete", "Delete category"],
            L["catalog.categories.delete_confirm", "Delete this category? Child categories move up to its parent."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await ProductCategoryService.DeleteAsync(c.ProductCategoryID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }

    private RenderFragment RenderNode(ProductCategory c, int depth) => __builder =>
    {
        var hasChildren = HasChildren(c.ProductCategoryID);
        var expanded = _expanded.Contains(c.ProductCategoryID) || !string.IsNullOrWhiteSpace(_search);
        var indent = depth * 16;
        var path = ParentPath(c);

        <li class="dn-tree-node">
            <div class="dn-tree-row dn-category-tree-row" style="@($"padding-inline-start:{10 + indent}px")">
                @if (hasChildren)
                {
                    <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" Class="pa-0"
                                   OnClick="@(() => ToggleExpand(c.ProductCategoryID))" />
                }
                else
                {
                    <span style="width:28px;display:inline-block;flex-shrink:0;"></span>
                }
                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Primary" />
                <div class="dn-category-tree-col-name" style="flex:1; min-width:0;">
                    <MudText Typo="Typo.body2" Class="text-truncate">@c.Name</MudText>
                    @if (!string.IsNullOrEmpty(path))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@path</MudText>
                    }
                </div>
                <code class="dn-category-tree-col-slug text-truncate d-none d-md-inline">@c.Slug</code>
                <span class="dn-category-tree-col-sort d-none d-md-inline">@c.SortOrder</span>
                <span class="dn-category-tree-col-status d-none d-md-inline">
                    <MudChip T="string" Size="Size.Small" Color="@(c.IsActive ? Color.Success : Color.Default)" Variant="Variant.Text">
                        @(c.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                    </MudChip>
                </span>
                <span class="dn-category-tree-col-actions" style="display:flex; gap:0; flex-shrink:0;">
                    @if (_canInsert)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       title="@L["catalog.categories.add_child", "Add child category"]"
                                       OnClick="@(() => CreateAsync(c.ProductCategoryID))" />
                    }
                    @if (_canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="@L["edit", "Edit"]"
                                       OnClick="@(() => EditAsync(c))" />
                    }
                    @if (_canDelete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="@L["delete", "Delete"]"
                                       OnClick="@(() => DeleteAsync(c))" />
                    }
                </span>
            </div>
            @if (hasChildren && expanded)
            {
                <ul class="dn-tree-children">
                    @foreach (var child in ChildrenOf(c.ProductCategoryID))
                    {
                        @RenderNode(child, depth + 1)
                    }
                </ul>
            }
        </li>
    };
}
