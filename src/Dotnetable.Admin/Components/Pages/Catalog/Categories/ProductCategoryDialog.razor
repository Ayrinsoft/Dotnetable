@inject IProductCategoryService ProductCategoryService
@inject IAttributeDefinitionService AttributeDefinitionService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject ILanguageService LanguageService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1">@L["catalog.categories.image", "Image (optional)"]</MudText>
                    <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickImageAsync">
                        <div style="aspect-ratio:16/9; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                            @if (!string.IsNullOrEmpty(_file?.CNDUrl))
                            {
                                <img src="@(_file.ThumbnailCDN ?? _file.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                            }
                        </div>
                    </MudPaper>
                    @if (_file is not null)
                    {
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" OnClick="@(() => _file = null)">@L["clear", "Clear"]</MudButton>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]" Variant="Variant.Outlined" Required="true" Class="mb-3" />
                    <MudTextField @bind-Value="Model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Required="true" Class="mb-3" />
                    <MudAutocomplete T="ProductCategory" Value="_selectedParent" ValueChanged="OnParentChanged"
                                     Label="@L["catalog.categories.parent", "Parent"]"
                                     Variant="Variant.Outlined"
                                     SearchFunc="SearchParents"
                                     ToStringFunc="CategoryPath"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     Dense="true"
                                     HelperText="@L["catalog.categories.parent_hint", "Search by name or path. Empty means top level."]" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" @bind-Value="Model.SortOrder" Label="@L["catalog.categories.sort", "Sort order"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive" Color="Color.Success"
                               Label="@(Model.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L["catalog.categories.attributes", "Category attributes"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        @L["catalog.categories.attributes_hint", "These product-level attributes appear on every product in this category (and children inherit them). Unlinking an attribute here does not remove values already saved on products — only the admin can remove those on the product itself."]
                    </MudText>
                    @if (_availableAttributes.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            @L["catalog.categories.no_attributes", "No product-level attributes defined for this website yet. Create them under Catalog → Attributes first."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudPaper Elevation="0" Class="border rounded-lg pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="flex-wrap:wrap; gap:8px;">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">
                                        @string.Format(L["catalog.categories.selected_count", "{0} selected"], _selectedAttributeIds.Count)
                                    </MudText>
                                    @if (_selectedAttributeIds.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @SelectedPreview
                                        </MudText>
                                    }
                                </MudStack>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="OpenPickAttributesAsync">
                                        @L["catalog.categories.select_attributes", "Select attributes"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Label"
                                               Disabled="@(_selectedAttributeIds.Count == 0)"
                                               OnClick="OpenSelectedAttributesAsync">
                                        @L["catalog.categories.manage_selected", "Manage selected"]
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudItem>

                @if (_languages.Length > 0)
                {
                <MudItem xs="12">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                            </MudText>
                            @foreach (var (code, label) in _languages)
                            {
                                <MudGrid Spacing="2" Class="mb-1">
                                    <MudItem xs="7">
                                        <MudTextField T="string" Value="@Name(code)" ValueChanged="@(v => SetName(code, v))"
                                                      Label="@($"{label} — {L["name", "Name"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="5">
                                        <MudTextField T="string" Value="@Slug(code)" ValueChanged="@(v => SetSlug(code, v))"
                                                      Label="@L["slug", "Slug"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
                }
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProductCategory Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public IReadOnlyList<ProductCategory> AllCategories { get; set; } = Array.Empty<ProductCategory>();

    [Inject] private IDialogService DialogService { get; set; } = null!;

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private FileRecord? _file;
    private ProductCategory? _selectedParent;
    private List<AttributeDefinition> _availableAttributes = new();
    private readonly HashSet<int> _selectedAttributeIds = new();
    private readonly Dictionary<string, (string Name, string Slug)> _tr = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<ProductCategory> ParentCandidates
    {
        get
        {
            var forbidden = DescendantIds(Model.ProductCategoryID);
            forbidden.Add(Model.ProductCategoryID);
            return AllCategories.Where(c => !forbidden.Contains(c.ProductCategoryID));
        }
    }

    private IEnumerable<AttributeDefinition> SelectedAttributes =>
        _availableAttributes.Where(a => _selectedAttributeIds.Contains(a.AttributeDefinitionID));

    private string SelectedPreview
    {
        get
        {
            var names = SelectedAttributes.Select(a => a.Name).Take(4).ToList();
            if (names.Count == 0) return string.Empty;
            var text = string.Join(", ", names);
            if (_selectedAttributeIds.Count > names.Count)
                text += "…";
            return text;
        }
    }

    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    protected override async Task OnInitializedAsync()
    {
        var websiteId = Model.WebsiteID > 0 ? Model.WebsiteID : L.WebsiteId;
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        _file = Model.ImageFile;
        if (Model.ParentCategoryID is int parentId)
            _selectedParent = AllCategories.FirstOrDefault(c => c.ProductCategoryID == parentId);

        _availableAttributes = (await AttributeDefinitionService.GetAllAsync(websiteId))
            .Where(a => a.Active && !a.IsVariantAttribute)
            .OrderBy(a => a.SortOrder).ThenBy(a => a.Name)
            .ToList();

        if (!IsNew)
        {
            foreach (var t in await ProductCategoryService.GetTranslationsAsync(Model.ProductCategoryID))
                _tr[t.LanguageCode] = (t.Name, t.Slug);

            var linked = await ProductCategoryService.GetAttributeDefinitionIdsAsync(Model.ProductCategoryID);
            var availableSet = _availableAttributes.Select(a => a.AttributeDefinitionID).ToHashSet();
            _selectedAttributeIds.Clear();
            foreach (var id in linked.Where(id => availableSet.Contains(id)))
                _selectedAttributeIds.Add(id);
        }
    }

    private async Task OpenPickAttributesAsync()
    {
        var websiteId = Model.WebsiteID > 0 ? Model.WebsiteID : L.WebsiteId;
        var parameters = new DialogParameters<CategoryAttributePickDialog>
        {
            { x => x.WebsiteId, websiteId },
            { x => x.InitialSelectedIds, _selectedAttributeIds.ToList() },
        };
        var dialog = await DialogService.ShowAsync<CategoryAttributePickDialog>(
            L["catalog.categories.pick_attributes", "Attributes for this category"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<int> ids })
            ReplaceSelection(ids);
    }

    private async Task OpenSelectedAttributesAsync()
    {
        var parameters = new DialogParameters<CategoryAttributeSelectedDialog>
        {
            { x => x.Attributes, SelectedAttributes.ToList() },
        };
        var dialog = await DialogService.ShowAsync<CategoryAttributeSelectedDialog>(
            L["catalog.categories.selected_attributes", "Selected attributes"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<int> ids })
            ReplaceSelection(ids);
    }

    private void ReplaceSelection(IReadOnlyList<int> ids)
    {
        _selectedAttributeIds.Clear();
        var availableSet = _availableAttributes.Select(a => a.AttributeDefinitionID).ToHashSet();
        foreach (var id in ids.Where(id => availableSet.Contains(id)))
            _selectedAttributeIds.Add(id);
    }

    private Task<IEnumerable<ProductCategory>> SearchParents(string value, CancellationToken ct)
    {
        IEnumerable<ProductCategory> candidates = ParentCandidates
            .OrderBy(c => CategoryPath(c), StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            candidates = candidates.Where(c =>
                c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || c.Slug.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || CategoryPath(c).Contains(needle, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(candidates);
    }

    private string CategoryPath(ProductCategory? category)
    {
        if (category is null) return string.Empty;
        var byId = AllCategories.ToDictionary(c => c.ProductCategoryID);
        var parts = new List<string> { category.Name };
        var current = category;
        var guard = 0;
        while (current.ParentCategoryID is int pid && byId.TryGetValue(pid, out var parent) && guard++ < 64)
        {
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join(" / ", parts);
    }

    private void OnParentChanged(ProductCategory? parent)
    {
        _selectedParent = parent;
        Model.ParentCategoryID = parent?.ProductCategoryID;
    }

    private string Name(string code) => _tr.TryGetValue(code, out var v) ? v.Name : string.Empty;
    private string Slug(string code) => _tr.TryGetValue(code, out var v) ? v.Slug : string.Empty;
    private void SetName(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (v ?? string.Empty, c.Slug ?? string.Empty); }
    private void SetSlug(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (c.Name ?? string.Empty, v ?? string.Empty); }

    private HashSet<int> DescendantIds(int rootId)
    {
        var result = new HashSet<int>();
        if (rootId == 0) return result;
        var queue = new Queue<int>();
        queue.Enqueue(rootId);
        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            foreach (var child in AllCategories.Where(c => c.ParentCategoryID == id))
                if (result.Add(child.ProductCategoryID)) queue.Enqueue(child.ProductCategoryID);
        }
        return result;
    }

    private async Task PickImageAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = Model.WebsiteID,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
            _file = file;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;
        if (string.IsNullOrWhiteSpace(Model.Name)) return;
        if (string.IsNullOrWhiteSpace(Model.Slug)) Model.Slug = Model.Name.Trim();

        if (Model.ParentCategoryID is 0) Model.ParentCategoryID = null;
        if (Model.WebsiteID <= 0)
        {
            Snackbar.Add(L["website_required", "Select a website first."], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            Model.ImageFileID = _file?.FileRecordID;
            if (IsNew)
                Model = await ProductCategoryService.CreateAsync(Model);
            else
                await ProductCategoryService.UpdateAsync(Model);
            await ProductCategoryService.SetTranslationsAsync(Model.ProductCategoryID, _tr);

            // Catalog order — does not cascade-delete product attribute values.
            var ordered = _availableAttributes
                .Where(a => _selectedAttributeIds.Contains(a.AttributeDefinitionID))
                .Select(a => a.AttributeDefinitionID)
                .ToList();
            await ProductCategoryService.SetAttributeDefinitionIdsAsync(Model.ProductCategoryID, ordered);

            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
