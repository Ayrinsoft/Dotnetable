@page "/catalog/warranties"
@attribute [Authorize(Policy = RoleKeys.CatalogTaxonomyView)]
@inject IWarrantyService WarrantyService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["warranties", "Warranties"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["warranties", "Warranties"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["warranties.subtitle", "Reusable warranty plans (company or official). Products can pick these or use free-text custom warranties."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["warranties.new", "New Warranty"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="5" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["warranties.empty", "No warranty plans yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var w in _items)
            {
                <tr>
                    <td>@w.Title</td>
                    <td>@(w.ProviderName ?? "—")</td>
                    <td>@(w.DurationMonths is int m ? $"{m} {L["warranties.months", "mo"]}" : "—")</td>
                    <td>
                        @if (w.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["active", "Active"]</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["inactive", "Inactive"]</MudChip>
                        }
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(w))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(w))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Warranty> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["title", "Title"], ColumnName = nameof(Warranty.Title), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["warranties.provider", "Provider"], ColumnName = nameof(Warranty.ProviderName), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["warranties.duration", "Duration"], ColumnName = nameof(Warranty.DurationMonths), HasSort = true },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(Warranty.IsActive) },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await WarrantyService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Warranty { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Warranty w)
    {
        var copy = new Warranty
        {
            WarrantyID = w.WarrantyID,
            WebsiteID = w.WebsiteID,
            Title = w.Title,
            Description = w.Description,
            ProviderName = w.ProviderName,
            DurationMonths = w.DurationMonths,
            IsActive = w.IsActive,
            SortOrder = w.SortOrder,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Warranty model, bool isNew)
    {
        var parameters = new DialogParameters<WarrantyDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<WarrantyDialog>(
            isNew ? L["warranties.new", "New Warranty"] : L["warranties.edit", "Edit Warranty"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Warranty w)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["warranties.delete", "Delete warranty"],
            L["warranties.delete_confirm", "Delete this warranty plan? Products using it keep a free-text copy of the title."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await WarrantyService.DeleteAsync(w.WarrantyID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
