@page "/catalog/marketplace"
@attribute [Authorize(Policy = RoleKeys.ProductsEdit)]
@using Dotnetable.Application.DTOs
@inject IMarketplaceChannelService ChannelService
@inject IMarketplaceProviderRegistry Registry
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject IPageLocalizer L

<DNPageTitle Title=@L["marketplace", "Search Engines"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["marketplace.heading", "Product Search Engines"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["marketplace.subtitle", "Feeds and marketplace pushes: Torob, Emalls, Google Shopping, Digikala"]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:200px;" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenEditAsync(null))">
            @L["marketplace.add", "Add Channel"]
        </MudButton>
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
else if (_items.Count == 0)
{
    <MudPaper Elevation="0" Class="app-card rounded-lg pa-8" Style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Large" Color="Color.Secondary" />
        <MudText Color="Color.Secondary" Class="mt-2">
            @L["marketplace.empty", "No search engine channel configured for this website yet."]
        </MudText>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var c in _items)
        {
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="app-card rounded-lg pa-4" Style="height:100%;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@(c.Mode == MarketplaceIntegrationMode.Feed ? Icons.Material.Filled.RssFeed : Icons.Material.Filled.CloudUpload)"
                                     Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@c.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@c.ProviderDisplayName</MudText>
                            </MudStack>
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            @if (!c.IsConfigured)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                                    @L["marketplace.incomplete", "Incomplete"]
                                </MudChip>
                            }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(c.IsActive ? Color.Success : Color.Default)">
                                @(c.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                            </MudChip>
                        </MudStack>
                    </MudStack>

                    <MudDivider Class="my-3" />

                    @if (!string.IsNullOrWhiteSpace(c.FeedUrl))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["marketplace.feed_url", "Feed URL — give this to the engine's seller panel"]
                        </MudText>
                        <MudTextField T="string" Value="@c.FeedUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Class="mt-1" />
                    }

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                        @if (c.LastSyncAt is null)
                        {
                            @L["marketplace.never_run", "Never run yet."]
                        }
                        else
                        {
                            <span>
                                @L["marketplace.last_run", "Last run"]: @c.LastSyncAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                — @(c.LastSyncMessage ?? c.LastSyncStatus?.ToString())
                            </span>
                        }
                    </MudText>

                    <MudStack Row="true" Spacing="1" Class="mt-3">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenEditAsync(c))">@L["edit", "Edit"]</MudButton>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Category"
                                   OnClick="@(() => OpenCategoriesAsync(c))">@L["marketplace.categories", "Categories"]</MudButton>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="@_syncing" OnClick="@(() => SyncAsync(c))">@L["marketplace.sync_now", "Sync Now"]</MudButton>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                       OnClick="@(() => OpenLogsAsync(c))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(c))" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private bool _isMaster;
    private int _websiteId;
    private bool _loading = true;
    private bool _syncing;
    private List<Website> _websites = new();
    private List<MarketplaceChannelInfo> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
        {
            _websites = (await WebsiteService.GetAllAsync()).ToList();
            if (_websiteId == 0 && _websites.Count > 0) _websiteId = _websites[0].WebsiteID;
        }
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int websiteId)
    {
        _websiteId = websiteId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await ChannelService.GetForWebsiteAsync(_websiteId)).ToList();
        _loading = false;
        StateHasChanged();
    }

    private async Task OpenEditAsync(MarketplaceChannelInfo? channel)
    {
        var parameters = new DialogParameters
        {
            [nameof(MarketplaceChannelEditDialog.WebsiteID)] = _websiteId,
            [nameof(MarketplaceChannelEditDialog.Channel)] = channel,
        };
        var dialog = await DialogService.ShowAsync<MarketplaceChannelEditDialog>(
            channel is null ? L["marketplace.add", "Add Channel"] : L["marketplace.edit_title", "Edit Channel"],
            parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenCategoriesAsync(MarketplaceChannelInfo channel)
    {
        var parameters = new DialogParameters
        {
            [nameof(MarketplaceCategoryDialog.Channel)] = channel,
        };
        var dialog = await DialogService.ShowAsync<MarketplaceCategoryDialog>(
            L["marketplace.categories_title", "Categories & mapping"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenLogsAsync(MarketplaceChannelInfo channel)
    {
        var parameters = new DialogParameters
        {
            [nameof(MarketplaceLogDialog.Channel)] = channel,
        };
        await DialogService.ShowAsync<MarketplaceLogDialog>(
            L["marketplace.logs_title", "Sync history"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task SyncAsync(MarketplaceChannelInfo channel)
    {
        _syncing = true;
        try
        {
            var result = await ChannelService.SyncNowAsync(channel.MarketplaceChannelID);
            var severity = result.Status switch
            {
                MarketplaceSyncStatus.Success => Severity.Success,
                MarketplaceSyncStatus.Partial => Severity.Warning,
                _ => Severity.Error,
            };
            Snackbar.Add(result.Message ?? result.Status.ToString(), severity);
        }
        finally
        {
            _syncing = false;
        }
        await LoadAsync();
    }

    private async Task DeleteAsync(MarketplaceChannelInfo channel)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            L["marketplace.delete_q", "Delete channel?"],
            L["marketplace.delete_body", "The feed URL stops working immediately and the engine will see an empty catalog on its next crawl."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (ok == true)
        {
            await ChannelService.DeleteAsync(channel.MarketplaceChannelID);
            Snackbar.Add(L["marketplace.deleted", "Channel deleted."], Severity.Success);
            await LoadAsync();
        }
    }
}
