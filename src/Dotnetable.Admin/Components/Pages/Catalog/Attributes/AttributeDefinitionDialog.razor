@inject IAttributeDefinitionService AttributeService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject ILanguageService LanguageService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Code" Label="@L["attributes.code", "Code"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="byte" @bind-Value="Model.InputType" Label="@L["attributes.input_type", "Input type"]" Variant="Variant.Outlined">
                        <MudSelectItem T="byte" Value="(byte)1">@L["attributes.select", "Select"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="(byte)2">@L["attributes.color", "Color"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="(byte)3">@L["attributes.numeric", "Numeric"]</MudSelectItem>
                        <MudSelectItem T="byte" Value="(byte)4">@L["attributes.text", "Text"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Model.Unit" Label="@L["attributes.unit", "Unit (optional)"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Model.SortOrder" Label="@L["categories.sort", "Sort"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSwitch T="bool" @bind-Value="Model.IsFilterable" Label="@L["attributes.filterable", "Filterable"]" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSwitch T="bool" @bind-Value="Model.IsVariantAttribute" Label="@L["attributes.variant", "Variant attribute"]" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSwitch T="bool" @bind-Value="Model.IsComparable" Label="@L["attributes.comparable", "Comparable"]" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSwitch T="bool" @bind-Value="Model.Active" Label="@L["active", "Active"]" Color="Color.Primary" />
                </MudItem>

                @if (Model.InputType is 1 or 2)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["attributes.options", "Options"]</MudText>
                        @if (Model.InputType == 2)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                @L["attributes.color_options_hint", "Each option needs a color name and a color code. Use the picker — switch modes for HEX or RGB (0–255)."]
                            </MudText>
                        }
                        @foreach (var (option, index) in _options.Select((o, i) => (o, i)))
                        {
                            <MudGrid Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                                <MudItem xs="@(Model.InputType == 2 ? 4 : 10)">
                                    <MudTextField T="string" @bind-Value="option.Value"
                                                  Label="@(Model.InputType == 2 ? L["attributes.color_name", "Color name"] : L["value", "Value"])"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Placeholder="@(Model.InputType == 2 ? L["attributes.color_name_placeholder", "e.g. Navy blue"] : null)" />
                                </MudItem>
                                @if (Model.InputType == 2)
                                {
                                    <MudItem xs="2" Class="d-flex align-center justify-center">
                                        <div class="dn-color-swatch" style="@SwatchStyle(option.ColorHex)" title="@(option.ColorHex ?? "")"></div>
                                    </MudItem>
                                    <MudItem xs="5">
                                        <MudColorPicker Label="@L["attributes.color_code", "Color"]"
                                                        Value="@ParseMudColor(option.ColorHex)"
                                                        ValueChanged="@(c => option.ColorHex = FormatHex(c))"
                                                        Variant="Variant.Outlined"
                                                        Margin="Margin.Dense"
                                                        ColorPickerView="ColorPickerView.Spectrum"
                                                        PickerVariant="PickerVariant.Dialog"
                                                        ShowModeSwitch="true"
                                                        ShowAlpha="false"
                                                        HelperText="@L["attributes.color_picker_hint", "HEX or RGB (bytes 0–255)"]" />
                                    </MudItem>
                                }
                                <MudItem xs="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => _options.RemoveAt(index))" />
                                </MudItem>
                            </MudGrid>
                        }
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => _options.Add(new AttributeOption { Value = string.Empty }))">
                            @L["attributes.add_option", "Add option"]
                        </MudButton>
                    </MudItem>
                }

                @if (_languages.Length > 0)
                {
                <MudItem xs="12">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                            </MudText>
                            @foreach (var (code, label) in _languages)
                            {
                                <MudTextField T="string" Value="@Name(code)" ValueChanged="@(v => SetName(code, v))"
                                              Label="@($"{label} — {L["name", "Name"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1" />
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
                }
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AttributeDefinition Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private List<AttributeOption> _options = new();
    private readonly Dictionary<string, (string Name, string? Unit)> _tr = new(StringComparer.OrdinalIgnoreCase);

    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    protected override async Task OnInitializedAsync()
    {
        var websiteId = Model.WebsiteID > 0 ? Model.WebsiteID : L.WebsiteId;
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        _options = Model.AttributeOptions?.OrderBy(o => o.SortOrder).ToList() ?? new List<AttributeOption>();
        if (!IsNew)
        {
            if (_options.Count == 0)
                _options = await AttributeService.GetOptionsAsync(Model.AttributeDefinitionID);
            foreach (var t in await AttributeService.GetTranslationsAsync(Model.AttributeDefinitionID))
                _tr[t.LanguageCode] = (t.Name, t.Unit);
        }
    }

    private string Name(string code) => _tr.TryGetValue(code, out var v) ? v.Name : string.Empty;
    private void SetName(string code, string v) { var c = _tr.GetValueOrDefault(code); _tr[code] = (v ?? string.Empty, c.Unit); }

    private static MudColor? ParseMudColor(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return null;
        try { return new MudColor(hex.Trim()); }
        catch { return null; }
    }

    private static string? FormatHex(MudColor? color)
    {
        if (color is null) return null;
        // Prefer #RRGGBB without alpha for storefront CSS.
        var hex = color.ToString(MudColorOutputFormats.Hex);
        if (string.IsNullOrEmpty(hex)) return null;
        if (hex.Length == 9 && hex.StartsWith('#')) // #AARRGGBB
            return "#" + hex[3..];
        return hex.StartsWith('#') ? hex.ToUpperInvariant() : "#" + hex.ToUpperInvariant();
    }

    private static string SwatchStyle(string? hex)
    {
        var c = string.IsNullOrWhiteSpace(hex) ? "#E0E0E0" : hex.Trim();
        return $"background:{c}; width:28px; height:28px; border-radius:50%; border:1px solid var(--mud-palette-lines-default);";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        // Drop blank option rows; require name for color options that have a hex.
        var cleaned = _options
            .Where(o => !string.IsNullOrWhiteSpace(o.Value))
            .Select(o =>
            {
                o.Value = o.Value.Trim();
                o.ColorHex = FormatHex(ParseMudColor(o.ColorHex)) ?? o.ColorHex?.Trim();
                return o;
            })
            .ToList();
        if (Model.InputType == 2)
        {
            var missingColor = cleaned.Where(o => string.IsNullOrWhiteSpace(o.ColorHex)).Select(o => o.Value).ToList();
            if (missingColor.Count > 0)
            {
                Snackbar.Add(L["attributes.color_required", "Each color option needs a color code from the picker."], Severity.Warning);
                return;
            }
        }

        _saving = true;
        try
        {
            if (IsNew) Model = await AttributeService.CreateAsync(Model);
            else await AttributeService.UpdateAsync(Model);
            await AttributeService.SetOptionsAsync(Model.AttributeDefinitionID, cleaned);
            await AttributeService.SetTranslationsAsync(Model.AttributeDefinitionID, _tr);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
