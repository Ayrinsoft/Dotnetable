@page "/catalog/attributes"
@attribute [Authorize(Policy = RoleKeys.CatalogTaxonomyView)]
@inject IAttributeDefinitionService AttributeService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["attributes", "Attributes"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["attributes", "Attributes"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["attributes.subtitle", "Product attributes (color, size, material, ...) and their selectable options."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["attributes.new", "New Attribute"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="6" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["attributes.empty", "No attributes yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var a in _items)
            {
                <tr>
                    <td>@a.Name</td>
                    <td><code>@a.Code</code></td>
                    <td>@(a.IsFilterable ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>@(a.IsVariantAttribute ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>@(a.Active ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(a))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(a))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<AttributeDefinition> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.CatalogTaxonomyDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(AttributeDefinition.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["attributes.code", "Code"], ColumnName = nameof(AttributeDefinition.Code), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["attributes.filterable", "Filterable"], ColumnName = nameof(AttributeDefinition.IsFilterable), HasSort = true },
                new() { ColumnTitle = L["attributes.variant", "Variant"], ColumnName = nameof(AttributeDefinition.IsVariantAttribute), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(AttributeDefinition.Active), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await AttributeService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new AttributeDefinition { WebsiteID = _websiteId, Active = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(AttributeDefinition a)
    {
        var full = await AttributeService.GetByIdAsync(a.AttributeDefinitionID) ?? a;
        if (await ShowDialogAsync(full, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(AttributeDefinition model, bool isNew)
    {
        var parameters = new DialogParameters<AttributeDefinitionDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<AttributeDefinitionDialog>(
            isNew ? L["attributes.new", "New Attribute"] : L["attributes.edit", "Edit Attribute"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(AttributeDefinition a)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["attributes.delete", "Delete attribute"],
            L["attributes.delete_confirm", "Delete this attribute and all its options?"],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await AttributeService.DeleteAsync(a.AttributeDefinitionID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
