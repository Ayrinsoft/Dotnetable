@using Dotnetable.Admin.Components.Pages.Media
@using Dotnetable.Domain.Enums
@inject IVendorService VendorService
@inject IMemberService MemberService
@inject IWebsiteService WebsiteService
@inject IFileService FileService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L
@inject ILanguageService LanguageService
@inject ICurrencyService CurrencyService
@inject ICurrencyConversionService Fx
@inject NavigationManager Nav

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.body2" Class="mb-1">@L["vendors.logo", "Logo"]</MudText>
                    <MudPaper Elevation="0" Class="border rounded-lg pa-2" Style="cursor:pointer;" @onclick="PickLogoAsync">
                        <div style="aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey); border-radius:8px; overflow:hidden;">
                            @if (!string.IsNullOrEmpty(_logo?.CNDUrl))
                            {
                                <img src="@(_logo.ThumbnailCDN ?? _logo.CNDUrl)" alt="" style="width:100%; height:100%; object-fit:contain;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Secondary" Size="Size.Large" />
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="9">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="7">
                            <MudTextField @bind-Value="Model.Name" Label="@L["name", "Name"]" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="Model.Slug" Label="@L["slug", "Slug"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="byte" Value="Model.VendorType" ValueChanged="OnVendorTypeChanged"
                                       Label="@L["vendors.type", "Vendor type"]" Variant="Variant.Outlined">
                                <MudSelectItem T="byte" Value="(byte)VendorType.Display">@L["vendors.type.display", "Display only"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="(byte)VendorType.Member">@L["vendors.type.member", "Member login"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="(byte)VendorType.Site">@L["vendors.type.site", "Linked website"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="byte" @bind-Value="Model.SettlementMode" Label="@L["vendors.settlement", "Settlement mode"]" Variant="Variant.Outlined">
                                <MudSelectItem T="byte" Value="(byte)0">@L["vendors.immediate", "Immediate"]</MudSelectItem>
                                <MudSelectItem T="byte" Value="(byte)1">@L["vendors.credit", "Credit"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Value="_settleCurrency" ValueChanged="OnSettleCurrencyChanged!"
                                       Label="@L["vendors.settle_currency", "Settle in"]"
                                       Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem T="string" Value="@("")">@L["vendors.settle_currency.order", "Same as order / site currency"]</MudSelectItem>
                                @foreach (var c in _currencies)
                                {
                                    <MudSelectItem T="string" Value="@c.CurrencyCode">@c.CurrencyCode — @c.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["vendors.settle_currency.hint", "Linked sites: catalog can stay USD; settlement converts sale currency → USD → this currency. External vendors: pick the currency you pay them in."]
                            </MudText>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(_fxWarning))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined"
                                          Class="mt-1">
                                    <MudStack Spacing="1">
                                        <MudText>@_fxWarning</MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                                   StartIcon="@Icons.Material.Filled.CurrencyExchange"
                                                   Href="/finance/currency-rates">
                                            @L["vendors.go_rates", "Open Exchange Rates"]
                                        </MudButton>
                                    </MudStack>
                                </MudAlert>
                            </MudItem>
                        }
                        <MudItem xs="12" sm="6">
                            <MudSwitch T="bool" @bind-Value="Model.IsActive" Label="@L["active", "Active"]" Color="Color.Primary" />
                        </MudItem>
                        @if (Model.VendorType == (byte)VendorType.Member)
                        {
                            <MudItem xs="12">
                                <MudAutocomplete T="Member" Value="@GetSelectedMember()" ValueChanged="OnMemberChanged"
                                                 SearchFunc="SearchMembers" ToStringFunc="MemberDisplay"
                                                 Label="@L["vendors.member", "Linked member"]" Variant="Variant.Outlined"
                                                 Clearable="true" Dense="true" CoerceText="false" ResetValueOnEmptyText="true" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["vendors.member.hint", "This member can sign in to admin and manage only their own products and prices."]
                                </MudText>
                            </MudItem>
                        }
                        @if (Model.VendorType == (byte)VendorType.Site)
                        {
                            <MudItem xs="12">
                                <MudAutocomplete T="Website" Value="@GetSelectedLinkedWebsite()" ValueChanged="OnLinkedWebsiteChanged"
                                                 SearchFunc="SearchWebsites" ToStringFunc="@(w => w is null ? string.Empty : $"{w.TradeName} (#{w.WebsiteID})")"
                                                 Label="@L["vendors.linked_site", "Linked website"]" Variant="Variant.Outlined"
                                                 Clearable="true" Dense="true" CoerceText="false" ResetValueOnEmptyText="true" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["vendors.linked_site.hint", "Only products owned by that website are shown here. Goods they import from others cannot be re-shared."]
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Value="@(Model.AvailableCredit != 0 || Model.AvailableCreditUsd == 0 ? Model.AvailableCredit : Model.AvailableCreditUsd)" Disabled="true"
                                                 Label="@L["vendors.available_credit", "Available credit"]" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                        @if (Model.SettlementMode == 1)
                        {
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int?" @bind-Value="Model.CreditDays" Label="@L["vendors.credit_days", "Credit days"]" Variant="Variant.Outlined" Min="1" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <DNMoneyFieldNullable @bind-Value="Model.CreditLimit" Label="@L["vendors.credit_limit", "Credit limit (site currency)"]" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
                @if (_languages.Length > 0)
                {
                <MudItem xs="12">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@L["other_languages", "Other languages"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default."]
                            </MudText>
                            @foreach (var (code, label) in _languages)
                            {
                                <MudTextField T="string" Value="@Name(code)" ValueChanged="@(v => SetName(code, v))"
                                              Label="@($"{label} — {L["name", "Name"]}")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1" />
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
                }
            </MudGrid>

            <DNValidationSummary Errors="_formErrors" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["cancel", "Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@L["save", "Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Vendor Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private bool _saving;
    private string[]? _formErrors;
    private FileRecord? _logo;
    private readonly Dictionary<string, string> _tr = new(StringComparer.OrdinalIgnoreCase);
    private List<Member> _members = new();
    private List<Website> _websites = new();
    private List<Currency> _currencies = new();
    private string _settleCurrency = "";
    private string? _hostCurrency;
    private string? _fxWarning;

    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    protected override async Task OnInitializedAsync()
    {
        var websiteId = Model.WebsiteID > 0 ? Model.WebsiteID : L.WebsiteId;
        _languages = (await LanguageService.GetOtherActiveForWebsiteAsync(websiteId))
            .Select(x => (x.LanguageCode, x.Name)).ToArray();

        if (Model.LogoFileID is int fid)
            _logo = await FileService.GetByIdAsync(fid);
        if (!IsNew)
            foreach (var t in await VendorService.GetTranslationsAsync(Model.VendorID))
                _tr[t.LanguageCode] = t.Name;

        _members = (await MemberService.GetByWebsiteAsync(websiteId)).Where(m => m.Active).OrderBy(m => m.Username).ToList();
        _websites = (await WebsiteService.GetAllAsync())
            .Where(w => w.Active && w.WebsiteID != websiteId)
            .OrderBy(w => w.TradeName)
            .ToList();
        _currencies = (await CurrencyService.GetAllAsync()).Where(c => c.IsActive).OrderBy(c => c.CurrencyCode).ToList();
        _settleCurrency = Model.SettlementCurrencyCode ?? "";
        var host = await WebsiteService.GetByIdAsync(websiteId);
        _hostCurrency = host?.DefaultCurrencyCode;
        await RefreshFxWarningAsync();
    }

    private string Name(string code) => _tr.TryGetValue(code, out var v) ? v : string.Empty;
    private void SetName(string code, string v) => _tr[code] = v ?? string.Empty;

    private void OnVendorTypeChanged(byte type)
    {
        Model.VendorType = type;
        if (type != (byte)VendorType.Member) Model.MemberID = null;
        if (type != (byte)VendorType.Site) Model.LinkedWebsiteID = null;
    }

    private Member? GetSelectedMember() =>
        Model.MemberID is int id ? _members.FirstOrDefault(m => m.MemberID == id) : null;

    private void OnMemberChanged(Member? member) => Model.MemberID = member?.MemberID;

    private string MemberDisplay(Member? m) =>
        m is null ? string.Empty : $"{m.Username} — {m.Givenname} {m.Surname}".Trim();

    private Task<IEnumerable<Member>> SearchMembers(string value, CancellationToken ct)
    {
        IEnumerable<Member> q = _members.OrderBy(m => m.Username);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(m =>
                m.Username.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || m.Givenname.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || m.Surname.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || m.Email.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private Website? GetSelectedLinkedWebsite() =>
        Model.LinkedWebsiteID is int id ? _websites.FirstOrDefault(w => w.WebsiteID == id) : null;

    private async Task OnLinkedWebsiteChanged(Website? website)
    {
        Model.LinkedWebsiteID = website?.WebsiteID;
        if (website is not null && string.IsNullOrWhiteSpace(_settleCurrency) && !string.IsNullOrWhiteSpace(website.DefaultCurrencyCode))
            _settleCurrency = website.DefaultCurrencyCode;
        await RefreshFxWarningAsync();
    }

    private async Task OnSettleCurrencyChanged(string value)
    {
        _settleCurrency = value ?? "";
        await RefreshFxWarningAsync();
    }

    private async Task RefreshFxWarningAsync()
    {
        _fxWarning = null;
        if (Model.WebsiteID <= 0) return;

        var dest = string.IsNullOrWhiteSpace(_settleCurrency) ? null : _settleCurrency.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(dest) && Model.VendorType == (byte)VendorType.Site)
        {
            var linked = GetSelectedLinkedWebsite();
            if (!string.IsNullOrWhiteSpace(linked?.DefaultCurrencyCode))
                dest = linked.DefaultCurrencyCode.Trim().ToUpperInvariant();
        }

        var host = string.IsNullOrWhiteSpace(_hostCurrency) ? null : _hostCurrency.Trim().ToUpperInvariant();
        dest ??= host;
        if (string.IsNullOrEmpty(dest) || string.IsNullOrEmpty(host)
            || string.Equals(dest, host, StringComparison.OrdinalIgnoreCase))
            return;

        var missing = await Fx.FindMissingFxRatesAsync(Model.WebsiteID, [host, dest]);
        if (missing.Count == 0) return;

        var codes = string.Join(", ", missing);
        _fxWarning = string.Format(
            L["vendors.fx_missing", "Exchange rate for {0} is not set. Open Exchange Rates and add how many {0} equal 1 USD, then come back and save."],
            codes);
    }

    private Task<IEnumerable<Website>> SearchWebsites(string value, CancellationToken ct)
    {
        IEnumerable<Website> q = _websites.OrderBy(w => w.TradeName);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(w =>
                w.TradeName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || w.WebsiteID.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private async Task PickLogoAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(FilePickerDialog.WebsiteId)] = Model.WebsiteID,
            [nameof(FilePickerDialog.Category)] = FileCategory.Image,
        };
        var dialog = await DialogService.ShowAsync<FilePickerDialog>(L["select_file", "Select a file"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: FileRecord file })
        {
            _logo = file;
            Model.LogoFileID = file.FileRecordID;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;
        if (string.IsNullOrWhiteSpace(Model.Slug)) Model.Slug = Model.Name.Trim();
        if (Model.SettlementMode != 1) { Model.CreditDays = null; }
        Model.SettlementCurrencyCode = string.IsNullOrWhiteSpace(_settleCurrency) ? null : _settleCurrency.Trim().ToUpperInvariant();
        await RefreshFxWarningAsync();
        if (!string.IsNullOrEmpty(_fxWarning))
        {
            Snackbar.Add(_fxWarning, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (IsNew) await VendorService.CreateAsync(Model);
            else await VendorService.UpdateAsync(Model);
            await VendorService.SetTranslationsAsync(Model.VendorID, _tr);
            Snackbar.Add(L["saved", "Saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
