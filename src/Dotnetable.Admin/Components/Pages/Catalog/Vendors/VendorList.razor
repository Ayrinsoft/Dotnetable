@page "/catalog/vendors"
@attribute [Authorize(Policy = RoleKeys.VendorsView)]
@inject IVendorService VendorService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["vendors", "Vendors"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["vendors", "Vendors"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["vendors.subtitle", "Marketplace sellers, with settlement mode and per-language translations."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["vendors.new", "New Vendor"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="5" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["vendors.empty", "No vendors yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var v in _items)
            {
                <tr>
                    <td>@v.Name</td>
                    <td><code>@v.Slug</code></td>
                    <td>@(v.SettlementMode == 1 ? L["vendors.credit", "Credit"] : L["vendors.immediate", "Immediate"])</td>
                    <td>@(v.IsActive ? L["yes", "Yes"] : L["no", "No"])</td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(v))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(v))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Vendor> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.VendorsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.VendorsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.VendorsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["name", "Name"], ColumnName = nameof(Vendor.Name), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["slug", "Slug"], ColumnName = nameof(Vendor.Slug), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["vendors.settlement", "Settlement"], ColumnName = nameof(Vendor.SettlementMode), HasSort = true },
                new() { ColumnTitle = L["active", "Active"], ColumnName = nameof(Vendor.IsActive), HasSort = true },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await VendorService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Vendor { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Vendor v)
    {
        var copy = new Vendor
        {
            VendorID = v.VendorID, WebsiteID = v.WebsiteID, Name = v.Name, Slug = v.Slug,
            LogoFileID = v.LogoFileID, Rating = v.Rating, IsActive = v.IsActive,
            SettlementMode = v.SettlementMode, CreditDays = v.CreditDays, CreditLimitUsd = v.CreditLimitUsd,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Vendor model, bool isNew)
    {
        var parameters = new DialogParameters<VendorDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<VendorDialog>(
            isNew ? L["vendors.new", "New Vendor"] : L["vendors.edit", "Edit Vendor"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Vendor v)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["vendors.delete", "Delete vendor"],
            L["vendors.delete_confirm", "Delete this vendor? Its vendor-product listings will be removed."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await VendorService.DeleteAsync(v.VendorID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
