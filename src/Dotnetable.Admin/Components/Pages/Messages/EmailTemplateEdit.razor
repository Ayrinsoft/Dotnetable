@page "/messages/email-templates/{TemplateKey}"
@attribute [Authorize(Policy = RoleKeys.WebsiteEdit)]
@inject IEmailTemplateService TemplateService
@inject ILanguageService LanguageService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@(_item?.Name ?? TemplateKey) />

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pb-2" />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_item?.Name ?? TemplateKey)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_item?.IsOverride == true
                ? L["email_templates.editing_own", "This website's own version of this template."]
                : L["email_templates.editing_default", "Currently using the built-in default — saving creates this website's own version."])
        </MudText>
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_item is not null)
{
    <MudForm @ref="_form">
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <div dir="@(_defaultRtl ? "rtl" : "ltr")">
                        <MudGrid Spacing="3" Class="mb-2">
                            <MudItem xs="12" sm="8">
                                <MudTextField @bind-Value="_item.Subject" Label="@L["email_templates.subject", "Subject"]"
                                              Variant="Variant.Outlined" Required="true"
                                              RequiredError="@L["required", "This field is required."]" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="EmailAccountType" @bind-Value="_item.AccountType" Label="@L["email_templates.sender", "Sender Account"]"
                                           Variant="Variant.Outlined">
                                    @foreach (var t in Enum.GetValues<EmailAccountType>())
                                    {
                                        <MudSelectItem T="EmailAccountType" Value="t">@AccountTypeLabel(t)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.body2" Class="mb-1" Color="Color.Secondary">@L["email_templates.body", "HTML Content"]</MudText>
                        <DNCkEditor ContentLanguage="@_defaultLanguageCode"
                                    Value="@_item.HtmlBody"
                                    OnValueChanged="@(v => _item!.HtmlBody = v)" />
                    </div>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                        @L["email_templates.tokens_hint", "Available placeholders depend on the email: {{SiteName}} and {{SiteUrl}} always work; others (e.g. {{Code}}, {{ResetUrl}}, {{Name}}, {{OrderNumber}}) are filled in when that specific email is sent."]
                    </MudText>

                    <MudSwitch T="bool" @bind-Value="_item.Active" Color="Color.Primary" Class="mt-3"
                               Label="@(_item.Active ? L["email_templates.active_on", "Active — will be sent"] : L["email_templates.active_off", "Inactive — sending will fail"])" />
                </MudPaper>

                @if (_otherLanguages.Count > 0)
                {
                    <MudExpansionPanels Elevation="0" Class="mt-4">
                        <MudExpansionPanel Text="@L["other_languages", "Other languages"]" IsInitiallyExpanded="true">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                @L["email_templates.other_languages.hint", "Main fields above are the site default language. Leave a translation blank to fall back to the default. RTL languages open the editor right-to-left."]
                            </MudText>
                            @foreach (var lang in _otherLanguages)
                            {
                                var t = Translation(lang.LanguageCode);
                                var dir = lang.RTLDesign ? "rtl" : "ltr";
                                <MudPaper Elevation="0" Class="pa-3 mb-3" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                        <MudText Typo="Typo.subtitle2">@lang.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                            @lang.LanguageCode.ToUpperInvariant()
                                        </MudChip>
                                        @if (lang.RTLDesign)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">RTL</MudChip>
                                        }
                                    </MudStack>
                                    <div dir="@dir">
                                        <MudTextField T="string" Value="@t.Subject" ValueChanged="@(v => t.Subject = v ?? string.Empty)"
                                                      Label="@L["email_templates.subject", "Subject"]"
                                                      Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense" />
                                        <MudText Typo="Typo.caption" Class="mb-1" Color="Color.Secondary">@L["email_templates.body", "HTML Content"]</MudText>
                                        <DNCkEditor ContentLanguage="@lang.LanguageCode"
                                                    Value="@(t.HtmlBody ?? "")"
                                                    OnValueChanged="@(v => t.HtmlBody = v)" />
                                    </div>
                                </MudPaper>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="@_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @L["save", "Save Changes"]
            </MudButton>
            @if (_item.IsOverride)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="ResetAsync" Disabled="@_saving">
                    @L["email_templates.reset", "Reset to Default"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Href="/messages/email-templates">
                @L["cancel", "Cancel"]
            </MudButton>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public string TemplateKey { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public int? WebsiteId { get; set; }

    private MudForm _form = null!;
    private EmailTemplateInfo? _item;
    private bool _loading = true;
    private bool _saving;
    private int _websiteId;
    private bool _defaultRtl;
    private string _defaultLanguageCode = "en";
    private List<Language> _otherLanguages = [];
    private readonly Dictionary<string, TranslationModel> _translations = new(StringComparer.OrdinalIgnoreCase);

    private sealed class TranslationModel
    {
        public string Subject { get; set; } = "";
        public string HtmlBody { get; set; } = "";
    }

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["dashboard", "Dashboard"], "/"),
        new(L["email_templates", "Email Templates"], "/messages/email-templates"),
        new(_item?.Name ?? TemplateKey, null, true),
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        var isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out var claimWebsiteId);

        _websiteId = isMaster && WebsiteId.HasValue ? WebsiteId.Value : claimWebsiteId;

        _item = await TemplateService.GetAsync(_websiteId, TemplateKey);
        if (_item is null)
        {
            Nav.NavigateTo("/messages/email-templates");
            return;
        }

        var languages = await LanguageService.GetActiveForWebsiteAsync(_websiteId);
        var defaultLang = languages.FirstOrDefault(l => l.IsDefault) ?? languages.FirstOrDefault();
        _defaultLanguageCode = defaultLang?.LanguageCode ?? "en";
        _defaultRtl = defaultLang?.RTLDesign == true;
        _otherLanguages = languages.Where(l => !l.IsDefault).ToList();

        foreach (var tr in _item.Translations)
            _translations[tr.LanguageCode] = new TranslationModel { Subject = tr.Subject, HtmlBody = tr.HtmlBody };

        _loading = false;
    }

    private TranslationModel Translation(string code)
    {
        if (!_translations.TryGetValue(code, out var t))
        {
            t = new TranslationModel();
            _translations[code] = t;
        }
        return t;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            await TemplateService.SaveAsync(_websiteId, _item!);
            var byLanguage = _otherLanguages.ToDictionary(
                l => l.LanguageCode,
                l =>
                {
                    var t = Translation(l.LanguageCode);
                    return (t.Subject, t.HtmlBody);
                },
                StringComparer.OrdinalIgnoreCase);
            await TemplateService.SetTranslationsAsync(_websiteId, TemplateKey, byLanguage);

            Snackbar.Add(L["email_templates.saved", "Template saved."], Severity.Success);
            _item = await TemplateService.GetAsync(_websiteId, TemplateKey);
            _translations.Clear();
            if (_item is not null)
            {
                foreach (var tr in _item.Translations)
                    _translations[tr.LanguageCode] = new TranslationModel { Subject = tr.Subject, HtmlBody = tr.HtmlBody };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task ResetAsync()
    {
        _saving = true;
        try
        {
            await TemplateService.ResetToDefaultAsync(_websiteId, TemplateKey);
            Snackbar.Add(L["email_templates.reset_done", "Reverted to the default template."], Severity.Success);
            _item = await TemplateService.GetAsync(_websiteId, TemplateKey);
            _translations.Clear();
        }
        finally { _saving = false; }
    }

    private string AccountTypeLabel(EmailAccountType t) => t switch
    {
        EmailAccountType.NoReply => L["email.type_noreply_short", "No-Reply"],
        EmailAccountType.Support => L["email.type_support_short", "Support"],
        EmailAccountType.Sales => L["email.type_sales_short", "Sales"],
        EmailAccountType.Marketing => L["email.type_marketing_short", "Marketing"],
        EmailAccountType.Info => L["email.type_info_short", "Info"],
        _ => L["email.type_custom", "Custom"],
    };
}
