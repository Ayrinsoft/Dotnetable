@page "/messages/email-accounts"
@attribute [Authorize(Policy = RoleKeys.WebsiteEdit)]
@inject IEmailAccountService AccountService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["email_accounts", "Email Accounts"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["email_accounts", "Email Accounts"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["email_accounts.subtitle", "Register one SMTP sender per purpose — No-Reply for OTP/system mail, Support for tickets, Sales for orders, Marketing for newsletters, etc."]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">
            @L["email_accounts.new", "New Account"]
        </MudButton>
    </MudStack>
</MudStack>

@if (!_websiteHasOwn && !_loading)
{
    <DNDismissibleAlert StorageKey="email-accounts.inherited-hint" Class="mb-4">
        @L["email_accounts.inherited_hint", "This website has no accounts of its own yet — outgoing mail uses the master website's accounts until you add one here."]
    </DNDismissibleAlert>
}

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["email_accounts.empty", "No email accounts registered for this website."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var a in _items)
            {
                <tr>
                    <td>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Primary" OnClick="@(() => EditAsync(a))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="@(() => DeleteAsync(a))" />
                        </MudStack>
                    </td>
                    <td>@AccountTypeLabel(a.AccountType)</td>
                    <td>@a.Name</td>
                    <td>@a.EmailAddress</td>
                    <td>@a.MailServer:@a.SmtpPort</td>
                    <td>@(a.IsDefault ? L["yes", "Yes"] : "")</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@(a.Active ? Color.Success : Color.Default)">
                            @(a.Active ? L["active", "Active"] : L["inactive", "Inactive"])
                        </MudChip>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _websiteHasOwn;
    private int _websiteId;
    private List<EmailAccountInfo> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 100 },
            HeaderItems = new()
            {
                new() { ColumnTitle = "", ColumnName = "" },
                new() { ColumnTitle = L["email.account_type", "Type"], ColumnName = "" },
                new() { ColumnTitle = L["name", "Name"], ColumnName = "" },
                new() { ColumnTitle = L["email.from_address", "Address"], ColumnName = "" },
                new() { ColumnTitle = L["email.smtp_server", "SMTP Server"], ColumnName = "" },
                new() { ColumnTitle = L["email.is_default", "Default"], ColumnName = "" },
                new() { ColumnTitle = L["active", "Active"], ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await AccountService.GetForWebsiteAsync(_websiteId);
        _websiteHasOwn = _items.Count > 0;
        _loading = false;
    }

    private async Task AddAsync()
    {
        var model = new EmailAccountInfo { WebsiteID = _websiteId, Active = true, SmtpPort = 587, EnableSSL = true };
        await OpenDialogAsync(model);
    }

    private async Task EditAsync(EmailAccountInfo item) => await OpenDialogAsync(item);

    private async Task OpenDialogAsync(EmailAccountInfo model)
    {
        var parameters = new DialogParameters<EmailAccountDialog> { { x => x.Model, model } };
        var dialog = await DialogService.ShowAsync<EmailAccountDialog>(
            model.EmailAccountID == 0 ? L["email_accounts.new", "New Account"] : L["email_accounts.edit", "Edit Account"],
            parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(L["email_accounts.saved", "Email account saved."], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(EmailAccountInfo item)
    {
        await AccountService.DeleteAsync(item.EmailAccountID);
        Snackbar.Add(L["email_accounts.deleted", "Email account deleted."], Severity.Success);
        await LoadAsync();
    }

    private string AccountTypeLabel(EmailAccountType t) => t switch
    {
        EmailAccountType.NoReply => L["email.type_noreply_short", "No-Reply"],
        EmailAccountType.Support => L["email.type_support_short", "Support"],
        EmailAccountType.Sales => L["email.type_sales_short", "Sales"],
        EmailAccountType.Marketing => L["email.type_marketing_short", "Marketing"],
        EmailAccountType.Info => L["email.type_info_short", "Info"],
        _ => L["email.type_custom", "Custom"],
    };
}
