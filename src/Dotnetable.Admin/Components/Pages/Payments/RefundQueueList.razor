@page "/payments/refunds"
@using Dotnetable.Application.RecordAttachments
@attribute [Authorize(Policy = RoleKeys.PaymentsRefund)]
@inject IPaymentService PaymentService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["payments.refunds", "Bank Refunds"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 flex-wrap gap-2">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["payments.refunds", "Bank Refunds"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["payments.refunds_subtitle", "Outgoing bank refunds: register a transfer here, or start one from an order, then mark it completed after the money is sent."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_websiteId > 0 && _currentMemberId is not null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenRegisterDialog">
                @L["payments.refunds.register", "Register bank refund"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<StatusQueueBar Items="_statusChips"
                SelectedValue="_statusFilter"
                SelectedValueChanged="OnStatusChipChanged"
                ShowAll="true"
                AllLabel="@L["all", "All"]"
                ShowAllCount="true"
                AllCount="_actionableTotal" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="9" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["payments.refunds_empty", "No pending bank refunds."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var r in _items)
            {
                <tr>
                    <td>
                        @if (r.Payment.Order is not null)
                        {
                            <MudLink Href="@($"/orders/{r.Payment.Order.OrderID}")">@r.Payment.Order.OrderNumber</MudLink>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @L["wallets.deposit", "Wallet deposit"] #@r.Payment.PaymentID
                            </MudChip>
                        }
                    </td>
                    <td>@($"{r.Payment.WebsiteClient?.Givenname} {r.Payment.WebsiteClient?.Surname}".Trim())</td>
                    <td>@r.BankAccount?.Bank.Name — @(r.BankAccount?.IBAN ?? r.BankAccount?.CardNumber)</td>
                    <td>@MoneyFormat.GroupWithCode(r.Amount, r.Payment.CurrencyCode)</td>
                    <td>@((PaymentRefundStatus)r.Status)</td>
                    <td>@r.Reason</td>
                    <td>@RefundRecordedByLabel(r)</td>
                    <td>
                        <RecordAttachmentsPanel WebsiteId="r.Payment.WebsiteID"
                                               EntityType="@RecordEntityTypes.PaymentRefund"
                                               EntityId="r.PaymentRefundID"
                                               CanEdit="true"
                                               Compact="true"
                                               Title="@L["attachments.refund", "Bank refund transfer scan"]" />
                    </td>
                    <td>
                        @if (r.Status == (byte)PaymentRefundStatus.Pending)
                        {
                            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => CompleteAsync(r.PaymentRefundID))">
                                @L["payments.mark_completed", "Mark completed"]
                            </MudButton>
                        }
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private int? _currentMemberId;
    private byte? _statusFilter = (byte)PaymentRefundStatus.Pending;
    private List<PaymentRefund> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();
    private List<StatusQueueBar.Item> _statusChips = new();
    private int _actionableTotal;
    private Dictionary<byte, int> _statusCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid)) _currentMemberId = mid;
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["orders.order", "Order"], ColumnName = "" },
                new() { ColumnTitle = L["clients", "Customer"], ColumnName = "" },
                new() { ColumnTitle = L["banks", "Bank account"], ColumnName = "" },
                new() { ColumnTitle = L["orders.total", "Amount"], ColumnName = nameof(PaymentRefund.Amount), HasSort = true },
                new()
                {
                    ColumnTitle = L["status", "Status"],
                    ColumnName = nameof(PaymentRefund.Status),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    SearchText = ((byte)PaymentRefundStatus.Pending).ToString(),
                    OtherDropDownValues = Enum.GetValues<PaymentRefundStatus>()
                        .ToDictionary(v => StatusLabel(v), v => ((byte)v).ToString())
                },
                new() { ColumnTitle = L["payments.reason", "Reason"], ColumnName = nameof(PaymentRefund.Reason), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["payments.recorded_by", "Recorded by"], ColumnName = "" },
                new() { ColumnTitle = L["attachments", "Scans"], ColumnName = "" },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task OnStatusChipChanged(byte? status)
    {
        _statusFilter = status;
        SetGridStatusSearch(status);
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _)
    {
        SyncStatusFromGrid();
        return LoadAsync();
    }

    private void SyncStatusFromGrid()
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(PaymentRefund.Status));
        if (col is null || string.IsNullOrWhiteSpace(col.SearchText))
            _statusFilter = null;
        else if (byte.TryParse(col.SearchText, out var b))
            _statusFilter = b;
    }

    private void SetGridStatusSearch(byte? status)
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(PaymentRefund.Status));
        if (col is not null)
            col.SearchText = status?.ToString() ?? "";
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await RefreshCountsAsync();

        var result = await PaymentService.GetBankRefundsPagedAsync(_websiteId, _statusFilter, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task RefreshCountsAsync()
    {
        _statusCounts = (await PaymentService.GetBankRefundStatusCountsAsync(_websiteId)).ToDictionary(kv => kv.Key, kv => kv.Value);
        _statusChips = PaymentRefundStatusQueues.Actionable
            .Select(s => new StatusQueueBar.Item(
                (byte)s,
                StatusLabel(s),
                _statusCounts.GetValueOrDefault((byte)s)))
            .ToList();
        _actionableTotal = _statusChips.Sum(c => c.Count);
    }

    private string StatusLabel(PaymentRefundStatus s) => s switch
    {
        PaymentRefundStatus.Pending => L["payments.refunds.status.pending", "Pending"],
        PaymentRefundStatus.Completed => L["payments.refunds.status.completed", "Completed"],
        _ => s.ToString(),
    };

    private string RefundRecordedByLabel(PaymentRefund r)
    {
        if (r.CreatedByMember is not null)
        {
            var m = r.CreatedByMember;
            var name = $"{m.Givenname} {m.Surname}".Trim();
            if (string.IsNullOrEmpty(name)) name = m.Username;
            return $"{L["payments.actor.admin", "Admin"]} — {name}";
        }
        if (r.CreatedByMemberID is int mid)
            return $"{L["payments.actor.admin", "Admin"]} — #{mid}";
        return L["payments.actor.admin", "Admin"];
    }

    private async Task OpenRegisterDialog()
    {
        if (_websiteId <= 0 || _currentMemberId is null) return;
        var parameters = new DialogParameters<RecordBankRefundDialog>
        {
            { x => x.WebsiteId, _websiteId },
            { x => x.MemberId, _currentMemberId.Value },
        };
        var dialog = await DialogService.ShowAsync<RecordBankRefundDialog>(
            L["payments.refunds.register", "Register bank refund"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }

    private async Task CompleteAsync(int paymentRefundId)
    {
        if (_currentMemberId is null) return;
        await PaymentService.CompleteBankRefundAsync(paymentRefundId, _currentMemberId.Value);
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }
}
