@page "/payments/refunds"
@attribute [Authorize(Policy = RoleKeys.PaymentsRefund)]
@inject IPaymentService PaymentService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["payments.refunds", "Bank Refunds"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["payments.refunds", "Bank Refunds"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["payments.refunds_subtitle", "Manual bank transfers awaiting completion by an admin."]</MudText>
    </MudStack>
    @if (_isMaster)
    {
        <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                         Label="@L["website", "Website"]" Variant="Variant.Outlined"
                         Dense="true" Style="min-width:180px" />
    }
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_items.Count == 0)
    {
        <div style="text-align:center; padding:32px;"><MudText Color="Color.Secondary">@L["payments.refunds_empty", "No pending bank refunds."]</MudText></div>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead><tr><th>@L["orders.order", "Order"]</th><th>@L["clients", "Customer"]</th><th>@L["banks", "Bank account"]</th><th>@L["orders.total", "Amount"]</th><th>@L["payments.reason", "Reason"]</th><th style="width:1%"></th></tr></thead>
            <tbody>
                @foreach (var r in _items)
                {
                    <tr>
                        <td>@r.Payment.Order?.OrderNumber</td>
                        <td>@($"{r.Payment.WebsiteClient?.Givenname} {r.Payment.WebsiteClient?.Surname}".Trim())</td>
                        <td>@r.BankAccount?.Bank.Name — @(r.BankAccount?.IBAN ?? r.BankAccount?.CardNumber)</td>
                        <td>@r.Amount.ToString("0.##")</td>
                        <td>@r.Reason</td>
                        <td>
                            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => CompleteAsync(r.PaymentRefundID))">@L["payments.mark_completed", "Mark completed"]</MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudPagination Count="@_pageCount" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-3" />
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private int? _currentMemberId;
    private int _page = 1, _pageCount = 1;
    private List<PaymentRefund> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var mid)) _currentMemberId = mid;
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await PaymentService.GetPendingRefundsAsync(_websiteId, new GridQuery { PageIndex = _page, PageSize = 20 });
        _items = result.Items.ToList();
        _pageCount = Math.Max(1, (int)Math.Ceiling(result.TotalCount / 20.0));
        _loading = false;
    }

    private async Task CompleteAsync(int paymentRefundId)
    {
        if (_currentMemberId is null) return;
        await PaymentService.CompleteBankRefundAsync(paymentRefundId, _currentMemberId.Value);
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }
}
