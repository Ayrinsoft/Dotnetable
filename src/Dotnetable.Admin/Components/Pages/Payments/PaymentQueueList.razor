@page "/payments"
@using Dotnetable.Application.RecordAttachments
@using Dotnetable.Admin.Components.Pages.Wallets
@attribute [Authorize(Policy = RoleKeys.PaymentsView)]
@inject IPaymentService PaymentService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["payments", "Payments"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["payments.pending", "Pending Manual Payments"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["payments.subtitle", "Bank-transfer receipts and admin-recorded wallet deposits."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        @if (_canRecord && _websiteId > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenDepositDialog">
                @L["wallets.deposit.new", "Register deposit"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<StatusQueueBar Items="_statusChips"
                SelectedValue="_statusFilter"
                SelectedValueChanged="OnStatusChipChanged"
                ShowAll="true"
                AllLabel="@L["all", "All"]"
                ShowAllCount="true"
                AllCount="_actionableTotal" />

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="8" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["payments.empty", "No pending payments."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in _items)
            {
                <tr>
                    <td>
                        @if (p.Order is not null)
                        {
                            <MudLink Href="@($"/orders/{p.Order.OrderID}")">@p.Order.OrderNumber</MudLink>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @L["wallets.deposit", "Wallet deposit"]
                            </MudChip>
                        }
                    </td>
                    <td>@($"{p.WebsiteClient?.Givenname} {p.WebsiteClient?.Surname}".Trim())</td>
                    <td>@(p.BankAccount?.Bank?.Name ?? p.BankAccount?.Title ?? "—")</td>
                    <td>@p.Amount.ToString("0.##") @p.CurrencyCode</td>
                    <td>@((PaymentStatus)p.Status)</td>
                    <td>
                        <MudText Typo="Typo.body2">@RecordedByLabel(p)</MudText>
                        @if (p.CreatedByMemberID is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="mt-1">
                                @L["wallets.manual_admin", "Registered by admin"]
                            </MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.GatewayRefNumber))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@p.GatewayRefNumber</MudText>
                        }
                        @if (p.VerifiedByMember is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["payments.verified_by", "Verified by"]: @MemberName(p.VerifiedByMember)
                            </MudText>
                        }
                    </td>
                    <td>
                        @if (p.ReceiptFile is not null)
                        {
                            <MudLink Href="@(p.ReceiptFile.CNDUrl)" Target="_blank" Class="me-1">@L["view", "View"]</MudLink>
                        }
                        <RecordAttachmentsPanel WebsiteId="p.WebsiteID"
                                               EntityType="@RecordEntityTypes.Payment"
                                               EntityId="p.PaymentID"
                                               CanEdit="true"
                                               Compact="true"
                                               Title="@L["attachments.payment", "Payment scans"]" />
                    </td>
                    <td>
                        @if (p.Status == (byte)PaymentStatus.Pending)
                        {
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => VerifyAsync(p.PaymentID, true))">@L["approve", "Approve"]</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => VerifyAsync(p.PaymentID, false))">@L["reject", "Reject"]</MudButton>
                            </MudStack>
                        }
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canRecord;
    private int _websiteId;
    private int _memberId;
    private byte? _statusFilter = (byte)PaymentStatus.Pending;
    private List<Payment> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();
    private List<StatusQueueBar.Item> _statusChips = new();
    private int _actionableTotal;
    private Dictionary<byte, int> _statusCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canRecord = AdminPolicies.Allows(user, RoleKeys.PaymentsVerify);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out _memberId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["orders.order", "Order"], ColumnName = "OrderNumber", HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["clients", "Customer"], ColumnName = "" },
                new() { ColumnTitle = L["banks", "Bank"], ColumnName = "" },
                new() { ColumnTitle = L["orders.total", "Amount"], ColumnName = nameof(Payment.Amount), HasSort = true },
                new()
                {
                    ColumnTitle = L["status", "Status"],
                    ColumnName = nameof(Payment.Status),
                    HasSort = true,
                    HasSearch = true,
                    SearchType = SearchColumnType.DropDown,
                    SearchText = ((byte)PaymentStatus.Pending).ToString(),
                    OtherDropDownValues = Enum.GetValues<PaymentStatus>()
                        .ToDictionary(v => v.ToString(), v => ((byte)v).ToString())
                },
                new() { ColumnTitle = L["payments.recorded_by", "Recorded by"], ColumnName = "" },
                new() { ColumnTitle = L["receipt", "Receipt"], ColumnName = "" },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id)
    {
        _websiteId = id;
        await LoadAsync();
    }

    private async Task OnStatusChipChanged(byte? status)
    {
        _statusFilter = status;
        SetGridStatusSearch(status);
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private Task OnGridChanged(GridViewHeaderParameters _)
    {
        SyncStatusFromGrid();
        return LoadAsync();
    }

    private void SyncStatusFromGrid()
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(Payment.Status));
        if (col is null || string.IsNullOrWhiteSpace(col.SearchText))
            _statusFilter = null;
        else if (byte.TryParse(col.SearchText, out var b))
            _statusFilter = b;
    }

    private void SetGridStatusSearch(byte? status)
    {
        var col = _grid.HeaderItems.FirstOrDefault(h => h.ColumnName == nameof(Payment.Status));
        if (col is not null)
            col.SearchText = status?.ToString() ?? "";
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await RefreshCountsAsync();

        // Prefer the explicit queue filter; grid status search is kept in sync for the dropdown UI.
        var status = _statusFilter;
        var result = await PaymentService.GetManualPagedAsync(_websiteId, status, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task RefreshCountsAsync()
    {
        _statusCounts = (await PaymentService.GetManualStatusCountsAsync(_websiteId)).ToDictionary(kv => kv.Key, kv => kv.Value);
        _statusChips = PaymentStatusQueues.Actionable
            .Select(s => new StatusQueueBar.Item(
                (byte)s,
                StatusLabel(s),
                _statusCounts.GetValueOrDefault((byte)s)))
            .ToList();
        _actionableTotal = _statusChips.Sum(c => c.Count);
    }

    private string StatusLabel(PaymentStatus s) => s switch
    {
        PaymentStatus.Pending => L["payments.status.pending", "Pending"],
        PaymentStatus.Paid => L["payments.status.paid", "Paid"],
        PaymentStatus.Rejected => L["payments.status.rejected", "Rejected"],
        PaymentStatus.Refunded => L["payments.status.refunded", "Refunded"],
        _ => s.ToString(),
    };

    private static string MemberName(Member m) =>
        $"{m.Givenname} {m.Surname}".Trim() is { Length: > 0 } name ? name : m.Username;

    private string RecordedByLabel(Payment p)
    {
        if (p.CreatedByMember is not null)
            return $"{L["payments.actor.admin", "Admin"]} — {MemberName(p.CreatedByMember)}";
        if (p.CreatedByMemberID is int mid)
            return $"{L["payments.actor.admin", "Admin"]} — #{mid}";

        var customer = p.WebsiteClient;
        if (customer is not null)
        {
            var name = $"{customer.Givenname} {customer.Surname}".Trim();
            if (string.IsNullOrEmpty(name)) name = customer.Email ?? customer.Cellphone ?? $"#{customer.WebsiteClientID}";
            return $"{L["payments.actor.customer", "Customer"]} — {name}";
        }
        return L["payments.actor.customer", "Customer"];
    }

    private async Task OpenDepositDialog()
    {
        if (_websiteId <= 0 || _memberId <= 0) return;
        var parameters = new DialogParameters<RecordWalletDepositDialog>
        {
            { x => x.WebsiteId, _websiteId },
            { x => x.MemberId, _memberId },
        };
        var dialog = await DialogService.ShowAsync<RecordWalletDepositDialog>(
            L["wallets.deposit.new", "Register deposit"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }

    private async Task VerifyAsync(int paymentId, bool approve)
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var memberId);
        await PaymentService.VerifyAsync(paymentId, memberId, approve, null);
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }
}
