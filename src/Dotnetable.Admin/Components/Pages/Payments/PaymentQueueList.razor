@page "/payments"
@attribute [Authorize(Policy = RoleKeys.PaymentsView)]
@inject IPaymentService PaymentService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["payments", "Payments"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["payments.pending", "Pending Manual Payments"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["payments.subtitle", "Bank-transfer receipts awaiting verification."]</MudText>
    </MudStack>
    @if (_isMaster)
    {
        <WebsiteSelector Value="_websiteId" ValueChanged="OnWebsiteChanged" Websites="_websites"
                         Label="@L["website", "Website"]" Variant="Variant.Outlined"
                         Dense="true" Style="min-width:180px" />
    }
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_items.Count == 0)
    {
        <div style="text-align:center; padding:32px;"><MudText Color="Color.Secondary">@L["payments.empty", "No pending payments."]</MudText></div>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead><tr><th>@L["orders.order", "Order"]</th><th>@L["clients", "Customer"]</th><th>@L["banks", "Bank"]</th><th>@L["orders.total", "Amount"]</th><th>@L["receipt", "Receipt"]</th><th style="width:1%"></th></tr></thead>
            <tbody>
                @foreach (var p in _items)
                {
                    <tr>
                        <td>@p.Order?.OrderNumber</td>
                        <td>@($"{p.WebsiteClient?.Givenname} {p.WebsiteClient?.Surname}".Trim())</td>
                        <td>@p.BankAccount?.Bank.Name</td>
                        <td>@p.Amount.ToString("0.##") @p.CurrencyCode</td>
                        <td>
                            @if (p.ReceiptFile is not null)
                            {
                                <MudLink Href="@(p.ReceiptFile.CNDUrl)" Target="_blank">@L["view", "View"]</MudLink>
                            }
                        </td>
                        <td>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => VerifyAsync(p.PaymentID, true))">@L["approve", "Approve"]</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => VerifyAsync(p.PaymentID, false))">@L["reject", "Reject"]</MudButton>
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudPagination Count="@_pageCount" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-3" />
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private int _websiteId;
    private int _page = 1, _pageCount = 1;
    private List<Payment> _items = new();
    private List<Website> _websites = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();
        await LoadAsync();
    }

    private async Task OnWebsiteChanged(int id) { _websiteId = id; await LoadAsync(); }
    private async Task OnPageChanged(int page) { _page = page; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await PaymentService.GetPendingAsync(_isMaster ? _websiteId : _websiteId, new GridQuery { PageIndex = _page, PageSize = 20 });
        _items = result.Items.ToList();
        _pageCount = Math.Max(1, (int)Math.Ceiling(result.TotalCount / 20.0));
        _loading = false;
    }

    private async Task VerifyAsync(int paymentId, bool approve)
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out var memberId);
        await PaymentService.VerifyAsync(paymentId, memberId, approve, null);
        Snackbar.Add(L["saved", "Saved."], Severity.Success);
        await LoadAsync();
    }
}
