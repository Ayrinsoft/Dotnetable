@page "/members/new"
@page "/members/{Id:int}"
@attribute [Authorize(Policy = RoleKeys.MembersView)]
@inject IMemberService MemberService
@inject IPolicyService PolicyService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@(_isNew ? L["members.new", "New Member"] : L["members.edit", "Edit Member"]) />

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pb-2" />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@(_isNew ? L["members.new", "New Member"] : L["members.edit", "Edit Member"])</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_isNew ? L["members.new_subtitle", "Create a new member account"] : $"{L["members.editing", "Editing member"]} #{Id}")
        </MudText>
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_member is not null)
{
    <MudForm @ref="_form">
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                        @L["account", "Account"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_member.Username" Label="@L["username", "Username"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_member.Email" Label="@L["email", "Email"]"
                                          Variant="Variant.Outlined" InputType="InputType.Email" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_password" Label="@(_isNew ? L["password", "Password"] : L["password_change", "New Password (leave blank to keep)"])"
                                          Variant="Variant.Outlined" InputType="InputType.Password"
                                          Required="@_isNew" RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (_isMaster && _isNew)
                            {
                                <WebsiteSelector Value="_member.WebsiteID" ValueChanged="OnWebsiteChanged" Websites="_websites"
                                                 Label="@L["website", "Website"]" Variant="Variant.Outlined" Required="true" />
                            }
                            else
                            {
                                <MudTextField Value="@($"#{_member.WebsiteID}")" Label="@L["website", "Website"]"
                                              Variant="Variant.Outlined" ReadOnly="true" Disabled="true" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Policy" Value="@GetSelectedPolicy()" ValueChanged="OnPolicyChanged"
                                             SearchFunc="SearchPolicies" ToStringFunc="@(p => p?.Title ?? string.Empty)"
                                             Label="@L["access_level", "Access Level"]" Variant="Variant.Outlined"
                                             Required="true" Disabled="@_isSelf"
                                             RequiredError="@L["required", "This field is required."]"
                                             Clearable="false" CoerceText="false" ResetValueOnEmptyText="true"
                                             HelperText="@(_isSelf ? L["members.self_access_locked", "You cannot change your own access level."]
                                                          : _policies.Count == 0 ? L["members.no_access_levels", "This website has no access levels you can assign."] : null)" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Class="me-1" />
                        @L["profile", "Profile"]
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_member.Givenname" Label="@L["given_name", "Given Name"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_member.Surname" Label="@L["surname", "Surname"]"
                                          Variant="Variant.Outlined" Required="true"
                                          RequiredError="@L["required", "This field is required."]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_member.CountryCode" Label="@L["country_code", "Country Code"]"
                                          Variant="Variant.Outlined" MaxLength="3"
                                          Placeholder="@(_defaultPhoneCountryCode ?? "")" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_member.CellphoneNumber" Label="@L["cellphone", "Cellphone"]"
                                          Variant="Variant.Outlined" MaxLength="12" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="bool?" @bind-Value="_member.Gender" Label="@L["gender", "Gender"]" Variant="Variant.Outlined">
                                <MudSelectItem T="bool?" Value="@((bool?)null)">—</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)true)">@L["male", "Male"]</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)false)">@L["female", "Female"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="border rounded-lg pa-6">
                    <MudStack Spacing="3">
                        <MudSwitch T="bool" @bind-Value="_member.Active" Color="Color.Primary" Disabled="@_isSelf"
                                   Label="@(_member.Active ? L["active_hint", "Active — can sign in"] : L["inactive_hint", "Inactive — cannot sign in"])" />
                        @if (_isSelf)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["members.self_active_locked", "You cannot deactivate your own account."]
                            </MudText>
                        }
                        <MudSwitch T="bool" @bind-Value="_member.IsSiteAdmin" Color="Color.Primary" Disabled="@_isSelf"
                                   Label="@L["members.site_admin", "Site admin — receives site notification emails and inbox items"]" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <DNValidationSummary Errors="_formErrors" />

        <MudStack Row="true" Class="mt-4" Spacing="2">
            @if (_canSave)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="@_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @(_isNew ? L["members.create", "Create Member"] : L["save", "Save Changes"])
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Href="/members">
                @L["cancel", "Cancel"]
            </MudButton>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm _form = null!;
    private Member? _member;
    private string _password = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _isMaster;
    private bool _canSave;
    private bool _isSelf;
    private int _websiteId;
    private int _currentMemberId;
    private int _originalPolicyId;
    private bool _originalActive;
    private string? _defaultPhoneCountryCode;
    private List<Website> _websites = new();
    private List<Policy> _policies = new();
    private HashSet<int> _grantablePolicyIds = new();
    private string[]? _formErrors;
    private bool _isNew => Id == 0;

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["dashboard", "Dashboard"], "/"),
        new(L["members", "Members"], "/members"),
        new(_isNew ? L["new", "New"] : $"#{Id}", null, true),
    };

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        // Creating requires the insert permission; editing an existing member requires edit.
        _canSave = AdminPolicies.Allows(user, _isNew ? RoleKeys.MembersInsert : RoleKeys.MembersEdit);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        int.TryParse(user.FindFirst(AdminClaimTypes.MemberId)?.Value, out _currentMemberId);

        if (_isNew)
        {
            _member = new Member
            {
                Active = true,
                WebsiteID = _websiteId,
                CellphoneNumber = string.Empty,
                CountryCode = string.Empty,
                RegisterDate = DateOnly.FromDateTime(DateTime.UtcNow),
            };
            if (_isMaster)
            {
                _websites = (await WebsiteService.GetAllAsync()).ToList();
                _member.WebsiteID = _websites.FirstOrDefault()?.WebsiteID ?? AppConstants.MasterWebsiteId;
            }
            await ApplyDefaultPhoneCountryAsync(_member.WebsiteID);
        }
        else
        {
            _member = await MemberService.GetByIdAsync(Id);
            if (_member is null || (!_isMaster && _member.WebsiteID != _websiteId))
            {
                Nav.NavigateTo("/members");
                return;
            }
            _isSelf = _member.MemberID == _currentMemberId;
            _originalPolicyId = _member.PolicyID;
            _originalActive = _member.Active;
            await ApplyDefaultPhoneCountryAsync(_member.WebsiteID);
        }

        await LoadPoliciesAsync();
        _loading = false;
    }

    private async Task ApplyDefaultPhoneCountryAsync(int websiteId)
    {
        if (websiteId <= 0) return;
        _defaultPhoneCountryCode = await WebsiteService.GetDefaultPhoneCountryCodeAsync(websiteId);
        if (_isNew && _member is not null && string.IsNullOrWhiteSpace(_member.CountryCode))
            _member.CountryCode = _defaultPhoneCountryCode ?? string.Empty;
    }

    private async Task LoadPoliciesAsync()
    {
        // A non-master admin can only assign access levels whose roles they hold themselves,
        // so they cannot escalate privileges through another (or a new) account.
        _policies = (await PolicyService.GetGrantablePoliciesAsync(_member!.WebsiteID, _currentMemberId, _isMaster)).ToList();

        // Master can also grant access levels defined on the master website itself,
        // even when creating/editing a member on another site. A non-master admin
        // is restricted to policies belonging to its own website only.
        if (_isMaster && _member.WebsiteID != AppConstants.MasterWebsiteId)
        {
            var masterPolicies = await PolicyService.GetByWebsiteAsync(AppConstants.MasterWebsiteId);
            _policies.AddRange(masterPolicies.Where(mp => _policies.All(p => p.PolicyID != mp.PolicyID)));
        }

        _grantablePolicyIds = _policies.Select(p => p.PolicyID).ToHashSet();

        if (!_isNew && !_policies.Any(p => p.PolicyID == _member.PolicyID))
        {
            // Keep an out-of-scope policy (e.g. a master-only access level granted earlier)
            // visible and selected rather than silently reassigning it on save.
            var current = await PolicyService.GetByIdAsync(_member.PolicyID);
            if (current is not null) _policies.Add(current);
        }
        if (!_policies.Any(p => p.PolicyID == _member.PolicyID))
            _member.PolicyID = _policies.FirstOrDefault()?.PolicyID ?? 0;
    }

    private async Task OnWebsiteChanged(int id)
    {
        _member!.WebsiteID = id;
        if (_isNew) _member.CountryCode = string.Empty;
        await ApplyDefaultPhoneCountryAsync(id);
        await LoadPoliciesAsync();
    }

    private Policy? GetSelectedPolicy() =>
        _member is null ? null : _policies.FirstOrDefault(p => p.PolicyID == _member.PolicyID);

    private void OnPolicyChanged(Policy? policy)
    {
        if (_member is null || policy is null) return;
        _member.PolicyID = policy.PolicyID;
    }

    private Task<IEnumerable<Policy>> SearchPolicies(string value, CancellationToken ct)
    {
        IEnumerable<Policy> q = _policies.OrderBy(p => p.Title);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(p => p.Title.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }

    private async Task SaveAsync()
    {
        if (!_canSave) return; // Guard against a stale/forged client state.

        await _form.ValidateAsync();
        _formErrors = _form.Errors;
        if (!_form.IsValid) return;

        if (_isSelf)
        {
            // Members can never change their own access level or active flag,
            // regardless of what a tampered UI state claims.
            _member!.PolicyID = _originalPolicyId;
            _member.Active = _originalActive;
        }
        else if (!_isMaster && _member!.PolicyID != _originalPolicyId && !_grantablePolicyIds.Contains(_member.PolicyID))
        {
            // Keeping an out-of-scope access level already on the member is fine;
            // granting one whose roles the current admin doesn't hold is not.
            Snackbar.Add(L["members.access_level_not_grantable", "You cannot assign an access level with permissions you don't have yourself."], Severity.Error);
            return;
        }

        if (_member!.PolicyID == 0)
        {
            Snackbar.Add(L["members.select_access_level", "Select an access level. This website has none you can assign — create one first."], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (_isNew)
            {
                await MemberService.CreateAsync(_member, _password);
                Snackbar.Add(L["members.created", "Member created successfully."], Severity.Success);
            }
            else
            {
                await MemberService.UpdateAsync(_member);
                if (!string.IsNullOrWhiteSpace(_password))
                    await MemberService.ChangePasswordAsync(_member.MemberID, _password);
                Snackbar.Add(L["saved", "Changes saved successfully."], Severity.Success);
            }
            Nav.NavigateTo("/members");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["save_failed", "Save failed"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
