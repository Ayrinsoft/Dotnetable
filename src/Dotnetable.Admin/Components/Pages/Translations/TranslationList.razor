@page "/website/translations"
@page "/translations"
@attribute [Authorize(Policy = RoleKeys.LocalizationEdit)]
@using Dotnetable.Application.DTOs
@inject ILocalizationService LocalizationService
@inject ILanguageService LanguageService
@inject IWebsiteService WebsiteService
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IPageLocalizer L
@inject NavigationManager Navigation

<DNPageTitle Title=@(_isAdminRoute ? L["translations.admin", "Admin Translations"] : L["website_translations", "Translations"]) />

@* ── Page header ──────────────────────────────────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">
            @(_isAdminRoute ? L["translations.admin", "Admin Translations"] : L["website_translations", "Translations"])
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_isAdminRoute
                ? L["translation.subtitle_admin", "UI strings for the admin panel only (WebsiteID empty). These never appear under Website → Translations — including on master site 1."]
                : L["translation.subtitle_site", "Custom key/value strings for this website’s storefront and themes only. Not admin panel labels — add any keys you need, then translate them for each language you enabled under Website → Languages."])
        </MudText>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @* Site translations: master can manage any website. Admin translations (/translations) stay on site 1. *@
        @if (_isMaster && !_isAdminRoute)
        {
            <WebsiteSelector Value="@(_scopeWebsiteId ?? 0)" ValueChanged="OnWebsiteChanged" Websites="_websites"
                             Label="@L["website", "Website"]" Variant="Variant.Outlined"
                             Dense="true" Style="min-width:180px" />
        }
        <MudAutocomplete T="string" Value="_languageCode" ValueChanged="OnLanguageChanged" Label="@L["language", "Language"]"
                          SearchFunc="SearchLanguages" ToStringFunc="@(code => _languages.FirstOrDefault(l => l.Code == code).Label ?? code)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="width:200px;" AnchorOrigin="Origin.BottomLeft"
                          CoerceText="true" ResetValueOnEmptyText="false" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddKeyAsync" Disabled="@(_busy || string.IsNullOrEmpty(_languageCode))">
            @L["translation.add_key", "Add Key"]
        </MudButton>
        <MudMenu Label="@L["translation.export", "Export CSV"]" Variant="Variant.Outlined" Color="Color.Primary"
                 StartIcon="@Icons.Material.Filled.Download" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 Disabled="_busy">
            <MudMenuItem OnClick="@(() => ExportAsync(false))">@L["translation.export_all", "All keys"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => ExportAsync(true))">@L["translation.export_untranslated", "Untranslated only"]</MudMenuItem>
        </MudMenu>
        <MudFileUpload T="IBrowserFile" FilesChanged="ImportAsync" Accept=".csv" Class="d-inline-flex">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload"
                           Disabled="_busy">@L["translation.import", "Import CSV"]</MudButton>
            </ActivatorContent>
        </MudFileUpload>
    </MudStack>
</MudStack>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Outlined">
    @if (string.Equals(_languageCode, _defaultLanguageCode, StringComparison.OrdinalIgnoreCase))
    {
        @L["translation.hint_default", "You are editing the site default language. New keys use this value as the fallback for every other language until translated."]
    }
    else
    {
        @L["translation.hint_other", "Export downloads a Key,Default,Value CSV for the selected language. Translate the Value column, keep the Key column unchanged, then import it back. Or edit values inline below."]
    }
</MudAlert>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_translations.Count == 0)
        {
            <tr>
                <td colspan="2" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@($"{L["translation.empty", "No translations found for"]} \"{_languageCode}\".")</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var entry in _translations)
            {
                <tr @key="entry.Key">
                    <td style="font-family:monospace; white-space:nowrap;">@entry.Key</td>
                    <td>
                        <MudTextField T="string" Value="@entry.Value"
                                      ValueChanged="@(v => SaveAsync(entry.Key, v))"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _isMaster;
    private bool _isAdminRoute;
    /// <summary>Null = admin panel catalog; otherwise the website being edited (site translations route).</summary>
    private int? _scopeWebsiteId;
    private string _defaultLanguageCode = "en";
    private List<Website> _websites = new();
    private string _languageCode = "en";
    private List<TranslationEntry> _translations = new();

    private const long MaxImportBytes = 16L * 1024 * 1024; // 16 MB

    private GridViewHeaderParameters _grid = new();

    private (string Code, string Label)[] _languages = Array.Empty<(string, string)>();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        _isAdminRoute = string.Equals(path, "/translations", StringComparison.OrdinalIgnoreCase);

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out var claimWebsiteId);

        if (_isMaster)
            _websites = (await WebsiteService.GetAllAsync()).ToList();

        // Admin Translations → WebsiteID null. Site translations → claim / selector website id.
        if (_isAdminRoute)
            _scopeWebsiteId = null;
        else
            _scopeWebsiteId = claimWebsiteId > 0 ? claimWebsiteId : AppConstants.MasterWebsiteId;

        await ResolveDefaultLanguageAsync();
        await LoadLanguagesAsync();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["key", "Key"], ColumnName = "Key", HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["value", "Value"], ColumnName = "Value", HasSearch = true },
            }
        };

        await LoadAsync();
    }

    private async Task ResolveDefaultLanguageAsync()
    {
        if (_isAdminRoute)
        {
            var catalog = await LanguageService.GetActiveCatalogAsync();
            var def = catalog.FirstOrDefault(l => l.IsDefault) ?? catalog.FirstOrDefault();
            _defaultLanguageCode = def?.LanguageCode ?? "en";
            _languageCode = _defaultLanguageCode;
            return;
        }

        var siteId = _scopeWebsiteId ?? 0;
        var site = await WebsiteService.GetByIdAsync(siteId);
        _defaultLanguageCode = string.IsNullOrWhiteSpace(site?.DefaultLanguageCode) ? "en" : site!.DefaultLanguageCode.Trim().ToLowerInvariant();

        var websiteLangs = await LanguageService.GetActiveForWebsiteAsync(siteId);
        var siteDefault = websiteLangs.FirstOrDefault(l => l.IsDefault);
        if (siteDefault is not null)
            _defaultLanguageCode = siteDefault.LanguageCode;

        _languageCode = _defaultLanguageCode;
    }

    private async Task LoadLanguagesAsync()
    {
        // Admin Translations → active admin catalog. Website Translations → that site's languages only.
        var source = _isAdminRoute
            ? await LanguageService.GetActiveCatalogAsync()
            : await LanguageService.GetActiveForWebsiteAsync(_scopeWebsiteId ?? 0);

        _languages = source.Select(x => (x.LanguageCode, x.Name)).ToArray();
        if (_languages.Length == 0)
            _languages = [(_defaultLanguageCode, _defaultLanguageCode)];

        var defaultCode = source.FirstOrDefault(l => l.IsDefault)?.LanguageCode ?? _defaultLanguageCode;
        if (source.Any(l => l.IsDefault))
            _defaultLanguageCode = defaultCode;

        if (!_languages.Any(l => string.Equals(l.Code, _languageCode, StringComparison.OrdinalIgnoreCase)))
            _languageCode = _languages.Any(l => string.Equals(l.Code, defaultCode, StringComparison.OrdinalIgnoreCase))
                ? defaultCode
                : _languages[0].Code;
    }

    private async Task OnWebsiteChanged(int id)
    {
        _scopeWebsiteId = id;
        await ResolveDefaultLanguageAsync();
        await LoadLanguagesAsync();
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private async Task OnLanguageChanged(string code)
    {
        if (string.IsNullOrEmpty(code) || !_languages.Any(l => l.Code == code)) return;
        _languageCode = code;
        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private Task<IEnumerable<string>> SearchLanguages(string value, CancellationToken ct)
    {
        var query = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Label.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.Code.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Select(l => l.Code));
    }

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await LocalizationService.GetPagedAsync(_scopeWebsiteId, _languageCode, _grid.ToQuery());
        _translations = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task ExportAsync(bool untranslatedOnly)
    {
        _busy = true;
        try
        {
            var bytes = await LocalizationService.ExportCsvAsync(_scopeWebsiteId, _languageCode, untranslatedOnly);
            var suffix = untranslatedOnly ? "-untranslated" : "";
            var scopeTag = _scopeWebsiteId is int w ? $"w{w}" : "admin";
            var fileName = $"translations-{scopeTag}-{_languageCode}{suffix}.csv";
            await JS.InvokeVoidAsync("dotnetableFile.download", fileName, Convert.ToBase64String(bytes), "text/csv");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null) return;
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await LocalizationService.ImportCsvAsync(_scopeWebsiteId, _languageCode, buffer);

            var summary = $"Imported \"{_languageCode}\": {result.Added} added, {result.Updated} updated, "
                        + $"{result.Unchanged} unchanged, {result.Skipped} skipped.";
            Snackbar.Add(summary, result.HasErrors ? Severity.Warning : Severity.Success);
            foreach (var error in result.Errors.Take(5))
                Snackbar.Add(error, Severity.Warning);
            if (result.Errors.Count > 5)
                Snackbar.Add($"…and {result.Errors.Count - 5} more issue(s).", Severity.Warning);

            _grid.Pagination.PageIndex = 1;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task AddKeyAsync()
    {
        var parameters = new DialogParameters<AddTranslationKeyDialog>
        {
            { x => x.WebsiteId, _scopeWebsiteId },
            { x => x.LanguageCode, _languageCode },
            { x => x.IsDefaultLanguage, string.Equals(_languageCode, _defaultLanguageCode, StringComparison.OrdinalIgnoreCase) },
            { x => x.DefaultLanguageCode, _defaultLanguageCode },
        };
        var dialog = await DialogService.ShowAsync<AddTranslationKeyDialog>(L["translation.add_key", "Add Key"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        _grid.Pagination.PageIndex = 1;
        await LoadAsync();
    }

    private async Task SaveAsync(string key, string value)
    {
        try
        {
            await LocalizationService.SetAsync(_scopeWebsiteId, _languageCode, key, value);
            if (string.Equals(_languageCode, _defaultLanguageCode, StringComparison.OrdinalIgnoreCase))
                await LocalizationService.SetDefaultValueAsync(_scopeWebsiteId, key, value);
            Snackbar.Add($"Saved \"{key}\".", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }
}
