@page "/sales/coupons"
@attribute [Authorize(Policy = RoleKeys.CouponsView)]
@inject ICouponService CouponService
@inject IWebsiteService WebsiteService
@inject AuthenticationStateProvider AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPageLocalizer L

<DNPageTitle Title=@L["coupons", "Coupons"] />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Class="fw-bold">@L["coupons", "Coupons"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["coupons.subtitle", "Discount codes for storefront carts and orders."]</MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_isMaster)
        {
            <MudSelect T="int" @bind-Value="_websiteId" Label="@L["website", "Website"]" Variant="Variant.Outlined"
                       Dense="true" Style="min-width:180px" SelectedValuesChanged="OnWebsiteChanged">
                @foreach (var w in _websites)
                {
                    <MudSelectItem T="int" Value="@w.WebsiteID">@w.TradeName</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
                @L["coupons.new", "New Coupon"]
            </MudButton>
        }
    </MudStack>
</MudStack>

<MudPaper Elevation="0" Class="app-card rounded-lg pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    <DNGridView GridHeaderParams="_grid" OnSearchChanged="OnGridChanged">
        @if (_items.Count == 0)
        {
            <tr>
                <td colspan="9" style="text-align:center; padding:32px;">
                    <MudText Color="Color.Secondary">@L["coupons.empty", "No coupons yet."]</MudText>
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in _items)
            {
                <tr>
                    <td><code>@c.Code</code></td>
                    <td>@(c.DiscountType == DiscountTypes.Percent ? $"{c.DiscountValue:0.##}%" : $"${c.DiscountValue:0.00}")</td>
                    <td>@c.MinOrderAmountUsd.ToString("0.00")</td>
                    <td>@(c.UsageLimitTotal is int t ? $"{c.TimesUsed}/{t}" : c.TimesUsed.ToString())</td>
                    <td>@(c.StartsAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>@(c.EndsAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@(c.IsActive ? Color.Success : Color.Default)">
                            @(c.IsActive ? L["active", "Active"] : L["inactive", "Inactive"])
                        </MudChip>
                    </td>
                    <td>
                        <MudStack Row="true" Spacing="0">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(c))" />
                            }
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(c))" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        }
    </DNGridView>
</MudPaper>

@code {
    private bool _loading = true;
    private bool _isMaster;
    private bool _canInsert, _canEdit, _canDelete;
    private int _websiteId;
    private List<Coupon> _items = new();
    private List<Website> _websites = new();
    private GridViewHeaderParameters _grid = new();

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        _canInsert = AdminPolicies.Allows(user, RoleKeys.CouponsInsert);
        _canEdit = AdminPolicies.Allows(user, RoleKeys.CouponsEdit);
        _canDelete = AdminPolicies.Allows(user, RoleKeys.CouponsDelete);
        int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out _websiteId);
        if (_isMaster) _websites = (await WebsiteService.GetAllAsync()).ToList();

        _grid = new GridViewHeaderParameters
        {
            Pagination = new PaginationModel { PageSize = 25 },
            HeaderItems = new()
            {
                new() { ColumnTitle = L["code", "Code"], ColumnName = nameof(Coupon.Code), HasSort = true, HasSearch = true },
                new() { ColumnTitle = L["discount", "Discount"], ColumnName = "" },
                new() { ColumnTitle = L["min_order", "Min. Order"], ColumnName = "" },
                new() { ColumnTitle = L["usage", "Usage"], ColumnName = "" },
                new() { ColumnTitle = L["starts_at", "Starts"], ColumnName = "" },
                new() { ColumnTitle = L["ends_at", "Ends"], ColumnName = "" },
                new() { ColumnTitle = L["status", "Status"], ColumnName = nameof(Coupon.IsActive) },
                new() { ColumnTitle = "", ColumnName = "" },
            }
        };

        await LoadAsync();
    }

    private async Task OnWebsiteChanged(IEnumerable<int> _) => await LoadAsync();

    private Task OnGridChanged(GridViewHeaderParameters _) => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await CouponService.GetPagedAsync(_websiteId, _grid.ToQuery());
        _items = result.Items.ToList();
        _grid.Pagination.MaxLength = result.TotalCount;
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (await ShowDialogAsync(new Coupon { WebsiteID = _websiteId, IsActive = true }, true)) await LoadAsync();
    }

    private async Task EditAsync(Coupon c)
    {
        var copy = new Coupon
        {
            CouponID = c.CouponID,
            WebsiteID = c.WebsiteID,
            Code = c.Code,
            DiscountType = c.DiscountType,
            DiscountValue = c.DiscountValue,
            MinOrderAmountUsd = c.MinOrderAmountUsd,
            MaxDiscountAmountUsd = c.MaxDiscountAmountUsd,
            UsageLimitTotal = c.UsageLimitTotal,
            UsageLimitPerClient = c.UsageLimitPerClient,
            TimesUsed = c.TimesUsed,
            StartsAt = c.StartsAt,
            EndsAt = c.EndsAt,
            IsActive = c.IsActive,
        };
        if (await ShowDialogAsync(copy, false)) await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(Coupon model, bool isNew)
    {
        var parameters = new DialogParameters<CouponDialog> { { x => x.Model, model }, { x => x.IsNew, isNew } };
        var dialog = await DialogService.ShowAsync<CouponDialog>(
            isNew ? L["coupons.new", "New Coupon"] : L["coupons.edit", "Edit Coupon"], parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task DeleteAsync(Coupon c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["coupons.delete", "Delete coupon"],
            L["coupons.delete_confirm", "Delete this coupon? This cannot be undone."],
            yesText: L["delete", "Delete"], cancelText: L["cancel", "Cancel"]);
        if (confirmed != true) return;
        await CouponService.DeleteAsync(c.CouponID);
        Snackbar.Add(L["deleted", "Deleted."], Severity.Success);
        await LoadAsync();
    }
}
