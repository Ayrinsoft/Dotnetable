@* Nullable money input with thousand-separator display. *@

@if (Min is decimal minVal)
{
    <MudNumericField T="decimal?"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     Label="@Label"
                     Variant="Variant"
                     Min="minVal"
                     Disabled="Disabled"
                     Required="Required"
                     Class="@Class"
                     Style="@Style"
                     Margin="Margin"
                     Immediate="Immediate"
                     HelperText="@HelperText"
                     Error="Error"
                     ErrorText="@ErrorText"
                     HideSpinButtons="HideSpinButtons"
                     Clearable="Clearable"
                     Format="@MoneyFormat.FieldFormat(DecimalDigits)"
                     Culture="@MoneyFormat.DisplayCulture" />
}
else
{
    <MudNumericField T="decimal?"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     Label="@Label"
                     Variant="Variant"
                     Disabled="Disabled"
                     Required="Required"
                     Class="@Class"
                     Style="@Style"
                     Margin="Margin"
                     Immediate="Immediate"
                     HelperText="@HelperText"
                     Error="Error"
                     ErrorText="@ErrorText"
                     HideSpinButtons="HideSpinButtons"
                     Clearable="Clearable"
                     Format="@MoneyFormat.FieldFormat(DecimalDigits)"
                     Culture="@MoneyFormat.DisplayCulture" />
}

@code {
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool HideSpinButtons { get; set; } = true;
    [Parameter] public decimal? Min { get; set; } = 0m;
    [Parameter] public int DecimalDigits { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
}
