@using Dotnetable.Domain.Entities

<MudAutocomplete T="Country" Value="_selected" ValueChanged="OnSelected"
                 SearchFunc="SearchAsync" ToStringFunc="@(c => c?.Title ?? string.Empty)"
                 Label="@Label" Variant="@Variant" Margin="@Margin" Dense="@Dense" Style="@Style" Class="@Class"
                 Required="@Required" RequiredError="@RequiredError" Disabled="@Disabled" ReadOnly="@ReadOnly"
                 Clearable="@Clearable" CoerceText="false" ResetValueOnEmptyText="true"
                 HelperText="@HelperText" />

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public List<Country> Countries { get; set; } = new();
    [Parameter] public string? Label { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public bool Dense { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public string? HelperText { get; set; }

    private Country? _selected;

    protected override void OnParametersSet()
    {
        if (_selected?.CountryID != Value)
            _selected = Value is int id ? Countries.FirstOrDefault(c => c.CountryID == id) : null;
    }

    private async Task OnSelected(Country? country)
    {
        _selected = country;
        var id = country?.CountryID;
        if (id != Value)
            await ValueChanged.InvokeAsync(id);
    }

    private Task<IEnumerable<Country>> SearchAsync(string value, CancellationToken ct)
    {
        IEnumerable<Country> q = Countries.OrderBy(c => c.Title);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var needle = value.Trim();
            q = q.Where(c =>
                c.Title.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || (c.CountryCode?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
                || c.CountryID.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(q);
    }
}
