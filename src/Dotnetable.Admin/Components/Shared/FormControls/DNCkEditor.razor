@using System.Text.RegularExpressions
@using CkEditor5.Blazor
@using CkEditor5.Blazor.Models
@inject IPageLocalizer L
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
  CkEditor wrapper with optional RTL/LTR for *saved* HTML:
  - Toolbar buttons remember a direction and push
    <div dir="rtl|ltr" style="direction:…">…</div>
    into the bound Value (what Save persists).
  - The live editor keeps unwrapped HTML so typing is stable.
  - On reload, if the DB HTML already has that wrapper, direction is restored
    (toolbar pressed state + visual dir on the editable).
*@
<div class="dn-ckeditor" @ref="_host">
    <CkEditor @ref="_editor"
              Id="@Id"
              Class="@Class"
              Value="@_editorHtml"
              OnValueChanged="OnEditorHtmlChanged"
              Configuration="@_configuration"
              IsReadOnly="IsReadOnly" />
</div>

@code {
    [Parameter] public string? ContentLanguage { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> OnValueChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private ElementReference _host;
    private CkEditor? _editor;
    private DotNetObjectReference<DNCkEditor>? _dotNetRef;
    private CkEditorConfiguration _configuration = CkEditorConfiguration.Default;
    private string? _appliedLanguage;

    /// <summary>HTML inside the editor (no outer direction wrapper).</summary>
    private string _editorHtml = "";

    /// <summary>Last HTML sent to the parent (often wrapped).</summary>
    private string _lastEmittedToParent = "";

    /// <summary>
    /// User-chosen (or DB-restored) direction for save output.
    /// null = do not wrap on save.
    /// </summary>
    private string? _saveDirection;

    private bool _toolbarAttached;
    private bool _seeded;
    private string? _visualAppliedFor;

    private static readonly Regex OuterDirectionDiv = new(
        @"^\s*<div\b(?=[^>]*\b(?:style\s*=\s*[""'][^""']*\bdirection\s*:\s*(?<dirStyle>rtl|ltr)|dir\s*=\s*[""'](?<dirAttr>rtl|ltr)[""']))[^>]*>\s*(?<inner>[\s\S]*)\s*</div>\s*$",
        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant | RegexOptions.Compiled);

    protected override void OnParametersSet()
    {
        ConfigureLanguage();

        var incoming = Value ?? "";

        // Echo of what we just emitted — ignore.
        if (string.Equals(incoming, _lastEmittedToParent, StringComparison.Ordinal))
            return;

        var incomingDir = DetectDirection(incoming);
        var incomingBody = Unwrap(incoming);

        // Stale parent Value after we already applied a direction (parent not updated yet):
        // same body, no dir on Value, but we have _saveDirection — do NOT wipe direction.
        if (_seeded
            && _saveDirection is not null
            && incomingDir is null
            && string.Equals(incomingBody, _editorHtml, StringComparison.Ordinal))
        {
            return;
        }

        // Real external change (load from DB, media insert, navigate).
        _saveDirection = incomingDir;
        if (!string.Equals(incomingBody, _editorHtml, StringComparison.Ordinal))
            _editorHtml = incomingBody;
        _lastEmittedToParent = incoming;
        _seeded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsReadOnly) return;

        if (firstRender && !_toolbarAttached)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync(
                    "dnCkEditor.attachDirectionToolbar",
                    _host,
                    new
                    {
                        rtl = "RTL",
                        ltr = "LTR",
                        rtlTitle = L["editor.direction_rtl", "Save content as right-to-left"],
                        ltrTitle = L["editor.direction_ltr", "Save content as left-to-right"],
                    },
                    _saveDirection ?? "",
                    _dotNetRef);
                _toolbarAttached = true;
            }
            catch
            {
                _toolbarAttached = false;
            }
        }

        // Once after load/restore — not on every re-render (would fight the caret).
        if (_toolbarAttached
            && _saveDirection is not null
            && !string.Equals(_visualAppliedFor, _saveDirection, StringComparison.Ordinal))
        {
            try
            {
                await JS.InvokeVoidAsync("dnCkEditor.applyVisualDirection", _host, _saveDirection);
                _visualAppliedFor = _saveDirection;
            }
            catch
            {
                // editor may not be ready yet; toolbar inject also applies visual dir
            }
        }
    }

    private void ConfigureLanguage()
    {
        var lang = NormalizeLanguage(ContentLanguage) ?? NormalizeLanguage(L.LanguageCode) ?? "en";
        if (string.Equals(_appliedLanguage, lang, StringComparison.OrdinalIgnoreCase)
            && _configuration.ContainsKey("language"))
            return;

        _appliedLanguage = lang;
        var config = CkEditorConfiguration.Default;
        config["language"] = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["ui"] = "en",
            ["content"] = lang,
        };
        _configuration = config;
    }

    private Task OnEditorHtmlChanged(string data)
    {
        _editorHtml = data ?? "";
        _seeded = true;
        return EmitToParentAsync(BuildSaveHtml(_editorHtml));
    }

    /// <summary>Toolbar RTL/LTR: set save direction and push wrapped HTML into the bound model.</summary>
    [JSInvokable]
    public async Task NotifyDirectionApplied(string html, string direction)
    {
        _saveDirection = NormalizeDir(direction);
        if (!string.IsNullOrWhiteSpace(html))
            _editorHtml = Unwrap(html);
        _seeded = true;

        var forParent = BuildSaveHtml(_editorHtml);
        await EmitToParentAsync(forParent);

        // Keep button pressed + visual dir even if schema never sees a wrapper.
        try
        {
            await JS.InvokeVoidAsync("dnCkEditor.setActiveDirection", _host, _saveDirection);
            await JS.InvokeVoidAsync("dnCkEditor.applyVisualDirection", _host, _saveDirection);
            _visualAppliedFor = _saveDirection;
        }
        catch
        {
            // ignore
        }
    }

    [JSInvokable]
    public Task ApplyDirectionFromJs(string direction) =>
        NotifyDirectionApplied(_editorHtml, direction);

    private async Task EmitToParentAsync(string htmlForParent)
    {
        htmlForParent ??= "";
        _lastEmittedToParent = htmlForParent;
        if (OnValueChanged.HasDelegate)
            await OnValueChanged.InvokeAsync(htmlForParent);
    }

    /// <summary>
    /// HTML that is bound for Save. Wrapped only when the user chose a direction
    /// (or content was loaded already wrapped from DB).
    /// </summary>
    private string BuildSaveHtml(string editorHtml)
    {
        if (_saveDirection is null)
            return editorHtml ?? "";

        var inner = Unwrap(editorHtml ?? "").Trim();
        if (IsEffectivelyEmpty(inner))
            return editorHtml ?? "";

        return $"<div dir=\"{_saveDirection}\" style=\"direction:{_saveDirection}\">{inner}</div>";
    }

    private static string NormalizeDir(string? direction) =>
        direction != null && direction.Equals("rtl", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";

    private static string? DetectDirection(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return null;
        var m = OuterDirectionDiv.Match(html);
        if (!m.Success) return null;
        var dir = m.Groups["dirStyle"].Success ? m.Groups["dirStyle"].Value : m.Groups["dirAttr"].Value;
        return string.IsNullOrEmpty(dir) ? null : dir.ToLowerInvariant();
    }

    private static string Unwrap(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return html ?? "";
        var m = OuterDirectionDiv.Match(html);
        return m.Success ? m.Groups["inner"].Value : html;
    }

    private static bool IsEffectivelyEmpty(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return true;
        var text = Regex.Replace(html, "<[^>]+>", " ");
        text = text.Replace("\u00a0", " ", StringComparison.Ordinal)
            .Replace("&nbsp;", " ", StringComparison.OrdinalIgnoreCase)
            .Trim();
        return text.Length == 0;
    }

    private static string? NormalizeLanguage(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return null;
        return code.Trim().ToLowerInvariant();
    }

    public async ValueTask DisposeAsync()
    {
        if (_toolbarAttached)
        {
            try { await JS.InvokeVoidAsync("dnCkEditor.dispose", _host); }
            catch { /* circuit disposed */ }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
        _toolbarAttached = false;
    }
}
