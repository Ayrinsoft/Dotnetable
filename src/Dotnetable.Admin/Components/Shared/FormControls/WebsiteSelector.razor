@using Dotnetable.Domain.Entities

<MudAutocomplete T="Website" Value="_selected" ValueChanged="OnSelected"
                  SearchFunc="SearchAsync" ToStringFunc="@(w => w == null ? string.Empty : $"{w.TradeName} (#{w.WebsiteID})")"
                  Label="@Label" Variant="@Variant" Margin="@Margin" Dense="@Dense" Style="@Style" Class="@Class"
                  Required="@Required" RequiredError="@RequiredError" Disabled="@Disabled" ReadOnly="@ReadOnly"
                  Clearable="@Clearable" CoerceText="true" ResetValueOnEmptyText="false" />

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public List<Website> Websites { get; set; } = new();
    [Parameter] public string? Label { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public bool Dense { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Clearable { get; set; }

    private Website? _selected;

    protected override void OnParametersSet()
    {
        if (_selected?.WebsiteID != Value)
            _selected = Websites.FirstOrDefault(w => w.WebsiteID == Value);
    }

    private async Task OnSelected(Website? website)
    {
        _selected = website;
        if (website != null && website.WebsiteID != Value)
            await ValueChanged.InvokeAsync(website.WebsiteID);
    }

    private Task<IEnumerable<Website>> SearchAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(Websites.AsEnumerable());

        var q = value.Trim();
        var results = Websites.Where(w =>
            w.TradeName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            w.WebsiteID.ToString().Contains(q));
        return Task.FromResult(results.AsEnumerable());
    }
}
