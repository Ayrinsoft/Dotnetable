@implements IDisposable
@inject IPageLocalizer L
@inject IWebsiteService WebsiteService
@inject AdminUiModeState UiModeState

<MudNavMenu Class="pt-1">

    <span class="app-nav-label">@L["nav.navigation", "Navigation"]</span>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        @L["dashboard", "Dashboard"]
    </MudNavLink>

    @if (_canMembers || _canClients || _canPolicies || _canLoginLogs || _canMessages || _canWebsite || _isMaster)
    {
        <span class="app-nav-label">@L["nav.management", "Management"]</span>
    }
    <MudNavGroup Title="@L["nav.user_management", "User Management"]" Icon="@Icons.Material.Filled.People" Expanded="true"
                 Hidden="@(!_canMembers && !_canClients && !_canPolicies && !_canLoginLogs && !_isMaster)">
        <AuthorizeView Policy="@RoleKeys.MembersView" Context="m">
            <MudNavLink Href="/members" Icon="@Icons.Material.Filled.PersonOutline">
                @L["members", "Members"]
            </MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.ClientsView" Context="c">
            <MudNavLink Href="/clients" Icon="@Icons.Material.Filled.People">
                @L["clients", "Customers"]
            </MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.PoliciesView" Context="p">
            <MudNavLink Href="/policies" Icon="@Icons.Material.Filled.Shield">
                @L["access_levels", "Access Levels"]
            </MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@AdminPolicies.SuperAdminOnly" Context="roles">
            <MudNavLink Href="/roles" Icon="@Icons.Material.Filled.VpnKey">
                @L["roles", "Roles"]
            </MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.LoginLogsView" Context="ll">
            <MudNavLink Href="/login-logs" Icon="@Icons.Material.Filled.History">
                @L["login_logs", "Login Logs"]
            </MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <AuthorizeView Policy="@RoleKeys.WebsiteEdit" Context="ws">
        <MudNavGroup Title="@L["website", "Website"]" Icon="@Icons.Material.Filled.WebAsset">
            <AuthorizeView Policy="@AdminPolicies.SuperAdminOnly" Context="wsm">
                <MudNavLink Href="/websites" Icon="@Icons.Material.Filled.Language">
                    @L["websites", "Websites"]
                </MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="/website/ips" Icon="@Icons.Material.Filled.Security">
                @L["ip_whitelist", "IP Whitelist"]
            </MudNavLink>
            <MudNavLink Href="/website/scripts" Icon="@Icons.Material.Filled.Code">
                @L["scripts", "Scripts"]
            </MudNavLink>
            <MudNavLink Href="/website/seo" Icon="@Icons.Material.Filled.Search">
                @L["seo_settings", "SEO Settings"]
            </MudNavLink>
            <MudNavLink Href="/website/social" Icon="@Icons.Material.Filled.Share">
                @L["social_links", "Social Links"]
            </MudNavLink>
            @if (_isMaster || _websiteIdForUiMode != AppConstants.MasterWebsiteId)
            {
                <MudNavLink Href="/website/api-key" Icon="@Icons.Material.Filled.VpnKey">
                    @L["website_api_key", "Website API Key"]
                </MudNavLink>
            }
        </MudNavGroup>
    </AuthorizeView>
    
    <MudNavGroup Title="@L["messages", "Messages"]" Icon="@Icons.Material.Filled.Message"
                 Hidden="@(!_canMessages && !_canWebsite && !_isMaster)">
        <AuthorizeView Policy="@RoleKeys.MessagesView" Context="cm">
            <MudNavLink Href="/messages/contacts" Icon="@Icons.Material.Filled.ContactMail">
                @L["contact_messages", "Contact Messages"]
            </MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.WebsiteEdit" Context="em">
            <MudNavLink Href="/messages/email" Icon="@Icons.Material.Filled.Email">
                @L["email_settings", "Email Settings"]
            </MudNavLink>
        </AuthorizeView>
    </MudNavGroup>


    @if (_canPosts || _canPages || _canTaxonomy || _canRedirects)
    {
        <span class="app-nav-label">@L["nav.content", "Content"]</span>
    }
    <MudNavGroup Title="@L["content", "Content"]" Icon="@Icons.Material.Filled.Article" hidden="@(!_canPosts && !_canPages && !_canTaxonomy && !_canRedirects)">

        
        <AuthorizeView Policy="@RoleKeys.MenusView" Context="mn">
            <MudNavLink Href="/menus" Icon="@Icons.Material.Filled.Menu">
                @L["menus", "Menus"]
            </MudNavLink>
        </AuthorizeView>

        @if (!_hideBlogNavForBasicStore)
        {
            <AuthorizeView Policy="@RoleKeys.PostsView" Context="po">
                <MudNavLink Href="/content/posts" Icon="@Icons.Material.Filled.Article">
                    @L["posts", "Posts"]
                </MudNavLink>
            </AuthorizeView>
        }
        <AuthorizeView Policy="@RoleKeys.PagesView" Context="pg">
            <MudNavLink Href="/content/pages" Icon="@Icons.Material.Filled.Description">
                @L["pages", "Pages"]
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@RoleKeys.ModerationView" Context="mod">
            <MudNavGroup Title="@L["nav.moderation", "Reviews & Q&A"]" Icon="@Icons.Material.Filled.RateReview">
                <MudNavLink Href="/moderation/reviews" Icon="@Icons.Material.Filled.Star">@L["moderation.reviews", "Reviews"]</MudNavLink>
                <MudNavLink Href="/moderation/questions" Icon="@Icons.Material.Filled.QuestionAnswer">@L["moderation.questions", "Questions"]</MudNavLink>
            </MudNavGroup>
        </AuthorizeView>

        <AuthorizeView Policy="@RoleKeys.SlideshowsView" Context="sl">
            <MudNavLink Href="/slideshows" Icon="@Icons.Material.Filled.ViewCarousel">
                @L["slideshows", "Slideshows"]
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@RoleKeys.FormsView" Context="fm">
            <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.DynamicForm">
                @L["forms", "Forms & Surveys"]
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Policy="@RoleKeys.ThemesView" Context="th">
            <MudNavLink Href="/themes" Icon="@Icons.Material.Filled.Palette">
                @L["themes", "Themes"]
            </MudNavLink>
        </AuthorizeView>

        @if (!_hideBlogNavForBasicStore)
        {
            <AuthorizeView Policy="@RoleKeys.TaxonomyView" Context="tx">
                <MudNavLink Href="/content/categories" Icon="@Icons.Material.Filled.Category">
                    @L["categories", "Categories"]
                </MudNavLink>
                <MudNavLink Href="/content/tags" Icon="@Icons.Material.Filled.Label">
                    @L["tags", "Tags"]
                </MudNavLink>
                <MudNavLink Href="/content/post-types" Icon="@Icons.Material.Filled.Dashboard">
                    @L["post_types", "Post Types"]
                </MudNavLink>
            </AuthorizeView>
        }
        <AuthorizeView Policy="@RoleKeys.RedirectsView" Context="rd">
            <MudNavLink Href="/content/redirects" Icon="@Icons.Material.Filled.CallSplit">
                @L["redirects", "Redirects"]
            </MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <AuthorizeView Policy="@RoleKeys.LocalizationEdit" Context="tr">
        <MudNavLink Href="/translations" Icon="@Icons.Material.Filled.Translate">
            @L["translations", "Translations"]
        </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@RoleKeys.MediaView" Context="md">
        <MudNavGroup Title="@L["media", "Media"]" Icon="@Icons.Material.Filled.PermMedia">
            <MudNavLink Href="/media" Icon="@Icons.Material.Filled.PhotoLibrary">
                @L["media_library", "Media Library"]
            </MudNavLink>
            <AuthorizeView Policy="@RoleKeys.MediaUpload" Context="ms">
                <MudNavLink Href="/media/storage" Icon="@Icons.Material.Filled.Cloud">
                    @L["storage", "Storage"]
                </MudNavLink>
                <MudNavLink Href="/media/watermark" Icon="@Icons.Material.Filled.BrandingWatermark">
                    @L["watermark.heading", "Watermark"]
                </MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>


    <span class="app-nav-label">@L["nav.commerce", "Commerce"]</span>
    <MudNavGroup Title="@L["nav.catalog", "Catalog"]" Icon="@Icons.Material.Filled.Inventory2">
        <AuthorizeView Policy="@RoleKeys.ProductsView" Context="pr">
            <MudNavLink Href="/catalog/products" Icon="@Icons.Material.Filled.ShoppingBag">@L["products", "Products"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.CatalogTaxonomyView" Context="pcat">
            <MudNavLink Href="/catalog/categories" Icon="@Icons.Material.Filled.Category">@L["categories", "Categories"]</MudNavLink>
            <MudNavLink Href="/catalog/attributes" Icon="@Icons.Material.Filled.Tune">@L["attributes", "Attributes"]</MudNavLink>
            <MudNavLink Href="/catalog/brands" Icon="@Icons.Material.Filled.BrandingWatermark">@L["brands", "Brands"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.VendorsView" Context="vd">
            <MudNavLink Href="/catalog/vendors" Icon="@Icons.Material.Filled.Store">@L["vendors", "Vendors"]</MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <AuthorizeView Policy="@RoleKeys.InventoryView" Context="inv">
        <MudNavGroup Title="@L["nav.inventory", "Inventory"]" Icon="@Icons.Material.Filled.Warehouse">
            <MudNavLink Href="/inventory" Icon="@Icons.Material.Filled.Numbers">@L["inventory.stock", "Stock"]</MudNavLink>
            <MudNavLink Href="/inventory/movements" Icon="@Icons.Material.Filled.History">@L["inventory.movements", "Movements"]</MudNavLink>
            <AuthorizeView Policy="@RoleKeys.SuppliersView" Context="sup">
                <MudNavLink Href="/inventory/suppliers" Icon="@Icons.Material.Filled.LocalShipping">@L["suppliers", "Suppliers"]</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@RoleKeys.OrdersView" Context="ord">
        <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.ReceiptLong">@L["orders", "Orders"]</MudNavLink>
    </AuthorizeView>

    <MudNavGroup Title="@L["nav.finance", "Finance"]" Icon="@Icons.Material.Filled.Payments">
        <AuthorizeView Policy="@RoleKeys.PaymentsView" Context="pay">
            <MudNavLink Href="/payments" Icon="@Icons.Material.Filled.CreditCard">@L["payments", "Payments"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.PaymentsRefund" Context="rfnd">
            <MudNavLink Href="/payments/refunds" Icon="@Icons.Material.Filled.AssignmentReturn">@L["payments.refunds", "Bank Refunds"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.WalletsView" Context="wal">
            <MudNavLink Href="/wallets/withdrawals" Icon="@Icons.Material.Filled.AccountBalanceWallet">@L["wallets.withdrawals", "Withdrawals"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.BankAccountsView" Context="bnk">
            <MudNavLink Href="/finance/bank-accounts" Icon="@Icons.Material.Filled.AccountBalance">@L["bank_accounts", "Bank Accounts"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.CurrencyView" Context="cur">
            <MudNavLink Href="/finance/currency-rates" Icon="@Icons.Material.Filled.CurrencyExchange">@L["currency_rates", "Exchange Rates"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@AdminPolicies.SuperAdminOnly" Context="bnkm">
            <MudNavLink Href="/finance/banks" Icon="@Icons.Material.Filled.AccountBalance">@L["banks", "Banks"]</MudNavLink>
            <MudNavLink Href="/finance/currencies" Icon="@Icons.Material.Filled.CurrencyExchange">@L["currencies", "Currencies"]</MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <MudNavGroup Title="@L["nav.promotions", "Promotions & Shipping"]" Icon="@Icons.Material.Filled.LocalOffer">
        <AuthorizeView Policy="@RoleKeys.CouponsView" Context="cpn">
            <MudNavLink Href="/sales/coupons" Icon="@Icons.Material.Filled.Discount">@L["coupons", "Coupons"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.ShippingView" Context="shp">
            <MudNavLink Href="/sales/shipping" Icon="@Icons.Material.Filled.LocalShipping">@L["shipping", "Shipping"]</MudNavLink>
        </AuthorizeView>
        <AuthorizeView Policy="@RoleKeys.TaxView" Context="tax">
            <MudNavLink Href="/sales/tax" Icon="@Icons.Material.Filled.Percent">@L["tax", "Tax"]</MudNavLink>
        </AuthorizeView>
    </MudNavGroup>

    <AuthorizeView Policy="@AdminPolicies.SuperAdminOnly">
        <span class="app-nav-label">@L["nav.administration", "Administration"]</span>
        <MudNavGroup Title="@L["initial_data", "Initial Data"]" Icon="@Icons.Material.Filled.Storage">
            <MudNavLink Href="/initial-data/countries" Icon="@Icons.Material.Filled.Flag">
                @L["countries", "Countries"]
            </MudNavLink>
            <MudNavLink Href="/initial-data/states" Icon="@Icons.Material.Filled.Map">
                @L["states", "States / Provinces"]
            </MudNavLink>
            <MudNavLink Href="/initial-data/cities" Icon="@Icons.Material.Filled.LocationCity">
                @L["cities", "Cities"]
            </MudNavLink>
        </MudNavGroup>

        <span class="app-nav-label">@L["nav.system", "System"]</span>
        <MudNavLink Href="/system/updates" Icon="@Icons.Material.Filled.SystemUpdateAlt">
            @L["db_updates", "DB Updates"]
        </MudNavLink>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
            @L["settings", "Settings"]
        </MudNavLink>
    </AuthorizeView>

</MudNavMenu>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isMaster;
    private bool _canMembers;
    private bool _canClients;
    private bool _canPolicies;
    private bool _canLoginLogs;
    private bool _canMessages;
    private bool _canWebsite;
    private bool _canPosts;
    private bool _canPages;
    private bool _canTaxonomy;
    private bool _canRedirects;
    private bool _hideBlogNavForBasicStore;
    private int? _websiteIdForUiMode;

    protected override async Task OnInitializedAsync()
    {
        await L.EnsureLoadedAsync();

        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
            _canMembers = AdminPolicies.Allows(user, RoleKeys.MembersView);
            _canClients = AdminPolicies.Allows(user, RoleKeys.ClientsView);
            _canPolicies = AdminPolicies.Allows(user, RoleKeys.PoliciesView);
            _canLoginLogs = AdminPolicies.Allows(user, RoleKeys.LoginLogsView);
            _canMessages = AdminPolicies.Allows(user, RoleKeys.MessagesView);
            _canWebsite = AdminPolicies.Allows(user, RoleKeys.WebsiteEdit);
            _canPosts = AdminPolicies.Allows(user, RoleKeys.PostsView);
            _canPages = AdminPolicies.Allows(user, RoleKeys.PagesView);
            _canTaxonomy = AdminPolicies.Allows(user, RoleKeys.TaxonomyView);
            _canRedirects = AdminPolicies.Allows(user, RoleKeys.RedirectsView);

            // Basic mode: trim the admin surface to what this member's Website.WebsiteType needs —
            // a pure store rarely needs blog taxonomy (Posts/Categories/Tags/Post Types).
            _websiteIdForUiMode = int.TryParse(user.FindFirst(AdminClaimTypes.WebsiteId)?.Value, out var websiteId) ? websiteId : null;
            await RefreshBlogNavVisibilityAsync();
        }

        UiModeState.Changed += OnUiModeChanged;
    }

    private async void OnUiModeChanged()
    {
        await RefreshBlogNavVisibilityAsync();
        StateHasChanged();
    }

    private async Task RefreshBlogNavVisibilityAsync()
    {
        _hideBlogNavForBasicStore = false;
        if (UiModeState.Current == AdminUiMode.Basic && !_isMaster && _websiteIdForUiMode is { } websiteId)
        {
            var site = await WebsiteService.GetByIdAsync(websiteId);
            _hideBlogNavForBasicStore = site?.WebsiteType.GetCategory() == WebsiteCategory.Commerce;
        }
    }

    public void Dispose() => UiModeState.Changed -= OnUiModeChanged;
}
