@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.JSInterop
@using Dotnetable.Admin.Auth
@using Dotnetable.Admin.Localization
@using Dotnetable.Admin.Theme
@inject IJSRuntime JS
@inject AdminUiModeState UiModeState
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject IPageLocalizer Loc
@inject NavigationManager Nav
@inject Dotnetable.Application.Interfaces.ILanguageService LanguageService

<MudRTLProvider RightToLeft="@_isRtl">
<MudPopoverProvider />
<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized Context="authCtx">
        <MudLayout Class="@(Loc.LanguageCode == "fa" ? "lang-fa" : null)" dir="@(_isRtl ? "rtl" : "ltr")">
            <MudAppBar Elevation="0" Dense="true" Color="Color.Surface">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" Edge="Edge.Start"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" />
                <MudTooltip Text="Search">
                    <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Default" OnClick="OpenSearchPalette" />
                </MudTooltip>
                <MudSpacer />
                <MudMenu Class="me-1">
                    <ActivatorContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="cursor-pointer">
                            <MudText Typo="Typo.body2" Class="me-1 d-none d-sm-flex" Style="color:#4c4c5c;">
                                @authCtx.User.Identity?.Name
                            </MudText>
                            <MudAvatar Color="Color.Primary" Size="Size.Small">
                                @(_initials(authCtx.User.Identity?.Name))
                            </MudAvatar>
                        </MudStack>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="@(() => GoToProfile(authCtx.User))">
                            Profile
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
                @if (!_isMaster)
                {
                    <MudTooltip Text="View mode (this browser only)">
                        <MudMenu Icon="@Icons.Material.Filled.Tune" Color="Color.Default">
                            @foreach (var mode in _uiModes)
                            {
                                <MudMenuItem OnClick="@(() => SetUiMode(mode))" Class="@(UiModeState.Current == mode ? "fw-bold" : null)">
                                    @mode
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </MudTooltip>
                }
                <MudTooltip Text="Language">
                    <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Default">
                        @foreach (var lang in _languages)
                        {
                            <MudMenuItem OnClick="@(() => SetLanguage(lang.Code))" Class="@(Loc.LanguageCode == lang.Code ? "fw-bold" : null)">
                                @lang.Flag @lang.Native
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTooltip>
                <MudTooltip Text="Admin skin (this browser only)">
                    <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Default" AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">
                        <div class="pa-2" style="min-width:200px;">
                            <MudText Typo="Typo.caption" Class="px-2 pb-2" Color="Color.Secondary">Panel skin</MudText>
                            @foreach (var skin in AdminSkinCatalog.All)
                            {
                                <MudMenuItem OnClick="@(() => SetSkinAsync(skin.Id))"
                                             Class="@(_skinId == skin.Id ? "fw-bold mud-primary-text" : null)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <span style="width:16px;height:16px;border-radius:50%;background:@skin.Primary;border:1px solid rgba(0,0,0,.12);display:inline-block;"></span>
                                        <span>@skin.Name</span>
                                        @if (_skinId == skin.Id)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                        }
                                    </MudStack>
                                </MudMenuItem>
                            }
                        </div>
                    </MudMenu>
                </MudTooltip>
                <MudTooltip Text="@(_isDarkMode ? "Light mode" : "Dark mode")">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Color="Color.Default" OnClick="ToggleDarkMode" />
                </MudTooltip>
                <MudTooltip Text="Logout">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Default" Href="/Logout" />
                </MudTooltip>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
                       ClipMode="DrawerClipMode.Never">
                <MudDrawerHeader Class="d-flex align-center gap-2 px-4">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="@($"color:{_skin.Primary};")" Size="Size.Medium" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold lh-1" Style="color:#fff; letter-spacing:.04em;">
                            @AppBranding.Name.ToUpperInvariant()
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#6d7681;">Dotnetable Panel</MudText>
                    </MudStack>
                </MudDrawerHeader>
                <NavMenu />
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4 px-sm-6">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
</MudRTLProvider>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _isMaster;
    private bool _isRtl;
    private string _skinId = AdminSkinCatalog.DefaultId;
    private AdminSkin _skin = AdminSkinCatalog.Get(AdminSkinCatalog.DefaultId);
    private MudTheme _theme = AdminSkinCatalog.BuildMudTheme(AdminSkinCatalog.Get(AdminSkinCatalog.DefaultId));
    private static readonly AdminUiMode[] _uiModes = Enum.GetValues<AdminUiMode>();

    private IReadOnlyList<LanguageOption> _languages = SupportedLanguages.Defaults;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _isMaster = user.HasClaim(AdminClaimTypes.Master, "true");
        UiModeState.Initialize(AdminClaimTypes.GetUiMode(user));
        UiModeState.Changed += StateHasChanged;

        var catalog = await LanguageService.GetActiveCatalogAsync();
        _languages = catalog.Select(l => l.ToOption()).ToList();

        await Loc.EnsureLoadedAsync();
        _isRtl = _languages.FirstOrDefault(l => l.Code == Loc.LanguageCode)?.Rtl ?? false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The real <html> element is static markup in App.razor, so RTL/lang have to be set
            // from script once the DB-resolved language is known — this also reaches dialogs,
            // menus and snackbars, which MudBlazor portals onto document.body outside MudLayout.
            await JS.InvokeVoidAsync("dotnetableLang.setDir", _isRtl, Loc.LanguageCode);

            var stored = await JS.InvokeAsync<string>("dotnetableTheme.get");
            if (stored == "dark" && !_isDarkMode)
                _isDarkMode = true;

            var storedSkin = await JS.InvokeAsync<string>("dotnetableAdminSkin.get");
            if (!string.IsNullOrWhiteSpace(storedSkin))
                ApplySkin(storedSkin);

            var storedMode = await JS.InvokeAsync<string>("dotnetableUiMode.get");
            if (Enum.TryParse<AdminUiMode>(storedMode, out var mode))
                UiModeState.Set(mode);

            StateHasChanged();
        }
    }

    private async Task OpenSearchPalette()
    {
        await DialogService.ShowAsync<SearchPaletteDialog>(null, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        });
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("dotnetableTheme.set", _isDarkMode ? "dark" : "light");
    }

    private async Task SetSkinAsync(string skinId)
    {
        ApplySkin(skinId);
        await JS.InvokeVoidAsync("dotnetableAdminSkin.set", _skinId);
    }

    private void ApplySkin(string skinId)
    {
        _skin = AdminSkinCatalog.Get(skinId);
        _skinId = _skin.Id;
        _theme = AdminSkinCatalog.BuildMudTheme(_skin);
    }

    private async Task SetUiMode(AdminUiMode mode)
    {
        UiModeState.Set(mode);
        await JS.InvokeVoidAsync("dotnetableUiMode.set", mode.ToString());
    }

    // Persists the choice, then does a full reload so the fresh circuit re-resolves
    // PageLocalizer.LanguageCode from the cookie and re-loads every page's translations.
    private async Task SetLanguage(string code)
    {
        await JS.InvokeVoidAsync("dotnetableLang.set", code);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    public void Dispose() => UiModeState.Changed -= StateHasChanged;

    private void GoToProfile(System.Security.Claims.ClaimsPrincipal user)
    {
        var memberId = user.FindFirst(AdminClaimTypes.MemberId)?.Value;
        if (!string.IsNullOrEmpty(memberId))
            Nav.NavigateTo($"/members/{memberId}");
    }

    private static string _initials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpper();
}
